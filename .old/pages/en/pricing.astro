---
import Layout from '../../layouts/Layout.astro';
import PricingBody from '../../components/PricingBody.astro';
import Redirect from '../../components/Redirect.astro';
import { TEASER } from '../../config/site';
---
{TEASER ? <Redirect to="/en/" locale="en" label="AirFone" /> : (
<Layout
  locale="en"
  path="/pricing/"
  title="Pricing | AirFone AI call center for Nepal"
  description="Pricing for AirFone, the AI call center for Nepali businesses, is announced at launch on 28 September. Built for shops, clinics, schools and online stores. Waitlist members hear first."
>
  <PricingBody locale="en" />
</Layout>
)}

---
// Shared layout for the legal pages (privacy, terms): a heading, the date
// it was last changed, an introduction, then numbered sections of
// paragraphs and lists.
import StructuredData from './StructuredData.astro';
import type { Locale } from '../i18n';

export interface Section {
  h: string;
  p?: readonly string[];
  list?: readonly string[];
}
export interface Props {
  locale: Locale;
  h1: string;
  updated: string;
  intro: readonly string[];
  sections: readonly Section[];
}
const { locale, h1, updated, intro, sections } = Astro.props;
---
<StructuredData locale={locale} />
<section class="page-hero">
  <div class="wrap prose">
    <h1>{h1}</h1>
    <p class="updated">{updated}</p>
    {intro.map((p) => <p set:html={p} />)}
    {sections.map((s, i) => (
      <>
        <h2>{i + 1}. {s.h}</h2>
        {(s.p ?? []).map((p) => <p set:html={p} />)}
        {s.list && (
          <ul>
            {s.list.map((li) => <li set:html={li} />)}
          </ul>
        )}
      </>
    ))}
  </div>
</section>
<style>
  .page-hero {
    padding: 72px 0 96px;
  }
  .prose {
    max-width: 720px;
  }
  .prose p,
  .prose li {
    color: var(--ink-muted);
  }
  .prose p {
    margin-top: 16px;
  }
  .prose .updated {
    margin-top: 8px;
  }
  .prose h2 {
    margin-top: 48px;
  }
  .prose ul {
    margin: 16px 0 0;
    padding-left: 24px;
    display: grid;
    gap: 8px;
  }
</style>

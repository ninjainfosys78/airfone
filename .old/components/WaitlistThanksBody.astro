---
import { localePath, type Locale } from '../i18n';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// The API redirects here with ?status=. The page is static, so the heading
// is picked in the browser; without JS the generic heading stays.
const copy = {
  ne: {
    created: 'सूचीमा तपाईंको नाम दर्ता भयो',
    already_on_list: 'तपाईं पहिले नै सूचीमा हुनुहुन्छ',
    fallback: 'धन्यवाद',
    home: 'गृहपृष्ठमा फर्कनुहोस्',
  },
  en: {
    created: "You're on the waitlist",
    already_on_list: "You're already on the list",
    fallback: 'Thank you',
    home: 'Back to the homepage',
  },
} as const;
const c = copy[locale];
---
<section class="page-hero">
  <div class="wrap">
    <h1 data-thanks data-created={c.created} data-already={c.already_on_list}>{c.fallback}</h1>
    <a class="btn btn-primary" href={localePath(locale, '/')}>{c.home}</a>
  </div>
</section>
<style>
  .page-hero {
    padding: 104px 0 120px;
  }
  .btn {
    margin-top: 40px;
    height: 52px;
    padding: 0 24px;
  }
</style>
<script>
  const h1 = document.querySelector<HTMLElement>('[data-thanks]');
  const status = new URLSearchParams(location.search).get('status');
  if (h1 && status === 'created') h1.textContent = h1.dataset.created || h1.textContent;
  if (h1 && status === 'already_on_list') h1.textContent = h1.dataset.already || h1.textContent;
</script>

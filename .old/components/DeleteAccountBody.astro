---
import StructuredData from './StructuredData.astro';
import { CONTACT_EMAIL } from '../config/site';
import type { Locale } from '../i18n';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const copy = {
  ne: {
    h1: 'आफ्नो AirFone खाता मेटाउनुहोस्',
    intro: 'तपाईंले एपबाटै खाता मेटाउन सक्नुहुन्छ। एप छैन भने इमेल गरेर पनि अनुरोध गर्न सकिन्छ।',
    appH: 'एपमा',
    steps: [
      'AirFone खोलेर साइन इन गर्नुहोस्।',
      'सेटिङ खोल्नुहोस्, त्यसपछि प्रोफाइल।',
      'पृष्ठको सबैभन्दा तल खाता मेटाउनुहोस् थिच्नुहोस्।',
      'आफ्नो पासवर्ड हाल्नुहोस्। Google बाट साइन इन गर्नुभएको भए आफ्नो इमेल टाइप गर्नुहोस्।',
      'खाता मेटाउनुहोस् थिच्नुहोस्। खाता तुरुन्तै मेटिन्छ र तपाईं साइन आउट हुनुहुन्छ।',
    ],
    blocked:
      'तपाईं कुनै व्यवसायको मालिक हुनुहुन्छ र त्यसमा अरू सदस्य छन् भने खाता मेटिँदैन। पहिला मालिकको अधिकार हस्तान्तरण गर्नुहोस् वा सदस्यहरू हटाउनुहोस्।',
    deletedH: 'के मेटिन्छ',
    deleted: [
      'तपाईंको नाम, इमेल, फोन नम्बर, पासवर्ड र Google खातासँगको सम्बन्ध।',
      'साइन इन भएका उपकरण, सूचना पठाउने टोकन र सूचनाहरू।',
      'टोलीको सदस्यता र पाएका निमन्त्रणाहरू।',
      'तपाईं व्यवसायका एक्लो सदस्य हुनुहुन्छ भने व्यवसाय नै बन्द हुन्छ: सहायक, ज्ञानको सामग्री, कल, रेकर्डिङ र ट्रान्सक्रिप्ट मेटिन्छन्, र फोन नम्बर फुकुवा हुन्छन्। फुकुवा भएका नम्बर ३० दिनसम्म कसैलाई दिइँदैन।',
    ],
    keptH: 'के राखिन्छ',
    kept: [
      'भुक्तानी, वालेट र इनभ्वाइसका अभिलेख, लेखा र करका लागि ७ वर्षसम्म। यिनमा अब तपाईंको नाम वा इमेल हुँदैन।',
      'वालेटमा बाँकी रकम खाता मेटाएपछि फिर्ता हुँदैन। फिर्ता चाहिए खाता मेटाउनुअघि हामीलाई लेख्नुहोस्।',
      'ब्याकअपमा रहेका प्रतिलिपि ३० दिनभित्र हट्छन्।',
      'व्यवसायमा अरू सदस्य छन् र तपाईं सदस्य मात्र हुनुहुन्थ्यो भने कल, रेकर्डिङ र ट्रान्सक्रिप्ट व्यवसायसँगै रहन्छन्। ती व्यवसायका हुन्, तपाईंका होइनन्।',
    ],
    emailH: 'एप नभएकाका लागि',
    email: 'आफ्नो खातामा दर्ता भएको इमेलबाट हामीलाई लेख्नुहोस्:',
    emailSubject: 'विषयमा “खाता मेटाउने अनुरोध” लेख्नुहोस्। हामी ३० दिनभित्र खाता मेटाउँछौं र त्यही इमेलमा जानकारी दिन्छौं।',
  },
  en: {
    h1: 'Delete your AirFone account',
    intro: 'You can delete your account in the app. If you no longer have the app, you can ask us by email.',
    appH: 'In the app',
    steps: [
      'Open AirFone and sign in.',
      'Open Settings, then Profile.',
      'Scroll to the bottom and tap Delete account.',
      'Enter your password. If you signed in with Google, type your email instead.',
      'Tap Delete account. Your account is deleted at once and you are signed out.',
    ],
    blocked:
      'If you own a business that still has other members, the account is not deleted. Transfer ownership or remove them first.',
    deletedH: 'What is deleted',
    deleted: [
      'Your name, email, phone number, password and Google sign-in link.',
      'Your signed-in devices, push notification tokens and notifications.',
      'Your team membership and any invitations.',
      'If you are the only person in your business, the business is closed too. Its assistant, knowledge, calls, recordings and transcripts are deleted, and its phone numbers are released. Released numbers are held for 30 days before anyone else can get them.',
    ],
    keptH: 'What is kept',
    kept: [
      'Payment, wallet and invoice records, for 7 years for accounting and tax. They no longer carry your name or email.',
      'Any balance left in your wallet is not refunded after deletion. If you want it back, write to us before you delete your account.',
      'Copies in backups are gone within 30 days.',
      'If your business has other members, its calls, recordings and transcripts stay with the business. They belong to the business, not to you.',
    ],
    emailH: 'Without the app',
    email: 'Write to us from the email address registered to your account:',
    emailSubject: 'Put “Delete my account” in the subject. We delete the account within 30 days and confirm by reply.',
  },
} as const;
const c = copy[locale];
---
<StructuredData locale={locale} />
<section class="page-hero">
  <div class="wrap prose">
    <h1>{c.h1}</h1>
    <p>{c.intro}</p>

    <h2>{c.appH}</h2>
    <ol>
      {c.steps.map((s) => <li>{s}</li>)}
    </ol>
    <p>{c.blocked}</p>

    <h2>{c.deletedH}</h2>
    <ul>
      {c.deleted.map((s) => <li>{s}</li>)}
    </ul>

    <h2>{c.keptH}</h2>
    <ul>
      {c.kept.map((s) => <li>{s}</li>)}
    </ul>

    <h2>{c.emailH}</h2>
    <p>{c.email} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
    <p>{c.emailSubject}</p>
  </div>
</section>
<style>
  .page-hero {
    padding: 72px 0 96px;
  }
  .prose {
    max-width: 720px;
  }
  .prose p,
  .prose li {
    color: var(--ink-muted);
  }
  .prose p {
    margin-top: 16px;
  }
  .prose h2 {
    margin-top: 48px;
  }
  .prose ol,
  .prose ul {
    margin: 16px 0 0;
    padding-left: 24px;
    display: grid;
    gap: 8px;
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ShieldCheck, Lock, Globe2, BarChart3, Check, Phone, Bot, ArrowRight } from 'lucide-react';
const locale = 'ne';
---

<BaseLayout title="हाम्रोबारे — AirFone" solidNav={true}>

  <!-- ============ ABOUT INTRO ============ -->
  <section class="about-hero">
    <div class="about-hero-bg" aria-hidden="true"></div>
    <div class="about-hero-inner">
      <div class="about-hero-text">
        <h1 class="about-hero-title">
          हामी विश्वास गर्छौं कि फोन कल अझै पनि<br />
          व्यवसायको सबैभन्दा <span class="about-highlight">मानवीय</span> च्यानल हो।
        </h1>
        <p class="about-hero-lede">
          हामी मात्र सोच्छौं कि यसले अन्ततः सुन्दै छ जस्तो लाग्नुपर्छ। AirFone कठोर,
          बटन-आधारित मेनुहरूलाई एउटा कन्भर्सेसनल AI तहले प्रतिस्थापन गर्न बनाइएको हो जसले
          उद्देश्य बुझ्छ, सन्दर्भ सम्झन्छ, र कलरलाई कहिल्यै होल्डमा राख्दैन।
        </p>
        <div class="about-hero-chips">
          <span class="about-chip"><Check size={14} /> AI-पहिलो भ्वाइस</span>
          <span class="about-chip"><Check size={14} /> टेलिकम-स्तरको भरपर्दोपन</span>
          <span class="about-chip"><Check size={14} /> नेपालमा निर्मित</span>
        </div>
      </div>

      <div class="about-hero-visual" aria-hidden="true">
        <div class="about-hero-ring">
          <div class="about-hero-ring-circle about-hero-ring-c1"></div>
          <div class="about-hero-ring-circle about-hero-ring-c2"></div>
          <div class="about-hero-ring-circle about-hero-ring-c3"></div>
          <div class="about-hero-ring-phone"><Phone size={42} /></div>
        </div>
        <div class="about-hero-float-card">
          <div class="about-hero-float-icon"><Bot size={18} /></div>
          <div>
            <div class="about-hero-float-num">२४/७</div>
            <div class="about-hero-float-label">AI ले हरेक कलको जवाफ दिन्छ</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ VISION + STATS ============ -->
  <section class="vision-section">
    <div class="vision-inner">
      <div class="vision-text">
        <span class="vision-tag">हाम्रो दृष्टिकोण</span>
        <h2 class="vision-title">व्यवसायिक भ्वाइस सञ्चारलाई पुनर्परिभाषित गर्दै।</h2>
        <p>
          हरेक फोन कललाई एउटा बौद्धिक, डाटा-संचालित अन्तरक्रियामा बदल्नु — मानव टिमहरूसँगै
          AI एजेन्टहरू प्रयोग गरेर कुनै पनि ग्राहकलाई कहिल्यै पर्खन नपरोस्, र कुनै पनि
          कुराकानी नमापिइको नरहोस्।
        </p>
        <p>
          परम्परागत PBX र IVR प्रणालीहरूले आफ्नो सञ्चालन सीमा पुगिसकेका छन्: रोबोटिक
          रेकर्डिङ, कठोर ट्री, र ट्रान्सफरहरूबीच कुनै सम्झना छैन। हामीले चाहेको प्लेटफर्म
          निर्माण गर्यौं — टेलिकम-स्तरको भरपर्दोपनका साथ एउटा AI तह जसले वास्तवमै
          कलरलाई बुझ्छ।
        </p>
      </div>

      <div class="vision-card">
        <div class="vision-stat">
          <div class="vision-stat-num">२०२४</div>
          <div class="vision-stat-label">काठमाडौंमा स्थापित</div>
        </div>
        <div class="vision-stat">
          <div class="vision-stat-num">३</div>
          <div class="vision-stat-label">नेटिभ रूपमा समर्थित भाषाहरू</div>
        </div>
        <div class="vision-stat">
          <div class="vision-stat-num">१,०००+</div>
          <div class="vision-stat-label">ठूलो स्केलमा समवर्ती कल च्यानलहरू</div>
        </div>
        <div class="vision-stat">
          <div class="vision-stat-num">९९.९५%</div>
          <div class="vision-stat-label">ग्यारेन्टीड कोर अपटाइम</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ VALUES ============ -->
  <section class="values-section">
    <div class="section-container">
      <span class="section-eyebrow">हामी केका लागि खडा छौं</span>
      <h2 class="section-title">हरेक आर्किटेक्चर निर्णय पछाडिका चार मूल्यहरू।</h2>

      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon"><ShieldCheck size={20} /></div>
          <h3>भरपर्दोपन पहिले</h3>
          <p>बहु-क्षेत्रीय रिडन्डेन्ट क्लस्टर र SBC हरू ताकि लाइन कहिल्यै कुराकानीको बीचमा नझरोस्।</p>
        </div>
        <div class="value-card">
          <div class="value-icon"><Lock size={20} /></div>
          <h3>सुरक्षा र अनुपालन</h3>
          <p>रेस्टमा AES-256, ट्रान्जिटमा TLS 1.3/SRTP, नियमित उद्योगहरूका लागि अन-प्रिमाइसेस विकल्पहरू।</p>
        </div>
        <div class="value-card">
          <div class="value-icon"><Globe2 size={20} /></div>
          <h3>स्थानीय, लोकलाइज्ड होइन</h3>
          <p>नेपाली, हिन्दी, र अंग्रेजी भ्वाइस मोडेलहरू यस क्षेत्रका लागि नै बनाइएका, थपिएका होइनन्।</p>
        </div>
        <div class="value-card">
          <div class="value-icon"><BarChart3 size={20} /></div>
          <h3>पूर्ण पारदर्शिता</h3>
          <p>हरेक कल ट्रान्सक्राइब, स्कोर, र सिंक गरिन्छ — कुनै पनि कुराकानी ब्ल्याक बक्स होइन।</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WHO WE WORK WITH ============ -->
  <section class="audience-section">
    <div class="section-container">
      <span class="section-eyebrow">हामी कोसँग काम गर्छौं</span>
      <h2 class="section-title light">फोनमै बस्ने टिमहरूका लागि निर्मित।</h2>
      <p class="audience-lede">
        ग्राहक सहयोग डेस्क, बिक्री र संकलन टिमहरू, र बैंकिङ, टेलिकम, खुद्रा, र सरकारी
        सेवाहरूमा उच्च कल भोल्युम चलाउने सञ्चालन इकाइहरू।
      </p>

      <div class="industry-tags">
        <span class="industry-tag">बैंकिङ र NBFC</span>
        <span class="industry-tag">टेलिकम</span>
        <span class="industry-tag">सरकार र सार्वजनिक सेवा</span>
        <span class="industry-tag">खुद्रा र ई-कमर्स</span>
        <span class="industry-tag">बीमा</span>
        <span class="industry-tag">लजिस्टिक्स</span>
      </div>
    </div>
  </section>

  <!-- ============ TEAM CTA ============ -->
  <section class="cta-section">
    <div class="cta-card">
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="cta-content">
        <h2 class="cta-title">प्लेटफर्म पछाडिको टिमलाई <span class="cta-accent">भेट्न चाहनुहुन्छ?</span></h2>
        <p class="cta-lede">हामी आर्किटेक्चरलाई लाइभ हिँडाउन खुसी छौं।</p>
        <div class="cta-actions">
          <a href={`/${locale}/contact/`} class="cta-btn">
            सम्पर्क गर्नुहोस्
            <ArrowRight size={18} />
          </a>
        </div>
      </div>

      <div class="cta-visual" aria-hidden="true">
        <div class="cta-ring">
          <div class="cta-ring-c1"></div>
          <div class="cta-ring-c2"></div>
          <div class="cta-ring-c3"></div>
          <div class="cta-ring-phone"><Phone size={40} /></div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ============ ABOUT INTRO ============ */
  .about-hero {
    position: relative;
    overflow: hidden;
    background: #FFFFFF;
    padding: 10rem 0 5rem;
  }

  .about-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 55% 70% at 82% 25%, rgba(109, 192, 64, 0.12), transparent 60%),
      radial-gradient(ellipse 45% 55% at 8% 95%, rgba(61, 181, 81, 0.08), transparent 60%),
      linear-gradient(180deg, #FFFFFF 0%, #F6FBF4 100%);
  }

  .about-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: center;
  }

  .about-hero-text {
    max-width: 720px;
  }

  .about-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    border: 1px solid rgba(61, 181, 81, 0.25);
    background: rgba(61, 181, 81, 0.06);
    color: var(--primary-dark);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .about-badge-icon { color: var(--primary); }

  .about-hero-title {
    font-size: clamp(2rem, 4.2vw, 2.9rem);
    font-weight: 800;
    line-height: 1.3;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    margin: 0 0 1.5rem;
  }

  .about-highlight {
    background: linear-gradient(135deg, #6DC040, #1B7A2F);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .about-hero-lede {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 720px;
    margin: 0 0 1.75rem;
  }

  .about-hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .about-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--primary-dark);
    background: #FFFFFF;
    border: 1px solid rgba(61, 181, 81, 0.22);
    border-radius: 9999px;
    padding: 0.45rem 1rem;
    box-shadow: 0 2px 8px rgba(61, 181, 81, 0.08);
  }

  .about-chip svg { color: var(--primary); flex-shrink: 0; }

  /* call-ring motif */
  .about-hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 380px;
  }

  .about-hero-ring {
    position: relative;
    width: 340px;
    height: 340px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about-hero-ring-circle {
    position: absolute;
    border-radius: 50%;
    border: 1.5px solid rgba(61, 181, 81, 0.18);
  }

  .about-hero-ring-c1 { width: 340px; height: 340px; }
  .about-hero-ring-c2 { width: 248px; height: 248px; }
  .about-hero-ring-c3 { width: 156px; height: 156px; }

  .about-hero-ring-phone {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6DC040, #2A8A3C);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 16px 32px rgba(42, 138, 60, 0.28);
    animation: aboutRingPulse 3.2s ease-in-out infinite;
  }

  @keyframes aboutRingPulse {
    0%, 100% { transform: scale(1); box-shadow: 0 16px 32px rgba(42, 138, 60, 0.28); }
    50% { transform: scale(1.06); box-shadow: 0 18px 40px rgba(42, 138, 60, 0.36); }
  }

  /* floating mini-stat card */
  .about-hero-float-card {
    position: absolute;
    right: 4%;
    bottom: 6%;
    background: #FFFFFF;
    border: 1px solid rgba(61, 181, 81, 0.22);
    border-radius: 14px;
    padding: 0.9rem 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    box-shadow: 0 12px 32px rgba(42, 138, 60, 0.14);
  }

  .about-hero-float-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(61, 181, 81, 0.1);
    border: 1px solid rgba(61, 181, 81, 0.22);
    color: var(--primary-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .about-hero-float-num {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.1;
  }

  .about-hero-float-label {
    font-size: 0.72rem;
    color: var(--text-secondary);
  }

  /* ============ VISION + STATS ============ */
  .vision-section {
    background: var(--bg-secondary);
    padding: 5rem 0;
  }

  .vision-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .vision-tag {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--primary-dark);
    margin-bottom: 1rem;
  }

  .vision-title {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    margin: 0 0 1.25rem;
    line-height: 1.4;
  }

  .vision-text p {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.8;
    margin: 0 0 1.25rem;
  }

  .vision-card {
    background: #FFFFFF;
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    box-shadow: 0 8px 30px rgba(61, 181, 81, 0.08);
  }

  .vision-stat-num {
    font-size: 1.9rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--primary-gradient-start), var(--primary-gradient-end));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .vision-stat-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  /* ============ SHARED ============ */
  .section-container { max-width: 1280px; margin: 0 auto; padding: 0 2rem; }
  .section-eyebrow {
    display: block; font-family: monospace; font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--primary-dark); margin-bottom: 1rem;
  }
  .section-title {
    font-size: clamp(1.6rem, 3.2vw, 2.2rem); font-weight: 800; color: var(--text-primary);
    letter-spacing: -0.01em; line-height: 1.4; margin: 0 0 2.5rem; max-width: 640px;
  }
  .section-title.light { color: var(--text-primary); }

  /* ============ VALUES ============ */
  .values-section {
    background: #FFFFFF;
    padding: 5rem 0;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .value-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 1.75rem;
  }

  .value-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(61, 181, 81, 0.1);
    border: 1px solid rgba(61, 181, 81, 0.25);
    color: var(--primary-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.1rem;
  }

  .value-card h3 {
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.6rem;
  }

  .value-card p {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  /* ============ WHO WE WORK WITH ============ */
  .audience-section {
    background: #F4FAF5;
    padding: 5rem 0;
  }

  .audience-lede {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.8;
    max-width: 640px;
    margin: 0 0 2.25rem;
  }

  .industry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .industry-tag {
    font-family: monospace;
    font-size: 0.85rem;
    color: var(--primary-dark);
    background: #FFFFFF;
    border: 1px solid var(--border-color);
    border-radius: 9999px;
    padding: 0.55rem 1.1rem;
  }

  @media (max-width: 900px) {
    .about-hero-inner { grid-template-columns: 1fr; gap: 2rem; }
    .about-hero-visual { display: none; }
    .vision-inner { grid-template-columns: 1fr; }
    .vision-card { grid-template-columns: 1fr 1fr; }
    .values-grid { grid-template-columns: repeat(2, 1fr); }
    .about-hero-inner, .vision-inner { padding-left: 1.5rem; padding-right: 1.5rem; }
  }

  @media (max-width: 600px) {
    .about-hero { padding: 9rem 0 3rem; }
    .vision-section { padding: 3rem 0; }
    .about-hero-inner, .vision-inner { padding-left: 1rem; padding-right: 1rem; }
    .vision-card { grid-template-columns: 1fr; padding: 2rem; }
    .values-grid { grid-template-columns: 1fr; }
    .values-section, .audience-section { padding: 3rem 0; }
  }

  /* Dark mode — deep/medium green sections */
  html[data-theme="dark"] .about-hero {
    background: var(--bg-primary);
  }

  html[data-theme="dark"] .about-hero-bg {
    background:
      radial-gradient(ellipse 55% 70% at 82% 25%, rgba(109, 192, 64, 0.14), transparent 60%),
      radial-gradient(ellipse 45% 55% at 8% 95%, rgba(61, 181, 81, 0.1), transparent 60%),
      var(--bg-primary);
  }

  html[data-theme="dark"] .about-chip {
    background: var(--card-bg);
    border-color: var(--card-border);
    color: var(--text-secondary);
  }

  html[data-theme="dark"] .about-hero-ring-circle {
    border-color: rgba(109, 192, 64, 0.3);
  }

  html[data-theme="dark"] .about-hero-float-card {
    background: var(--card-bg);
    border-color: var(--card-border);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }

  html[data-theme="dark"] .about-hero-float-num {
    color: var(--text-primary);
  }

  html[data-theme="dark"] .vision-card {
    background: var(--card-bg);
    border-color: var(--card-border);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
  }

  html[data-theme="dark"] .values-section {
    background: var(--bg-primary);
  }

  html[data-theme="dark"] .value-card {
    background: var(--card-bg);
    border-color: var(--card-border);
  }

  html[data-theme="dark"] .audience-section {
    background: var(--bg-secondary);
  }

  html[data-theme="dark"] .industry-tag {
    background: var(--card-bg);
    border-color: var(--card-border);
  }

  /* ============ PRE-FOOTER CTA SECTION ============ */
  .cta-section {
    background: linear-gradient(180deg, #FFFFFF 0%, #F3F9EE 100%);
    padding: 1rem 2.5rem 5rem;
  }
  .cta-card {
    position: relative; overflow: hidden;
    max-width: 1280px; margin: 0 auto;
    background: linear-gradient(135deg, #0B3318 0%, #16612B 55%, #2A8A3C 100%);
    border-radius: 24px; padding: 3.5rem;
    display: grid; grid-template-columns: 1fr auto;
    align-items: center; gap: 2.5rem;
  }
  .cta-glow {
    position: absolute; top: -55%; left: -15%;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(109, 192, 64, 0.45) 0%, rgba(109, 192, 64, 0) 70%);
    pointer-events: none;
  }

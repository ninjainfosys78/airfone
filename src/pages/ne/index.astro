---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomepageStructuredData from '../../components/seo/HomepageStructuredData.astro';
import AnswersEveryCallSection from '../../components/home/AnswersEveryCallSection.astro';
import { Phone, LogIn, Mic, PlayCircle, Rocket, ArrowRight } from 'lucide-react';

const locale = 'ne';

// Client/partner logos for the trust carousel.
const trustedLogos = [
  { name: 'बेसीशहर नगरपालिका', src: '/images/emblem.png' },
  { name: 'बैजनाथ गाउँपालिका', src: '/images/logo-baijanath-rural-municipality.png' },
  { name: 'राप्ती सोनारी गाउँपालिका', src: '/images/RaptiSonari.png' },
  { name: 'हेटौँडा उपमहानगरपालिका', src: '/images/hetauda.png' },
];

// Repeat the logo set so one lap is always wider than the carousel viewport —
// otherwise, with only a few logos, the track runs out before it can loop and the scroll visibly stalls/resets.
const carouselLogos = Array.from({ length: 4 }, () => trustedLogos).flat();
---

<BaseLayout title="Airfone — गृहपृष्ठ">
  <HomepageStructuredData locale="ne" />
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="hero-text">
        <h1 class="hero-title reveal">
          हरेक ग्राहक कलका लागि <br />
          <span class="highlight-green">AI भ्वाइस प्लेटफर्म</span>
        </h1>
        <div class="hero-ctas reveal">
          <a href="https://sip.mylunago.com/" class="btn btn-green" data-astro-reload>सुरु गर्नुहोस्</a>
          <a href="/ne/pricing/" class="btn btn-outline">मूल्य निर्धारण हेर्नुहोस्</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trusted By / Logo Carousel Section -->
  <section class="logo-carousel-section">
    <div class="logo-carousel-inner">
      <div class="logo-carousel-track-wrap">
        <div class="logo-carousel-track">
          {carouselLogos.map((logo) => (
            <div class="logo-item">
              {logo.src ? (
                <>
                  <div class="logo-image-wrap">
                    <img src={logo.src} alt={logo.name} loading="lazy" />
                  </div>
                  <span class="logo-name">{logo.name}</span>
                </>
              ) : (
                <span class="logo-placeholder">{logo.name}</span>
              )}
            </div>
          ))}
          {carouselLogos.map((logo) => (
            <div class="logo-item" aria-hidden="true">
              {logo.src ? (
                <>
                  <div class="logo-image-wrap">
                    <img src={logo.src} alt="" loading="lazy" />
                  </div>
                  <span class="logo-name">{logo.name}</span>
                </>
              ) : (
                <span class="logo-placeholder">{logo.name}</span>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Get Started Section -->
  <section class="get-started-section">
    <div class="get-started-inner">
      <div class="get-started-header reveal">
        <h2 class="get-started-title">तपाईंको आफ्नै AI एजेन्टका लागि चार चरण।</h2>
      </div>

      <div class="get-started-steps">
        <div class="step-traveler" aria-hidden="true">
          <span class="step-traveler-fill"></span>
          <span class="step-traveler-badge">
            <span class="step-traveler-ring"></span>
            <Phone size={14} />
          </span>
        </div>

        <!-- चरण ०१ — रेखामाथि कार्ड -->
        <div class="step-card step-col-1 reveal">
          <div class="step-heading">
            <LogIn size={18} class="step-icon" />
            <h3 class="step-title">सेकेन्डमै साइन अप गर्नुहोस्</h3>
          </div>
          <p class="step-description">Google खाताबाट तपाईंको खाता बनाउनुहोस् — कुनै फारम भर्नु पर्दैन, कुनै पर्खाइ छैन।</p>
        </div>
        <div class="step-node step-col-1 reveal"><span class="step-dot"></span></div>
        <span class="step-index step-col-1 reveal">01</span>

        <!-- चरण ०२ — रेखामुनि कार्ड -->
        <span class="step-index step-col-2 step-invert reveal">02</span>
        <div class="step-node step-col-2 reveal"><span class="step-dot"></span></div>
        <div class="step-card step-col-2 step-invert reveal">
          <div class="step-heading">
            <Mic size={18} class="step-icon" />
            <h3 class="step-title">आफ्नो व्यवसायको बारेमा सिकाउनुहोस्</h3>
          </div>
          <p class="step-description">बोलेर बताउनुहोस्, आफ्नो वेबसाइटको लिङ्क पेस्ट गर्नुहोस्, Facebook पेज जोड्नुहोस्, वा फोटो वा भिडियोमार्फत देखाउनुहोस्। Airfone ले स्वतः तपाईंको AI को ज्ञान निर्माण गर्छ।</p>
        </div>

        <!-- चरण ०३ — रेखामाथि कार्ड -->
        <div class="step-card step-col-3 reveal">
          <div class="step-heading">
            <PlayCircle size={18} class="step-icon" />
            <h3 class="step-title">निःशुल्क प्रयास गर्नुहोस्</h3>
          </div>
          <p class="step-description">आफ्नो PIN प्रयोग गरी डेमो नम्बरमा कल गर्नुहोस् र आफ्नो AI एजेन्टसँग कुरा गर्नुहोस्। पहिलो १०० मिनेट निःशुल्क छ।</p>
        </div>
        <div class="step-node step-col-3 reveal"><span class="step-dot"></span></div>
        <span class="step-index step-col-3 reveal">03</span>

        <!-- चरण ०४ — रेखामुनि कार्ड -->
        <span class="step-index step-col-4 step-invert reveal">04</span>
        <div class="step-node step-col-4 reveal"><span class="step-dot"></span></div>
        <div class="step-card step-col-4 step-invert reveal">
          <div class="step-heading">
            <Rocket size={18} class="step-icon" />
            <h3 class="step-title">लाइभ जानुहोस्</h3>
          </div>
          <p class="step-description">सन्तुष्ट हुनुभयो? आफ्नै समर्पित AI फोन नम्बर लिनुहोस् र वास्तविक ग्राहक कलहरू लिन सुरु गर्नुहोस्।</p>
        </div>
      </div>
    </div>
  </section>

  <AnswersEveryCallSection locale="ne" />

  {/* Live Demo CTA
  <section id="live-demo" class="cta-section reveal">
    <div class="cta-card">
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="cta-content">
        <h2 class="cta-title">लाइभ लाइनमा हेर्न <span class="cta-accent">तयार हुनुहुन्छ?</span></h2>
        <p class="cta-lede">प्रस्ताव स्वीकार गर्नुहोस्, कार्यान्वयन सुरु गर्नुहोस्, वा लाइभ प्रणाली प्रदर्शन बुक गर्नुहोस्।</p>
        <a href="/ne/pricing/" class="cta-button">
          मूल्य निर्धारण हेर्नुहोस्
          <ArrowRight size={18} />
        </a>
      </div>

      <div class="cta-mascot" aria-hidden="true">
        <div class="cta-mascot-blob"><Phone size={30} /></div>
      </div>
    </div>
  </section>
  */}

</BaseLayout>

<style>
  /* Looser word spacing across the landing page's own sections (hero,
     trust carousel, "three steps") — the display heading font tracks
     tight by default, so this opens the copy back up. */
  section {
    word-spacing: 0.12em;
  }

  /* ── Hero Section ─────────────────────────────────────────────────────
     Palantir-inspired: sharp corners, hairline borders, tight-tracked
     bold type, an adjoined two-button "toolbar" CTA group. */
  .hero {
    word-spacing: 0.5em;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 0;
    position: relative;
    overflow: clip;
    /* Solid fallback so the light hero text stays readable even if the
       background image is slow/blocked or the page background is light. */
    background-color: #081E1F;
  }

  /* Hero background: brand gradient artwork with a soft green ambient glow on top,
     over a transparent base so the hero blends into the page's own backdrop. */
  /* Hero background: a bold, confident vertical gradient (dark near-black at
     the top, ramping up to a vivid saturated brand cyan at the bottom) —
     ScyllaDB-style: a clean, punchy color block, not a muted glow. */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: linear-gradient(180deg,
      #041213 0%,
      #0A2D2F 35%,
      #115255 60%,
      #1C8487 80%,
      #28BDC3 100%);
  }

  .hero-content {
    max-width: 1280px;
    width: 100%;
    margin: 0 auto;
    padding: 8.5rem 2rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    font-weight: 700;
    line-height: 1.35;
    margin: 0 0 2.75rem;
    letter-spacing: normal;
    color: #EAF6F6;
    padding-top: 0.15em;
    padding-bottom: 0.15em;
  }

  .highlight-green {
    background: linear-gradient(135deg, #40BBC0, #1B777A);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: inline-block;
    padding: 0.14em 0.05em;
    margin-top: -0.14em;
    margin-bottom: -0.14em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .hero-ctas {
    display: inline-flex;
    border: 1px solid rgba(234, 246, 246, 0.3);
    margin: 0 auto 6rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.05rem 2.25rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.25s ease, color 0.25s ease;
    border: none;
    border-radius: 0;
    cursor: pointer;
    white-space: nowrap;
  }

  .btn-green { background: #3DB1B5; color: #061617; }
  .btn-green:hover { background: #40BBC0; }

  .btn-outline {
    background: transparent;
    color: #EAF6F6;
    border-left: 1px solid rgba(234, 246, 246, 0.3);
  }

  .btn-outline:hover { background: rgba(234, 246, 246, 0.08); }

  /* ── Trusted By / Logo Carousel Section ──────────────────────────────── */
  .logo-carousel-section {
    position: relative;
    padding: 3.5rem 0 3.25rem;
    background: transparent;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    overflow: hidden;
  }

  .logo-carousel-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .logo-carousel-track-wrap {
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .logo-carousel-track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: 4.5rem;
    animation: logo-scroll 38s linear infinite;
  }

  .logo-carousel-track-wrap:hover .logo-carousel-track { animation-play-state: paused; }

  .logo-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    flex-shrink: 0;
  }

  .logo-image-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 96px;
  }

  .logo-image-wrap img {
    height: 100%;
    width: auto;
    max-width: 220px;
    object-fit: contain;
  }

  .logo-name {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    text-align: center;
    max-width: 200px;
    line-height: 1.35;
    transition: color 0.35s ease;
  }

  .logo-item:hover .logo-name {
    color: var(--text-primary);
  }

  .logo-placeholder {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    white-space: nowrap;
    transition: color 0.25s ease;
  }

  .logo-item:hover .logo-placeholder { color: var(--text-primary); }

  @keyframes logo-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-carousel-track {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .logo-carousel-track {
      gap: 2.5rem;
      animation-duration: 24s;
    }
    .logo-image-wrap {
      height: 68px;
    }
    .logo-name {
      font-size: 0.65rem;
    }
    .logo-placeholder {
      font-size: 0.9rem;
    }
  }

  /* ── Get Started Section ───────────────────────────────────────────────
     a horizontal timeline: a single line running left to right, with a dot
     at each step, cards alternating above/below it, and the step number
     sitting on the opposite side of the line from its card. */
  .get-started-section {
    padding: 7rem 1.5rem;
    background: var(--bg-primary);
  }

  .get-started-inner { max-width: 1100px; margin: 0 auto; }

  .get-started-header { text-align: left; margin-bottom: 4.5rem; }

  .get-started-title {
    font-size: clamp(2.2rem, 4vw, 3.25rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.15;
    letter-spacing: -0.03em;
    max-width: 800px;
  }

  .get-started-steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: auto auto auto;
    column-gap: 2.5rem;
    align-items: center;
  }

  /* ── Traveling call-signal indicator ─────────────────────────────────
     Spans the same grid row as the timeline line, so its box has the exact
     coordinate space needed to compute each dot's on-screen position. */
  .step-traveler {
    grid-column: 1 / -1;
    grid-row: 2;
    position: relative;
    height: 100%;
    min-height: 2.5rem;
    pointer-events: none;
    z-index: 3;
  }

  .step-traveler-fill {
    position: absolute;
    left: 0;
    top: 50%;
    width: 0;
    height: 2px;
    transform: translateY(-50%);
    background: linear-gradient(90deg, #2A868A, #40BBC0);
    border-radius: 2px;
    transition: width 0.9s cubic-bezier(0.65, 0, 0.35, 1), opacity 0.35s ease;
  }

  .step-traveler-badge {
    position: absolute;
    left: 0;
    top: 50%;
    width: 32px;
    height: 32px;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: linear-gradient(135deg, #40BBC0, #1B777A);
    color: #FFFFFF;
    box-shadow: 0 8px 18px -6px rgba(27, 119, 122, 0.6), 0 0 0 4px var(--bg-primary);
    opacity: 0;
    transition: left 0.9s cubic-bezier(0.65, 0, 0.35, 1), opacity 0.35s ease;
  }

  .step-traveler-badge.is-jumping { transition: opacity 0.35s ease; }
  .step-traveler-badge.is-visible { opacity: 1; }

  .step-traveler-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid rgba(64, 187, 192, 0.6);
    opacity: 0;
  }

  .step-traveler-badge.pop {
    animation: stepTravelerPop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .step-traveler-badge.pop .step-traveler-ring {
    animation: stepTravelerPing 0.7s ease-out;
  }

  @keyframes stepTravelerPop {
    0% { transform: translate(-50%, -50%) scale(1); }
    45% { transform: translate(-50%, -50%) scale(1.35); }
    100% { transform: translate(-50%, -50%) scale(1); }
  }

  @keyframes stepTravelerPing {
    0% { opacity: 0.9; transform: scale(1); }
    100% { opacity: 0; transform: scale(2.1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .step-traveler { display: none; }
  }

  .step-col-1 { grid-column: 1; }
  .step-col-2 { grid-column: 2; }
  .step-col-3 { grid-column: 3; }
  .step-col-4 { grid-column: 4; }

  .step-card { grid-row: 1; align-self: end; margin-bottom: 1.5rem; }
  .step-node { grid-row: 2; }
  .step-index { grid-row: 3; align-self: start; margin-top: 1.5rem; }

  .step-invert.step-card { grid-row: 3; align-self: start; margin-bottom: 0; margin-top: 1.5rem; }
  .step-invert.step-index { grid-row: 1; align-self: end; margin-top: 0; margin-bottom: 1.5rem; }

  .step-node {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
  }

  .step-node::before {
    content: '';
    position: absolute;
    left: -1.25rem;
    right: -1.25rem;
    top: 50%;
    height: 1px;
    background: var(--border-color);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .step-node.is-visible::before { transform: scaleX(1); }

  .step-dot {
    position: relative;
    z-index: 1;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #3DB1B5;
    box-shadow: 0 0 0 5px var(--bg-primary);
    transform: scale(0);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 0.5s;
  }

  .step-node.is-visible .step-dot { transform: scale(1); }

  :global([data-theme='dark']) .step-dot { background: #4AD9DE; }

  .step-node.step-active .step-dot {
    transform: scale(1.35);
    box-shadow: 0 0 0 5px var(--bg-primary), 0 0 14px 4px rgba(61, 177, 181, 0.55);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  .step-index {
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--text-primary);
    text-align: center;
    letter-spacing: -0.01em;
    transition: color 0.4s ease;
  }

  .step-index.step-active { color: #3DB1B5; }

  :global([data-theme='dark']) .step-index.step-active { color: #4AD9DE; }

  .step-card {
    background: var(--bg-secondary);
    border: 1px solid transparent;
    border-radius: 16px;
    padding: 1.75rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.4s ease;
  }

  .step-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px -16px rgba(42, 134, 138, 0.35);
  }

  :global([data-theme='dark']) .step-card:hover { box-shadow: 0 16px 32px -16px rgba(0, 0, 0, 0.5); }

  .step-card.step-active {
    border-color: #3DB1B5;
    box-shadow: 0 16px 32px -16px rgba(42, 134, 138, 0.45);
    transform: translateY(-4px);
  }

  :global([data-theme='dark']) .step-card.step-active { border-color: #4AD9DE; }

  .step-heading {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
  }

  .step-icon { color: #3DB1B5; flex-shrink: 0; }

  :global([data-theme='dark']) .step-icon { color: #4AD9DE; }

  .step-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .step-description {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Pre-footer CTA Section ───────────────────────────────────────────── */
  .cta-section {
    position: relative;
    background: radial-gradient(ellipse 60% 60% at 50% 0%, rgba(61, 177, 181, 0.14), transparent 65%), var(--bg-primary);
    padding: 6rem 1.5rem 8rem;
    overflow: hidden;
  }

  .cta-card {
    position: relative;
    overflow: visible;
    max-width: 880px;
    margin: 0 auto;
    background: linear-gradient(135deg, #0B3233 0%, #165E61 55%, #2A868A 100%);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.25),
      0 40px 90px -45px rgba(16, 111, 115, 0.55);
    padding: 4rem 3rem;
    text-align: center;
  }

  .cta-glow {
    position: absolute;
    top: -55%;
    left: 50%;
    transform: translateX(-50%);
    width: 560px;
    height: 400px;
    background: radial-gradient(ellipse, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0) 70%);
    pointer-events: none;
  }

  .cta-content { position: relative; z-index: 1; max-width: 560px; margin: 0 auto; }

  .cta-title {
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    margin: 0 0 1rem;
  }

  .cta-accent { color: #7CDCE0; }

  .cta-lede {
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 2.25rem;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    border: 1px solid rgba(234, 246, 246, 0.4);
    border-radius: 6px;
    padding: 0.9rem 1.75rem;
    color: #EAF6F6;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .cta-button:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: #FFFFFF;
    color: #FFFFFF;
  }

  .cta-mascot {
    position: absolute;
    right: 2.5rem;
    bottom: -1.75rem;
    z-index: 2;
  }

  .cta-mascot-blob {
    width: 84px;
    height: 84px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1B777A;
    background: linear-gradient(135deg, #FFFFFF, #EAF6F6);
    border-radius: 58% 42% 55% 45% / 45% 55% 45% 55%;
    box-shadow: 0 16px 34px -12px rgba(0, 0, 0, 0.35);
    animation: mascotFloat 4s ease-in-out infinite;
  }

  @keyframes mascotFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @media (max-width: 900px) {
    .cta-card { padding: 3.5rem 2rem; }
    .cta-mascot { right: 50%; transform: translateX(50%); bottom: -1.5rem; }
  }

  @media (max-width: 600px) {
    .cta-section { padding: 4rem 1.25rem 5rem; }
    .cta-card { padding: 3rem 1.5rem 2.75rem; }
  }

  /* ── Responsive ─────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .hero { min-height: 70vh; align-items: center; }
    .hero-content { padding-top: 6rem; padding-bottom: 2rem; }
    .hero-title { font-size: clamp(2.2rem, 6vw, 3.2rem); }
  }

  @media (max-width: 768px) {
    .hero { min-height: auto; align-items: flex-start; }
    .hero-content {
      padding-top: 9rem;
      padding-bottom: 3rem;
    }
    .hero-title { font-size: clamp(1.8rem, 8vw, 2.6rem); }
    .hero-ctas { flex-direction: column; align-items: stretch; width: 100%; }
    .btn { width: 100%; text-align: center; }
    .btn-outline { border-left: none; border-top: 1px solid rgba(234, 246, 246, 0.3); }
    /* Collapse the horizontal timeline to a simple vertical stack */
    .get-started-steps { grid-template-columns: 1fr; row-gap: 1.5rem; }
    .step-col-1, .step-col-2, .step-col-3, .step-col-4 { grid-column: 1; }
    .step-card, .step-index, .step-invert.step-card, .step-invert.step-index {
      grid-row: auto;
      align-self: auto;
      margin: 0;
    }
    .step-node { display: none; }
    .step-traveler { display: none; }
    .step-index { font-size: 1.5rem; text-align: left; margin-bottom: 0.35rem; }

    /* Normalize reading order to "number, then card" for every step,
       regardless of which side of the (now-hidden) line they sat on. */
    .step-col-1.step-index { order: 1; }
    .step-col-1.step-card { order: 2; }
    .step-col-2.step-index { order: 3; }
    .step-col-2.step-card { order: 4; }
    .step-col-3.step-index { order: 5; }
    .step-col-3.step-card { order: 6; }
    .step-col-4.step-index { order: 7; }
    .step-col-4.step-card { order: 8; }
  }

  @media (max-width: 480px) {
    .hero-content { padding-top: 7.5rem; padding-bottom: 2.5rem; }
    .hero-title { font-size: clamp(1.4rem, 6vw, 1.8rem); }
  }
</style>

<script>
  function updateNepaliClock() {
    const clockEl = document.getElementById('live-clock-nep');
    const containerEl = document.getElementById('hero-live-time');
    if (!clockEl || !containerEl) return;

    const now = new Date();
    const hours = now.getHours();
    const minutes = String(now.getMinutes()).padStart(2, '0');
    const seconds = String(now.getSeconds()).padStart(2, '0');

    let period = 'बिहानको';
    if (hours >= 12 && hours < 17) period = 'दिउँसोको';
    else if (hours >= 17 && hours < 20) period = 'बेलुकाको';
    else if (hours >= 20 || hours < 4) period = 'रातिको';

    const displayHours = String(hours % 12 || 12).padStart(2, '0');
    const nepaliDigits = ['०', '१', '२', '३', '४', '५', '६', '७', '८', '९'];
    const timeStr = `${displayHours}:${minutes}:${seconds}`.replace(/[0-9]/g, d => nepaliDigits[parseInt(d, 10)]);

    containerEl.childNodes[0].nodeValue = `अहिले ${period} `;
    clockEl.textContent = timeStr;
  }

  updateNepaliClock();
  setInterval(updateNepaliClock, 1000);
  document.addEventListener('astro:page-load', updateNepaliClock);
</script>

<script>
  function initStepsHighlight() {
    const HOLD_MS = 1700;
    const TRAVEL_MS = 900;
    const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

    document.querySelectorAll('.get-started-section').forEach((section) => {
      if (section.dataset.stepsBound) return;
      section.dataset.stepsBound = 'true';

      const track = section.querySelector('.get-started-steps');
      const travelerBox = section.querySelector('.step-traveler');
      const badge = section.querySelector('.step-traveler-badge');
      const fill = section.querySelector('.step-traveler-fill');
      if (!track || !travelerBox || !badge || !fill) return;

      const columns = new Map();
      track.querySelectorAll('[class*="step-col-"]').forEach((el) => {
        const match = el.className.match(/step-col-(\d)/);
        if (!match) return;
        const col = match[1];
        if (!columns.has(col)) columns.set(col, []);
        columns.get(col).push(el);
      });
      const stepGroups = Array.from(columns.keys()).sort().map((key) => columns.get(key));
      if (!stepGroups.length) return;

      const dots = stepGroups
        .map((group) => group.find((el) => el.classList.contains('step-node')))
        .map((node) => (node ? node.querySelector('.step-dot') : null));
      if (dots.some((dot) => !dot)) return;

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      function stopX(dot) {
        const boxRect = travelerBox.getBoundingClientRect();
        const dotRect = dot.getBoundingClientRect();
        return dotRect.left + dotRect.width / 2 - boxRect.left;
      }

      function setActive(i) {
        stepGroups.forEach((els, idx) => {
          els.forEach((el) => el.classList.toggle('step-active', idx === i));
        });
      }

      function clearActiveAll() {
        stepGroups.forEach((els) => els.forEach((el) => el.classList.remove('step-active')));
      }

      async function moveTo(x) {
        badge.style.left = `${x}px`;
        fill.style.width = `${Math.max(x, 0)}px`;
        await wait(TRAVEL_MS);
      }

      function pop() {
        badge.classList.remove('pop');
        void badge.offsetWidth;
        badge.classList.add('pop');
      }

      let runId = 0;
      let running = false;

      async function runLoop(myRun) {
        while (runId === myRun) {
          for (let i = 0; i < dots.length; i++) {
            if (runId !== myRun) return;
            await moveTo(stopX(dots[i]));
            if (runId !== myRun) return;
            setActive(i);
            pop();
            await wait(HOLD_MS);
          }
          if (runId !== myRun) return;

          clearActiveAll();
          badge.classList.remove('is-visible');
          fill.style.opacity = '0';
          await wait(350);
          if (runId !== myRun) return;

          badge.classList.add('is-jumping');
          badge.style.left = '0px';
          fill.style.width = '0px';
          void badge.offsetWidth;
          badge.classList.remove('is-jumping');
          fill.style.opacity = '1';
          await wait(50);
          if (runId !== myRun) return;

          badge.classList.add('is-visible');
          await wait(500);
        }
      }

      function start() {
        if (running) return;
        running = true;
        const myRun = ++runId;
        badge.style.left = '0px';
        fill.style.width = '0px';
        requestAnimationFrame(() => badge.classList.add('is-visible'));
        runLoop(myRun);
      }

      function stop() {
        running = false;
        runId++;
        clearActiveAll();
        badge.classList.remove('is-visible', 'pop');
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => (entry.isIntersecting ? start() : stop()));
      }, { threshold: 0.4 });

      observer.observe(section);
    });
  }

  initStepsHighlight();
  document.addEventListener('astro:page-load', initStepsHighlight);
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Clock, Bot, Radio, Brain, Plug2, BarChart3, ShieldCheck, Zap, Headphones, Megaphone, PhoneMissed, Phone, ArrowRight } from 'lucide-react';

const locale = 'ne';
---

<BaseLayout title="Airfone — गृहपृष्ठ">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="hero-text">
        <div class="hero-badge reveal">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hero-badge-icon">
             <path d="M12 2v20M17 5v14M22 10v4M7 5v14M2 10v4"/>
          </svg>
          स्मार्ट IVR र AI क्लाउड भ्वाइस ब्रोडकास्टिङ प्लेटफर्म
        </div>
        <h1 class="hero-title reveal">
          हरेक फोन कललाई एउटा <br />
          <span class="highlight-green">बौद्धिक</span>, डाटा-संचालित <br />
          अन्तरक्रियामा बदल्नुहोस्।
        </h1>
        <p class="hero-description reveal">
          एउटा क्लाउड-नेटिभ भ्वाइस प्लेटफर्म जसले टेलिफोनी लचिलोपनलाई प्राकृतिक भाषा प्रशोधन, न्यूरल टेक्स्ट-टु-स्पीच, र वास्तविक-समयको भावना विश्लेषणसँग जोड्दछ — एकै प्रणालीबाट उच्च भोल्युमको इनबाउन्ड सपोर्ट र लक्षित आउटबाउन्ड अभियानहरू व्यवस्थापन गर्दै।
        </p>
        <div class="hero-ctas reveal">
          <a href="/ne/contact/" class="btn btn-green">लाइभ डेमो अनुरोध गर्नुहोस्</a>
          <a href="/ne/pricing/" class="btn btn-outline">मूल्य निर्धारण हेर्नुहोस्</a>
        </div>
      </div>

      <div class="hero-stats">
        <div class="hero-stat reveal">
          <div class="hero-stat-icon"><PhoneMissed size={24} /></div>
          <div class="hero-stat-num">०</div>
          <div class="hero-stat-label">ठूलो स्केलमा परित्यक्त कल दर</div>
        </div>
        <div class="hero-stat reveal">
          <div class="hero-stat-icon"><Bot size={24} /></div>
          <div class="hero-stat-num">६०%</div>
          <div class="hero-stat-label">स्वचालित समर्थन भोल्युम</div>
        </div>
        <div class="hero-stat reveal">
          <div class="hero-stat-icon"><Zap size={24} /></div>
          <div class="hero-stat-num">&lt;७००ms</div>
          <div class="hero-stat-label">AI भ्वाइस प्रतिक्रिया विलम्बता</div>
        </div>
        <div class="hero-stat reveal">
          <div class="hero-stat-icon"><ShieldCheck size={24} /></div>
          <div class="hero-stat-num">९९.९५%</div>
          <div class="hero-stat-label">कोर अपटाइम SLA</div>
        </div>
      </div>
    </div>

    <!-- Subtle call-ring motif -->
    <div class="hero-ring" aria-hidden="true">
      <div class="hero-ring-circle hero-ring-c1"></div>
      <div class="hero-ring-circle hero-ring-c2"></div>
      <div class="hero-ring-circle hero-ring-c3"></div>
      <div class="hero-ring-phone"><Phone size={42} /></div>
    </div>
  </section>

  <!-- Platform Capabilities Section -->
  <section class="capabilities-section">
    <div class="capabilities-inner">
      <div class="cap-header reveal">
        <span class="cap-tag">प्लेटफर्म क्षमताहरू</span>
        <h2 class="cap-title">ठूलो स्केलमा <span class="cap-highlight">बौद्धिक भ्वाइस</span> चलाउनका लागि सबै कुछ</h2>
      </div>
      <div class="cap-grid">

        <div class="cap-card reveal">
          <div class="cap-icon-wrap">
            <Clock size={28} class="cap-icon" />
          </div>
          <h3>शून्य प्रतीक्षा समय</h3>
          <p>हरेक कलर AI भ्वाइसबोट वा गतिशील मेनुले तुरुन्त उत्तर दिन्छ।</p>
        </div>

        <div class="cap-card reveal">
          <div class="cap-icon-wrap">
            <Bot size={28} class="cap-icon" />
          </div>
          <h3>६०% स्वचालन</h3>
          <p>Conversational AI र डाटाबेस इन्टिग्रेसनद्वारा नियमित प्रश्नहरू समाधान।</p>
        </div>

        <div class="cap-card reveal">
          <div class="cap-icon-wrap">
            <Radio size={28} class="cap-icon" />
          </div>
          <h3>आउटबाउन्ड पहुँच</h3>
          <p>ठूलो स्केलमा Neural TTS प्रयोग गरी हाइपर-व्यक्तिगतकृत अभियान।</p>
        </div>

        <div class="cap-card reveal">
          <div class="cap-icon-wrap">
            <Brain size={28} class="cap-icon" />
          </div>
          <h3>भावना विश्लेषण</h3>
          <p>१००% कलहरू ट्रान्सक्राइब र स्कोर गर्नुहोस्: सकारात्मक, तटस्थ, नकारात्मक।</p>
        </div>

        <div class="cap-card reveal">
          <div class="cap-icon-wrap">
            <Plug2 size={28} class="cap-icon" />
          </div>
          <h3>अन्तर-सञ्चालनशीलता</h3>
          <p>CRM/ERP प्रणालीहरूसँग नेटिभ REST API र वेबहुक सिंक।</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Platform Modules Section -->
  <section class="modules-section">
    <div class="modules-inner">
      <div class="modules-header reveal">
        <span class="modules-eyebrow">प्लेटफर्म मोड्युलहरू</span>
        <h2 class="modules-title">तीन इन्जिन, एउटा नियन्त्रण कक्ष।</h2>
        <p class="modules-subtitle">पूर्ण विवरण सुविधाहरू पृष्ठमा छ।</p>
      </div>
      <div class="modules-grid">

        <div class="module-card reveal">
          <div class="module-icon module-icon-a"><Headphones size={22} /></div>
          <h3>स्मार्ट IVR प्रणाली</h3>
          <p>Conversational Voice AI, डाइनामिक मेनु, प्रिडिक्टिभ राउटिङ, स्व-सेवा।</p>
        </div>

        <div class="module-card reveal">
          <div class="module-icon module-icon-b"><Megaphone size={22} /></div>
          <h3>भ्वाइस ब्रोडकास्टिङ</h3>
          <p>सामूहिक अभियान, DTMF प्रतिक्रिया, प्रिडिक्टिभ डायलर, अनुपालन फिल्टरिङ।</p>
        </div>

        <div class="module-card reveal">
          <div class="module-icon module-icon-c"><BarChart3 size={22} /></div>
          <h3>एनालिटिक्स र सुपरभिजन</h3>
          <p>लाइभ वालबोर्ड, सेन्टिमेन्ट विश्लेषण, कल रेकर्डिङ, CRM इन्टिग्रेसन।</p>
        </div>

      </div>
      <div class="modules-cta-row">
        <a href="/ne/features/" class="modules-link">पूर्ण सुविधा विवरण हेर्नुहोस् &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Live Demo CTA -->
  <section class="cta-section reveal">
    <div class="cta-card">
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="cta-content">
        <h2 class="cta-title">लाइभ लाइनमा हेर्न <span class="cta-accent">तयार हुनुहुन्छ?</span></h2>
        <p class="cta-lede">प्रस्ताव स्वीकार गर्नुहोस्, कार्यान्वयन सुरु गर्नुहोस्, वा लाइभ प्रणाली प्रदर्शन बुक गर्नुहोस्।</p>
        <div class="cta-actions">
          <a href="/ne/contact/" class="cta-btn">
            लाइभ डेमो बुक गर्नुहोस्
            <ArrowRight size={18} />
          </a>
          <a href="/ne/pricing/" class="cta-link">मूल्य निर्धारण हेर्नुहोस्</a>
        </div>
      </div>

      <div class="cta-visual" aria-hidden="true">
        <div class="cta-ring">
          <div class="cta-ring-c1"></div>
          <div class="cta-ring-c2"></div>
          <div class="cta-ring-c3"></div>
          <div class="cta-ring-phone"><Phone size={40} /></div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero Section */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 0;
    position: relative;
    overflow: clip;
    background: #FFFFFF;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 78% 30%, rgba(109, 192, 64, 0.12), transparent 55%),
      linear-gradient(180deg, #FFFFFF 0%, #F6FBF4 100%);
  }

  .hero-ring {
    position: absolute;
    right: 3%;
    top: 50%;
    transform: translateY(-50%);
    z-index: 0;
    width: 340px;
    height: 340px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .hero-ring-circle {
    position: absolute;
    border-radius: 50%;
    border: 1.5px solid rgba(61, 181, 81, 0.18);
  }

  .hero-ring-c1 { width: 340px; height: 340px; }
  .hero-ring-c2 { width: 248px; height: 248px; }
  .hero-ring-c3 { width: 156px; height: 156px; }

  .hero-ring-phone {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6DC040, #2A8A3C);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 16px 32px rgba(42, 138, 60, 0.28);
    animation: heroRingPulse 3.2s ease-in-out infinite;
  }

  @keyframes heroRingPulse {
    0%, 100% { transform: scale(1); box-shadow: 0 16px 32px rgba(42, 138, 60, 0.28); }
    50% { transform: scale(1.06); box-shadow: 0 18px 40px rgba(42, 138, 60, 0.36); }
  }

  .hero-content {
    max-width: 1280px;
    width: 100%;
    margin: 0 auto;
    padding: 8.5rem 2rem 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
    z-index: 1;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    border: 1px solid rgba(61, 181, 81, 0.25);
    background: rgba(61, 181, 81, 0.06);
    color: #2A8A3C;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 2rem;
  }

  .hero-badge-icon { color: #2A8A3C; }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.35;
    margin: 0 0 1.5rem;
    letter-spacing: normal;
    color: #1A1A1A;
    padding-top: 0.15em;
    padding-bottom: 0.15em;
  }

  .highlight-green {
    background: linear-gradient(135deg, #6DC040, #1B7A2F);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: inline-block;
    padding: 0.14em 0.05em;
    margin-top: -0.14em;
    margin-bottom: -0.14em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .hero-description {
    font-size: 1.15rem;
    color: #4B5563;
    line-height: 1.6;
    margin-bottom: 2.5rem;
    max-width: 800px;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 5rem;
  }

  .btn {
    display: inline-block;
    padding: 0.85rem 1.5rem;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .btn-green {
    background: linear-gradient(135deg, #6DC040, #2A8A3C);
    color: #FFFFFF;
    box-shadow: 0 2px 12px rgba(61, 181, 81, 0.3);
  }

  .btn-green:hover {
    background: linear-gradient(135deg, #3DB551, #1B7A2F);
    color: #FFFFFF;
    box-shadow: 0 6px 20px rgba(61, 181, 81, 0.45);
    transform: translateY(-1px);
  }

  .btn-outline {
    background: transparent;
    color: #1A1A1A;
    border: 1px solid #D1D5DB;
  }

  .btn-outline:hover {
    border-color: #1A1A1A;
    background: rgba(0,0,0,0.02);
  }

  .hero-stats {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid #C8E6C9;
  }

  .hero-stat {
    padding: 2rem 1.5rem 2rem 0;
    border-right: 1px solid #C8E6C9;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 180px;
  }

  .hero-stat:last-child {
    border-right: none;
    padding-right: 0;
  }

  .hero-stat:not(:first-child) {
    padding-left: 1.5rem;
  }

  .hero-stat-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    color: #1B7A2F;
    background: linear-gradient(135deg, rgba(109, 192, 64, 0.15), rgba(27, 122, 47, 0.1));
    border: 1px solid rgba(109, 192, 64, 0.35);
  }

  .hero-stat-icon svg { stroke-width: 2; }

  .hero-stat-num {
    font-size: 1.75rem;
    font-weight: 800;
    background: linear-gradient(135deg, #6DC040, #1B7A2F);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-stat-label {
    font-size: 0.85rem;
    color: #6B7280;
    font-weight: 500;
  }

  .divider {
    height: 1px;
    background: #F0F0F0;
    margin: 0;
  }

  .capabilities-section {
    background: #FFFFFF;
    padding: 5rem 0 5.5rem;
    position: relative;
    overflow: hidden;
  }

  .capabilities-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 40% at 20% 50%, rgba(61, 181, 81, 0.07) 0%, transparent 70%),
      radial-gradient(ellipse 50% 40% at 80% 50%, rgba(109, 192, 64, 0.05) 0%, transparent 70%);
    pointer-events: none;
  }

  .capabilities-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 1;
  }

  .cap-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .cap-tag {
    display: inline-block;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    border: 1px solid rgba(61, 181, 81, 0.25);
    background: rgba(61, 181, 81, 0.06);
    color: #2A8A3C;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .cap-title {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 900;
    color: #1A1A1A;
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .cap-highlight {
    background: linear-gradient(135deg, #6DC040, #1B7A2F);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .cap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .cap-card {
    background: #FFFFFF;
    border: 1px solid #E8F5E9;
    border-radius: 16px;
    padding: 2.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(61, 181, 81, 0.06);
  }

  .cap-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(109, 192, 64, 0.06) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .cap-card:hover {
    border-color: #C8E6C9;
    transform: translateY(-6px);
    box-shadow: 0 12px 32px rgba(61, 181, 81, 0.15), 0 0 0 1px rgba(61, 181, 81, 0.12);
  }

  .cap-card:hover::before { opacity: 1; }

  .cap-icon-wrap {
    width: 62px;
    height: 62px;
    border-radius: 16px;
    background: rgba(61, 181, 81, 0.08);
    border: 1px solid rgba(61, 181, 81, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .cap-card:hover .cap-icon-wrap {
    background: rgba(61, 181, 81, 0.14);
    border-color: rgba(61, 181, 81, 0.4);
    transform: scale(1.08);
  }

  .cap-icon { color: #3DB551; display: block; }

  .cap-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1A1A1A;
    margin: 0 0 0.65rem;
    line-height: 1.3;
  }

  .cap-card p {
    font-size: 0.875rem;
    color: #6B7280;
    margin: 0;
    line-height: 1.65;
  }

  @media (max-width: 768px) {
    .capabilities-section { padding: 3rem 0 3.5rem; }
    .cap-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
    .cap-card { padding: 1.75rem 1.25rem; }
    .cap-title { font-size: 1.6rem; }
  }

  @media (max-width: 480px) {
    .cap-grid { grid-template-columns: 1fr; }
  }

  /* ── Platform Modules Section ────────────────────────────────────────── */
  .modules-section {
    background: #F4FAF5;
    padding: 5rem 0 4.5rem;
    position: relative;
    overflow: hidden;
    border-top: 1px solid #C8E6C9;
    border-bottom: 1px solid #C8E6C9;
  }

  .modules-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 0%, rgba(109, 192, 64, 0.12) 0%, transparent 60%),
      linear-gradient(rgba(61, 181, 81, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(61, 181, 81, 0.04) 1px, transparent 1px);
    background-size: 100% 100%, 48px 48px, 48px 48px;
    pointer-events: none;
  }

  html[data-theme="dark"] .modules-section {
    background: #0A2410;
    border-color: rgba(61, 181, 81, 0.2);
  }

  .modules-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2.5rem;
    position: relative;
    z-index: 1;
  }

  .modules-header { margin-bottom: 3rem; }

  .modules-eyebrow {
    display: inline-block;
    padding: 0.35rem 0.9rem;
    border-radius: 9999px;
    border: 1px solid rgba(61, 181, 81, 0.3);
    background: rgba(61, 181, 81, 0.08);
    color: #2A8A3C;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  html[data-theme="dark"] .modules-eyebrow {
    color: #6DC040;
    background: rgba(109, 192, 64, 0.12);
    border-color: rgba(109, 192, 64, 0.3);
  }

  .modules-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: #1A1A1A;
    margin: 0 0 0.75rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  html[data-theme="dark"] .modules-title { color: #FFFFFF; }

  .modules-subtitle { font-size: 0.95rem; color: #555555; margin: 0; }

  html[data-theme="dark"] .modules-subtitle { color: rgba(232,233,235,0.6); }

  .modules-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .module-card {
    background: #FFFFFF;
    border: 1px solid #C8E6C9;
    border-radius: 16px;

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Clock, Bot, Radio, Brain, Plug2, BarChart3, ShieldCheck, Zap, Globe } from 'lucide-react';

const locale = 'ne';
---

<BaseLayout title="स्मार्ट IVR AI — गृहपृष्ठ">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <div class="hero-text">
        <div class="hero-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hero-badge-icon">
             <path d="M12 2v20M17 5v14M22 10v4M7 5v14M2 10v4"/>
          </svg>
          स्मार्ट IVR र AI क्लाउड भ्वाइस ब्रोडकास्टिङ प्लेटफर्म
        </div>
        <h1 class="hero-title">
          हरेक फोन कललाई एउटा <br />
          <span class="highlight-green">बौद्धिक</span>, डाटा-संचालित <br />
          अन्तरक्रियामा बदल्नुहोस्।
        </h1>
        <p class="hero-description">
          एउटा क्लाउड-नेटिभ भ्वाइस प्लेटफर्म जसले टेलिफोनी लचिलोपनलाई प्राकृतिक भाषा प्रशोधन, न्यूरल टेक्स्ट-टु-स्पीच, र वास्तविक-समयको भावना विश्लेषणसँग जोड्दछ — एकै प्रणालीबाट उच्च भोल्युमको इनबाउन्ड सपोर्ट र लक्षित आउटबाउन्ड अभियानहरू व्यवस्थापन गर्दै।
        </p>
        <div class="hero-ctas">
          <a href="/ne/demo/" class="btn btn-green">लाइभ डेमो अनुरोध गर्नुहोस्</a>
          <a href="/ne/pricing/" class="btn btn-outline">मूल्य निर्धारण हेर्नुहोस्</a>
        </div>
      </div>

      <div class="hero-stats">
        <div class="hero-stat">
          <div class="hero-stat-num">०</div>
          <div class="hero-stat-label">ठूलो स्केलमा परित्यक्त कल दर</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">६०%</div>
          <div class="hero-stat-label">स्वचालित समर्थन भोल्युम</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">&lt;७००ms</div>
          <div class="hero-stat-label">AI भ्वाइस प्रतिक्रिया विलम्बता</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">९९.९५%</div>
          <div class="hero-stat-label">कोर अपटाइम SLA</div>
        </div>
      </div>
    </div>
  </section>

  <!-- प्लेटफर्म क्षमताहरू -->
  <section class="capabilities-section">
    <div class="capabilities-inner">
      <div class="cap-header">
        <span class="cap-tag">प्लेटफर्म क्षमताहरू</span>
        <h2 class="cap-title">ठूलो स्केलमा <span class="cap-highlight">बौद्धिक भ्वाइस</span> चलाउनका लागि सबै कुछ</h2>
      </div>
      <div class="cap-grid">

        <div class="cap-card">
          <div class="cap-icon-wrap">
            <Clock size={28} class="cap-icon" />
          </div>
          <h3>शून्य प्रतीक्षा समय</h3>
          <p>हरेक कलर AI भ्वाइसबोट वा गतिशील मेनुले तुरुन्त उत्तर दिन्छ।</p>
        </div>

        <div class="cap-card">
          <div class="cap-icon-wrap">
            <Bot size={28} class="cap-icon" />
          </div>
          <h3>६०% स्वचालन</h3>
          <p>Conversational AI र डाटाबेस इन्टिग्रेसनद्वारा नियमित प्रश्नहरू समाधान।</p>
        </div>

        <div class="cap-card">
          <div class="cap-icon-wrap">
            <Radio size={28} class="cap-icon" />
          </div>
          <h3>आउटबाउन्ड पहुँच</h3>
          <p>ठूलो स्केलमा Neural TTS प्रयोग गरी हाइपर-व्यक्तिगतकृत अभियान।</p>
        </div>

        <div class="cap-card">
          <div class="cap-icon-wrap">
            <Brain size={28} class="cap-icon" />
          </div>
          <h3>भावना विश्लेषण</h3>
          <p>१००% कलहरू ट्रान्सक्राइब र स्कोर गर्नुहोस्: सकारात्मक, तटस्थ, नकारात्मक।</p>
        </div>

        <div class="cap-card">
          <div class="cap-icon-wrap">
            <Plug2 size={28} class="cap-icon" />
          </div>
          <h3>अन्तर-सञ्चालनशीलता</h3>
          <p>CRM/ERP प्रणालीहरूसँग नेटिभ REST API र वेबहुक सिंक।</p>
        </div>

        <div class="cap-card">
          <div class="cap-icon-wrap">
            <BarChart3 size={28} class="cap-icon" />
          </div>
          <h3>रियल-टाइम एनालिटिक्स</h3>
          <p>कल भोल्युम, भावना प्रवृत्ति र SLA मेट्रिकका लागि लाइभ ड्यासबोर्ड।</p>
        </div>

        <div class="cap-card">
          <div class="cap-icon-wrap">
            <ShieldCheck size={28} class="cap-icon" />
          </div>
          <h3>एन्टरप्राइज सुरक्षा</h3>
          <p>एन्ड-टु-एन्ड इन्क्रिप्शन, भूमिका-आधारित पहुँच र पूर्ण अडिट ट्रेल।</p>
        </div>

        <div class="cap-card">
          <div class="cap-icon-wrap">
            <Zap size={28} class="cap-icon" />
          </div>
          <h3>&lt;७००ms विलम्बता</h3>
          <p>प्राकृतिक, तरल कुराकानीका लागि अति-न्यून AI भ्वाइस प्रतिक्रिया विलम्बता।</p>
        </div>

        <div class="cap-card">
          <div class="cap-icon-wrap">
            <Globe size={28} class="cap-icon" />
          </div>
          <h3>बहु-भाषा</h3>
          <p>नेपाली, अंग्रेजी र क्षेत्रीय बोलीहरूमा कलरहरूलाई निर्बाध समर्थन।</p>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero Section */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 0;
    position: relative;
    overflow: hidden;
    background: #FFFFFF;
  }

  .hero-content {
    max-width: 1100px;
    width: 100%;
    margin: 0 auto;
    padding: 8.5rem 2rem 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
    z-index: 1;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    border: 1px solid rgba(61, 181, 81, 0.2);
    background: rgba(61, 181, 81, 0.05);
    color: #2A8A3C;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 2rem;
  }

  .hero-badge-icon {
    color: #2A8A3C;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 1.5rem;
    letter-spacing: -0.02em;
    color: #1A1A1A;
  }

  .highlight-green {
    color: #2A8A3C;
  }

  .hero-description {
    font-size: 1.15rem;
    color: #4B5563;
    line-height: 1.6;
    margin-bottom: 2.5rem;
    max-width: 800px;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 5rem;
  }

  .btn {
    display: inline-block;
    padding: 0.85rem 1.5rem;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .btn-green {
    background: #3DB551;
    color: #111827;
  }

  .btn-green:hover {
    background: #2A8A3C;
    color: #FFFFFF;
  }

  .btn-outline {
    background: transparent;
    color: #1A1A1A;
    border: 1px solid #D1D5DB;
  }

  .btn-outline:hover {
    border-color: #1A1A1A;
    background: rgba(0,0,0,0.02);
  }

  .hero-stats {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid #E5E7EB;
  }

  .hero-stat {
    padding: 2rem 1.5rem 2rem 0;
    border-right: 1px solid #E5E7EB;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 180px;
  }

  .hero-stat:last-child {
    border-right: none;
    padding-right: 0;
  }

  .hero-stat:not(:first-child) {
    padding-left: 1.5rem;
  }

  .hero-stat-num {
    font-size: 1.75rem;
    font-weight: 800;
    color: #2A8A3C;
  }

  .hero-stat-label {
    font-size: 0.85rem;
    color: #6B7280;
    font-weight: 500;
  }

  /* Divider */
  .divider {
    height: 1px;
    background: #F0F0F0;
    margin: 3rem 0;
  }

  /* ── Platform Capabilities Section ─────────────────────────────────── */
  .capabilities-section {
    background: #FFFFFF;
    padding: 5rem 0 5.5rem;
    position: relative;
    overflow: hidden;
  }

  .capabilities-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 40% at 20% 50%, rgba(61, 181, 81, 0.06) 0%, transparent 70%),
      radial-gradient(ellipse 50% 40% at 80% 50%, rgba(16, 185, 129, 0.04) 0%, transparent 70%);
    pointer-events: none;
  }

  .capabilities-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 1;
  }

  .cap-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .cap-tag {
    display: inline-block;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    border: 1px solid rgba(61, 181, 81, 0.2);
    background: rgba(61, 181, 81, 0.05);
    color: #2A8A3C;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .cap-title {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 900;
    color: #1A1A1A;
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .cap-highlight {
    color: #2A8A3C;
  }

  .cap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .cap-card {
    background: #FFFFFF;
    border: 1px solid #F0F0F0;
    border-radius: 16px;
    padding: 2.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .cap-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.04) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .cap-card:hover {
    border-color: #E0E0E0;
    transform: translateY(-6px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(16, 185, 129, 0.1);
  }

  .cap-card:hover::before {
    opacity: 1;
  }

  .cap-icon-wrap {
    width: 62px;
    height: 62px;
    border-radius: 16px;
    background: rgba(61, 181, 81, 0.08);
    border: 1px solid rgba(61, 181, 81, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .cap-card:hover .cap-icon-wrap {
    background: rgba(61, 181, 81, 0.14);
    border-color: rgba(61, 181, 81, 0.35);
    transform: scale(1.08);
  }

  .cap-icon {
    color: #2A8A3C;
    display: block;
  }

  .cap-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1A1A1A;
    margin: 0 0 0.65rem;
    line-height: 1.3;
  }

  .cap-card p {
    font-size: 0.875rem;
    color: #6B7280;
    margin: 0;
    line-height: 1.65;
  }

  /* Responsive for capabilities */
  @media (max-width: 768px) {
    .capabilities-section { padding: 3rem 0 3.5rem; }
    .cap-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
    .cap-card { padding: 1.75rem 1.25rem; }
    .cap-title { font-size: 1.6rem; }
  }

  @media (max-width: 480px) {
    .cap-grid { grid-template-columns: 1fr; }
  }

  /* About Section */
  .about-section {
    padding: 5rem 0;
    background-color: #FFFFFF !important;
  }

  html[data-theme="dark"] .about-section {
    background-color: #FFFFFF !important;
  }

  .section-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .about-text h2 {
    font-size: 3rem;
    font-weight: 900;
    margin: 0 0 1.5rem;
    color: #1A1A1A;
  }

  html[data-theme="dark"] .about-text h2 {
    color: #FFFFFF;
  }

  .about-text p {
    font-size: 1.1rem;
    color: #666666;
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  html[data-theme="dark"] .about-text p {
    color: #CCCCCC;
  }

  .about-stats {
    display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  width: 100%;
  }

  .stat {
    display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;

  width: 100%;
  height: 220px;
  padding: 2rem;

  box-sizing: border-box;
  background: #fff;
  border-radius: 20px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);

  transition:
    transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    overflow: hidden;
  }

  html[data-theme="dark"] .stat {
      background: rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.05);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  }

  .stat:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
  }

  html[data-theme="dark"] .stat:hover {
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
  }

  .stat-num {
    font-size: 2.6rem;
    font-weight: 900;
    color: #3DB551 !important;
    line-height: 1;
    margin-bottom: 0.75rem;
    white-space: nowrap;
  }

  .stat-label {
    font-size: 1rem;
    color: #1A1A1A;
    margin-top: 0;
    font-weight: 600;
  }

  html[data-theme="dark"] .stat-label {
    color: #FFFFFF;
  }

  /* Services Section */
  .services-section {
    padding: 5rem 0;
    background-color: #FFFFFF !important;
  }

  html[data-theme="dark"] .services-section {
    background-color: #0F1419 !important;
  }

  .section-header {
    max-width: 1280px;
    margin: 0 auto 2.5rem;
    padding: 0 2rem;
  }

  .section-header h2 {
    font-size: 3rem;
    font-weight: 900;
    margin: 0 0 0.5rem;
    color: #1A1A1A;
  }

  html[data-theme="dark"] .section-header h2 {
    color: #FFFFFF;
  }

  .section-header p {
    font-size: 1.2rem;
    color: #3DB551;
  }

  .services-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
  }

  .service-item {
    padding: 2.5rem 2rem;
    border: 1px solid #F0F0F0;
    border-radius: 12px;
    background: #FFFFFF;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  html[data-theme="dark"] .service-item {
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .service-item:hover {
    border-color: #E0E0E0;
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  }

  html[data-theme="dark"] .service-item:hover {
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
  }

  .service-number {
    font-size: 2.5rem;
    font-weight: 900;
    color: #3DB551;
    opacity: 0.9;
    margin-bottom: 1rem;
  }

  .service-item h3 {
    font-size: 1.3rem;
    font-weight: 700;
    margin: 0 0 1rem;
    color: #1A1A1A;
  }

  html[data-theme="dark"] .service-item h3 {
    color: #FFFFFF;
  }

  .service-item p {
    font-size: 0.95rem;
    color: #666666;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  html[data-theme="dark"] .service-item p {
    color: #CCCCCC;
  }

  .service-link {
    color: #3DB551;
    font-weight: 700;
    text-decoration: none;
    display: inline-block;
    transition: all 0.3s ease;
  }

  .service-link:hover {
    color: #2A8A3C;
    transform: translateX(4px);
  }

  /* Features Section */
  .features-section {
    padding: 6rem 0;
  }

  .feature-block {
    max-width: 1280px;
    margin: 0 auto 6rem;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .feature-block.reverse {
    direction: rtl;
  }

  .feature-block.reverse .feature-text {
    direction: ltr;
  }

  .feature-text h2 {
    font-size: 2.5rem;
    font-weight: 900;
    margin: 0 0 1.5rem;
    color: #E8E9EB;
  }

  .feature-text p {
    font-size: 1.1rem;
    color: rgba(232, 233, 235, 0.8);
    line-height: 1.8;
  }

  /* CTA Section */
  .cta-section {
    padding: 8rem 2rem;
    text-align: center;
    background: linear-gradient(135deg, rgba(22, 160, 133, 0.1) 0%, rgba(22, 160, 133, 0.05) 100%);
    border-top: 1px solid rgba(22, 160, 133, 0.2);
    border-bottom: 1px solid rgba(22, 160, 133, 0.2);
  }

  .cta-section h2 {
    font-size: 3rem;
    font-weight: 900;
    margin: 0 0 0.5rem;
    color: #E8E9EB;
  }

  .cta-section p {
    font-size: 1.2rem;
    color: #16A085;
    margin-bottom: 2.5rem;
  }

  /* Direct Citizens Access Section */
  .section-container-full {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .direct-access-section {
    padding: 5rem 0;
  }

  html[data-theme="light"] .direct-access-section {
    background: #FFFFFF;
  }

  .direct-access-section .section-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .header-line {
    width: 3rem;
    height: 3px;
    background: #3DB551;
  }

  .direct-access-section .section-header::before,
  .direct-access-section .section-header::after {
    content: '';
    width: 3rem;
    height: 3px;
    background: #3DB551;
  }

  .header-label {
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #3DB551;

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BadgeDollarSign, ShieldCheck, Phone, ArrowRight } from 'lucide-react';
const locale = 'ne';
---

<BaseLayout title="मूल्य निर्धारण — AirFone" solidNav={true}>

  <!-- ============ HERO ============ -->
  <section class="page-hero">
    <div class="page-hero-bg" aria-hidden="true"></div>
    <div class="page-hero-inner">
      <div class="page-hero-text">
        <h1 class="page-hero-title reveal">
          पारदर्शी तहहरू।<br />
          <span class="page-hero-highlight">कुनै आश्चर्यजनक मिनेट छैन।</span>
        </h1>
        <p class="page-hero-lede reveal">
          Airfone लाई दैनिक १०० मिनेट निःशुल्क प्रयोग गर्नुहोस्। तयार हुनुभएपछि, एउटै सरल मासिक
          योजना — कुनै लुकेको शुल्क छैन, कुनै लामो-अवधिको सम्झौता छैन।
        </p>
      </div>

      <div class="page-hero-visual" aria-hidden="true">
        <div class="page-hero-ring">
          <div class="page-hero-ring-circle page-hero-ring-c1"></div>
          <div class="page-hero-ring-circle page-hero-ring-c2"></div>
          <div class="page-hero-ring-circle page-hero-ring-c3"></div>
          <div class="page-hero-ring-phone"><BadgeDollarSign size={42} /></div>
        </div>
        <div class="page-hero-float-card">
          <div class="page-hero-float-icon"><ShieldCheck size={18} /></div>
          <div>
            <div class="page-hero-float-num">१०० मिनेट/दिन</div>
            <div class="page-hero-float-label">निःशुल्क लाइभ डेमो, कार्ड आवश्यक पर्दैन</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PLAN ============ -->
  <section class="plans-section">
    <div class="section-container">
      <span class="section-eyebrow reveal">मूल्य निर्धारण</span>
      <h2 class="section-title reveal">एउटै सरल योजना</h2>

      <div class="plans-grid">
        <div class="plan-card plan-featured reveal">
          <span class="plan-name">Airfone Standard</span>
          <div class="plan-price">रु. ५,९९९–१०,०००<span>/मास</span></div>
          <ul class="plan-specs">
            <li><span>समावेश मिनेट</span><b>मासिक १,५०० सम्म</b></li>
            <li><span>क्यापभन्दा बढी भयो?</span><b>जुनसुकै बेला अपग्रेड गर्नुहोस्</b></li>
            <li><span>ज्ञान आधार</span><b>आवाज, वेबसाइट, Facebook, फोटो/भिडियो</b></li>
            <li><span>जवाफ दिने माध्यम</span><b>फोन (WhatsApp चाँडै आउँदैछ)</b></li>
            <li><span>प्रयोग गरेर हेर्नुहोस्</span><b>दैनिक १०० मिनेट निःशुल्क</b></li>
            <li><span>भाषाहरू</span><b>नेपाली र अंग्रेजी</b></li>
          </ul>
          <a href="https://sip.mylunago.com/" class="plan-btn plan-btn-filled" data-astro-reload>सुरु गर्नुहोस्</a>
        </div>
      </div>
      <p class="vat-note">मूल्य अझै अन्तिम रूप दिइँदैछ र VAT समावेश छैन।</p>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="cta-section reveal">
    <div class="cta-card">
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="cta-content">
        <h2 class="cta-title">पहिले निःशुल्क प्रयास गर्नुहोस् — <span class="cta-accent">आफ्नै AI एजेन्टसँग कुरा गर्नुहोस्।</span></h2>
        <p class="cta-lede">प्रतिबद्ध हुनुअघि आफ्नो PIN प्रयोग गरी डेमो नम्बरमा कल गर्नुहोस्। मूल्यबारे प्रश्न छ? हामी सहयोग गर्न खुसी छौं।</p>
        <div class="cta-actions">
          <a href="https://sip.mylunago.com/" class="cta-btn" data-astro-reload>
            निःशुल्क सुरु गर्नुहोस्
            <ArrowRight size={18} />
          </a>
          <a href="/ne/contact/" class="cta-btn-secondary">सम्पर्क गर्नुहोस्</a>
        </div>
      </div>

      <div class="cta-visual" aria-hidden="true">
        <div class="cta-ring">
          <div class="cta-ring-c1"></div>
          <div class="cta-ring-c2"></div>
          <div class="cta-ring-c3"></div>
          <div class="cta-ring-phone"><Phone size={40} /></div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .section-container { max-width: 1280px; margin: 0 auto; padding: 0 2rem; }
  .section-eyebrow {
    display: block; font-family: monospace; font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--primary-dark); margin-bottom: 1rem;
  }
  .section-title { font-size: clamp(1.6rem, 3vw, 2.1rem); font-weight: 800; color: var(--text-primary); letter-spacing: -0.01em; line-height: 1.4; margin: 0 0 2rem; }

  /* ============ PLAN ============ */
  .plans-section { background: var(--bg-secondary); padding: 4.5rem 0; }
  .plans-grid { display: grid; justify-items: center; }

  .plan-card {
    background: #FFFFFF; border: 1px solid var(--border-color); border-radius: 18px;
    padding: 2rem; display: flex; flex-direction: column; position: relative;
    width: 100%; max-width: 440px;
  }
  .plan-featured { border: 2px solid var(--primary); box-shadow: 0 12px 30px rgba(61, 177, 181, 0.15); }
  .plan-name { font-family: monospace; font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-secondary); }
  .plan-price { font-size: 2rem; font-weight: 800; color: var(--text-primary); margin: 0.6rem 0 1.5rem; }
  .plan-price span { font-size: 0.9rem; font-weight: 500; color: var(--text-secondary); }

  .plan-specs { list-style: none; margin: 0 0 1.5rem; padding: 0; flex: 1; }
  .plan-specs li { display: flex; justify-content: space-between; gap: 0.75rem; padding: 0.6rem 0; border-bottom: 1px solid var(--border-color); font-size: 0.85rem; }
  .plan-specs li:first-child { border-top: 1px solid var(--border-color); }
  .plan-specs li span { color: var(--text-secondary); }
  .plan-specs li b { color: var(--text-primary); font-weight: 700; text-align: right; }

  .plan-btn { display: block; text-align: center; padding: 0.85rem; border-radius: 10px; font-weight: 700; font-size: 0.9rem; text-decoration: none; }
  .plan-btn-filled { background: linear-gradient(135deg, #40BBC0, #2A868A); color: #FFFFFF; box-shadow: 0 3px 12px rgba(61, 177, 181, 0.3); }
  .plan-btn-filled:hover { background: linear-gradient(135deg, #3DB1B5, #1B777A); color: #FFFFFF; }

  .vat-note { font-size: 0.8rem; color: var(--text-secondary); margin: 1.5rem 0 0; text-align: center; }

  /* ============ CTA ============ */
  .pricing-cta-section {
    background: linear-gradient(180deg, #D4F4F5 0%, #E6F9FA 55%, #F2FCFC 100%);
    padding: 4rem 2.5rem 5rem;
  }
  .pricing-cta-inner {
    max-width: 1280px; margin: 0 auto;
    background: #FFFFFF;
    border: 1px solid rgba(61, 177, 181, 0.25); border-radius: 16px; padding: 2.5rem 3rem;
    display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap;
    box-shadow: 0 8px 24px rgba(61, 177, 181, 0.15);
  }
  .pricing-cta-text h2 { font-size: 1.5rem; font-weight: 700; color: #1A393A; margin: 0 0 0.4rem; }
  .pricing-cta-text p { font-size: 0.9rem; color: rgba(26, 57, 58, 0.7); margin: 0; }
  .pricing-cta-btn {
    display: inline-flex; align-items: center; padding: 0.8rem 1.6rem;
    background: linear-gradient(135deg, #40BBC0, #2A868A); color: #FFFFFF; font-weight: 700;
    font-size: 0.9rem; border-radius: 10px; text-decoration: none; white-space: nowrap;
    box-shadow: 0 3px 12px rgba(61, 177, 181, 0.35); transition: all 0.2s ease;
  }
  .pricing-cta-btn:hover { background: linear-gradient(135deg, #3DB1B5, #1B777A); color: #FFFFFF; transform: translateY(-1px); }

  @media (max-width: 600px) {
    .pricing-cta-section { padding: 3rem 1.25rem 3rem; }
    .pricing-cta-inner { flex-direction: column; align-items: flex-start; padding: 2rem 1.5rem; }
    .pricing-cta-btn { width: 100%; text-align: center; justify-content: center; }
  }

  /* Dark mode — deep/medium green sections */
  html[data-theme="dark"] .plans-section {
    background: var(--bg-secondary);
  }

  html[data-theme="dark"] .plan-card {
    background: var(--card-bg);
    border-color: var(--card-border);
  }

  html[data-theme="dark"] .plan-featured {
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
  }

  /* ============ PRE-FOOTER CTA SECTION ============ */
  .cta-section {
    background: linear-gradient(180deg, #FFFFFF 0%, #EEF9F9 100%);
    padding: 1rem 2.5rem 5rem;
  }
  .cta-card {
    position: relative; overflow: hidden;
    max-width: 1280px; margin: 0 auto;
    background: linear-gradient(135deg, #0B3233 0%, #165E61 55%, #2A868A 100%);
    border-radius: 24px; padding: 3.5rem;
    display: grid; grid-template-columns: 1fr auto;
    align-items: center; gap: 2.5rem;
  }
  .cta-glow {
    position: absolute; top: -55%; left: -15%;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(64, 187, 192, 0.45) 0%, rgba(64, 187, 192, 0) 70%);
    pointer-events: none;
  }
  .cta-content { position: relative; z-index: 1; }
  .cta-title {
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    font-weight: 800; line-height: 1.2; letter-spacing: -0.02em;
    color: #FFFFFF; margin: 0 0 1rem; max-width: 640px;
  }
  .cta-accent { color: #7CDCE0; }
  .cta-lede {
    font-size: 1rem; line-height: 1.65; color: rgba(255, 255, 255, 0.8);
    max-width: 560px; margin: 0 0 2rem;
  }
  .cta-actions { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
  .cta-btn {
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.95rem 1.9rem;
    background: #FFFFFF; color: #14575A; font-weight: 800;
    font-size: 0.95rem; border-radius: 12px; text-decoration: none; white-space: nowrap;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }
  .cta-btn:hover { background: #ECF9FA; color: #0B3233; transform: translateY(-2px); box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3); }
  .cta-btn-secondary {
    display: inline-flex; align-items: center;
    padding: 0.95rem 1.9rem;
    color: #FFFFFF; font-weight: 700;
    font-size: 0.95rem; border-radius: 12px; text-decoration: none; white-space: nowrap;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .cta-btn-secondary:hover { background: rgba(255, 255, 255, 0.1); border-color: rgba(255, 255, 255, 0.6); }
  .cta-visual { position: relative; width: 220px; height: 220px; z-index: 1; }
  .cta-ring { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
  .cta-ring-c1, .cta-ring-c2, .cta-ring-c3 {
    position: absolute; border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.22);
    animation: ctaPulse 3s ease-out infinite;
  }
  .cta-ring-c1 { width: 220px; height: 220px; }
  .cta-ring-c2 { width: 150px; height: 150px; animation-delay: 0.6s; }
  .cta-ring-c3 { width: 90px; height: 90px; animation-delay: 1.2s; }
  .cta-ring-phone {
    width: 64px; height: 64px; border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #FFFFFF; display: flex; align-items: center; justify-content: center;
  }
  @keyframes ctaPulse {
    0% { transform: scale(0.85); opacity: 0; }
    40% { opacity: 1; }
    100% { transform: scale(1.15); opacity: 0; }
  }
  @media (max-width: 900px) {
    .cta-card { grid-template-columns: 1fr; text-align: center; }
    .cta-actions { justify-content: center; }
    .cta-visual { display: none; }
  }
  @media (max-width: 600px) {
    .cta-section { padding: 0.5rem 1.25rem 3rem; }
    .cta-card { padding: 2.5rem 1.5rem; }
    .cta-actions { flex-direction: column; }
    .cta-btn, .cta-btn-secondary { width: 100%; justify-content: center; }
  }
  html[data-theme="dark"] .cta-section {
    background: linear-gradient(180deg, var(--bg-primary) 0%, #081617 100%);
  }
  html[data-theme="dark"] .cta-btn:hover { background: #ECF9FA; }
</style>
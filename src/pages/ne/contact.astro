---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Phone, Mail, MapPin, Check } from 'lucide-react';
const locale = 'ne';
---

<BaseLayout title="सम्पर्क — AirFone" solidNav={true}>

  <!-- ============ HERO ============ -->
  <section class="page-hero">
    <div class="page-hero-bg" aria-hidden="true"></div>
    <div class="page-hero-inner">
      <div class="page-hero-text">
        <h1 class="page-hero-title">
          यसलाई <span class="page-hero-highlight">लाइभ लाइनमा</span> राखौं।
        </h1>
        <p class="page-hero-lede">
          हामीलाई तपाईंको कल भोल्युमको बारेमा बताउनुहोस् र हामी लाइभ डेमो तालिका बनाउनेछौं,
          वा तलका विवरणहरू प्रयोग गरी सिधै सम्पर्क गर्नुहोस्।
        </p>
        <div class="page-hero-chips">
          <span class="page-hero-chip"><Check size={14} /> एक व्यावसायिक दिनभित्र प्रतिक्रिया</span>
          <span class="page-hero-chip"><Check size={14} /> तपाईंको लाइनमा लाइभ डेमो</span>
          <span class="page-hero-chip"><Check size={14} /> अंग्रेजी, नेपाली र हिन्दी</span>
        </div>
      </div>

      <div class="page-hero-visual" aria-hidden="true">
        <div class="page-hero-ring">
          <div class="page-hero-ring-circle page-hero-ring-c1"></div>
          <div class="page-hero-ring-circle page-hero-ring-c2"></div>
          <div class="page-hero-ring-circle page-hero-ring-c3"></div>
          <div class="page-hero-ring-phone"><Phone size={42} /></div>
        </div>
        <div class="page-hero-float-card">
          <div class="page-hero-float-icon"><Mail size={18} /></div>
          <div>
            <div class="page-hero-float-num">२४/७</div>
            <div class="page-hero-float-label">डेमो अनुरोधहरू छिटो सम्बोधन</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FORM + SIDEBAR ============ -->
  <section class="contact-main">
    <div class="section-container contact-grid">

      <!-- Form card -->
      <div class="contact-form-card">
        <h2>डेमो अनुरोध गर्नुहोस्</h2>

        <form class="contact-form">
          <div class="form-row">
            <div class="form-field">
              <label for="fullName">पूरा नाम</label>
              <input type="text" id="fullName" name="fullName" placeholder="अनिता शर्मा" required />
            </div>
            <div class="form-field">
              <label for="workEmail">कार्यालय इमेल</label>
              <input type="email" id="workEmail" name="workEmail" placeholder="anita@company.com" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-field">
              <label for="phone">फोन नम्बर</label>
              <input type="tel" id="phone" name="phone" placeholder="+९७७ ९८XXXXXXXX" required />
            </div>
            <div class="form-field">
              <label for="company">कम्पनी</label>
              <input type="text" id="company" name="company" placeholder="कम्पनी प्रा.लि." required />
            </div>
          </div>

          <div class="form-field full">
            <label for="plan">रुचि भएको प्लान</label>
            <select id="plan" name="plan" required>
              <option value="">प्लान छान्नुहोस्</option>
              <option>Starter</option>
              <option selected>Growth</option>
              <option>AI Enterprise</option>
              <option>अझै निश्चित छैन</option>
            </select>
          </div>

          <div class="form-field full">
            <label for="message">सन्देश</label>
            <textarea id="message" name="message" placeholder="तपाईंको हालको कल भोल्युम र प्रयोग केस बारे बताउनुहोस्..." required></textarea>
          </div>

          <button type="submit" class="contact-submit-btn">लाइभ डेमो तालिका बनाउनुहोस्</button>
        </form>
      </div>

      <!-- Sidebar -->
      <div class="contact-sidebar">

        <div class="contact-info-card">
          <div class="contact-info-row">
            <div class="contact-info-icon"><Phone size={18} /></div>
            <div>
              <h4>बिक्री र सहयोग</h4>
              <p>+९७७ १-४XXXXXX · सोम–शनि, बिहान ९ – साँझ ७ (NPT)</p>
            </div>
          </div>
          <div class="contact-info-row">
            <div class="contact-info-icon"><Mail size={18} /></div>
            <div>
              <h4>इमेल</h4>
              <p>hello@airfone.example · sales@airfone.example</p>
            </div>
          </div>
          <div class="contact-info-row">
            <div class="contact-info-icon"><MapPin size={18} /></div>
            <div>
              <h4>कार्यालय</h4>
              <p>काठमाडौं, नेपाल</p>
            </div>
          </div>

          <div class="contact-map-placeholder">
            <span>नक्सा प्लेसहोल्डर — Google Maps इम्बेड गर्नुहोस्</span>
          </div>
        </div>

        <div class="contact-doc-card">
          <h4>कागजात रुचाउनुहुन्छ?</h4>
          <p>आर्किटेक्चर र SLA सर्तहरू सहितको पूर्ण प्लेटफर्म प्रस्ताव डाउनलोड गर्नुहोस्।</p>
          <a href="/proposal.pdf" class="contact-doc-btn" download>पूरा प्रस्ताव डाउनलोड गर्नुहोस्</a>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .section-container { max-width: 1280px; margin: 0 auto; padding: 0 2rem; }
  .section-eyebrow {
    display: block; font-family: monospace; font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--primary-dark); margin-bottom: 1rem;
  }

  .contact-main { background: #FFFFFF; padding: 4.5rem 0; }
  .contact-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2rem; align-items: start; }

  .contact-form-card {
    background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 20px; padding: 2.5rem;
  }
  .contact-form-card h2 { font-size: 1.4rem; font-weight: 800; color: var(--text-primary); margin: 0 0 1.75rem; }

  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 1.25rem; }
  .form-field { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.25rem; }
  .form-field.full { margin-bottom: 1.25rem; }
  .form-field label { font-size: 0.82rem; font-weight: 600; color: var(--text-secondary); }
  .form-field input, .form-field select, .form-field textarea {
    border: 1.5px solid var(--border-color); border-radius: 10px; padding: 0.8rem 1rem;
    font-size: 0.92rem; background: #FFFFFF; color: var(--text-primary); font-family: inherit;
  }
  .form-field input:focus, .form-field select:focus, .form-field textarea:focus {
    outline: none; border-color: var(--primary);
  }
  .form-field textarea { resize: vertical; min-height: 100px; }

  .contact-submit-btn {
    width: 100%; padding: 0.95rem; border: none; border-radius: 10px; cursor: pointer;
    background: linear-gradient(135deg, #6DC040, #2A8A3C); color: #FFFFFF;
    font-weight: 700; font-size: 0.95rem; box-shadow: 0 3px 12px rgba(61, 181, 81, 0.3);
    transition: all 0.2s ease;
  }
  .contact-submit-btn:hover { background: linear-gradient(135deg, #3DB551, #1B7A2F); transform: translateY(-1px); }

  .contact-sidebar { display: flex; flex-direction: column; gap: 1.5rem; }

  .contact-info-card { background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 20px; padding: 2rem; }

  .contact-info-row { display: flex; gap: 1rem; margin-bottom: 1.5rem; }
  .contact-info-row:last-of-type { margin-bottom: 1.75rem; }
  .contact-info-icon {
    width: 38px; height: 38px; border-radius: 10px; background: rgba(61, 181, 81, 0.12);
    color: var(--primary-dark); display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .contact-info-row h4 { font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin: 0 0 0.3rem; }
  .contact-info-row p { font-size: 0.85rem; color: var(--text-secondary); margin: 0; line-height: 1.5; }

  .contact-map-placeholder {
    height: 140px; border-radius: 14px; border: 1px dashed var(--border-color);
    background-image:
      linear-gradient(rgba(61,181,81,0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(61,181,81,0.06) 1px, transparent 1px);
    background-size: 24px 24px;
    display: flex; align-items: center; justify-content: center;
  }
  .contact-map-placeholder span { font-family: monospace; font-size: 0.75rem; color: var(--text-secondary); text-align: center; padding: 0 1rem; }

  .contact-doc-card { background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 20px; padding: 2rem; }
  .contact-doc-card h4 { font-size: 1rem; font-weight: 700; color: var(--text-primary); margin: 0 0 0.6rem; }
  .contact-doc-card p { font-size: 0.85rem; color: var(--text-secondary); line-height: 1.6; margin: 0 0 1.25rem; }
  .contact-doc-btn {
    display: block; text-align: center; padding: 0.85rem; border: 1.5px solid var(--border-color);
    border-radius: 10px; font-weight: 700; font-size: 0.9rem; color: var(--text-primary); text-decoration: none;
  }
  .contact-doc-btn:hover { border-color: var(--primary); color: var(--primary-dark); }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .form-row { grid-template-columns: 1fr; gap: 0; }
    .contact-form-card, .contact-info-card, .contact-doc-card { padding: 1.5rem; }
  }

  /* Dark mode — deep/medium green sections */
  html[data-theme="dark"] .contact-main {
    background: var(--bg-primary);
  }

  html[data-theme="dark"] .contact-form-card,
  html[data-theme="dark"] .contact-info-card,
  html[data-theme="dark"] .contact-doc-card {
    background: var(--bg-secondary);
    border-color: var(--card-border);
  }

  html[data-theme="dark"] .form-field input,
  html[data-theme="dark"] .form-field select,
  html[data-theme="dark"] .form-field textarea {
    background: var(--card-bg);
    border-color: var(--card-border);
    color: var(--text-primary);
  }

  html[data-theme="dark"] .form-field input::placeholder,
  html[data-theme="dark"] .form-field textarea::placeholder {
    color: rgba(185, 214, 192, 0.6);
  }
</style>

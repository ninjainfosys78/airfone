---
import { render } from 'astro:content';
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/site/CtaBand.astro';
import { coverFor, fmtDate, posts, readMinutes, type Post } from '../../lib/posts';
import { related } from '../../lib/blog';
import { articleJsonLd, breadcrumbJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const all = await posts();
  return all.map((post) => ({ params: { slug: post.id }, props: { post, all } }));
}
const { post, all } = Astro.props as { post: Post; all: Post[] };
const { Content } = await render(post);
const d = post.data;
const path = `/blog/${post.id}`;
const image = coverFor(post);
const more = related(all.map((p) => ({ ...p, data: { ...p.data, draft: false } })), { ...post, data: { ...d, draft: false } }) as Post[];
const pillar = all.find((p) => p.data.pillar && p.id !== post.id && p.data.tags.some((t) => d.tags.includes(t)));
const next = [...(pillar ? [pillar] : []), ...more.filter((m) => m.id !== pillar?.id)];
const readNext = (next.length ? next : all.filter((p) => p.id !== post.id)).slice(0, 3);
---
<Base
  title={d.title}
  description={d.description}
  path={path}
  type="article"
  image={image}
  imageAlt={d.imageAlt}
  published={d.date}
  modified={d.updated ?? d.date}
  noindex={d.draft}
  jsonLd={[
    articleJsonLd({ slug: post.id, title: d.title, description: d.description, date: d.date, updated: d.updated, image }),
    breadcrumbJsonLd([{ name: 'Insights', path: '/blog' }, { name: d.title, path }]),
  ]}
>
  <article class="post">
    <div class="wrap"><div class="col">
      <a class="back" href="/blog"><span aria-hidden="true">←</span> All insights</a>
      <h1 class="title">{d.title}</h1>
      <p class="meta">
        <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
        {d.updated && <> · Updated <time datetime={d.updated.toISOString()}>{fmtDate(d.updated)}</time></>}
        {' · '}{readMinutes(post)} min read
        {d.draft && <span class="draft"> · Draft, not published</span>}
      </p>
      <div class="prose body"><Content /></div>
    </div></div>
  </article>

  {readNext.length > 0 && (
    <nav class="next wrap no-print" aria-labelledby="next-h"><div class="col">
      <h2 id="next-h" class="next-h">Read next</h2>
      <ul>
        {readNext.map((p) => (
          <li><a href={`/blog/${p.id}`}><span>{p.data.title}</span><time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time></a></li>
        ))}
      </ul>
    </div></nav>
  )}
  <CtaBand />
</Base>

<script>
  // Wide tables scroll inside their own box instead of the page.
  document.querySelectorAll('.prose table').forEach((t) => {
    const box = document.createElement('div');
    box.className = 'table-scroll';
    t.replaceWith(box);
    box.append(t);
  });
</script>


<style>
  /* One reading column on the page's left edge: back link, title, date, text. */
  .col { max-width: 700px; }
  .post { padding-block: var(--space-7) var(--space-9); }
  .back { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; color: var(--ink-muted); text-decoration: none; font-size: 16px; transition: color var(--fast) var(--ease); }
  .back span { transition: transform var(--fast) var(--ease); }
  .back:hover { color: var(--ink); }
  .back:hover span { transform: translateX(-4px); }
  .title { margin: var(--space-6) 0 var(--space-4); max-width: 20ch; font-family: 'Source Serif 4 Variable', Georgia, serif; font-weight: 600; font-variation-settings: 'opsz' 60; font-size: clamp(2.25rem, 1.6rem + 2.4vw, 3.5rem); line-height: 1.1; overflow-wrap: anywhere; }
  .meta { margin: 0 0 var(--space-8); padding-bottom: var(--space-6); border-bottom: 1px solid var(--line); font-size: 14px; color: var(--ink-muted); }
  .draft { color: var(--error); }
  .body { max-width: none; font-family: 'Source Serif 4 Variable', Georgia, serif; font-size: 1.1875rem; line-height: 1.55; }
  .body :global(h2), .body :global(h3) { font-family: inherit; font-weight: 600; }
  .body :global(li + li) { margin-top: var(--space-1); }
  .body :global(h2) { font-size: 1.5rem; line-height: 1.25; margin: var(--space-7) 0 var(--space-3); scroll-margin-top: 104px; }
  .body :global(p), .body :global(ul), .body :global(ol) { margin-bottom: var(--space-4); }
  .body :global(table) { display: block; overflow-x: auto; }
  .next { padding-bottom: var(--space-9); }
  .next-h { font-size: 1.125rem; margin: 0 0 var(--space-3); }
  .next ul { list-style: none; margin: 0; padding: 0; }
  .next a { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-5); padding: var(--space-4) 0; border-top: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .next li:last-child a { border-bottom: 1px solid var(--line); }
  .next span { font-weight: 500; transition: color var(--fast) var(--ease); }
  .next a:hover span { color: var(--link); }
  .next time { flex: none; font-size: 14px; color: var(--ink-muted); }
  @media (max-width: 599px) { .next a { flex-direction: column; gap: var(--space-1); } }
</style>

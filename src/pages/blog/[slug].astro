---
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import { render } from 'astro:content';
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import serifUrl from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/site/CtaBand.astro';
import { coverFor, fmtDate, posts, type Post } from '../../lib/posts';
import { related } from '../../lib/blog';
import { articleJsonLd, breadcrumbJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const all = await posts();
  return all.map((post) => ({ params: { slug: post.id }, props: { post, all } }));
}
const { post, all } = Astro.props as { post: Post; all: Post[] };
const { Content } = await render(post);
const d = post.data;
const path = `/blog/${post.id}`;
const image = coverFor(post);
const more = related(all.map((p) => ({ ...p, data: { ...p.data, draft: false } })), { ...post, data: { ...d, draft: false } }) as Post[];
const pillar = all.find((p) => p.data.pillar && p.id !== post.id && p.data.tags.some((t) => d.tags.includes(t)));
const next = [...(pillar ? [pillar] : []), ...more.filter((m) => m.id !== pillar?.id)];
const readNext = (next.length ? next : all.filter((p) => p.id !== post.id)).slice(0, 3);
---
<Base
  title={d.title}
  description={d.description}
  path={path}
  type="article"
  image={image}
  imageAlt={d.imageAlt}
  published={d.date}
  modified={d.updated ?? d.date}
  noindex={d.draft}
  jsonLd={[
    articleJsonLd({ slug: post.id, title: d.title, description: d.description, date: d.date, updated: d.updated, image }),
    breadcrumbJsonLd([{ name: 'Insights', path: '/blog' }, { name: d.title, path }]),
  ]}
>
  <link slot="head" rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
  <article class="post">
    <header class="wrap">
      <a class="back" href="/blog" data-enter><ArrowLeft size={18} stroke-width={2} aria-hidden="true" /> All insights</a>
      <h1 class="title" data-enter>{d.title}</h1>
      <p class="meta" data-enter>
        <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
        {d.updated && <> · Updated <time datetime={d.updated.toISOString()}>{fmtDate(d.updated)}</time></>}
        {d.draft && <span class="draft"> · Draft, not published</span>}
      </p>
    </header>
    <div class="wrap grid">
      <div class="col prose body" data-enter><Content /></div>
      {readNext.length > 0 && (
        <nav class="next no-print" aria-labelledby="next-h" data-enter>
          <h2 id="next-h" class="next-h">Read next</h2>
          <ul>
            {readNext.map((p) => (
              <li><a href={`/blog/${p.id}`}><span>{p.data.title}</span><time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time></a></li>
            ))}
          </ul>
        </nav>
      )}
  </div>
  </article>

  <CtaBand />
</Base>

<script>
  // Wide tables scroll inside their own box instead of the page.
  document.querySelectorAll('.prose table').forEach((t) => {
    const box = document.createElement('div');
    box.className = 'table-scroll';
    t.replaceWith(box);
    box.append(t);
  });
</script>


<style is:global>
  /* Georgia sized to Source Serif 4, so text barely moves if the font is late. */
  @font-face { font-family: 'Serif Fallback'; src: local('Georgia'); size-adjust: 92%; ascent-override: 98%; descent-override: 31%; line-gap-override: 0%; }
</style>

<style>
  /* One reading column on the page's left edge: back link, title, date, text. */
  .col { max-width: 700px; }
  .post { padding-block: var(--space-7) var(--space-9); }
  .back { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; color: var(--ink-muted); text-decoration: none; font-size: 16px; transition: color var(--fast) var(--ease); }
  .back svg { transition: transform var(--fast) var(--ease); }
  .back:hover { color: var(--ink); }
  .back:hover svg { transform: translateX(-4px); }
  .title { margin: var(--space-6) 0 var(--space-4); width: min(calc(100vw - 2 * var(--gutter)), 1000px); max-width: 28ch; font-family: 'Source Serif 4 Variable', 'Serif Fallback', Georgia, serif; font-weight: 600; font-variation-settings: 'opsz' 60; font-size: clamp(2.25rem, 1.6rem + 2.4vw, 3.5rem); line-height: 1.1; overflow-wrap: anywhere; }
  .meta { margin: 0 0 var(--space-8); padding-bottom: var(--space-6); border-bottom: 1px solid var(--line); font-family: 'Source Serif 4 Variable', 'Serif Fallback', Georgia, serif; font-size: 16px; color: var(--ink-muted); }
  .draft { color: var(--error); }
  .body { max-width: none; font-family: 'Source Serif 4 Variable', 'Serif Fallback', Georgia, serif; font-size: 1.1875rem; line-height: 1.45; }
  .body :global(h2), .body :global(h3) { font-family: inherit; font-weight: 600; }
  .body :global(li + li) { margin-top: var(--space-1); }
  .body :global(h2) { font-size: 1.5rem; line-height: 1.25; margin: var(--space-7) 0 var(--space-3); scroll-margin-top: 104px; }
  .body :global(p), .body :global(ul), .body :global(ol) { margin-bottom: var(--space-4); }
  .body :global(table) { display: block; overflow-x: auto; }
  /* Desktop: read next sits in the empty right column and stays in view. */
  .grid { display: grid; grid-template-columns: minmax(0, 700px) minmax(220px, 300px); justify-content: space-between; gap: var(--space-9); }
  .next { position: sticky; top: 112px; align-self: start; }
  @media (max-width: 1099px) {
    .grid { grid-template-columns: minmax(0, 700px); gap: 0; }
    .next { position: static; margin-top: var(--space-8); }
  }
  .next-h { font-size: 1.125rem; margin: 0 0 var(--space-3); }
  .next ul { list-style: none; margin: 0; padding: 0; }
  .next a { display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-4) 0; border-top: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .next li:last-child a { border-bottom: 1px solid var(--line); }
  .next span { font-weight: 500; line-height: 1.35; transition: color var(--fast) var(--ease); }
  .next a:hover span { color: var(--link); }
  .next time { flex: none; font-size: 14px; color: var(--ink-muted); }
</style>

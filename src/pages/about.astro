---
import BaseLayout from '../../layouts/BaseLayout.astro';
const locale = 'en';
import { ShieldCheck, Lock, Globe2, BarChart3, Check, Phone, Bot, ArrowRight } from 'lucide-react';
---

<BaseLayout title="About Us — AirFone" solidNav={true}>

  <!-- ============ ABOUT INTRO ============ -->
  <section class="about-hero">
    <div class="about-hero-bg" aria-hidden="true"></div>
    <div class="about-hero-inner">
      <div class="about-hero-text">
        <h1 class="about-hero-title reveal">
          We believe a phone call is still the<br />
          most <span class="about-highlight">human</span> channel a business has.
        </h1>
        <p class="about-hero-lede reveal">
          We just think it should finally sound like it's listening. AirFone was built to
          replace rigid, button-based menus with a conversational AI layer that understands
          intent, remembers context, and never puts a caller on hold.
        </p>
        <div class="about-hero-chips reveal">
          <span class="about-chip"><Check size={14} /> AI-First Voice</span>
          <span class="about-chip"><Check size={14} /> Telecom-Grade Reliability</span>
          <span class="about-chip"><Check size={14} /> Built in Nepal</span>
        </div>
      </div>

      <div class="about-hero-visual" aria-hidden="true">
        <div class="about-hero-ring">
          <div class="about-hero-ring-circle about-hero-ring-c1"></div>
          <div class="about-hero-ring-circle about-hero-ring-c2"></div>
          <div class="about-hero-ring-circle about-hero-ring-c3"></div>
          <div class="about-hero-ring-phone"><Phone size={42} /></div>
        </div>
        <div class="about-hero-float-card">
          <div class="about-hero-float-icon"><Bot size={18} /></div>
          <div>
            <div class="about-hero-float-num">24/7</div>
            <div class="about-hero-float-label">AI answers every call</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ VISION + STATS ============ -->
  <section class="vision-section">
    <div class="vision-inner">
      <div class="vision-text reveal">
        <span class="vision-tag">Our Vision</span>
        <h2 class="vision-title">Redefining business voice communication.</h2>
        <p>
          To convert every phone call into an intelligent, data-driven interaction —
          deploying AI agents alongside human teams so no customer is ever left waiting,
          and no conversation goes unmeasured.
        </p>
        <p>
          Traditional PBX and IVR systems have reached their operational limits: robotic
          recordings, rigid trees, and no memory between transfers. We built the platform
          we wished existed — one engineered for telecom-grade reliability with an
          AI layer that actually understands the caller.
        </p>
      </div>

      <div class="vision-card reveal">
        <div class="vision-stat">
          <div class="vision-stat-num">2024</div>
          <div class="vision-stat-label">Founded in Kathmandu</div>
        </div>
        <div class="vision-stat">
          <div class="vision-stat-num">3</div>
          <div class="vision-stat-label">Languages natively supported</div>
        </div>
        <div class="vision-stat">
          <div class="vision-stat-num">1,000+</div>
          <div class="vision-stat-label">Concurrent call channels at scale</div>
        </div>
        <div class="vision-stat">
          <div class="vision-stat-num">99.95%</div>
          <div class="vision-stat-label">Guaranteed core uptime</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ VALUES ============ -->
  <section class="values-section">
    <div class="section-container">
      <span class="section-eyebrow reveal">What We Stand For</span>
      <h2 class="section-title reveal">Four values behind every architectural decision.</h2>

      <div class="values-grid">
        <div class="value-card reveal">
          <div class="value-icon"><ShieldCheck size={20} /></div>
          <h3>Reliability First</h3>
          <p>Multi-region redundant clusters and SBCs so the line never drops mid-conversation.</p>
        </div>
        <div class="value-card reveal">
          <div class="value-icon"><Lock size={20} /></div>
          <h3>Security &amp; Compliance</h3>
          <p>AES-256 at rest, TLS 1.3/SRTP in transit, on-premises options for regulated industries.</p>
        </div>
        <div class="value-card reveal">
          <div class="value-icon"><Globe2 size={20} /></div>
          <h3>Local, Not Localized</h3>
          <p>Nepali, Hindi, and English voice models built for the region, not bolted on.</p>
        </div>
        <div class="value-card reveal">
          <div class="value-icon"><BarChart3 size={20} /></div>
          <h3>Radical Transparency</h3>
          <p>Every call transcribed, scored, and synced — nothing about a conversation is a black box.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WHO WE WORK WITH ============ -->
  <section class="audience-section">
    <div class="section-container">
      <span class="section-eyebrow reveal">Who We Work With</span>
      <h2 class="section-title light reveal">Built for teams that live on the phone.</h2>
      <p class="audience-lede reveal">
        Customer support desks, sales &amp; collections teams, and operations units running
        high call volumes across banking, telecom, retail, and government services.
      </p>

      <div class="industry-tags reveal">
        <span class="industry-tag">Banking &amp; NBFC</span>
        <span class="industry-tag">Telecom</span>
        <span class="industry-tag">Government &amp; Public Service</span>
        <span class="industry-tag">Retail &amp; E-commerce</span>
        <span class="industry-tag">Insurance</span>
        <span class="industry-tag">Logistics</span>
      </div>
    </div>
  </section>

  <!-- ============ TEAM CTA ============ -->
  <section class="cta-section reveal">
    <div class="cta-card">
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="cta-content">
        <h2 class="cta-title">Want to meet the team behind <span class="cta-accent">the platform?</span></h2>
        <p class="cta-lede">We're happy to walk you through the architecture live.</p>
        <div class="cta-actions">
          <a href={`/${locale}/contact/`} class="cta-btn">
            Get in Touch
            <ArrowRight size={18} />
          </a>
        </div>
      </div>

      <div class="cta-visual" aria-hidden="true">
        <div class="cta-ring">
          <div class="cta-ring-c1"></div>
          <div class="cta-ring-c2"></div>
          <div class="cta-ring-c3"></div>
          <div class="cta-ring-phone"><Phone size={40} /></div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ============ ABOUT INTRO ============ */
  .about-hero {
    position: relative;
    overflow: clip;
    background: #FFFFFF;
    padding: 10rem 0 5rem;
  }

  .about-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 55% 70% at 82% 25%, rgba(109, 192, 64, 0.12), transparent 60%),
      radial-gradient(ellipse 45% 55% at 8% 95%, rgba(61, 181, 81, 0.08), transparent 60%),
      linear-gradient(180deg, #FFFFFF 0%, #F6FBF4 100%);
  }

  .about-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: center;
  }

  .about-hero-text {
    max-width: 720px;
  }

  .about-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    border: 1px solid rgba(61, 181, 81, 0.25);
    background: rgba(61, 181, 81, 0.06);
    color: var(--primary-dark);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .about-badge-icon { color: var(--primary); }

  .about-hero-title {
    font-size: clamp(2rem, 4.2vw, 2.9rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }

  .about-highlight {
    background: linear-gradient(135deg, #6DC040, #1B7A2F);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .about-hero-lede {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 720px;
    margin: 0 0 1.75rem;
  }

  .about-hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .about-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--primary-dark);
    background: #FFFFFF;
    border: 1px solid rgba(61, 181, 81, 0.22);
    border-radius: 9999px;
    padding: 0.45rem 1rem;
    box-shadow: 0 2px 8px rgba(61, 181, 81, 0.08);
  }

  .about-chip svg { color: var(--primary); flex-shrink: 0; }

  /* call-ring motif */
  .about-hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 380px;
  }

  .about-hero-ring {
    position: relative;
    width: 340px;
    height: 340px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about-hero-ring-circle {
    position: absolute;
    border-radius: 50%;
    border: 1.5px solid rgba(61, 181, 81, 0.18);
  }

  .about-hero-ring-c1 { width: 340px; height: 340px; }
  .about-hero-ring-c2 { width: 248px; height: 248px; }
  .about-hero-ring-c3 { width: 156px; height: 156px; }

  .about-hero-ring-phone {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6DC040, #2A8A3C);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 16px 32px rgba(42, 138, 60, 0.28);
    animation: aboutRingPulse 3.2s ease-in-out infinite;
  }

  @keyframes aboutRingPulse {
    0%, 100% { transform: scale(1); box-shadow: 0 16px 32px rgba(42, 138, 60, 0.28); }
    50% { transform: scale(1.06); box-shadow: 0 18px 40px rgba(42, 138, 60, 0.36); }
  }

  /* floating mini-stat card */
  .about-hero-float-card {
    position: absolute;
    right: 4%;
    bottom: 6%;
    background: #FFFFFF;
    border: 1px solid rgba(61, 181, 81, 0.22);
    border-radius: 14px;
    padding: 0.9rem 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    box-shadow: 0 12px 32px rgba(42, 138, 60, 0.14);
  }

  .about-hero-float-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(61, 181, 81, 0.1);
    border: 1px solid rgba(61, 181, 81, 0.22);
    color: var(--primary-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .about-hero-float-num {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.1;
  }

  .about-hero-float-label {
    font-size: 0.72rem;
    color: var(--text-secondary);
  }

  /* ============ VISION + STATS ============ */
  .vision-section {
    background: var(--bg-secondary);
    padding: 5rem 0;
  }

  .vision-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .vision-tag {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--primary-dark);
    margin-bottom: 1rem;
  }

  .vision-title {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
    line-height: 1.25;
  }

  .vision-text p {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.75;
    margin: 0 0 1.25rem;
  }

  .vision-card {
    background: #FFFFFF;
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    box-shadow: 0 8px 30px rgba(61, 181, 81, 0.08);
  }

  .vision-stat-num {
    font-size: 1.9rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--primary-gradient-start), var(--primary-gradient-end));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .vision-stat-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .about-hero-inner { grid-template-columns: 1fr; gap: 2rem; }
    .about-hero-visual { display: none; }
    .vision-inner { grid-template-columns: 1fr; }
    .vision-card { grid-template-columns: 1fr 1fr; }
    .about-hero-inner, .vision-inner { padding-left: 1.5rem; padding-right: 1.5rem; }
  }

  @media (max-width: 600px) {
    .about-hero { padding: 9rem 0 3rem; }
    .vision-section { padding: 3rem 0; }
    .about-hero-inner, .vision-inner { padding-left: 1rem; padding-right: 1rem; }
    .vision-card { grid-template-columns: 1fr; padding: 2rem; }
  }

  /* shared container — reuse everywhere so left/right edges always line up */
  .section-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-eyebrow {
    display: block;
    font-family: monospace;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--primary-dark);
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: clamp(1.6rem, 3.2vw, 2.2rem);
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0 0 2.5rem;
    max-width: 640px;
  }

  .section-title.light { color: var(--text-primary); }

  /* ============ VALUES ============ */
  .values-section {
    background: #FFFFFF;
    padding: 5rem 0;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .value-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 1.75rem;
  }

  .value-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(61, 181, 81, 0.1);
    border: 1px solid rgba(61, 181, 81, 0.25);
    color: var(--primary-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.1rem;
  }

  .value-card h3 {
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.6rem;
  }

  .value-card p {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* ============ WHO WE WORK WITH ============ */
  .audience-section {
    background: #F4FAF5;
    padding: 5rem 0;
  }

  .audience-lede {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 640px;
    margin: 0 0 2.25rem;
  }

  .industry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .industry-tag {
    font-family: monospace;
    font-size: 0.85rem;
    color: var(--primary-dark);
    background: #FFFFFF;
    border: 1px solid var(--border-color);
    border-radius: 9999px;
    padding: 0.55rem 1.1rem;
  }

  @media (max-width: 900px) {
    .values-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .values-grid { grid-template-columns: 1fr; }
    .values-section, .audience-section { padding: 3rem 0; }
  }

  /* Dark mode — deep/medium green sections */
  html[data-theme="dark"] .about-hero {
    background: var(--bg-primary);
  }

  html[data-theme="dark"] .about-hero-bg {
    background:
      radial-gradient(ellipse 55% 70% at 82% 25%, rgba(109, 192, 64, 0.14), transparent 60%),
      radial-gradient(ellipse 45% 55% at 8% 95%, rgba(61, 181, 81, 0.1), transparent 60%),
      var(--bg-primary);
  }

  html[data-theme="dark"] .about-chip {
    background: var(--card-bg);
    border-color: var(--card-border);
    color: var(--text-secondary);
  }

  html[data-theme="dark"] .about-hero-ring-circle {
    border-color: rgba(109, 192, 64, 0.3);
  }

  html[data-theme="dark"] .about-hero-float-card {
    background: var(--card-bg);
    border-color: var(--card-border);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }

  html[data-theme="dark"] .about-hero-float-num {
    color: var(--text-primary);
  }

  html[data-theme="dark"] .vision-card {
    background: var(--card-bg);
    border-color: var(--card-border);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
  }

  html[data-theme="dark"] .values-section {
    background: var(--bg-primary);
  }

  html[data-theme="dark"] .value-card {
    background: var(--card-bg);
    border-color: var(--card-border);
  }

  html[data-theme="dark"] .audience-section {
    background: var(--bg-secondary);
  }

  html[data-theme="dark"] .industry-tag {
    background: var(--card-bg);
    border-color: var(--card-border);
  }

  /* ============ PRE-FOOTER CTA SECTION ============ */
  .cta-section {
    background: linear-gradient(180deg, #FFFFFF 0%, #F3F9EE 100%);
    padding: 1rem 2.5rem 5rem;
  }
  .cta-card {
    position: relative;
    overflow: hidden;
    max-width: 1280px; margin: 0 auto;
    background: linear-gradient(135deg, #0B3318 0%, #16612B 55%, #2A8A3C 100%);
    border-radius: 24px;
    padding: 3.5rem;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2.5rem;
  }
  .cta-glow {
    position: absolute; top: -55%; left: -15%;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(109, 192, 64, 0.45) 0%, rgba(109, 192, 64, 0) 70%);
    pointer-events: none;
  }
  .cta-content { position: relative; z-index: 1; }
  .cta-title {
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    font-weight: 800; line-height: 1.2; letter-spacing: -0.02em;
    color: #FFFFFF; margin: 0 0 1rem; max-width: 640px;
  }
  .cta-accent { color: #8FE07C; }
  .cta-lede {
    font-size: 1rem; line-height: 1.65; color: rgba(255, 255, 255, 0.8);
    max-width: 560px; margin: 0 0 2rem;
  }
  .cta-actions { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
  .cta-btn {
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.95rem 1.9rem;
    background: #FFFFFF; color: #145A27; font-weight: 800;
    font-size: 0.95rem; border-radius: 12px; text-decoration: none; white-space: nowrap;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }
  .cta-btn:hover { background: #F2FAEC; color: #0B3318; transform: translateY(-2px); box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3); }

  .cta-visual { position: relative; width: 220px; height: 220px; z-index: 1; }
  .cta-ring { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
  .cta-ring-c1, .cta-ring-c2, .cta-ring-c3 {
    position: absolute; border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.22);
    animation: ctaPulse 3s ease-out infinite;
  }
  .cta-ring-c1 { width: 220px; height: 220px; }
  .cta-ring-c2 { width: 150px; height: 150px; animation-delay: 0.6s; }
  .cta-ring-c3 { width: 90px; height: 90px; animation-delay: 1.2s; }
  .cta-ring-phone {
    width: 64px; height: 64px; border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #FFFFFF;
    display: flex; align-items: center; justify-content: center;
  }
  @keyframes ctaPulse {
    0% { transform: scale(0.85); opacity: 0; }
    40% { opacity: 1; }
    100% { transform: scale(1.15); opacity: 0; }
  }

  @media (max-width: 900px) {
    .cta-card { grid-template-columns: 1fr; text-align: center; }
    .cta-actions { justify-content: center; }
    .cta-visual { display: none; }
  }
  @media (max-width: 600px) {
    .cta-section { padding: 0.5rem 1.25rem 3rem; }
    .cta-card { padding: 2.5rem 1.5rem; }
    .cta-actions { flex-direction: column; }
    .cta-btn { width: 100%; justify-content: center; }
  }

  html[data-theme="dark"] .cta-section {
    background: linear-gradient(180deg, var(--bg-primary) 0%, #08170C 100%);
  }
  html[data-theme="dark"] .cta-btn:hover { background: #F2FAEC; }

</style>

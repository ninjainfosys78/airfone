---
import Base from '../layouts/Base.astro';
import Faq from '../components/site/Faq.astro';
import CtaBand from '../components/site/CtaBand.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { plans, addons, pricingFaq } from '../data/plans';
import { breadcrumbJsonLd, faqJsonLd } from '../lib/seo';
---
<Base title="Pricing: AI call agent and cloud phone system plans" description="AirFone pricing for the cloud phone system, the AI call agent that answers in Nepali, and the AI phone system. Priced for your call volume, quoted the same day." path="/pricing" jsonLd={[faqJsonLd(pricingFaq), breadcrumbJsonLd([{ name: 'Pricing', path: '/pricing' }])]}>
  <section class="top">
    <div class="wrap">
      <h1 data-enter>Plans priced for your calls</h1>
    </div>
  </section>

  <section class="plans-wrap">
    <div class="wrap">
      <ul class="plans">
        {plans.map((p, i) => (
          <li class:list={['plan', { featured: p.featured }]} data-enter style={`--d:${i + 1}`}>
            <h2>{p.name}</h2>
            <p class="pitch">{p.pitch}</p>
            {p.price && <p class="price"><span class="amount">{p.price}</span> <span class="per">{p.per}</span></p>}
            <a class:list={['btn', p.featured ? 'btn-lime' : 'btn-secondary']} href={p.cta.href}>{p.cta.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight" data-reveal>
    <div class="wrap two">
      <h2>Add to any plan</h2>
      <ul class="addons">
        {addons.map((a) => (
          <li><a href={a.href}><span class="a-name">{a.name}</span><ArrowRight class="go" size={20} stroke-width={2} aria-hidden="true" /></a></li>
        ))}
      </ul>
    </div>
  </section>

  <Faq items={pricingFaq} />
  <CtaBand />
</Base>

<style>
  .top { padding-block: var(--space-9) var(--space-7); }
  h1 { max-width: 14ch; }

  .plans-wrap { padding-bottom: var(--space-9); }
  .plans { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); align-items: stretch; }
  .plan {
    display: flex; flex-direction: column; gap: var(--space-5); min-height: 340px; padding: var(--space-7);
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1), border-color 200ms var(--ease);
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-panel);
  }
  .plan:hover { transform: translateY(-4px); border-color: var(--brand); }
  .plan h2 { font-size: 1rem; font-weight: 600; margin: 0; color: var(--link); }
  .pitch { margin: 0 0 auto; font-size: clamp(1.625rem, 1.3rem + 1vw, 2rem); font-weight: 600; line-height: 1.2; max-width: 14ch; }
  .featured h2 { color: var(--lime); }
  .price { margin: 0; padding-block: var(--space-4); border-block: 1px solid var(--line); }
  .amount { font-size: 2.25rem; font-weight: 600; }
  .per { font-size: 16px; color: var(--ink-muted); }
  .plan .btn { width: 100%; }

  /* The plan most businesses pick sits on the green stage. */
  .featured { background: var(--stage); border-color: var(--stage); color: var(--stage-ink); }
  .featured .per { color: var(--stage-muted); }
  .featured .price { border-color: var(--stage-line); }

  .two { display: grid; grid-template-columns: 1fr 1.4fr; gap: var(--space-8); align-items: start; }
  .addons { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  .addons a {
    display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'name go'; gap: var(--space-1) var(--space-4); align-items: center;
    padding: var(--space-5) 0; border-top: 1px solid var(--line); color: var(--ink); text-decoration: none;
  }
  .a-name { grid-area: name; font-size: 1.25rem; font-weight: 600; transition: color var(--fast) var(--ease); }
  .addons :global(.go) { grid-area: go; color: var(--link); transition: transform var(--fast) var(--ease); }
  .addons a:hover .a-name { color: var(--link); }
  .addons a:hover :global(.go) { transform: translateX(4px); }

  @media (prefers-reduced-motion: reduce) { .plan:hover { transform: none; } }
  @media (max-width: 959px) {
    .plans { grid-template-columns: 1fr; }
    .plan { min-height: 260px; }
    .two { grid-template-columns: 1fr; gap: var(--space-6); }
  }
</style>

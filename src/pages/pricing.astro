---
import Base from '../layouts/Base.astro';
import Faq from '../components/site/Faq.astro';
import CtaBand from '../components/site/CtaBand.astro';
import Related from '../components/site/Related.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { pricingFaq } from '../data/plans';
import { priceRows, offerPrice, rs, OFFER_OFF, addOnRates, oneTimeCharges } from '../data/prices';
import { products } from '../data/products';
import { solutions } from '../data/solutions';
import { breadcrumbJsonLd, faqJsonLd, pricedProductJsonLd } from '../lib/seo';

const off = Math.round(OFFER_OFF * 100);
const rows = priceRows.map((r) => ({ ...r, p: products.find((x) => x.slug === r.product)! }));
const offers = rows.map((r) => pricedProductJsonLd(r.p, r.tiers.filter((t) => t.mrp).map((t) => ({ name: t.name, mrp: t.mrp!, price: offerPrice(t.mrp!) }))));
---
<Base
  title="Pricing: AI call agent, phone system and website agent plans in Nepal"
  description={`AirFone plans in Nepali rupees per month: AI call agent, AI phone system, cloud PBX, website voice agent and chatbot, with pay-as-you-go add-ons and one-time setup charges.`}
  path="/pricing"
  jsonLd={[...offers, faqJsonLd(pricingFaq), breadcrumbJsonLd([{ name: 'Pricing', path: '/pricing' }])]}
>
  <section class="top">
    <div class="wrap">
      <h1 data-enter>{off ? `${off}% off every plan` : 'Pricing'}</h1>
      {off > 0 && <p class="promo" data-enter style="--d:1">Launch prices. {off}% off the listed price (MRP) on every monthly plan.</p>}
      <nav class="jump" aria-label="Products" data-enter style="--d:2">
        {rows.map((r) => <a href={`#plans-${r.p.slug}`}>{r.p.name}</a>)}
        <a href="#extras">Add-ons and setup</a>
      </nav>
    </div>
  </section>

  <section class="prices">
    <div class="wrap">
      {rows.map((r) => (
        <div class="product" id={`plans-${r.p.slug}`}>
          <div class="intro">
            <h2><a href={`/products/${r.p.slug}`}>{r.p.name}</a></h2>
            <p class="short">{r.p.short}</p>
            <p class="extra">{r.extra}</p>
            <a class="about" href={`/products/${r.p.slug}`}>How {r.p.name} works <ArrowRight size={16} stroke-width={2} aria-hidden="true" /></a>
          </div>
          <ul class="tiers">
            {r.tiers.map((t, ti) => (
              <li class:list={['tier', { featured: ti === 1 }]} style={`--i:${ti}`}>
                <div class="tier-top">
                  <span class="tname">{t.name}</span>
                  {ti === 1 && <span class="pick">Recommended</span>}
                </div>
                {t.mrp ? (
                  <div class="cost">
                    <span class="now"><span class="cur">Rs</span>{offerPrice(t.mrp).toLocaleString('en-IN')}{t.from && <span class="plus">+</span>}</span>
                    <span class="per">per month</span>
                    {off > 0 && <span class="was">MRP <s>{rs(t.mrp)}</s></span>}
                  </div>
                ) : (
                  <div class="cost">
                    <span class="now custom">Talk to sales</span>
                    <span class="per">priced on your call volume</span>
                  </div>
                )}
                <ul class="inc">
                  {t.includes.split(', ').map((x) => <li>{x}</li>)}
                </ul>
                <a class:list={['btn', ti === 1 ? 'btn-lime' : 'btn-secondary']} href={t.mrp ? '/demo' : '/contact'}>{t.mrp ? 'Get started' : 'Talk to sales'}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="charges" id="extras">
    <div class="wrap">
      <div class="charge-block">
        <h2>Add-ons, pay as you go</h2>
        <ul class="rates">
          {addOnRates.map((a) => (
            <li><span class="rn">{a.name}</span><span class="rp">{a.price} <span class="ru">{a.unit}</span></span></li>
          ))}
        </ul>
      </div>
      <div class="charge-block">
        <h2>One-time charges</h2>
        <ul class="rates">
          {oneTimeCharges.map((a) => (
            <li><span class="rn">{a.name}</span><span class="rp">{a.price} <span class="ru">{a.unit}</span></span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>


  <Faq items={pricingFaq} />
  <Related groups={[
    { h: 'Products', items: products.map((p) => ({ href: `/products/${p.slug}`, label: p.name })) },
    { h: 'Industries', items: solutions.map((x) => ({ href: `/solutions/${x.slug}`, label: x.name })) },
    { h: 'Next steps', items: [{ href: '/demo', label: 'Book a demo' }, { href: '/resellers', label: 'Become a reseller' }, { href: '/contact', label: 'Contact sales' }] },
  ]} />
  <CtaBand />
</Base>

<style>
  .top { padding-block: var(--space-9) 0; }
  h1 { max-width: 16ch; margin-bottom: var(--space-3); }
  .promo { margin: 0 0 var(--space-5); font-size: 17px; color: var(--ink-muted); }
  .jump { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); margin-top: var(--space-6); padding-bottom: var(--space-5); border-bottom: 1px solid var(--line); }
  .jump a { font-size: 16px; font-weight: 500; color: var(--ink-muted); text-decoration: none; transition: color var(--fast) var(--ease); }
  .jump a:hover { color: var(--link); }

  .prices { padding: 0 0 var(--space-9); }
  .product { display: grid; gap: var(--space-6) var(--space-8); padding: var(--space-8) 0; border-bottom: 1px solid var(--line); scroll-margin-top: var(--space-6); }
  .product:last-child { border-bottom: 0; }
  @media (min-width: 900px) { .product { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; } }

  .intro h2 { font-size: 1.625rem; margin-bottom: var(--space-3); }
  .intro h2 a { color: inherit; text-decoration: none; }
  .short { margin: 0 0 var(--space-4); font-size: 17px; line-height: 1.5; color: var(--ink-muted); max-width: 38ch; }
  .extra { margin: 0 0 var(--space-5); font-size: 14px; line-height: 1.5; color: var(--ink-muted); max-width: 44ch; }
  .about { display: inline-flex; align-items: center; gap: 6px; font-size: 15px; font-weight: 600; color: var(--link); text-decoration: none; }
  .about :global(svg) { transition: transform var(--fast) var(--ease); }
  .about:hover :global(svg) { transform: translateX(3px); }

  /* One card per plan; the recommended plan is the dark one. */
  .tiers { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .tier {
    display: flex; flex-direction: column; gap: var(--space-5); padding: var(--space-6);
    background: var(--canvas); border: 1px solid var(--line); border-radius: var(--radius-panel);
    animation: tier-in 400ms var(--ease) both; animation-delay: calc(var(--i) * 60ms);
  }
  @keyframes tier-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  .tier-top { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-3); }
  .tname { font-family: var(--font-display); font-size: 1.125rem; font-weight: 600; }
  .pick { font-size: 14px; font-weight: 600; color: var(--lime); }

  .cost { display: grid; gap: 6px; }
  .now { display: flex; align-items: flex-start; gap: 4px; font-family: var(--font-display); font-size: clamp(2rem, 1.7rem + 1vw, 2.5rem); font-weight: 600; line-height: 1.05; font-variant-numeric: tabular-nums; }
  .cur { font-size: 0.45em; margin-top: 0.3em; }
  .plus { font-size: 0.55em; margin-top: 0.15em; }
  .now.custom { font-size: 1.5rem; padding-block: 0.3rem; }
  .per, .was { font-size: 14px; color: var(--ink-muted); }

  .inc { list-style: none; margin: 0 0 auto; padding: var(--space-4) 0 0; border-top: 1px solid var(--line); display: grid; gap: var(--space-3); font-size: 15px; line-height: 1.45; }
  .tier .btn { width: 100%; }

  .featured { background: var(--stage); color: var(--stage-ink); border-color: var(--stage); }
  .featured .per, .featured .was { color: var(--stage-muted); }
  .featured .inc { border-color: var(--stage-line); }

  .charges { padding: var(--space-8) 0 var(--space-10); border-top: 1px solid var(--line); scroll-margin-top: var(--space-6); }
  .charges .wrap { display: grid; gap: var(--space-8) var(--space-9); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .charge-block h2 { font-size: 1.375rem; margin-bottom: var(--space-5); }
  .rates { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .rates li { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); padding: var(--space-4) 0; border-bottom: 1px solid var(--line); font-size: 16px; }
  .rp { font-weight: 600; font-variant-numeric: tabular-nums; text-align: right; }
  .ru { font-weight: 400; color: var(--ink-muted); font-size: 14px; }

  @media (prefers-reduced-motion: reduce) { .tier { animation: none; } }
  @media (max-width: 899px) {
    .charges .wrap { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .tiers { grid-template-columns: 1fr; }
    .tier { padding: var(--space-5); }
  }
</style>

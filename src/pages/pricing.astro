---
import Base from '../layouts/Base.astro';
import Faq from '../components/site/Faq.astro';
import CtaBand from '../components/site/CtaBand.astro';
import Related from '../components/site/Related.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { pricingFaq } from '../data/plans';
import { priceRows, offerPrice, rs, OFFER_OFF, addOnRates, oneTimeCharges } from '../data/prices';
import { products } from '../data/products';
import { solutions } from '../data/solutions';
import { breadcrumbJsonLd, faqJsonLd, pricedProductJsonLd } from '../lib/seo';

const off = Math.round(OFFER_OFF * 100);
const rows = priceRows.map((r) => ({ ...r, p: products.find((x) => x.slug === r.product)! }));
const offers = rows.map((r) => pricedProductJsonLd(r.p, r.tiers.filter((t) => t.mrp).map((t) => ({ name: t.name, mrp: t.mrp!, price: offerPrice(t.mrp!) }))));
---
<Base
  title="Pricing: AI call agent, phone system and website agent plans in Nepal"
  description={`AirFone plans in Nepali rupees per month: AI call agent, AI phone system, cloud PBX, website voice agent and chatbot, with pay-as-you-go add-ons and one-time setup charges.`}
  path="/pricing"
  jsonLd={[...offers, faqJsonLd(pricingFaq), breadcrumbJsonLd([{ name: 'Pricing', path: '/pricing' }])]}
>
  <section class="top">
    <div class="wrap">
      <h1 data-enter>{off ? `${off}% off every plan` : 'Pricing'}</h1>
      {off > 0 && <p class="promo" data-enter style="--d:1">Launch prices. {off}% off the listed price (MRP) on every monthly plan.</p>}
      <nav class="jump" aria-label="Products" data-enter style="--d:2">
        {rows.map((r) => <a href={`#plans-${r.p.slug}`}>{r.p.name}</a>)}
        <a href="#extras">Add-ons and setup</a>
      </nav>
    </div>
  </section>

  <section class="prices">
    <div class="wrap">
      <div class="table-scroll">
        <table class="plans">
          <caption class="sr-only">AirFone plans and what each includes, per month in Nepali rupees</caption>
          <thead>
            <tr>
              <th scope="col">Product</th>
              <th scope="col">Starter</th>
              <th scope="col" class="rec">Growth <span class="pick">Recommended</span></th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr id={`plans-${r.p.slug}`}>
                <th scope="row">
                  <a class="pname" href={`/products/${r.p.slug}`}>{r.p.name}</a>
                  <span class="extra">{r.extra}</span>
                </th>
                {r.tiers.map((t, ti) => (
                  <td class:list={{ rec: ti === 1 }}>
                    {t.mrp ? (
                      <span class="now"><span class="cur">Rs</span>{offerPrice(t.mrp).toLocaleString('en-IN')}<span class="per">/month</span></span>
                    ) : (
                      <a class="now custom" href="/contact">Talk to sales</a>
                    )}
                    {t.mrp && off > 0 && <span class="was">MRP <s>{rs(t.mrp)}</s></span>}
                    <ul class="inc">
                      {r.features.map((f) => <li>{f.values[ti]} {/^[A-Z][a-z]/.test(f.label) ? f.label[0].toLowerCase() + f.label.slice(1) : f.label}</li>)}
                    </ul>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="table-cta">
        <a class="btn btn-lime" href="/demo">Book a demo</a>
        <a class="btn btn-secondary" href="/contact">Talk to sales</a>
      </div>
    </div>
  </section>

  <section class="charges" id="extras">
    <div class="wrap">
      <div class="charge-block">
        <h2>Add-ons, pay as you go</h2>
        <ul class="rates">
          {addOnRates.map((a) => (
            <li><span class="rn">{a.name}</span><span class="rp">{a.price} <span class="ru">{a.unit}</span></span></li>
          ))}
        </ul>
      </div>
      <div class="charge-block">
        <h2>One-time charges</h2>
        <ul class="rates">
          {oneTimeCharges.map((a) => (
            <li><span class="rn">{a.name}</span><span class="rp">{a.price} <span class="ru">{a.unit}</span></span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>


  <Faq items={pricingFaq} />
  <Related groups={[
    { h: 'Products', items: products.map((p) => ({ href: `/products/${p.slug}`, label: p.name })) },
    { h: 'Industries', items: solutions.map((x) => ({ href: `/solutions/${x.slug}`, label: x.name })) },
    { h: 'Next steps', items: [{ href: '/demo', label: 'Book a demo' }, { href: '/resellers', label: 'Become a reseller' }, { href: '/contact', label: 'Contact sales' }] },
  ]} />
  <CtaBand />
</Base>

<style>
  .top { padding-block: var(--space-9) 0; }
  h1 { max-width: 16ch; margin-bottom: var(--space-3); }
  .promo { margin: 0 0 var(--space-5); font-size: 17px; color: var(--ink-muted); }
  .jump { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); margin-top: var(--space-6); padding-bottom: var(--space-5); border-bottom: 1px solid var(--line); }
  .jump a { font-size: 16px; font-weight: 500; color: var(--ink-muted); text-decoration: none; transition: color var(--fast) var(--ease); }
  .jump a:hover { color: var(--link); }

  .prices { padding: var(--space-6) 0 var(--space-8); }
  .table-scroll { overflow-x: auto; }
  .plans { width: 100%; min-width: 640px; border-collapse: collapse; }
  .plans th, .plans td { padding: var(--space-4); text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
  .plans thead th { font-family: var(--font-display); font-size: 1rem; font-weight: 600; border-bottom: 2px solid var(--ink); white-space: nowrap; }
  .plans thead th:first-child { width: 36%; }
  .plans tbody th { font-weight: 400; }
  .pname { display: block; font-family: var(--font-display); font-size: 1.125rem; font-weight: 600; color: var(--ink); text-decoration: none; }
  .pname:hover { color: var(--link); }
  .extra { display: block; margin-top: 4px; font-size: 14px; line-height: 1.45; color: var(--ink-muted); }
  .rec { background: var(--surface); }
  .pick { margin-left: var(--space-2); font-family: var(--font-sans); font-size: 14px; font-weight: 600; color: var(--brand); }
  .now { display: inline-flex; align-items: baseline; gap: 4px; font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .cur { font-size: 0.6em; }
  .per { font-family: var(--font-sans); font-size: 14px; font-weight: 400; color: var(--ink-muted); margin-left: 2px; }
  .now.custom { font-size: 1.0625rem; color: var(--link); text-decoration: none; }
  .was { display: block; margin-top: 2px; font-size: 14px; color: var(--ink-muted); }
  .inc { list-style: none; margin: var(--space-3) 0 0; padding: 0; display: grid; gap: 4px; font-size: 15px; line-height: 1.4; }
  .table-cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .charges { padding: var(--space-8) 0 var(--space-10); border-top: 1px solid var(--line); scroll-margin-top: var(--space-6); }
  .charges .wrap { display: grid; gap: var(--space-8) var(--space-9); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .charge-block h2 { font-size: 1.375rem; margin-bottom: var(--space-5); }
  .rates { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .rates li { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); padding: var(--space-4) 0; border-bottom: 1px solid var(--line); font-size: 16px; }
  .rp { font-weight: 600; font-variant-numeric: tabular-nums; text-align: right; }
  .ru { font-weight: 400; color: var(--ink-muted); font-size: 14px; }

  @media (max-width: 899px) {
    .charges .wrap { grid-template-columns: 1fr; }
  }
</style>

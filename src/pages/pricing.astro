---
import Base from '../layouts/Base.astro';
import { products } from '../data/products';
import { DEMO_NUMBER_DISPLAY, DEMO_NUMBER_TEL } from '../config/site';
---
<Base title="Pricing" description="AirFone plans are set for your call volume and team size. Book a demo and we send a price for your business the same day." path="/pricing" noindex>
  <section class="section">
    <div class="wrap two">
      <div>
        <h1>A monthly plan sized to your calls</h1>
        <div class="actions">
          <a class="btn btn-primary" href="/demo">Get a price</a>
          <a class="btn btn-secondary" href={DEMO_NUMBER_TEL}>Call {DEMO_NUMBER_DISPLAY}</a>
        </div>
      </div>
      <ul class="list">
        {products.map((p) => <li><a href={`/products/${p.slug}`}>{p.name}</a><span class="muted">Monthly plan</span></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .two { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-8); align-items: start; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
  .list { list-style: none; margin: 0; padding: 0; }
  .list li { display: flex; justify-content: space-between; gap: var(--space-4); padding: var(--space-4) 0; border-bottom: 1px solid var(--line); }
  .list a { font-weight: 500; }
  @media (max-width: 959px) { .two { grid-template-columns: 1fr; } }
</style>

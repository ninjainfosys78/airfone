---
import Base from '../layouts/Base.astro';
import Faq from '../components/site/Faq.astro';
import CtaBand from '../components/site/CtaBand.astro';
import Related from '../components/site/Related.astro';
import { pricingFaq } from '../data/plans';
import { priceRows, offerPrice, rs, OFFER_OFF } from '../data/prices';
import { products } from '../data/products';
import { solutions } from '../data/solutions';
import { breadcrumbJsonLd, faqJsonLd, pricedProductJsonLd } from '../lib/seo';

const off = Math.round(OFFER_OFF * 100);
const rows = priceRows.map((r) => ({ ...r, p: products.find((x) => x.slug === r.product)! }));
const offers = rows.map((r) => pricedProductJsonLd(r.p, r.tiers.filter((t) => t.mrp).map((t) => ({ name: t.name, mrp: t.mrp!, price: offerPrice(t.mrp!) }))));
---
<Base
  title="Pricing: AI call agent, phone system and website agent plans in Nepal"
  description={`AirFone plans in Nepali rupees per month: AI call agent, AI phone system, cloud PBX, website voice agent and chatbot. Now ${off}% off every plan.`}
  path="/pricing"
  jsonLd={[...offers, faqJsonLd(pricingFaq), breadcrumbJsonLd([{ name: 'Pricing', path: '/pricing' }])]}
>
  <section class="top">
    <div class="wrap">
      <h1 data-enter>{off ? `${off}% off every plan` : 'Pricing'}</h1>
    </div>
  </section>

  <section class="prices" data-prices>
    <div class="wrap">
      {rows.map((r, ri) => (
        <div class="row" data-enter style={`--d:${Math.min(ri + 1, 5)}`}>
          <div class="pname">
            <h2><a href={`/products/${r.p.slug}`}>{r.p.name}</a></h2>
            <p class="extra">{r.extra}</p>
          </div>
          <ul class="tiers">
            {r.tiers.map((t) => (
              <li class="tier">
                <span class="tname">{t.name}</span>
                {t.mrp ? (
                  <span class="cost">
                    {off > 0 && <span class="was"><s>{rs(t.mrp)}</s><span class="tag">{off}% off</span></span>}
                    <span class="now">{rs(offerPrice(t.mrp))}{t.from && <span class="plus">+</span>}</span>
                    <span class="per">per month</span>
                  </span>
                ) : (
                  <span class="cost"><span class="now custom">Custom</span><span class="per">priced on your volume</span></span>
                )}
                <span class="inc">{t.includes}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div class="actions">
        <a class="btn btn-primary" href="/demo">Book a demo</a>
        <a class="btn btn-secondary" href="/contact">Ask for a different mix</a>
      </div>
    </div>
  </section>

  <Faq items={pricingFaq} />
  <Related groups={[
    { h: 'Products', items: products.map((p) => ({ href: `/products/${p.slug}`, label: p.name })) },
    { h: 'Industries', items: solutions.map((x) => ({ href: `/solutions/${x.slug}`, label: x.name })) },
    { h: 'Next steps', items: [{ href: '/demo', label: 'Book a demo' }, { href: '/resellers', label: 'Become a reseller' }, { href: '/contact', label: 'Contact sales' }] },
  ]} />
  <CtaBand />
</Base>

<style>
  .top { padding-block: var(--space-9) var(--space-6); }
  h1 { max-width: 16ch; }

  .prices { padding-bottom: var(--space-9); }
  .row { display: grid; grid-template-columns: minmax(0, 260px) minmax(0, 1fr); gap: var(--space-7); padding: var(--space-7) 0; border-top: 1px solid var(--line); }
  .row:last-of-type { border-bottom: 1px solid var(--line); }
  .pname h2 { font-size: 1.375rem; margin: 0 0 var(--space-2); }
  .pname h2 a { color: var(--ink); text-decoration: none; }
  .pname h2 a:hover { color: var(--link); }
  .extra { margin: 0; font-size: 14px; line-height: 1.45; color: var(--ink-muted); }

  .tiers { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  .tier {
    display: grid; align-content: start; gap: var(--space-2); padding: var(--space-5);
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-panel);
    transition: border-color 200ms var(--ease), transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .tier:hover { border-color: var(--brand); transform: translateY(-3px); }
  .tname { font-size: 14px; font-weight: 600; color: var(--link); }
  .cost { display: grid; gap: 2px; }
  .was { display: flex; align-items: center; gap: var(--space-2); font-size: 14px; color: var(--ink-muted); }
  .tag { padding: 2px 8px; border-radius: 999px; background: var(--lime); color: var(--on-lime); font-size: 12px; font-weight: 600; }
  .now { font-family: var(--font-display); font-size: 1.75rem; font-weight: 600; line-height: 1.15; font-variant-numeric: tabular-nums; }
  .now.custom { font-size: 1.5rem; }
  .plus { font-size: 1.25rem; margin-left: 2px; }
  .per { font-size: 14px; color: var(--ink-muted); }
  .inc { margin-top: var(--space-2); padding-top: var(--space-3); border-top: 1px solid var(--line); font-size: 14px; line-height: 1.45; color: var(--ink); }

  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-7); }

  @media (prefers-reduced-motion: reduce) { .tier:hover { transform: none; } }
  @media (max-width: 1023px) { .row { grid-template-columns: 1fr; gap: var(--space-4); } }
  @media (max-width: 699px) { .tiers { grid-template-columns: 1fr; } }
</style>

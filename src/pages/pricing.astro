---
import Layout from '../layouts/Layout.astro';
import PricingBody from '../components/PricingBody.astro';
import Redirect from '../components/Redirect.astro';
import { TEASER } from '../config/site';
---
{TEASER ? <Redirect to="/" locale="ne" label="AirFone" /> : (
<Layout
  locale="ne"
  path="/pricing/"
  title="मूल्य | AirFone नेपाली AI कल सेन्टर"
  description="AirFone AI कल सेन्टरको मूल्य अझै सार्वजनिक गरिएको छैन। पसल, क्लिनिक, विद्यालय र अनलाइन स्टोरका लागि बनिँदैछ। सूचीमा नाम लेखाउनेले पहिले थाहा पाउनेछन्।"
>
  <PricingBody locale="ne" />
</Layout>
)}

---
import Base from '../layouts/Base.astro';
import Faq from '../components/site/Faq.astro';
import CtaBand from '../components/site/CtaBand.astro';
import Related from '../components/site/Related.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { pricingFaq } from '../data/plans';
import { priceRows, offerPrice, rs, OFFER_OFF } from '../data/prices';
import { products } from '../data/products';
import { solutions } from '../data/solutions';
import { breadcrumbJsonLd, faqJsonLd, pricedProductJsonLd } from '../lib/seo';

const off = Math.round(OFFER_OFF * 100);
const rows = priceRows.map((r) => ({ ...r, p: products.find((x) => x.slug === r.product)! }));
const offers = rows.map((r) => pricedProductJsonLd(r.p, r.tiers.filter((t) => t.mrp).map((t) => ({ name: t.name, mrp: t.mrp!, price: offerPrice(t.mrp!) }))));
---
<Base
  title="Pricing: AI call agent, phone system and website agent plans in Nepal"
  description={`AirFone plans in Nepali rupees per month: AI call agent, AI phone system, cloud PBX, website voice agent and chatbot. Now ${off}% off every plan.`}
  path="/pricing"
  jsonLd={[...offers, faqJsonLd(pricingFaq), breadcrumbJsonLd([{ name: 'Pricing', path: '/pricing' }])]}
>
  <section class="top">
    <div class="wrap">
      <h1 data-enter>{off ? `${off}% off every plan` : 'Pricing'}</h1>
      {off > 0 && <p class="promo" data-enter style="--d:1">Launch prices. {off}% off the listed price (MRP) on every monthly plan.</p>}

      <div class="switch" role="tablist" aria-label="Products" data-enter style="--d:2">
        <span class="pill" aria-hidden="true"></span>
        {rows.map((r, i) => (
          <button type="button" role="tab" id={`tab-${r.p.slug}`} aria-controls={`plans-${r.p.slug}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{r.p.name}</button>
        ))}
      </div>
    </div>
  </section>

  <section class="prices" data-prices>
    <div class="wrap">
      {rows.map((r, ri) => (
        <div class="panel" role="tabpanel" id={`plans-${r.p.slug}`} aria-labelledby={`tab-${r.p.slug}`} data-panel>
          <h2 class="panel-h">{r.p.name}</h2>
          <ul class="tiers">
            {r.tiers.map((t, ti) => (
              <li class:list={['tier', { featured: ti === 1 }]} style={`--i:${ti}`}>
                <div class="tier-top">
                  <span class="tname">{t.name}</span>
                  {ti === 1 && <span class="pick">Recommended</span>}
                </div>
                {t.mrp ? (
                  <div class="cost">
                    <span class="now"><span class="cur">Rs</span>{offerPrice(t.mrp).toLocaleString('en-IN')}{t.from && <span class="plus">+</span>}</span>
                    <span class="per">per month</span>
                    {off > 0 && <span class="was">MRP <s>{rs(t.mrp)}</s></span>}
                  </div>
                ) : (
                  <div class="cost">
                    <span class="now custom">Custom</span>
                    <span class="per">priced on your call volume</span>
                  </div>
                )}
                <p class="inc">{t.includes}</p>
                <a class:list={['btn', ti === 1 ? 'btn-lime' : 'btn-secondary']} href={t.mrp ? '/demo' : '/contact'}>{t.mrp ? 'Get started' : 'Talk to sales'}</a>
              </li>
            ))}
          </ul>
          <div class="foot">
            <p class="extra">{r.extra}</p>
            <a class="about" href={`/products/${r.p.slug}`}>How {r.p.name} works <ArrowRight size={16} stroke-width={2} aria-hidden="true" /></a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <script>
    // Product tabs. Without JavaScript every product's plans stay listed.
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.switch [role="tab"]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
    if (tabs.length) {
      document.documentElement.classList.add('tabs-on');
      const bar = document.querySelector<HTMLElement>('.switch')!;
      const pill = bar.querySelector<HTMLElement>('.pill')!;
      // The white pill slides to the chosen product.
      const place = (i: number) => {
        const t = tabs[i];
        pill.style.transform = `translateX(${t.offsetLeft}px)`;
        pill.style.width = `${t.offsetWidth}px`;
        t.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
      };
      const pick = (i: number, focus = false) => {
        tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
        panels.forEach((p, j) => { p.hidden = i !== j; });
        place(i);
        if (focus) tabs[i].focus();
        history.replaceState(null, '', `#${tabs[i].id.slice(4)}`);
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => pick(i));
        t.addEventListener('keydown', (e) => {
          const k = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (k) { e.preventDefault(); pick((i + k + tabs.length) % tabs.length, true); }
        });
      });
      const start = tabs.findIndex((t) => t.id === `tab-${location.hash.slice(1)}`);
      pick(start >= 0 ? start : 0);
      requestAnimationFrame(() => bar.classList.add('ready'));
      addEventListener('resize', () => place(tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true')), { passive: true });
    }
  </script>

  <Faq items={pricingFaq} />
  <Related groups={[
    { h: 'Products', items: products.map((p) => ({ href: `/products/${p.slug}`, label: p.name })) },
    { h: 'Industries', items: solutions.map((x) => ({ href: `/solutions/${x.slug}`, label: x.name })) },
    { h: 'Next steps', items: [{ href: '/demo', label: 'Book a demo' }, { href: '/resellers', label: 'Become a reseller' }, { href: '/contact', label: 'Contact sales' }] },
  ]} />
  <CtaBand />
</Base>

<style>
  .top { padding-block: var(--space-9) 0; }
  h1 { max-width: 16ch; margin-bottom: var(--space-3); }
  .promo { margin: 0 0 var(--space-7); font-size: 17px; color: var(--ink-muted); }

  /* Product tabs: plain text with an underline that slides to the chosen one. */
  .switch { position: relative; display: flex; gap: var(--space-6); max-width: 100%; overflow-x: auto; scrollbar-width: none; border-bottom: 1px solid var(--line); }
  .switch::-webkit-scrollbar { display: none; }
  .pill { position: absolute; left: 0; bottom: -1px; height: 2px; width: 0; background: var(--brand); pointer-events: none; }
  .switch.ready .pill { transition: transform 380ms cubic-bezier(0.22, 1, 0.36, 1), width 380ms cubic-bezier(0.22, 1, 0.36, 1); }
  .switch button {
    position: relative; flex: none; min-height: 52px; padding: 0; border: 0; background: none; cursor: pointer;
    color: var(--ink-muted); font-size: 16px; font-weight: 500; white-space: nowrap; transition: color 200ms var(--ease);
  }
  .switch button:hover, .switch button[aria-selected='true'] { color: var(--ink); }
  :global(html:not(.tabs-on)) .switch { display: none; }

  .prices { padding: var(--space-8) 0 var(--space-10); }
  .panel + .panel { margin-top: var(--space-9); }
  .panel-h { font-size: 1.375rem; margin-bottom: var(--space-5); }
  :global(html.tabs-on) .panel-h { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  :global(html.tabs-on) .panel + .panel { margin-top: 0; }

  /* Three plans side by side in one bordered strip, divided by hairlines. */
  .tiers { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--line); border-radius: var(--radius-panel); overflow: hidden; }
  .tier {
    display: flex; flex-direction: column; gap: var(--space-5); padding: var(--space-7) var(--space-6);
    background: var(--canvas); border-left: 1px solid var(--line);
    animation: tier-in 600ms cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: calc(var(--i) * 70ms);
  }
  .tier:first-child { border-left: 0; }
  @keyframes tier-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

  .tier-top { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-3); }
  .tname { font-family: var(--font-display); font-size: 1.125rem; font-weight: 600; }
  .pick { font-size: 13px; font-weight: 600; color: var(--lime); }

  .cost { display: grid; gap: 6px; }
  .now { display: flex; align-items: flex-start; gap: 4px; font-family: var(--font-display); font-size: clamp(2.25rem, 1.8rem + 1.2vw, 2.75rem); font-weight: 600; line-height: 1; font-variant-numeric: tabular-nums; }
  .cur { font-size: 0.45em; margin-top: 0.3em; }
  .plus { font-size: 0.55em; margin-top: 0.15em; }
  .now.custom { font-size: 2.25rem; }
  .per { font-size: 14px; color: var(--ink-muted); }
  .was { font-size: 14px; color: var(--ink-muted); }

  .inc { margin: 0 0 auto; padding-top: var(--space-5); border-top: 1px solid var(--line); font-size: 15px; line-height: 1.5; }
  .tier .btn { width: 100%; }

  /* The recommended plan is the dark column. */
  .featured { background: var(--stage); color: var(--stage-ink); border-left-color: var(--stage); }
  .featured + .tier { border-left-color: var(--stage); }
  .featured .per, .featured .was { color: var(--stage-muted); }
  .featured .inc { border-color: var(--stage-line); }

  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-3) var(--space-6); margin-top: var(--space-4); }
  .extra { margin: 0; font-size: 14px; color: var(--ink-muted); }
  .about { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; color: var(--link); text-decoration: none; }
  .about :global(svg) { transition: transform var(--fast) var(--ease); }
  .about:hover :global(svg) { transform: translateX(3px); }

  @media (prefers-reduced-motion: reduce) { .tier { animation: none; } }
  @media (max-width: 899px) {
    .tiers { grid-template-columns: 1fr; }
    .tier { border-left: 0; border-top: 1px solid var(--line); padding: var(--space-6) var(--space-5); }
    .tier:first-child { border-top: 0; }
    .featured + .tier { border-top-color: var(--stage); }
  }
</style>

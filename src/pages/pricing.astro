---
import Base from '../layouts/Base.astro';
import Faq from '../components/site/Faq.astro';
import CtaBand from '../components/site/CtaBand.astro';
import Check from '@lucide/astro/icons/check';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { plans, addons, pricingFaq } from '../data/plans';
import { faqJsonLd } from '../lib/seo';
---
<Base title="Pricing" description="AirFone plans for the phone system, the AI call agent and the full AI phone system, priced for your call volume. Get a quote the same working day." path="/pricing" noindex jsonLd={[faqJsonLd(pricingFaq)]}>
  <section class="top">
    <div class="wrap">
      <h1 data-enter>Plans that grow with your calls</h1>
    </div>
  </section>

  <section class="plans-wrap">
    <div class="wrap">
      <ul class="plans">
        {plans.map((p, i) => (
          <li class:list={['plan', { featured: p.featured }]} data-enter style={`--d:${i + 1}`}>
            <div class="plan-head">
              <h2>{p.name}</h2>
              <p class="for">{p.for}</p>
            </div>
            <p class="price">
              {p.price ? <><span class="amount">{p.price}</span> <span class="per">{p.per}</span></> : <span class="quote">Priced for your call volume</span>}
            </p>
            <a class:list={['btn', p.featured ? 'btn-lime' : 'btn-secondary']} href={p.cta.href}>{p.cta.label}</a>
            <div class="features">
              {p.builds && <p class="builds">Everything in {p.builds}, plus</p>}
              <ul>
                {p.features.map((f) => <li><Check class="tick" size={18} stroke-width={2.25} aria-hidden="true" /><span>{f}</span></li>)}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight" data-reveal>
    <div class="wrap two">
      <h2>Add to any plan</h2>
      <ul class="addons">
        {addons.map((a) => (
          <li><a href={a.href}><span class="a-name">{a.name}</span><span class="a-what">{a.what}</span><ArrowRight class="go" size={20} stroke-width={2} aria-hidden="true" /></a></li>
        ))}
      </ul>
    </div>
  </section>

  <Faq items={pricingFaq} />
  <CtaBand />
</Base>

<style>
  .top { padding-block: var(--space-9) var(--space-7); }
  h1 { max-width: 14ch; }

  .plans-wrap { padding-bottom: var(--space-9); }
  .plans { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); align-items: stretch; }
  .plan {
    display: flex; flex-direction: column; gap: var(--space-5); padding: var(--space-7) var(--space-6);
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-panel);
  }
  .plan h2 { font-size: 1.5rem; margin: 0; }
  .for { margin: var(--space-2) 0 0; font-size: 16px; color: var(--ink-muted); min-height: 3em; }
  .price { margin: 0; padding-block: var(--space-4); border-block: 1px solid var(--line); }
  .amount { font-size: 2.25rem; font-weight: 600; }
  .per { font-size: 16px; color: var(--ink-muted); }
  .quote { font-size: 1.125rem; font-weight: 600; }
  .plan .btn { width: 100%; }
  .builds { margin: 0 0 var(--space-3); font-size: 15px; font-weight: 600; }
  .features ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  .features li { display: flex; gap: var(--space-3); align-items: flex-start; font-size: 16px; line-height: 1.4; }
  .features :global(.tick) { flex: none; margin-top: 2px; color: var(--brand); }

  /* The plan most businesses pick sits on the green stage. */
  .featured { background: var(--stage); border-color: var(--stage); color: var(--stage-ink); }
  .featured .for, .featured .per { color: var(--stage-muted); }
  .featured .price { border-color: var(--stage-line); }
  .featured :global(.tick) { color: var(--lime); }

  .two { display: grid; grid-template-columns: 1fr 1.4fr; gap: var(--space-8); align-items: start; }
  .addons { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  .addons a {
    display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'name go' 'what go'; gap: var(--space-1) var(--space-4); align-items: center;
    padding: var(--space-5) 0; border-top: 1px solid var(--line); color: var(--ink); text-decoration: none;
  }
  .a-name { grid-area: name; font-size: 1.25rem; font-weight: 600; transition: color var(--fast) var(--ease); }
  .a-what { grid-area: what; font-size: 16px; color: var(--ink-muted); }
  .addons :global(.go) { grid-area: go; color: var(--link); transition: transform var(--fast) var(--ease); }
  .addons a:hover .a-name { color: var(--link); }
  .addons a:hover :global(.go) { transform: translateX(4px); }

  @media (max-width: 959px) {
    .plans { grid-template-columns: 1fr; }
    .for { min-height: 0; }
    .two { grid-template-columns: 1fr; gap: var(--space-6); }
  }
</style>

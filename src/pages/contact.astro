---
import Layout from '../layouts/Layout.astro';
import ContactBody from '../components/ContactBody.astro';
import Redirect from '../components/Redirect.astro';
import { TEASER } from '../config/site';
---
{TEASER ? <Redirect to="/" locale="ne" label="AirFone" /> : (
<Layout
  locale="ne"
  path="/contact/"
  title="सम्पर्क | AirFone"
  description="AirFone सँग सम्पर्क गर्नुहोस्। फोन ९८५८०४२४३३ वा इमेल info@airfone.app। नेपाली व्यवसायका लागि AI कल सेन्टरबारे प्रश्न सोध्नुहोस्।"
>
  <ContactBody locale="ne" />
</Layout>
)}

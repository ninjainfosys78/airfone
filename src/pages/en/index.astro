<script>
  function updateEnglishClock() {
    const clockEl = document.getElementById('live-clock-eng');
    const ampmEl = document.getElementById('live-clock-ampm');
    const periodEl = document.getElementById('live-clock-period');
    if (!clockEl) return;

    const now = new Date();
    const hours = now.getHours();
    const minutes = String(now.getMinutes()).padStart(2, '0');
    const seconds = String(now.getSeconds()).padStart(2, '0');
    const ampm = hours >= 12 ? 'PM' : 'AM';

    let period = 'in the morning';
    if (hours >= 12 && hours < 17) period = 'in the afternoon';
    else if (hours >= 17 && hours < 20) period = 'in the evening';
    else if (hours >= 20 || hours < 4) period = 'at night';

    const displayHours = String(hours % 12 || 12).padStart(2, '0');
    clockEl.textContent = `${displayHours}:${minutes}:${seconds}`;
    if (ampmEl) ampmEl.textContent = ampm;
    if (periodEl) periodEl.textContent = period;
  }

  updateEnglishClock();
  setInterval(updateEnglishClock, 1000);
  document.addEventListener('astro:page-load', updateEnglishClock);
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Clock, Bot, Radio, Brain, Plug2, PhoneCall, BarChart3, ShieldCheck, Zap, Globe,Headphone } from 'lucide-react';

const locale = 'en';
---

<BaseLayout title="SmartIVRAI — Home">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <div class="hero-text">
        <div class="hero-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hero-badge-icon">
             <path d="M12 2v20M17 5v14M22 10v4M7 5v14M2 10v4"/>
          </svg>
          Smart IVR & AI Cloud Voice Broadcasting Platform
        </div>
        <h1 class="hero-title">
          Turn every phone call into an <br />
          <span class="highlight-green">intelligent</span>, data-driven <br />
          interaction.
        </h1>
        <p class="hero-description">
          A cloud-native voice platform that combines telephony resilience with Natural Language Processing, Neural Text-to-Speech, and real-time sentiment analysis — managing high-volume inbound support and targeted outbound campaigns from one system.
        </p>
        <div class="hero-ctas">
          <a href="/en/demo/" class="btn btn-green">Request a Live Demo</a>
          <a href="/en/pricing/" class="btn btn-outline">See Pricing</a>
        </div>
      </div>

      <div class="hero-stats">
        <div class="hero-stat">
          <div class="hero-stat-num">0</div>
          <div class="hero-stat-label">Abandoned call rate at scale</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">60%</div>
          <div class="hero-stat-label">Of support volume automated</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">&lt;700ms</div>
          <div class="hero-stat-label">AI voice response latency</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">99.95%</div>
          <div class="hero-stat-label">Core uptime SLA</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Platform Capabilities Section -->
  <section class="capabilities-section">
    <div class="capabilities-inner">
      <div class="cap-header">
        <span class="cap-tag">Platform Capabilities</span>
        <h2 class="cap-title">Everything you need to run <span class="cap-highlight">intelligent voice</span> at scale</h2>
      </div>
      <div class="cap-grid">

        <div class="cap-card">
          <div class="cap-icon-wrap">
            <Clock size={28} class="cap-icon" />
          </div>
          <h3>Zero Wait Times</h3>
          <p>Every caller answered instantly by an AI voicebot or dynamic menu.</p>
        </div>

        <div class="cap-card">
          <div class="cap-icon-wrap">
            <Bot size={28} class="cap-icon" />
          </div>
          <h3>60% Automation</h3>
          <p>Resolve routine queries via Conversational AI and database integrations.</p>
        </div>

        <div class="cap-card">
          <div class="cap-icon-wrap">
            <Radio size={28} class="cap-icon" />
          </div>
          <h3>Outbound Reach</h3>
          <p>Hyper-personalized campaigns using Neural TTS at scale.</p>
        </div>

        <div class="cap-card">
          <div class="cap-icon-wrap">
            <Brain size={28} class="cap-icon" />
          </div>
          <h3>Sentiment Intelligence</h3>
          <p>Transcribe and score 100% of calls: positive, neutral, negative.</p>
        </div>

        <div class="cap-card">
          <div class="cap-icon-wrap">
            <Plug2 size={28} class="cap-icon" />
          </div>
          <h3>Interoperability</h3>
          <p>Native REST API &amp; webhook sync with CRM/ERP systems.</p>
        </div>

       

      </div>
    </div>
  </section>

  <!-- Platform Modules Section -->
  <section class="modules-section">
    <div class="modules-inner">
      <div class="modules-header">
        <span class="modules-eyebrow">PLATFORM MODULES</span>
        <h2 class="modules-title">Three engines, one control room.</h2>
        <p class="modules-subtitle">A full breakdown lives on the Features page.</p>
      </div>
      <div class="modules-grid">

        <div class="module-card">
          <div class="module-badge module-badge-a">A</div>
          <h3>Smart IVR System</h3>
          <p>Conversational voice AI, dynamic menus, predictive routing, self-service.</p>
        </div>

        <div class="module-card">
          <div class="module-badge module-badge-b">B</div>
          <h3>Voice Broadcasting</h3>
          <p>Mass campaigns, DTMF responses, predictive dialer, compliance filtering.</p>
        </div>

        <div class="module-card">
          <div class="module-badge module-badge-c">C</div>
          <h3>Analytics &amp; Supervision</h3>
          <p>Live wallboard, sentiment analysis, call recording, CRM integrations.</p>
        </div>

      </div>
      <div class="modules-cta-row">
        <a href="/en/platform/" class="modules-link">View Full Feature Breakdown &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Live Demo CTA Banner -->
  <section class="demo-cta-section">
    <div class="demo-cta-inner">
      <div class="demo-cta-text">
        <h2>Ready to see it on a live line?</h2>
        <p>Accept the proposal, initialize implementation, or book a live system demonstration.</p>
      </div>
      <div class="demo-cta-actions">
        <a href="/en/demo/" class="demo-cta-btn">Schedule a Live Demo</a>
        <a href="/en/pricing/" class="demo-cta-link">See Pricing</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero Section */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 0;
    position: relative;
    overflow: hidden;
    background: #FFFFFF;
  }

  .hero-content {
    max-width: 1280px;
    width: 100%;
    margin: 0 auto;
    padding: 8.5rem 2rem 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
    z-index: 1;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    border: 1px solid rgba(61, 181, 81, 0.25);
    background: rgba(61, 181, 81, 0.06);
    color: #2A8A3C;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 2rem;
  }

  .hero-badge-icon {
    color: #2A8A3C;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 1.5rem;
    letter-spacing: -0.02em;
    color: #1A1A1A;
  }

  .highlight-green {
    background: linear-gradient(135deg, #6DC040, #1B7A2F);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-description {
    font-size: 1.15rem;
    color: #4B5563;
    line-height: 1.6;
    margin-bottom: 2.5rem;
    max-width: 800px;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 5rem;
  }

  .btn {
    display: inline-block;
    padding: 0.85rem 1.5rem;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .btn-green {
    background: linear-gradient(135deg, #6DC040, #2A8A3C);
    color: #FFFFFF;
    box-shadow: 0 2px 12px rgba(61, 181, 81, 0.3);
  }

  .btn-green:hover {
    background: linear-gradient(135deg, #3DB551, #1B7A2F);
    color: #FFFFFF;
    box-shadow: 0 6px 20px rgba(61, 181, 81, 0.45);
    transform: translateY(-1px);
  }

  .btn-outline {
    background: transparent;
    color: #1A1A1A;
    border: 1px solid #D1D5DB;
  }

  .btn-outline:hover {
    border-color: #1A1A1A;
    background: rgba(0,0,0,0.02);
  }

  .hero-stats {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid #C8E6C9;
  }

  .hero-stat {
    padding: 2rem 1.5rem 2rem 0;
    border-right: 1px solid #C8E6C9;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 180px;
  }

  .hero-stat:last-child {
    border-right: none;
    padding-right: 0;
  }

  .hero-stat:not(:first-child) {
    padding-left: 1.5rem;
  }

  .hero-stat-num {
    font-size: 1.75rem;
    font-weight: 800;
    background: linear-gradient(135deg, #6DC040, #1B7A2F);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-stat-label {
    font-size: 0.85rem;
    color: #6B7280;
    font-weight: 500;
  }

  /* Divider */
  .divider {
    height: 1px;
    background: #F0F0F0;
    margin: 0;
  }

  .capabilities-section {
    background: #FFFFFF;
    padding: 5rem 0 5.5rem;
    position: relative;
    overflow: hidden;
  }

  .capabilities-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 40% at 20% 50%, rgba(61, 181, 81, 0.07) 0%, transparent 70%),
      radial-gradient(ellipse 50% 40% at 80% 50%, rgba(109, 192, 64, 0.05) 0%, transparent 70%);
    pointer-events: none;
  }

  .capabilities-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 1;
  }

  .cap-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .cap-tag {
    display: inline-block;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    border: 1px solid rgba(61, 181, 81, 0.25);
    background: rgba(61, 181, 81, 0.06);
    color: #2A8A3C;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .cap-title {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 900;
    color: #1A1A1A;
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .cap-highlight {
    background: linear-gradient(135deg, #6DC040, #1B7A2F);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .cap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .cap-card {
    background: #FFFFFF;
    border: 1px solid #E8F5E9;
    border-radius: 16px;
    padding: 2.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(61, 181, 81, 0.06);
  }

  .cap-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(109, 192, 64, 0.06) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .cap-card:hover {
    border-color: #C8E6C9;
    transform: translateY(-6px);
    box-shadow: 0 12px 32px rgba(61, 181, 81, 0.15), 0 0 0 1px rgba(61, 181, 81, 0.12);
  }

  .cap-card:hover::before {
    opacity: 1;
  }

  .cap-icon-wrap {
    width: 62px;
    height: 62px;
    border-radius: 16px;
    background: rgba(61, 181, 81, 0.08);
    border: 1px solid rgba(61, 181, 81, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .cap-card:hover .cap-icon-wrap {
    background: rgba(61, 181, 81, 0.14);
    border-color: rgba(61, 181, 81, 0.4);
    transform: scale(1.08);
  }

  .cap-icon {
    color: #3DB551;
    display: block;
  }

  .cap-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1A1A1A;
    margin: 0 0 0.65rem;
    line-height: 1.3;
  }

  .cap-card p {
    font-size: 0.875rem;
    color: #6B7280;
    margin: 0;
    line-height: 1.65;
  }

  /* Responsive for capabilities */
  @media (max-width: 768px) {
    .capabilities-section { padding: 3rem 0 3.5rem; }
    .cap-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
    .cap-card { padding: 1.75rem 1.25rem; }
    .cap-title { font-size: 1.6rem; }
  }

  @media (max-width: 480px) {
    .cap-grid { grid-template-columns: 1fr; }
  }

  /* About Section */
  .about-section {
    padding: 5rem 0;
    background-color: #F4FAF5 !important;
  }

  html[data-theme="dark"] .about-section {
    background-color: #F4FAF5 !important;
  }

  .section-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .about-text h2 {
    font-size: 3rem;
    font-weight: 900;
    margin: 0 0 1.5rem;
    color: #1A1A1A;
  }

  html[data-theme="dark"] .about-text h2 {
    color: #FFFFFF;
  }

  .about-text p {
    font-size: 1.1rem;
    color: #666666;
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  html[data-theme="dark"] .about-text p {
    color: #CCCCCC;
  }

  .about-stats {
     display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  width: 100%;
  }

  .stat {
   display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;

  width: 100%;
  height: 220px;

  padding: 2rem;
  box-sizing: border-box;

  background: #fff;
  border-radius: 20px;
  box-shadow: 0 4px 15px rgba(0,0,0,.08);
 transition:
    transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  overflow: hidden;
  }

  html[data-theme="dark"] .stat {
    background: rgba(255, 255, 255, 0.05);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  }
  html[data-theme="dark"] .stat {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.35);
}

  .stat:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
  }

  html[data-theme="dark"] .stat:hover {
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
  }

  .stat-num {
     font-size: 2.6rem;
  font-weight: 900;
  background: linear-gradient(135deg, #6DC040, #1B7A2F);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1;
  margin-bottom: 0.75rem;
  white-space: nowrap;
  }

  .stat-label {
    font-size: 1rem;
    color: #1A1A1A;
    margin-top: 0;
    font-weight: 600;
  }

  html[data-theme="dark"] .stat-label {
    color: #FFFFFF;
  }

  /* Services Section */
  .services-section {
    padding: 5rem 0;
    background-color: #FFFFFF !important;
  }

  html[data-theme="dark"] .services-section {
    background-color: #0F1419 !important;
  }

  .section-header {
    max-width: 1280px;
    margin: 0 auto 2.5rem;
    padding: 0 2rem;
  }

  .section-header h2 {
    font-size: 3rem;
    font-weight: 900;
    margin: 0 0 0.5rem;
    color: #1A1A1A;
  }

  html[data-theme="dark"] .section-header h2 {
    color: #FFFFFF;
  }

  .section-header p {
    font-size: 1.2rem;
    color: #3DB551;
  }

  .services-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
  }

  .service-item {
    padding: 2.5rem 2rem;
    border: 1px solid #F0F0F0;
    border-radius: 12px;
    background: #FFFFFF;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  html[data-theme="dark"] .service-item {
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .service-item:hover {
    border-color: #E0E0E0;
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  }

  html[data-theme="dark"] .service-item:hover {
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
  }

  .service-number {
    font-size: 2.5rem;
    font-weight: 900;
    background: linear-gradient(135deg, #6DC040, #2A8A3C);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    opacity: 0.9;
    margin-bottom: 1rem;
  }

  .service-item h3 {
    font-size: 1.3rem;
    font-weight: 700;
    margin: 0 0 1rem;
    color: #1A1A1A;
  }

  html[data-theme="dark"] .service-item h3 {
    color: #FFFFFF;
  }

  .service-item p {
    font-size: 0.95rem;
    color: #666666;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  html[data-theme="dark"] .service-item p {
    color: #CCCCCC;
  }

  .service-link {
    color: #3DB551;
    font-weight: 700;
    text-decoration: none;
    display: inline-block;
    transition: all 0.3s ease;
  }

  .service-link:hover {
    color: #2A8A3C;
    transform: translateX(4px);
  }

  /* Features Section */
  .features-section {
    padding: 6rem 0;
  }

  .feature-block {
    max-width: 1280px;
    margin: 0 auto 6rem;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .feature-block.reverse {
    direction: rtl;
  }

  .feature-block.reverse .feature-text {
    direction: ltr;
  }

  .feature-text h2 {
    font-size: 2.5rem;
    font-weight: 900;
    margin: 0 0 1.5rem;
    color: #FFFFFF;
  }

  .feature-text p {
    font-size: 1.1rem;
    color: rgba(232, 233, 235, 0.8);
    line-height: 1.8;
  }

  /* CTA Section */
  .cta-section {
    padding: 8rem 2rem;
    text-align: center;
    background: linear-gradient(135deg, rgba(26, 58, 26, 0.1) 0%, rgba(26, 58, 26, 0.05) 100%);
    border-top: 1px solid rgba(26, 58, 26, 0.2);
    border-bottom: 1px solid rgba(26, 58, 26, 0.2);
  }

  .cta-section h2 {
    font-size: 3rem;
    font-weight: 900;
    margin: 0 0 0.5rem;
    color: #FFFFFF;
  }

  .cta-section p {
    font-size: 1.2rem;
    color: #1A3A1A;
    margin-bottom: 2.5rem;
  }

  /* Direct Citizens Access Section */
  .section-container-full {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .direct-access-section {
    padding: 5rem 0;
    background: #F3F0F8;
  }

  html[data-theme="dark"] .direct-access-section {
    background: #1A2332;
  }

  /* Heading with red underline accent */
  .das-heading {
    font-size: 2.6rem;
    font-weight: 900;
    color: #1A1A1A;
    text-align: center;
    margin: 0 auto 1rem;
    position: relative;
    display: inline-block;
    width: 100%;
  }

  html[data-theme="dark"] .das-heading {
    color: #FFFFFF;
  }

  .das-heading::after {
    content: '';
    display: block;
    width: 4rem;
    height: 4px;
    background: linear-gradient(90deg, #6DC040, #2A8A3C);
    border-radius: 2px;
    margin: 0.6rem auto 0;
  }

  .das-subtitle {
    font-size: 1rem;
    color: #555555;
    text-align: center;
    max-width: 640px;
    margin: 0 auto 3rem;
    line-height: 1.7;
  }

  html[data-theme="dark"] .das-subtitle {
    color: #CCCCCC;
  }

  .access-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.75rem;
  }

  .access-card {
    padding: 2rem 1.75rem;
    background: #FFFFFF;
    border-radius: 16px;
    transition: all 0.28s ease;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.07);
    display: flex;
    flex-direction: column;
  }

  html[data-theme="dark"] .access-card {
    background: rgba(255, 255, 255, 0.05);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
  }

  .access-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.12);
  }

  html[data-theme="dark"] .access-card:hover {
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.4);
  }

  .access-icon {
    width: 56px;
    height: 56px;
    background: #E2E5F5;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.4rem;
    flex-shrink: 0;
  }

  html[data-theme="dark"] .access-icon {
    background: rgba(61, 61, 143, 0.15);
  }

  .access-card h3 {
    font-size: 1.05rem;

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Phone, Building2, Bot, Rocket } from 'lucide-react';

const locale = 'en';

// Client/partner logos for the trust carousel.
const trustedLogos = [
  { name: 'Client logo', src: '/images/emblem.png' },
  { name: 'Client logo', src: '/images/logo-partner.png' },
  { name: 'Client logo', src: '/images/logo-baijanath-rural-municipality.png' },
];

// Repeat the logo set so one lap is always wider than the carousel viewport —
// otherwise, with only a few logos, the track runs out before it can loop and the scroll visibly stalls/resets.
const carouselLogos = Array.from({ length: 4 }, () => trustedLogos).flat();
---

<BaseLayout title="Airfone — Home">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="hero-text">
        <h1 class="hero-title reveal">
          The AI Voice Platform <br />
          for Every <span class="highlight-green">Customer Call</span>
        </h1>
        <div class="hero-ctas reveal">
          <a href="https://sip.mylunago.com/" class="btn btn-green" data-astro-reload>Get Started</a>
          <a href="/en/pricing/" class="btn btn-outline">See Pricing</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trusted By / Logo Carousel Section -->
  <section class="logo-carousel-section">
    <div class="logo-carousel-inner">
      <div class="logo-carousel-track-wrap">
        <div class="logo-carousel-track">
          {carouselLogos.map((logo) => (
            <div class="logo-item">
              {logo.src ? (
                <img src={logo.src} alt={logo.name} loading="lazy" />
              ) : (
                <span class="logo-placeholder">{logo.name}</span>
              )}
            </div>
          ))}
          {carouselLogos.map((logo) => (
            <div class="logo-item" aria-hidden="true">
              {logo.src ? (
                <img src={logo.src} alt="" loading="lazy" />
              ) : (
                <span class="logo-placeholder">{logo.name}</span>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Get Started Section -->
  <section class="get-started-section">
    <div class="get-started-inner">
      <div class="get-started-header reveal">
        <h2 class="get-started-title">Three steps to a live AI agent.</h2>
      </div>

      <div class="get-started-steps">
        <!-- Step 01 — card above the line -->
        <div class="step-card step-col-1 reveal">
          <div class="step-heading">
            <Building2 size={18} class="step-icon" />
            <h3 class="step-title">Enter Your Business Details</h3>
          </div>
          <p class="step-description">Tell us about your business, including industry, use case, and expected call volume, so your agent is configured to fit from the start.</p>
        </div>
        <div class="step-node step-col-1 reveal"><span class="step-dot"></span></div>
        <span class="step-index step-col-1 reveal">01</span>

        <!-- Step 02 — card below the line -->
        <span class="step-index step-col-2 step-invert reveal">02</span>
        <div class="step-node step-col-2 reveal"><span class="step-dot"></span></div>
        <div class="step-card step-col-2 step-invert reveal">
          <div class="step-heading">
            <Bot size={18} class="step-icon" />
            <h3 class="step-title">Choose Your Agent</h3>
          </div>
          <p class="step-description">Pick a ready-made AI voice agent or customize one to match your exact workflow.</p>
        </div>

        <!-- Step 03 — card above the line -->
        <div class="step-card step-col-3 reveal">
          <div class="step-heading">
            <Rocket size={18} class="step-icon" />
            <h3 class="step-title">Deploy Your Agent</h3>
          </div>
          <p class="step-description">Go live in minutes. Your agent starts handling calls immediately, no engineering required.</p>
        </div>
        <div class="step-node step-col-3 reveal"><span class="step-dot"></span></div>
        <span class="step-index step-col-3 reveal">03</span>
      </div>
    </div>
  </section>

  <!-- Live Demo CTA -->
  <section class="cta-section reveal">
    <div class="cta-card">
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="cta-content">
        <h2 class="cta-title">See Airfone answer a real call.</h2>
        <p class="cta-lede">Watch a live AI agent handle a real conversation in real time — no setup, no waiting.</p>
        <div class="cta-actions">
          <a href="/en/pricing/" class="cta-link">See Pricing</a>
        </div>
      </div>

      <div class="cta-visual">
        <div class="cta-ring">
          <div class="cta-ring-c1"></div>
          <div class="cta-ring-c2"></div>
          <div class="cta-ring-c3"></div>
          <div class="cta-ring-phone"><Phone size={40} /></div>
        </div>
        <span class="cta-visual-label">Hear a Live Call</span>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero Section ─────────────────────────────────────────────────────
     Palantir-inspired: sharp corners, hairline borders, tight-tracked
     bold type, an adjoined two-button "toolbar" CTA group. */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 0;
    position: relative;
    overflow: clip;
    background: transparent;
  }

  /* Hero background: brand gradient artwork with a soft green ambient glow on top,
     over a transparent base so the hero blends into the page's own backdrop. */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 55% at 50% 62%, rgba(61, 181, 81, 0.16), transparent 65%),
      radial-gradient(ellipse 50% 40% at 14% 12%, rgba(16, 115, 58, 0.14), transparent 60%),
      url('/images/airfone_hero_bg_scylla_style_gradient.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .hero-content {
    max-width: 1280px;
    width: 100%;
    margin: 0 auto;
    padding: 8.5rem 2rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 2.75rem;
    letter-spacing: -0.03em;
    color: #EAF6EC;
  }

  .highlight-green {
    background: linear-gradient(135deg, #6DC040, #1B7A2F);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-ctas {
    display: inline-flex;
    border: 1px solid rgba(234, 246, 236, 0.3);
    margin: 0 auto 6rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.05rem 2.25rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.25s ease, color 0.25s ease;
    border: none;
    border-radius: 0;
    cursor: pointer;
    white-space: nowrap;
  }

  .btn-green { background: #3DB551; color: #06170B; }
  .btn-green:hover { background: #6DC040; }

  .btn-outline {
    background: transparent;
    color: #EAF6EC;
    border-left: 1px solid rgba(234, 246, 236, 0.3);
  }

  .btn-outline:hover { background: rgba(234, 246, 236, 0.08); }

  /* ── Trusted By / Logo Carousel Section ──────────────────────────────── */
  .logo-carousel-section {
    position: relative;
    padding: 3rem 0;
    background: transparent;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    overflow: hidden;
  }

  .logo-carousel-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .logo-carousel-track-wrap {
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .logo-carousel-track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: 4rem;
    animation: logo-scroll 22s linear infinite;
  }

  .logo-carousel-track-wrap:hover .logo-carousel-track { animation-play-state: paused; }

  .logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 104px;
  }

  .logo-item img {
    height: 100%;
    width: auto;
    max-width: 240px;
    object-fit: contain;
  }

  .logo-placeholder {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    white-space: nowrap;
    transition: color 0.25s ease;
  }

  .logo-item:hover .logo-placeholder { color: var(--text-primary); }

  @keyframes logo-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-carousel-track {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .logo-carousel-track {
      gap: 2.5rem;
      animation-duration: 16s;
    }
    .logo-item {
      height: 68px;
    }
    .logo-placeholder {
      font-size: 0.9rem;
    }
  }

  /* ── Get Started Section ───────────────────────────────────────────────
     Technical, engineered feel: a faint blueprint grid behind sharp-edged,
     a horizontal timeline: a single line running left to right, with a dot
     at each step, cards alternating above/below it, and the step number
     sitting on the opposite side of the line from its card. */
  .get-started-section {
    padding: 7rem 1.5rem;
    background: var(--bg-primary);
  }

  .get-started-inner { max-width: 1100px; margin: 0 auto; }

  .get-started-header { text-align: left; margin-bottom: 4.5rem; }

  .get-started-title {
    font-size: clamp(2.2rem, 4vw, 3.25rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.15;
    letter-spacing: -0.03em;
    max-width: 800px;
  }

  .get-started-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto auto auto;
    column-gap: 2.5rem;
    align-items: center;
  }

  .step-col-1 { grid-column: 1; }
  .step-col-2 { grid-column: 2; }
  .step-col-3 { grid-column: 3; }

  .step-card { grid-row: 1; align-self: end; margin-bottom: 1.5rem; }
  .step-node { grid-row: 2; }
  .step-index { grid-row: 3; align-self: start; margin-top: 1.5rem; }

  .step-invert.step-card { grid-row: 3; align-self: start; margin-bottom: 0; margin-top: 1.5rem; }
  .step-invert.step-index { grid-row: 1; align-self: end; margin-top: 0; margin-bottom: 1.5rem; }

  .step-node {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
  }

  .step-node::before {
    content: '';
    position: absolute;
    left: -1.25rem;
    right: -1.25rem;
    top: 50%;
    height: 1px;
    background: var(--border-color);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .step-node.is-visible::before { transform: scaleX(1); }

  .step-dot {
    position: relative;
    z-index: 1;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #3DB551;
    box-shadow: 0 0 0 5px var(--bg-primary);
    transform: scale(0);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 0.5s;
  }

  .step-node.is-visible .step-dot { transform: scale(1); }

  :global([data-theme='dark']) .step-dot { background: #4ADE80; }

  .step-index {
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--text-primary);
    text-align: center;
    letter-spacing: -0.01em;
  }

  .step-card {
    background: var(--bg-secondary);
    border-radius: 16px;
    padding: 1.75rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .step-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px -16px rgba(42, 138, 60, 0.35);
  }

  :global([data-theme='dark']) .step-card:hover { box-shadow: 0 16px 32px -16px rgba(0, 0, 0, 0.5); }

  .step-heading {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
  }

  .step-icon { color: #3DB551; flex-shrink: 0; }

  :global([data-theme='dark']) .step-icon { color: #4ADE80; }

  .step-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .step-description {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Pre-footer CTA Section ───────────────────────────────────────────── */
  .cta-section {
    background: linear-gradient(180deg, #FFFFFF 0%, #F3F9EE 100%);
    padding: 1rem 2.5rem 5rem;
  }

  .cta-card {
    position: relative;
    overflow: hidden;
    max-width: 1280px;
    margin: 0 auto;
    background: linear-gradient(135deg, #0B3318 0%, #16612B 55%, #2A8A3C 100%);
    border-radius: 24px;
    padding: 3.5rem;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2.5rem;
  }

  .cta-glow {
    position: absolute;
    top: -55%;
    left: -15%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(109, 192, 64, 0.45) 0%, rgba(109, 192, 64, 0) 70%);
    pointer-events: none;
  }

  .cta-content { position: relative; z-index: 1; }

  .cta-title {
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    margin: 0 0 1rem;
    max-width: 640px;
  }

  .cta-accent { color: #8FE07C; }

  .cta-lede {
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.8);
    max-width: 560px;
    margin: 0 0 2rem;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .cta-link {
    color: rgba(255, 255, 255, 0.9);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    border-bottom: none;
    transition: color 0.2s ease;
  }

  .cta-link:hover { color: #8FE07C; }

  .cta-visual {
    position: relative;
    width: 220px;
    height: 220px;
    z-index: 1;
  }

  .cta-visual-label {
    position: absolute;
    bottom: -1.75rem;
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.85);
  }

  .cta-ring {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cta-ring-c1, .cta-ring-c2, .cta-ring-c3 {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.22);
    animation: ctaPulse 3s ease-out infinite;
  }

  .cta-ring-c1 { width: 220px; height: 220px; }
  .cta-ring-c2 { width: 150px; height: 150px; animation-delay: 0.6s; }
  .cta-ring-c3 { width: 90px; height: 90px; animation-delay: 1.2s; }

  .cta-ring-phone {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @keyframes ctaPulse {
    0% { transform: scale(0.85); opacity: 0; }
    40% { opacity: 1; }
    100% { transform: scale(1.15); opacity: 0; }
  }

  @media (max-width: 900px) {
    .cta-card { grid-template-columns: 1fr; text-align: center; }
    .cta-actions { justify-content: center; }
    .cta-visual { display: none; }
  }

  @media (max-width: 600px) {
    .cta-section { padding: 0.5rem 1.25rem 3rem; }
    .cta-card { padding: 2.5rem 1.5rem; }
    .cta-actions { flex-direction: column; }
  }

  html[data-theme="dark"] .cta-section {
    background: linear-gradient(180deg, var(--bg-primary) 0%, #08170C 100%);
  }

  /* ── Responsive ─────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .hero {
      min-height: 70vh;
      align-items: center;
    }
    .hero-content {
      padding-top: 6rem;
      padding-bottom: 2rem;
    }
    .hero-title { font-size: clamp(2.2rem, 6vw, 3.2rem); }
  }

  @media (max-width: 768px) {
    .hero { min-height: auto; align-items: flex-start; }
    .hero-content {
      padding-top: 9rem;
      padding-bottom: 3rem;
    }
    .hero-title { font-size: clamp(1.8rem, 8vw, 2.6rem); }
    .hero-ctas { flex-direction: column; align-items: stretch; width: 100%; }
    .btn { width: 100%; text-align: center; }
    .btn-outline { border-left: none; border-top: 1px solid rgba(234, 246, 236, 0.3); }
    /* Collapse the horizontal timeline to a simple vertical stack */
    .get-started-steps { grid-template-columns: 1fr; row-gap: 1.5rem; }
    .step-col-1, .step-col-2, .step-col-3 { grid-column: 1; }
    .step-card, .step-index, .step-invert.step-card, .step-invert.step-index {
      grid-row: auto;
      align-self: auto;
      margin: 0;
    }
    .step-node { display: none; }
    .step-index { font-size: 1.5rem; text-align: left; margin-bottom: 0.35rem; }

    /* Normalize reading order to "number, then card" for every step,
       regardless of which side of the (now-hidden) line they sat on. */
    .step-col-1.step-index { order: 1; }
    .step-col-1.step-card { order: 2; }
    .step-col-2.step-index { order: 3; }
    .step-col-2.step-card { order: 4; }
    .step-col-3.step-index { order: 5; }
    .step-col-3.step-card { order: 6; }
  }

  @media (max-width: 480px) {
    .hero-content {
      padding-top: 7.5rem;
      padding-bottom: 2.5rem;
    }
    .hero-title { font-size: clamp(1.4rem, 6vw, 1.8rem); }
  }
</style>

<script>
  function updateEnglishClock() {
    const clockEl = document.getElementById('live-clock-eng');
    const ampmEl = document.getElementById('live-clock-ampm');
    const periodEl = document.getElementById('live-clock-period');
    if (!clockEl) return;

    const now = new Date();
    const hours = now.getHours();
    const minutes = String(now.getMinutes()).padStart(2, '0');
    const seconds = String(now.getSeconds()).padStart(2, '0');
    const ampm = hours >= 12 ? 'PM' : 'AM';

    let period = 'in the morning';
    if (hours >= 12 && hours < 17) period = 'in the afternoon';
    else if (hours >= 17 && hours < 20) period = 'in the evening';
    else if (hours >= 20 || hours < 4) period = 'at night';

    const displayHours = String(hours % 12 || 12).padStart(2, '0');
    clockEl.textContent = `${displayHours}:${minutes}:${seconds}`;
    if (ampmEl) ampmEl.textContent = ampm;
    if (periodEl) periodEl.textContent = period;
  }

  updateEnglishClock();
  setInterval(updateEnglishClock, 1000);
  document.addEventListener('astro:page-load', updateEnglishClock);
</script>

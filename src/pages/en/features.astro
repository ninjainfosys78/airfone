---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  Waves, Workflow, Route, Database, PhoneForwarded, Voicemail,
  Radio, Phone, RefreshCw, AudioWaveform, BellOff,
  LayoutDashboard, Brain, Mic2, Plug2, Tags, Check, ArrowRight
} from 'lucide-react';
const locale = 'en';
---
<BaseLayout title="Features — AirFone" solidNav={true}>

  <!-- ============ HERO + TABS ============ -->
  <section class="page-hero">
    <div class="page-hero-bg" aria-hidden="true"></div>
    <div class="page-hero-inner">
      <div class="page-hero-text">
        <h1 class="page-hero-title">
          Every capability, organized by how<br />
          you'll <span class="page-hero-highlight">actually use it.</span>
        </h1>
        <p class="page-hero-lede">
          Three modules covering inbound service, outbound campaigns, and the analytics layer that ties them together.
        </p>
        <div class="page-hero-chips">
          <span class="page-hero-chip"><Check size={14} /> Sub-700ms responses</span>
          <span class="page-hero-chip"><Check size={14} /> Natural-language NLP</span>
          <span class="page-hero-chip"><Check size={14} /> 99.95% core uptime</span>
        </div>
      </div>

      <div class="page-hero-visual" aria-hidden="true">
        <div class="page-hero-ring">
          <div class="page-hero-ring-circle page-hero-ring-c1"></div>
          <div class="page-hero-ring-circle page-hero-ring-c2"></div>
          <div class="page-hero-ring-circle page-hero-ring-c3"></div>
          <div class="page-hero-ring-phone"><Radio size={42} /></div>
        </div>
        <div class="page-hero-float-card">
          <div class="page-hero-float-icon"><Brain size={18} /></div>
          <div>
            <div class="page-hero-float-num">3</div>
            <div class="page-hero-float-label">Modules in one platform</div>
          </div>
        </div>
      </div>
    </div>

    <div class="section-container page-hero-tabs">
      <div class="tabs-nav">
        <button class="tab-btn active" data-tab="tab-a">Module A · Smart IVR</button>
        <button class="tab-btn" data-tab="tab-b">Module B · Broadcasting</button>
        <button class="tab-btn" data-tab="tab-c">Module C · Analytics</button>
      </div>
    </div>
  </section>

  <!-- ============ MODULE A ============ -->
  <section class="module-panel active" id="tab-a">
    <div class="section-container">
      <div class="module-head">
        <span class="module-badge badge-a">Module A</span>
        <h2>Smart IVR System</h2>
      </div>
      <p class="module-sub">Conversational reception, dynamic menus, and self-service — all in natural language.</p>

      <div class="feat-grid">
        <div class="feat-card">
          <div class="feat-icon icon-a"><Waves size={20} /></div>
          <h3>Conversational Voice AI &amp; NLP</h3>
          <p>Understands natural speech, preserves context across multi-turn dialogue, sub-700ms responses.</p>
        </div>
        <div class="feat-card">
          <div class="feat-icon icon-a"><Workflow size={20} /></div>
          <h3>Multi-Layer Dynamic Menu</h3>
          <p>Drag-and-drop flow builder, time-based routing, custom Neural TTS greetings.</p>
        </div>
        <div class="feat-card">
          <div class="feat-icon icon-a"><Route size={20} /></div>
          <h3>Predictive &amp; Skill Routing</h3>
          <p>Skill-tag matching, VIP priority queueing, Round-Robin / Least Recent / Ring-All algorithms.</p>
        </div>
        <div class="feat-card">
          <div class="feat-icon icon-a"><Database size={20} /></div>
          <h3>AI Self-Service &amp; DB Query</h3>
          <p>Real-time account lookups, OTP authentication, zero-agent resolution for routine actions.</p>
        </div>
        <div class="feat-card">
          <div class="feat-icon icon-a"><PhoneForwarded size={20} /></div>
          <h3>Warm/Cold Transfer &amp; Conferencing</h3>
          <p>Screen-pop warm transfers, blind transfer, 3-way manager conferencing.</p>
        </div>
        <div class="feat-card">
          <div class="feat-icon icon-a"><Voicemail size={20} /></div>
          <h3>Voicemail-to-Text &amp; Off-Hours</h3>
          <p>Automated transcription delivered by email/SMS, callback scheduling instead of hold music.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MODULE B ============ -->
  <section class="module-panel" id="tab-b">
    <div class="section-container">
      <div class="module-head">
        <span class="module-badge badge-b">Module B</span>
        <h2>AI Voice Broadcasting &amp; Smart Campaigns</h2>
      </div>
      <p class="module-sub">Outbound reach at scale, with compliance built in from the first dial.</p>

      <div class="feat-grid">
        <div class="feat-card">
          <div class="feat-icon icon-b"><Radio size={20} /></div>
          <h3>Mass Voice &amp; AI Audio Campaigns</h3>
          <p>Reach tens of thousands of contacts; type a script and generate broadcast-ready audio instantly.</p>
        </div>
        <div class="feat-card">
          <div class="feat-icon icon-b"><Phone size={20} /></div>
          <h3>Interactive DTMF &amp; Voice Response</h3>
          <p>Keypad or spoken replies, with instant "Press-1" live agent escalation.</p>
        </div>
        <div class="feat-card">
          <div class="feat-icon icon-b"><RefreshCw size={20} /></div>
          <h3>Predictive Dialer &amp; Auto-Retry</h3>
          <p>Dynamic pacing algorithms, configurable retry rules, answering machine detection.</p>
        </div>
        <div class="feat-card">
          <div class="feat-icon icon-b"><AudioWaveform size={20} /></div>
          <h3>Dynamic AI Text-to-Speech</h3>
          <p>Variable injection for personalization, native Nepali/English/Hindi voice models.</p>
        </div>
        <div class="feat-card">
          <div class="feat-icon icon-b"><BellOff size={20} /></div>
          <h3>DND &amp; Compliance Filtering</h3>
          <p>Automated DND scrubbing against regulatory lists, one-keypress opt-out.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MODULE C ============ -->
  <section class="module-panel" id="tab-c">
    <div class="section-container">
      <div class="module-head">
        <span class="module-badge badge-c">Module C</span>
        <h2>AI Analytics, Supervision &amp; Integrations</h2>
      </div>
      <p class="module-sub">Everything a supervisor and a CRM both need, in real time.</p>

      <div class="feat-grid">
        <div class="feat-card">
          <div class="feat-icon icon-c"><LayoutDashboard size={20} /></div>
          <h3>Live Supervision Dashboard</h3>
          <p>Wallboard metrics, plus Whisper, Barge-In, and Takeover controls for supervisors.</p>
        </div>
        <div class="feat-card">
          <div class="feat-icon icon-c"><Brain size={20} /></div>
          <h3>Sentiment &amp; Intent Detection</h3>
          <p>Grades every call Positive / Neutral / Negative and flags escalation triggers automatically.</p>
        </div>
        <div class="feat-card">
          <div class="feat-icon icon-c"><Mic2 size={20} /></div>
          <h3>Dual-Channel Recording</h3>
          <p>Separate customer/agent channels, fully searchable transcripts for compliance audits.</p>
        </div>
        <div class="feat-card">
          <div class="feat-icon icon-c"><Plug2 size={20} /></div>
          <h3>REST API &amp; Webhook Gateway</h3>
          <p>Pre-built connectors for Salesforce, HubSpot, Zoho, plus bi-directional event webhooks.</p>
        </div>
        <div class="feat-card">
          <div class="feat-icon icon-c"><Tags size={20} /></div>
          <h3>Automated Summaries &amp; Tagging</h3>
          <p>AI-written call summaries and automatic disposition tagging by topic.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ARCHITECTURE STRIP ============ -->
  <section class="mini-arch-section">
    <div class="section-container">
      <span class="section-eyebrow">Under the Hood</span>
      <h2 class="mini-arch-title">Four architecture layers.</h2>
      <p class="module-sub">Cloud-native, microservices-based, built for sub-second audio latency.</p>

      <div class="mini-arch-grid">
        <div class="mini-arch-card">
          <h4>01 · Telephony &amp; Edge</h4>
          <p>SBCs and WebRTC gateways connect to NTC, Ncell, and international carriers.</p>
        </div>
        <div class="mini-arch-card">
          <h4>02 · AI Orchestration</h4>
          <p>Coordinates STT, NLU, and Neural TTS for sub-700ms responses.</p>
        </div>
        <div class="mini-arch-card">
          <h4>03 · Application &amp; DB</h4>
          <p>Multi-tenant cluster for business logic and live monitoring.</p>
        </div>
        <div class="mini-arch-card">
          <h4>04 · Integration Gateway</h4>
          <p>REST API and webhook middleware to CRMs, ERPs, and custom databases.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="cta-section">
    <div class="cta-card">
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="cta-content">
        <h2 class="cta-title">See these modules on a <span class="cta-accent">real line.</span></h2>
        <p class="cta-lede">
          We'll walk through inbound and outbound flows over an actual call — not a slide deck.
        </p>
        <div class="cta-actions">
          <a href={`/${locale}/contact/`} class="cta-btn">
            Schedule a Live Demo
            <ArrowRight size={18} />
          </a>
        </div>
      </div>

      <div class="cta-visual" aria-hidden="true">
        <div class="cta-ring">
          <div class="cta-ring-c1"></div>
          <div class="cta-ring-c2"></div>
          <div class="cta-ring-c3"></div>
          <div class="cta-ring-phone"><Phone size={40} /></div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  function initFeaturesTabs() {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.module-panel');

    function activateTab(tabId: string) {
      tabBtns.forEach(btn => {
        const isTarget = btn.getAttribute('data-tab') === tabId;
        btn.classList.toggle('active', isTarget);
      });
      panels.forEach(panel => {
        const isTarget = panel.getAttribute('id') === tabId;
        panel.classList.toggle('active', isTarget);
      });
    }

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const tabId = btn.getAttribute('data-tab');
        if (tabId) {
          activateTab(tabId);
        }
      });
    });

    const hash = window.location.hash.replace('#', '');
    if (hash && document.getElementById(hash)) {
      activateTab(hash);
    }
  }

  initFeaturesTabs();
  document.addEventListener('astro:page-load', initFeaturesTabs);
</script>

<style>
  /* ============ SHARED ============ */
  .section-container { max-width: 1280px; margin: 0 auto; padding: 0 2rem; }
  .section-eyebrow {
    display: block; font-family: monospace; font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--primary-dark); margin-bottom: 1rem;
  }
  .module-sub { font-size: 0.98rem; color: var(--text-secondary); line-height: 1.6; margin: 0 0 2.5rem; max-width: 640px; }

  /* ============ HERO + TABS ============ */
  .tabs-nav { display: flex; gap: 0.75rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.5rem; }
  .tab-btn {
    background: var(--bg-secondary); border: 1px solid var(--border-color); cursor: pointer;
    padding: 0.65rem 1.3rem;
    font-size: 0.9rem; font-weight: 700; color: var(--text-secondary);
    border-radius: 9999px; white-space: nowrap;
    transition: all 0.2s ease;
  }
  .tab-btn.active {
    background: linear-gradient(135deg, #6DC040, #2A8A3C); border-color: transparent;
    color: #FFFFFF;
    box-shadow: 0 3px 12px rgba(61, 181, 81, 0.35);
  }
  .tab-btn:hover:not(.active) {
    color: var(--primary-dark); border-color: rgba(61, 181, 81, 0.4);
    background: rgba(61, 181, 81, 0.06);
  }

  /* ============ MODULE PANELS ============ */
  .module-panel { display: none; background: var(--bg-secondary); padding: 3.5rem 0; }
  .module-panel.active { display: block; }

  .module-head { display: flex; align-items: center; gap: 0.9rem; margin-bottom: 0.6rem; }
  .module-head h2 { font-size: 1.5rem; font-weight: 800; color: var(--text-primary); margin: 0; }

  .module-badge {
    font-family: monospace; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em;
    padding: 0.3rem 0.7rem; border-radius: 6px; color: #FFFFFF;
  }
  .badge-a { background: linear-gradient(135deg, #6DC040, #2A8A3C); }
  .badge-b { background: linear-gradient(135deg, #6DC040, #2A8A3C); }
  .badge-c { background: linear-gradient(135deg, #3DB551, #1B5E20); }

  .feat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }

  .feat-card {
    background: #FFFFFF; border: 1px solid var(--border-color); border-radius: 14px;
    padding: 1.75rem; transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .feat-card:hover { transform: translateY(-4px); box-shadow: 0 10px 24px rgba(61, 181, 81, 0.12); }

  .feat-icon {
    width: 42px; height: 42px; border-radius: 10px; display: flex; align-items: center; justify-content: center;
    margin-bottom: 1rem;
  }
  .icon-a { background: rgba(61, 181, 81, 0.1); color: var(--primary-dark); }
  .icon-b { background: rgba(61, 181, 81, 0.1); color: var(--primary-dark); }
  .icon-c { background: rgba(61, 181, 81, 0.1); color: var(--primary-dark); }

  .feat-card h3 { font-size: 1rem; font-weight: 700; color: var(--text-primary); margin: 0 0 0.5rem; }
  .feat-card p { font-size: 0.85rem; color: var(--text-secondary); line-height: 1.6; margin: 0; }

  /* ============ ARCHITECTURE STRIP ============ */
  .mini-arch-section { background: #FFFFFF; padding: 4.5rem 0; }
  .mini-arch-title { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 800; color: var(--text-primary); margin: 0 0 0.75rem; }
  .mini-arch-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
  .mini-arch-card { background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 14px; padding: 1.5rem; }
  .mini-arch-card h4 { font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin: 0 0 0.5rem; }
  .mini-arch-card p { font-size: 0.85rem; color: var(--text-secondary); line-height: 1.6; margin: 0; }

  /* ============ PRE-FOOTER CTA SECTION ============ */
  .cta-section {
    background: linear-gradient(180deg, #FFFFFF 0%, #F3F9EE 100%);
    padding: 1rem 2.5rem 5rem;
  }
  .cta-card {
    position: relative;
    overflow: hidden;
    max-width: 1280px; margin: 0 auto;
    background: linear-gradient(135deg, #0B3318 0%, #16612B 55%, #2A8A3C 100%);
    border-radius: 24px;
    padding: 3.5rem;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2.5rem;
  }
  .cta-glow {
    position: absolute; top: -55%; left: -15%;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(109, 192, 64, 0.45) 0%, rgba(109, 192, 64, 0) 70%);
    pointer-events: none;
  }
  .cta-content { position: relative; z-index: 1; }
  .cta-title {
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    font-weight: 800; line-height: 1.2; letter-spacing: -0.02em;
    color: #FFFFFF; margin: 0 0 1rem; max-width: 640px;
  }
  .cta-accent { color: #8FE07C; }
  .cta-lede {
    font-size: 1rem; line-height: 1.65; color: rgba(255, 255, 255, 0.8);
    max-width: 560px; margin: 0 0 2rem;
  }
  .cta-actions { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
  .cta-btn {
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.95rem 1.9rem;
    background: #FFFFFF; color: #145A27; font-weight: 800;
    font-size: 0.95rem; border-radius: 12px; text-decoration: none; white-space: nowrap;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }
  .cta-btn:hover { background: #F2FAEC; color: #0B3318; transform: translateY(-2px); box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3); }

  .cta-visual { position: relative; width: 220px; height: 220px; z-index: 1; }
  .cta-ring { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
  .cta-ring-c1, .cta-ring-c2, .cta-ring-c3 {
    position: absolute; border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.22);
    animation: ctaPulse 3s ease-out infinite;
  }
  .cta-ring-c1 { width: 220px; height: 220px; }
  .cta-ring-c2 { width: 150px; height: 150px; animation-delay: 0.6s; }
  .cta-ring-c3 { width: 90px; height: 90px; animation-delay: 1.2s; }
  .cta-ring-phone {
    width: 64px; height: 64px; border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #FFFFFF;
    display: flex; align-items: center; justify-content: center;
  }
  @keyframes ctaPulse {
    0% { transform: scale(0.85); opacity: 0; }
    40% { opacity: 1; }
    100% { transform: scale(1.15); opacity: 0; }
  }

  @media (max-width: 900px) {
    .feat-grid { grid-template-columns: repeat(2, 1fr); }
    .mini-arch-grid { grid-template-columns: repeat(2, 1fr); }
    .tabs-nav { gap: 1.25rem; overflow-x: auto; }
    .cta-card { grid-template-columns: 1fr; text-align: center; }
    .cta-actions { justify-content: center; }
    .cta-visual { display: none; }
  }
  @media (max-width: 600px) {
    .feat-grid { grid-template-columns: 1fr; }
    .mini-arch-grid { grid-template-columns: 1fr; }
    .cta-section { padding: 0.5rem 1.25rem 3rem; }
    .cta-card { padding: 2.5rem 1.5rem; }
    .cta-actions { flex-direction: column; }
    .cta-btn { width: 100%; justify-content: center; }
  }

  /* Dark mode — deep/medium green sections */
  html[data-theme="dark"] .feat-card {
    background: var(--card-bg);
    border-color: var(--card-border);
  }

  html[data-theme="dark"] .feat-card:hover {
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.4);
  }

  html[data-theme="dark"] .icon-b {
    color: #6DC040;
  }

  html[data-theme="dark"] .mini-arch-section {
    background: var(--bg-primary);
  }

  html[data-theme="dark"] .mini-arch-card {
    background: var(--card-bg);
    border-color: var(--card-border);
  }

  html[data-theme="dark"] .cta-section {
    background: linear-gradient(180deg, var(--bg-primary) 0%, #08170C 100%);
  }

  html[data-theme="dark"] .cta-btn:hover {
    background: #F2FAEC;
  }
</style>
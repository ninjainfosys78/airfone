---
import BaseLayout from '../../layouts/BaseLayout.astro';
const locale = 'en';
import { ShieldCheck, Lock, Globe2, BarChart3 } from 'lucide-react';
---

<BaseLayout title="About Us — AirFone" solidNav={true}>

  <!-- ============ ABOUT INTRO ============ -->
  <section class="about-hero">
    <div class="about-hero-inner">
      <h1 class="about-hero-title">
        We believe a phone call is still the<br />
        most human channel a business has.
      </h1>
      <p class="about-hero-lede">
        We just think it should finally sound like it's listening. AirFone was built to
        replace rigid, button-based menus with a conversational AI layer that understands
        intent, remembers context, and never puts a caller on hold.
      </p>
    </div>
  </section>

  <!-- ============ VISION + STATS ============ -->
  <section class="vision-section">
    <div class="vision-inner">
      <div class="vision-text">
        <span class="vision-tag">Our Vision</span>
        <h2 class="vision-title">Redefining business voice communication.</h2>
        <p>
          To convert every phone call into an intelligent, data-driven interaction —
          deploying AI agents alongside human teams so no customer is ever left waiting,
          and no conversation goes unmeasured.
        </p>
        <p>
          Traditional PBX and IVR systems have reached their operational limits: robotic
          recordings, rigid trees, and no memory between transfers. We built the platform
          we wished existed — one engineered for telecom-grade reliability with an
          AI layer that actually understands the caller.
        </p>
      </div>

      <div class="vision-card">
        <div class="vision-stat">
          <div class="vision-stat-num">2024</div>
          <div class="vision-stat-label">Founded in Kathmandu</div>
        </div>
        <div class="vision-stat">
          <div class="vision-stat-num">3</div>
          <div class="vision-stat-label">Languages natively supported</div>
        </div>
        <div class="vision-stat">
          <div class="vision-stat-num">1,000+</div>
          <div class="vision-stat-label">Concurrent call channels at scale</div>
        </div>
        <div class="vision-stat">
          <div class="vision-stat-num">99.95%</div>
          <div class="vision-stat-label">Guaranteed core uptime</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ VALUES ============ -->
  <section class="values-section">
    <div class="section-container">
      <span class="section-eyebrow">What We Stand For</span>
      <h2 class="section-title">Four values behind every architectural decision.</h2>

      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon"><ShieldCheck size={20} /></div>
          <h3>Reliability First</h3>
          <p>Multi-region redundant clusters and SBCs so the line never drops mid-conversation.</p>
        </div>
        <div class="value-card">
          <div class="value-icon"><Lock size={20} /></div>
          <h3>Security &amp; Compliance</h3>
          <p>AES-256 at rest, TLS 1.3/SRTP in transit, on-premises options for regulated industries.</p>
        </div>
        <div class="value-card">
          <div class="value-icon"><Globe2 size={20} /></div>
          <h3>Local, Not Localized</h3>
          <p>Nepali, Hindi, and English voice models built for the region, not bolted on.</p>
        </div>
        <div class="value-card">
          <div class="value-icon"><BarChart3 size={20} /></div>
          <h3>Radical Transparency</h3>
          <p>Every call transcribed, scored, and synced — nothing about a conversation is a black box.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WHO WE WORK WITH ============ -->
  <section class="audience-section">
    <div class="section-container">
      <span class="section-eyebrow">Who We Work With</span>
      <h2 class="section-title light">Built for teams that live on the phone.</h2>
      <p class="audience-lede">
        Customer support desks, sales &amp; collections teams, and operations units running
        high call volumes across banking, telecom, retail, and government services.
      </p>

      <div class="industry-tags">
        <span class="industry-tag">Banking &amp; NBFC</span>
        <span class="industry-tag">Telecom</span>
        <span class="industry-tag">Government &amp; Public Service</span>
        <span class="industry-tag">Retail &amp; E-commerce</span>
        <span class="industry-tag">Insurance</span>
        <span class="industry-tag">Logistics</span>
      </div>
    </div>
  </section>

  <!-- ============ TEAM CTA ============ -->
  <section class="team-cta-section">
    <div class="team-cta-inner">
      <div class="team-cta-text">
        <h2>Want to meet the team behind the platform?</h2>
        <p>We're happy to walk you through the architecture live.</p>
      </div>
      <a href={`/${locale}/contact/`} class="team-cta-btn">Get in Touch</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* ============ ABOUT INTRO ============ */
  .about-hero {
    background: #FFFFFF;
    padding: 11rem 0 4rem;
  }

  .about-hero-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .about-badge {
    display: inline-block;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    border: 1px solid rgba(61, 181, 81, 0.25);
    background: rgba(61, 181, 81, 0.06);
    color: var(--primary-dark);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .about-hero-title {
    font-size: clamp(2rem, 4.2vw, 2.9rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }

  .about-hero-lede {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 720px;
    margin: 0;
  }

  /* ============ VISION + STATS ============ */
  .vision-section {
    background: var(--bg-secondary);
    padding: 5rem 0;
  }

  .vision-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .vision-tag {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--primary-dark);
    margin-bottom: 1rem;
  }

  .vision-title {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
    line-height: 1.25;
  }

  .vision-text p {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.75;
    margin: 0 0 1.25rem;
  }

  .vision-card {
    background: #FFFFFF;
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    box-shadow: 0 8px 30px rgba(61, 181, 81, 0.08);
  }

  .vision-stat-num {
    font-size: 1.9rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--primary-gradient-start), var(--primary-gradient-end));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .vision-stat-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .vision-inner { grid-template-columns: 1fr; }
    .vision-card { grid-template-columns: 1fr 1fr; }
    .about-hero-inner, .vision-inner { padding-left: 1.5rem; padding-right: 1.5rem; }
  }

  @media (max-width: 600px) {
    .about-hero { padding: 9rem 0 3rem; }
    .vision-section { padding: 3rem 0; }
    .about-hero-inner, .vision-inner { padding-left: 1rem; padding-right: 1rem; }
    .vision-card { grid-template-columns: 1fr; padding: 2rem; }
  }

  /* shared container — reuse everywhere so left/right edges always line up */
  .section-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* fix: was 900px — now matches every other section on this page */
  .about-hero-inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .section-eyebrow {
    display: block;
    font-family: monospace;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--primary-dark);
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: clamp(1.6rem, 3.2vw, 2.2rem);
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0 0 2.5rem;
    max-width: 640px;
  }

  .section-title.light { color: var(--text-primary); }

  /* ============ VALUES ============ */
  .values-section {
    background: #FFFFFF;
    padding: 5rem 0;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .value-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 1.75rem;
  }

  .value-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(61, 181, 81, 0.1);
    border: 1px solid rgba(61, 181, 81, 0.25);
    color: var(--primary-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.1rem;
  }

  .value-card h3 {
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.6rem;
  }

  .value-card p {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* ============ WHO WE WORK WITH ============ */
  .audience-section {
    background: #F4FAF5;
    padding: 5rem 0;
  }

  .audience-lede {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 640px;
    margin: 0 0 2.25rem;
  }

  .industry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .industry-tag {
    font-family: monospace;
    font-size: 0.85rem;
    color: var(--primary-dark);
    background: #FFFFFF;
    border: 1px solid var(--border-color);
    border-radius: 9999px;
    padding: 0.55rem 1.1rem;
  }

  @media (max-width: 900px) {
    .values-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .values-grid { grid-template-columns: 1fr; }
    .values-section, .audience-section { padding: 3rem 0; }
  }

/* ============ TEAM CTA ============ */
  .team-cta-section {
    background: linear-gradient(180deg, #E4F5D4 0%, #F2FAE6 55%, #F8FCF2 100%);
    padding: 4rem 2rem 5rem;
  }

  .team-cta-inner {
    max-width: 1280px;
    margin: 0 auto;
    background: #FFFFFF;
    border: 1px solid rgba(61, 181, 81, 0.25);
    border-radius: 16px;
    padding: 2.5rem 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    box-shadow: 0 8px 24px rgba(61, 181, 81, 0.15);
  }

  .team-cta-text h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1A3A1A;
    margin: 0 0 0.4rem;
  }

  .team-cta-text p {
    font-size: 0.9rem;
    color: rgba(26, 58, 26, 0.7);
    margin: 0;
  }

  .team-cta-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.8rem 1.6rem;
    background: linear-gradient(135deg, #6DC040, #2A8A3C);
    color: #FFFFFF;
    font-weight: 700;
    font-size: 0.9rem;
    border-radius: 10px;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 3px 12px rgba(61, 181, 81, 0.35);
    transition: all 0.2s ease;
  }

  .team-cta-btn:hover {
    background: linear-gradient(135deg, #3DB551, #1B7A2F);
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(61, 181, 81, 0.5);
  }

  @media (max-width: 768px) {
    .team-cta-inner {
      flex-direction: column;
      align-items: flex-start;
      padding: 2rem 1.5rem;
    }
    .team-cta-btn { width: 100%; text-align: center; justify-content: center; }
    .team-cta-section { padding: 3rem 1rem 3rem; }
  }

  /* Dark mode — deep/medium green sections */
  html[data-theme="dark"] .about-hero {
    background: var(--bg-primary);
  }

  html[data-theme="dark"] .vision-card {
    background: var(--card-bg);
    border-color: var(--card-border);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
  }

  html[data-theme="dark"] .values-section {
    background: var(--bg-primary);
  }

  html[data-theme="dark"] .value-card {
    background: var(--card-bg);
    border-color: var(--card-border);
  }

  html[data-theme="dark"] .audience-section {
    background: var(--bg-secondary);
  }

  html[data-theme="dark"] .industry-tag {
    background: var(--card-bg);
    border-color: var(--card-border);
  }

  html[data-theme="dark"] .team-cta-section {
    background: linear-gradient(180deg, #0A2410 0%, #0C2B14 55%, #0F2E1A 100%);
  }

  html[data-theme="dark"] .team-cta-inner {
    background: var(--card-bg);
    border-color: rgba(109, 192, 64, 0.3);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  html[data-theme="dark"] .team-cta-text h2 {
    color: var(--text-primary);
  }

  html[data-theme="dark"] .team-cta-text p {
    color: var(--text-secondary);
  }

</style>

---
import Layout from '../../layouts/Layout.astro';
import ContactBody from '../../components/ContactBody.astro';
import Redirect from '../../components/Redirect.astro';
import { TEASER } from '../../config/site';
---
{TEASER ? <Redirect to="/en/" locale="en" label="AirFone" /> : (
<Layout
  locale="en"
  path="/contact/"
  title="Contact | AirFone"
  description="Contact AirFone by phone at 985-8042433 or email info@airfone.app. Ask about the AI call center that answers customer calls in Nepali."
>
  <ContactBody locale="en" />
</Layout>
)}

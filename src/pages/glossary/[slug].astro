---
import Base from '../../layouts/Base.astro';
import Related from '../../components/site/Related.astro';
import CtaBand from '../../components/site/CtaBand.astro';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import { glossary, termBySlug, type Term } from '../../data/glossary';
import { productLink } from '../../data/links';
import { posts } from '../../lib/posts';
import { productTags } from '../../data/links';
import { breadcrumbJsonLd, definedTermJsonLd, faqJsonLd, termArticleJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return glossary.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props as { t: Term };
const path = `/glossary/${t.slug}`;
const heading = t.full ? `What is ${t.term} (${t.full})?` : `What is ${/^[A-Z]{2,}/.test(t.term) ? t.term : `a ${t.term.toLowerCase()}`}?`;
const related = t.related.map(termBySlug).filter((x): x is Term => !!x);
const product = t.product ? productLink(t.product) : null;
const guides = t.product
  ? (await posts()).filter((x) => !x.data.draft && x.data.tags.some((g) => productTags[t.product!]?.includes(g))).slice(0, 3)
  : [];
const sections = t.sections ?? [];
const faq = [{ q: heading, a: t.short }, ...(t.faq ?? [])];
const title = t.title ?? `${t.term}${t.full ? ` (${t.full})` : ''}: meaning and how it works`;
const description = t.description ?? (t.short.length <= 160 ? t.short : `${t.short.slice(0, 157).replace(/\s+\S*$/, '')}…`);
const strip = (x: string) => x.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
const words = [t.short, ...t.body, ...sections.flatMap((x) => [x.h, ...x.p, ...(x.list ?? [])]), ...(t.faq ?? []).flatMap((f) => [f.q, f.a])]
  .map(strip).join(' ').split(/\s+/).length;
// Copy is ours; escape it, then turn [text](/path) into internal links.
const esc = (x: string) => x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// A link to a glossary term that is not live yet renders as plain text.
const md = (x: string) => esc(x).replace(/\[([^\]]+)\]\((\/[^)\s]*)\)/g, (_, text, href) =>
  href.startsWith('/glossary/') && !termBySlug(href.slice(10).split('#')[0]) ? text : `<a href="${href}">${text}</a>`);
---
<Base
  title={title}
  description={description}
  path={path}
  jsonLd={[
    definedTermJsonLd(t),
    ...(sections.length && t.updated ? [termArticleJsonLd({ slug: t.slug, term: t.term, title, description, published: t.published ?? t.updated, updated: t.updated, sections, words })] : []),
    faqJsonLd(faq.map((f) => ({ q: f.q, a: strip(f.a) }))),
    breadcrumbJsonLd([{ name: 'Glossary', path: '/glossary' }, { name: t.term, path }]),
  ]}
>
  <article class="term">
    <div class="wrap">
      <div class="col">
        <a class="back" href="/glossary" data-enter><ArrowLeft size={18} stroke-width={2} aria-hidden="true" /> Glossary</a>
        <h1 data-enter>{heading}</h1>
        <p class="def" data-enter><dfn>{t.term}</dfn>{t.short.slice(t.term.length)}</p>
        <div class="prose body" data-enter>
          {t.body.map((p) => <p set:html={md(p)} />)}
        </div>
        {sections.length > 0 && (
          <nav class="toc" aria-label="On this page" data-enter>
            <span class="see-h">On this page</span>
            <ol>{sections.map((x) => <li><a href={`#${x.id}`}>{x.h}</a></li>)}</ol>
          </nav>
        )}
        {sections.map((x) => (
          <section class="prose body sec" id={x.id}>
            <h2>{x.h}</h2>
            {x.p.map((p) => <p set:html={md(p)} />)}
            {x.list && <ul>{x.list.map((li) => <li set:html={md(li)} />)}</ul>}
          </section>
        ))}
        {t.faq && t.faq.length > 0 && (
          <section class="prose body sec" id="faq">
            <h2>Questions people ask about {/^[A-Z]{2,}/.test(t.term) ? t.term : t.term.toLowerCase()}s</h2>
            {t.faq.map((f) => (
              <>
                <h3>{f.q}</h3>
                <p set:html={md(f.a)} />
              </>
            ))}
          </section>
        )}
        {t.updated && <p class="upd">Updated <time datetime={t.updated}>{new Date(t.updated).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time></p>}
        {related.length > 0 && (
          <nav class="see" aria-label="Related terms" data-enter>
            <span class="see-h">Related terms</span>
            <ul>{related.map((r) => <li><a href={`/glossary/${r.slug}`}>{r.term}</a></li>)}</ul>
          </nav>
        )}
      </div>
    </div>
  </article>

  <Related groups={[
    { h: 'Where this matters', items: product ? [product] : [] },
    { h: 'Guides', items: guides.map((g) => ({ href: `/blog/${g.id}`, label: g.data.title })) },
    { h: 'More terms', items: glossary.filter((x) => x.slug !== t.slug && !t.related.includes(x.slug)).slice(0, 4).map((x) => ({ href: `/glossary/${x.slug}`, label: x.term })) },
  ]} />
  <CtaBand />
</Base>

<style>
  .term { padding-block: var(--space-8) var(--space-9); }
  .col { max-width: 720px; }
  .back { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; color: var(--ink-muted); text-decoration: none; font-size: 16px; }
  .back:hover { color: var(--ink); }
  h1 { margin: var(--space-5) 0 var(--space-5); font-family: 'Source Serif 4 Variable', 'Serif Fallback', Georgia, serif; font-weight: 600; font-size: clamp(2rem, 1.5rem + 2vw, 3rem); line-height: 1.12; }
  /* The quotable one-line answer, set apart from the explanation. */
  .def { margin: 0 0 var(--space-6); padding: var(--space-5) var(--space-6); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-panel); font-size: 1.1875rem; line-height: 1.5; }
  dfn { font-style: normal; font-weight: 600; }
  .body { max-width: none; font-family: 'Source Serif 4 Variable', 'Serif Fallback', Georgia, serif; font-size: 1.125rem; line-height: 1.5; }
  .body p { margin: 0 0 var(--space-4); }
  .toc { margin: var(--space-6) 0; padding: var(--space-5) var(--space-6); border: 1px solid var(--line); border-radius: var(--radius-panel); }
  .toc ol { margin: var(--space-3) 0 0; padding-left: var(--space-5); font-size: 16px; line-height: 1.5; }
  .toc li { margin: var(--space-1) 0; }
  .toc a { color: var(--link); }
  .sec { margin-top: var(--space-7); scroll-margin-top: var(--space-8); }
  .sec h2 { margin: 0 0 var(--space-4); font-weight: 600; font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem); line-height: 1.12; }
  .sec h3 { margin: var(--space-5) 0 var(--space-2); font-size: 1.25rem; font-weight: 600; line-height: 1.3; }
  .sec ul { margin: 0 0 var(--space-4); padding-left: var(--space-5); }
  .sec li { margin: 0 0 var(--space-2); }
  .body a { color: var(--link); }
  .upd { margin-top: var(--space-6); font-size: 15px; color: var(--ink-muted); }
  .see { margin-top: var(--space-6); display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .see-h { font-size: 15px; font-weight: 600; color: var(--ink-muted); }
  .see ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .see a { display: inline-flex; align-items: center; min-height: 36px; padding: 0 var(--space-4); border: 1px solid var(--line); border-radius: var(--radius-control); color: var(--ink); text-decoration: none; font-size: 15px; transition: border-color var(--fast) var(--ease), color var(--fast) var(--ease); }
  .see a:hover { border-color: var(--brand); color: var(--link); }
</style>

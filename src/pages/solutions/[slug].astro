---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Base from '../../layouts/Base.astro';
import CallPlayer from '../../components/player/CallPlayer.astro';
import CtaBand from '../../components/site/CtaBand.astro';
import Faq from '../../components/site/Faq.astro';
import { solutions, type Solution } from '../../data/solutions';
import { productBySlug } from '../../data/products';
import { breadcrumbJsonLd, faqJsonLd, serviceJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return solutions.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Solution };
const path = `/solutions/${s.slug}`;
const used = s.products.map(productBySlug).filter((p) => !!p);
---
<Base title={`AI call answering for ${s.name.toLowerCase()} in Nepal`} description={s.description} path={path} jsonLd={[serviceJsonLd(s), faqJsonLd(s.faq), breadcrumbJsonLd([{ name: s.name, path }])]}>
  <section class="top">
    <div class="wrap grid">
      <div>
        <h1 class="rise">{s.headline.split(' ').map((w, i) => (<><span class="w"><span style={`--i:${i}`}>{w}</span></span>{' '}</>))}</h1>
      </div>
      <div class="call-panel" data-enter style="--d:1"><CallPlayer clip={s.clip} chat /></div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="wrap">
      <h2>The calls it answers</h2>
      <ul class="calls" data-stagger>
        {s.calls.map((c, i) => (
          <li style={`--i:${i}`}>
            <span class="q">“{c.q}”</span>
            <span class="a"><ArrowRight class="to" size={16} stroke-width={2} aria-hidden="true" />{c.a}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight" data-reveal>
    <div class="wrap two">
      <h2>Products to use</h2>
      <ul class="prods" data-stagger>
        {used.map((p, i) => <li style={`--i:${i}`}><a href={`/products/${p!.slug}`}><span class="pname">{p!.name}</span><span class="arrow" aria-hidden="true"><ArrowRight class="arrow-icon" size={18} stroke-width={2} aria-hidden="true" /></span></a></li>)}
      </ul>
    </div>
  </section>

  <Faq items={s.faq} />
  <CtaBand />
</Base>

<style>
  .top { padding-block: var(--space-9); border-bottom: 1px solid var(--line); }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-8); align-items: center; }
  h1 { max-width: 14ch; }
  .two { display: grid; grid-template-columns: 1fr 1.4fr; gap: var(--space-8); align-items: start; }
  .section h2 { margin-bottom: var(--space-5); }
  .calls { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  .calls li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-5); align-items: baseline; padding: var(--space-3) 0; border-top: 1px solid var(--line); }
  .q { font-family: 'Source Serif 4 Variable', 'Serif Fallback', Georgia, serif; font-size: 1.0625rem; line-height: 1.3; }
  .a { display: flex; gap: var(--space-2); align-items: baseline; font-size: 15px; line-height: 1.35; color: var(--ink-muted); }
  .a :global(.to) { flex: none; color: var(--link); transform: translateY(3px); }
  @media (max-width: 767px) { .calls li { grid-template-columns: 1fr; gap: 2px; } }
  .h3 { font-size: 1.375rem; }
  .prods { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  .prods a { display: flex; justify-content: space-between; align-items: center; min-height: 88px; border-top: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .pname { font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem); font-weight: 600; transition: color var(--fast) var(--ease); }
  .arrow { display: inline-flex; color: var(--link); font-size: 1.5rem; transition: transform var(--fast) var(--ease); }
  .prods a:hover .pname { color: var(--link); }
  .prods a:hover .arrow { transform: translateX(4px); }
  @media (max-width: 959px) {
    .grid, .two { grid-template-columns: 1fr; gap: var(--space-6); }
  }
</style>

---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import Faq from '../components/site/Faq.astro';
import { breadcrumbJsonLd } from '../lib/seo';

const why = [
  { h: 'A product your customers ask for', p: 'Every business loses calls. AirFone fixes that on their existing number, in Nepali.' },
  { h: 'Monthly income that grows', p: 'You earn on every month each customer stays, and your share rises as you add customers.' },
  { h: 'We do the heavy lifting', p: 'Training, demo numbers, sales material and second-line support come from us.' },
];
const steps = [
  { h: 'Apply', p: 'Fill in the form. We call within one working day.' },
  { h: 'Get trained', p: 'One session on the products, the demo and setup.' },
  { h: 'Sell and set up', p: 'Use your own demo number with prospects, then set customers up from your partner portal.' },
];
const faq = [
  { q: 'Who can become a reseller?', a: 'IT shops, telecom and internet companies, consultants and agencies who already serve businesses in Nepal.' },
  { q: 'Do I need technical skills?', a: 'Basic ones. Most setups are a SIP line, a price list and a test call, and we help with the first few.' },
  { q: 'How do I get paid?', a: 'Every month, for every active customer. We share the full terms and your price list after the first call.' },
];
---
<Base title="Resellers" description="Sell AirFone to businesses in your area. Monthly income per customer, training, demo numbers and support from the AirFone team." path="/resellers" jsonLd={[breadcrumbJsonLd([{ name: 'Resellers', path: '/resellers' }])]}>
  <section class="top">
    <div class="wrap">
      <h1>Sell AirFone in your city</h1>
      <div class="cols">
        {why.map((w) => <div><h2 class="h3">{w.h}</h2><p class="muted">{w.p}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="wrap two">
      <h2>How it works</h2>
      <ol class="steps">{steps.map((s, i) => <li><span class="n mono">{i + 1}</span><div><h3>{s.h}</h3><p class="muted">{s.p}</p></div></li>)}</ol>
    </div>
  </section>

  <section class="section apply" id="apply" data-reveal>
    <div class="wrap two">
      <h2>Apply</h2>
      <LeadForm kind="reseller" submit="Send application" withType={false} withCity />
    </div>
  </section>

  <Faq items={faq} />
</Base>

<style>
  .top { padding-block: var(--space-8) var(--space-9); border-bottom: 1px solid var(--line); }
  h1 { max-width: 14ch; margin-bottom: var(--space-8); }
  .cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-7); }
  .h3 { font-size: 1.375rem; margin-bottom: var(--space-3); }
  .two { display: grid; grid-template-columns: 1fr 1.4fr; gap: var(--space-8); align-items: start; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-5); }
  .steps li { display: grid; grid-template-columns: 40px 1fr; gap: var(--space-4); padding-bottom: var(--space-5); border-bottom: 1px solid var(--line); }
  .n { display: grid; place-items: center; width: 40px; height: 40px; border-radius: var(--radius-control); background: var(--lime); color: var(--on-lime); font-weight: 600; }
  .steps h3 { margin-bottom: var(--space-1); }
  .apply { background: var(--surface); }
  @media (max-width: 959px) { .cols, .two { grid-template-columns: 1fr; gap: var(--space-6); } }
</style>

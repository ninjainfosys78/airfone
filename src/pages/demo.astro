---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import AudioLines from '@lucide/astro/icons/audio-lines';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { DEMO_NUMBER_DISPLAY, DEMO_NUMBER_TEL } from '../config/site';
import { breadcrumbJsonLd } from '../lib/seo';
import { Image } from 'astro:assets';
import team from '../assets/photos/team-front-desk.png';

const steps = [
  'Leave your number. We call within one working day.',
  'Send us a price list or a few common questions.',
  'Hear AirFone answer calls for your business on a test number.',
];
---
<Base title="Book a demo" description="Book a short AirFone demo. We set it up on a test number with your own prices, so you hear it answer calls for your business." path="/demo" jsonLd={[breadcrumbJsonLd([{ name: 'Book a demo', path: '/demo' }])]}>
  <section class="page">
    <div class="wrap grid">
      <div class="intro">
        <h1 data-enter>Book a demo</h1>
        <ol class="steps">
          {steps.map((s, i) => (
            <li data-enter style={`--d:${i + 1}`}>
              <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span>{s}</span>
            </li>
          ))}
        </ol>

        <a class="ring" href={DEMO_NUMBER_TEL} data-enter style="--d:4">
          <span class="icon" aria-hidden="true"><AudioLines size={22} stroke-width={1.75} /></span>
          <span class="ring-text">
            <span class="ring-label">Or ring it now</span>
            <span class="ring-num">{DEMO_NUMBER_DISPLAY}</span>
          </span>
          <ArrowRight class="go" size={20} stroke-width={2} aria-hidden="true" />
        </a>

        <div class="photo-wrap" data-enter style="--d:5">
          <Image src={team} alt="An AirFone team member at the office front desk" widths={[360, 720, 1080]} sizes="(max-width: 959px) 100vw, 320px" quality={90} format="webp" class="photo" />
        </div>
      </div>

      <div class="panel" data-enter style="--d:2">
        <h2 class="panel-h">Your details</h2>
        <LeadForm kind="demo" />
      </div>
    </div>
  </section>
</Base>

<style>
  .page { padding-block: var(--space-9) var(--space-10); }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 520px); gap: var(--space-9); align-items: start; }
  h1 { margin-bottom: var(--space-7); }

  /* Three steps: small green numbers beside plain lines, divided by rules. */
  .steps { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); max-width: 520px; }
  .steps li { display: grid; grid-template-columns: 40px 1fr; gap: var(--space-3); padding: var(--space-4) 0; border-top: 1px solid var(--line); font-size: 17px; line-height: 1.45; }
  .n { font-family: var(--font-display); font-weight: 600; color: var(--link); font-variant-numeric: tabular-nums; }

  .ring {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--space-4);
    max-width: 520px; margin-top: var(--space-7); padding: var(--space-5);
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-panel);
    color: var(--ink); text-decoration: none;
    transition: border-color 200ms var(--ease), transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ring:hover { border-color: var(--brand); transform: translateY(-3px); }
  .icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 10px; background: var(--subtle); color: var(--brand); transition: background-color 200ms var(--ease), color 200ms var(--ease); }
  .ring:hover .icon { background: var(--brand); color: var(--stage-ink); }
  .ring-text { display: grid; gap: 2px; }
  .ring-label { font-size: 15px; color: var(--ink-muted); }
  .ring-num { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; }
  .ring :global(.go) { color: var(--ink-muted); transition: transform var(--fast) var(--ease), color var(--fast) var(--ease); }
  .ring:hover :global(.go) { transform: translateX(4px); color: var(--brand); }

  .photo-wrap { margin-top: var(--space-7); max-width: 320px; }
  .photo { display: block; width: 100%; height: auto; aspect-ratio: 1080 / 1700; border-radius: var(--radius-panel); }

  .panel { position: sticky; top: 104px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-panel); padding: var(--space-7); }
  .panel-h { font-size: 1.375rem; margin-bottom: var(--space-5); }

  @media (prefers-reduced-motion: reduce) { .ring:hover { transform: none; } }
  @media (max-width: 959px) {
    .page { padding-block: var(--space-8); }
    .grid { grid-template-columns: 1fr; gap: var(--space-7); }
    .panel { position: static; padding: var(--space-5); }
    .photo-wrap { display: none; }
  }
</style>

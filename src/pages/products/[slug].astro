---
import Base from '../../layouts/Base.astro';
import CallPlayer from '../../components/player/CallPlayer.astro';
import ChatDemo from '../../components/demos/ChatDemo.astro';
import PhoneMenu from '../../components/demos/PhoneMenu.astro';
import OutboundTimeline from '../../components/demos/OutboundTimeline.astro';
import CtaBand from '../../components/site/CtaBand.astro';
import Faq from '../../components/site/Faq.astro';
import { fmtDate, posts } from '../../lib/posts';
import { products, type Product } from '../../data/products';
import { faqJsonLd, breadcrumbJsonLd, softwareJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
const path = `/products/${p.slug}`;
// Guides on the same topic, so each product page links into the blog.
const topic: Record<string, string[]> = {
  'ai-call-agent': ['ai-call-agent'], 'ai-phone-system': ['ai-call-agent', 'phone-system'], 'phone-system': ['phone-system'],
  'website-voice-agent': ['voice-agent', 'website'], 'website-chatbot': ['website'],
};
const guides = (await posts()).filter((x) => !x.data.draft && x.data.tags.some((t) => topic[p.slug]?.includes(t))).slice(0, 3);
---
<Base
  title={p.seoTitle}
  description={p.description}
  path={path}
  jsonLd={[softwareJsonLd(p), faqJsonLd(p.faq), breadcrumbJsonLd([{ name: p.name, path }])]}
>
  <section class="top">
    <div class="wrap grid">
      <div data-enter>
        <h1>{p.headline}</h1>
        <div class="actions">
          <a class="btn btn-primary" href="/demo">Book a demo</a>
          <a class="btn btn-secondary" href="/pricing">Pricing</a>
        </div>
      </div>
      <div class="demo" data-enter style="--d:1">
        {p.demo.kind === 'chat' && <ChatDemo />}
        {p.demo.kind === 'call' && <CallPlayer clip={p.demo.clip} />}
        {p.demo.kind === 'menu' && <><PhoneMenu /><div class="gap"><CallPlayer clip={p.demo.clip} compact /></div></>}
        {p.demo.kind === 'outbound' && <><CallPlayer clip={p.demo.clip} /><div class="gap"><OutboundTimeline /></div></>}
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="wrap">
      <h2>How it works</h2>
      <ol class="how" data-stagger>
        {p.how.map((h, i) => (
          <li style={`--i:${i}`}>
            <span class="n" aria-hidden="true">{i + 1}</span>
            <h3>{h.h}</h3>
            <p>{h.p}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-tight specs-wrap" data-reveal>
    <div class="wrap two">
      <h2>The details</h2>
      <dl class="specs" data-stagger>
        {p.specs.map(([k, v], i) => <div style={`--i:${i}`}><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </section>

  <Faq items={p.faq} />

  {guides.length > 0 && (
    <section class="section-tight" data-reveal>
      <div class="wrap two">
        <h2>Guides</h2>
        <ul class="guides">
          {guides.map((g) => <li><a href={`/blog/${g.id}`}><span>{g.data.title}</span><time datetime={g.data.date.toISOString()}>{fmtDate(g.data.date)}</time></a></li>)}
        </ul>
      </div>
    </section>
  )}


  <CtaBand />
</Base>

<style>
  .guides { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  .guides a { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-5); padding: var(--space-4) 0; border-top: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .guides span { font-size: 1.125rem; font-weight: 500; transition: color var(--fast) var(--ease); }
  .guides a:hover span { color: var(--link); }
  .guides time { flex: none; font-size: 14px; color: var(--ink-muted); }
  @media (max-width: 599px) { .guides a { flex-direction: column; gap: var(--space-1); } }
  .top { padding-block: var(--space-9); border-bottom: 1px solid var(--line); }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-8); align-items: center; }
  h1 { max-width: 14ch; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-7); }
  .gap { margin-top: var(--space-4); }

  .section h2, .specs-wrap h2 { margin-bottom: var(--space-7); }
  .how { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-6); }
  .how li { padding-top: var(--space-4); border-top: 2px solid var(--line); }
  .how li:first-child { border-top-color: var(--brand); }
  .how .n { display: block; font-family: var(--font-display); font-size: 14px; font-weight: 600; color: var(--link); margin-bottom: var(--space-3); }
  .how h3 { font-size: 1.125rem; line-height: 1.3; margin-bottom: var(--space-2); }
  .how p { margin: 0; font-size: 16px; line-height: 1.5; color: var(--ink-muted); }

  .specs-wrap { background: var(--surface); border-block: 1px solid var(--line); }
  .two { display: grid; grid-template-columns: 1fr 1.4fr; gap: var(--space-8); align-items: start; }
  .specs-wrap .two h2 { margin: 0; }
  .specs { margin: 0; border-bottom: 1px solid var(--line); }
  .specs div { display: grid; grid-template-columns: 180px 1fr; gap: var(--space-4); padding: var(--space-4) 0; border-top: 1px solid var(--line); }
  .specs dt { font-size: 16px; color: var(--ink-muted); }
  .specs dd { margin: 0; font-size: 16px; font-weight: 500; }

  @media (max-width: 1023px) { .how { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 959px) {
    .grid, .two { grid-template-columns: 1fr; gap: var(--space-6); }
    .top { padding-block: var(--space-7) var(--space-8); }
  }
  @media (max-width: 599px) {
    .how { grid-template-columns: 1fr; }
    .specs div { grid-template-columns: 1fr; gap: var(--space-1); }
  }
</style>

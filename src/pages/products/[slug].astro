---
import Base from '../../layouts/Base.astro';
import CallPlayer from '../../components/player/CallPlayer.astro';
import ChatDemo from '../../components/demos/ChatDemo.astro';
import PhoneMenu from '../../components/demos/PhoneMenu.astro';
import CtaBand from '../../components/site/CtaBand.astro';
import Faq from '../../components/site/Faq.astro';
import { fmtDate, posts } from '../../lib/posts';
import { products, type Product } from '../../data/products';
import { faqJsonLd, breadcrumbJsonLd, softwareJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
const path = `/products/${p.slug}`;
// Guides on the same topic, so each product page links into the blog.
const topic: Record<string, string[]> = {
  'ai-call-agent': ['ai-call-agent'], 'ai-phone-system': ['ai-call-agent', 'phone-system'], 'phone-system': ['phone-system'],
  'website-voice-agent': ['voice-agent', 'website'], 'website-chatbot': ['website'],
};
const guides = (await posts()).filter((x) => !x.data.draft && x.data.tags.some((t) => topic[p.slug]?.includes(t))).slice(0, 3);
---
<Base
  title={p.seoTitle}
  description={p.description}
  path={path}
  jsonLd={[softwareJsonLd(p), faqJsonLd(p.faq), breadcrumbJsonLd([{ name: p.name, path }])]}
>
  <section class="top">
    <div class="wrap grid">
      <div>
        <h1 class="rise">{p.headline.split(' ').map((w, i) => (<><span class="w"><span style={`--i:${i}`}>{w}</span></span>{' '}</>))}</h1>
      </div>
      <div class="demo" data-enter style="--d:1">
        {p.demo.kind === 'chat' && <ChatDemo />}
        {p.demo.kind === 'call' && <CallPlayer clip={p.demo.clip} chat />}
        {p.demo.kind === 'menu' && <><PhoneMenu /><div class="gap"><CallPlayer clip={p.demo.clip} compact /></div></>}
        {p.demo.kind === 'outbound' && <CallPlayer clip={p.demo.clip} chat />}
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="wrap two">
      <h2>Setup</h2>
      <ol class="how" data-stagger>
        {p.how.map((h, i) => (
          <li style={`--i:${i}`}>
            <span class="n" aria-hidden="true">{i + 1}</span>
            <h3>{h.h}</h3>
            <p>{h.p}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-tight specs-wrap" data-reveal>
    <div class="wrap two">
      <h2>Specifications</h2>
      <dl class="specs" data-stagger>
        {p.specs.map(([k, v], i) => <div style={`--i:${i}`}><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </section>

  <Faq items={p.faq} />

  {guides.length > 0 && (
    <section class="section-tight" data-reveal>
      <div class="wrap two">
        <h2>Guides</h2>
        <ul class="guides">
          {guides.map((g) => <li><a href={`/blog/${g.id}`}><span>{g.data.title}</span><time datetime={g.data.date.toISOString()}>{fmtDate(g.data.date)}</time></a></li>)}
        </ul>
      </div>
    </section>
  )}


  <CtaBand />
</Base>

<style>
  .guides { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  .guides a { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-5); padding: var(--space-4) 0; border-top: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .guides span { font-size: 1.125rem; font-weight: 500; transition: color var(--fast) var(--ease); }
  .guides a:hover span { color: var(--link); }
  .guides time { flex: none; font-size: 14px; color: var(--ink-muted); }
  @media (max-width: 599px) { .guides a { flex-direction: column; gap: var(--space-1); } }
  .top { padding-block: var(--space-9); border-bottom: 1px solid var(--line); }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-8); align-items: center; }
  h1 { max-width: 16ch; font-size: clamp(2.25rem, 1.6rem + 2.2vw, 3.25rem); }
  /* The call as one panel: a player bar (play, name, waveform, time) on top,
     the conversation below. */
  .demo :global(call-player.chat) {
    display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-areas: 'play meta' 'play wave' 'tx tx';
    gap: 0 var(--space-4); padding: 0; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-panel); overflow: hidden;
  }
  .demo :global(.chat .head) { display: contents; }
  .demo :global(.chat .play) {
    grid-area: play; align-self: center; margin: var(--space-5) 0 var(--space-5) var(--space-5);
    width: 56px; height: 56px; border-radius: 50%; background: var(--ink); color: #fff;
    transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1), background-color 200ms var(--ease);
  }
  .demo :global(.chat .play) { position: relative; }
  /* Until the call is played, a soft ring pulses out from the button to invite a tap. */
  .demo :global(.chat .play[aria-pressed='false']:not(.played))::after {
    content: ''; position: absolute; inset: 0; border-radius: 50%; border: 2px solid var(--lime);
    animation: invite 1.8s cubic-bezier(0.22, 1, 0.36, 1) infinite; pointer-events: none;
  }
  /* Headline words rise out of a mask; the conversation bubbles follow in turn. */
  @media (prefers-reduced-motion: no-preference) {
    .rise .w { display: inline-block; overflow: hidden; vertical-align: bottom; padding-bottom: 0.08em; margin-bottom: -0.08em; }
    .rise .w > span { display: inline-block; animation: word-up 900ms cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: calc(var(--i) * 60ms + 80ms); }
    .demo :global(.chat .transcript li) { animation: bubble-in 600ms cubic-bezier(0.22, 1, 0.36, 1) both; }
    .demo :global(.chat .transcript li:nth-child(1)) { animation-delay: 450ms; }
    .demo :global(.chat .transcript li:nth-child(2)) { animation-delay: 600ms; }
    .demo :global(.chat .transcript li:nth-child(3)) { animation-delay: 750ms; }
    .demo :global(.chat .transcript li:nth-child(4)) { animation-delay: 900ms; }
    .demo :global(.chat .transcript li:nth-child(n+5)) { animation-delay: 1050ms; }
  }
  @keyframes word-up { from { transform: translateY(105%); } to { transform: none; } }
  @keyframes bubble-in { from { opacity: 0; transform: translateY(12px) scale(0.98); } to { opacity: 1; transform: none; } }
  @keyframes invite { from { transform: scale(1); opacity: 0.9; } to { transform: scale(1.7); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .demo :global(.chat .play)::after { animation: none !important; display: none; } }
  .demo :global(.chat .play:hover) { background: var(--brand); transform: scale(1.05); }
  .demo :global(.chat .play:active) { transform: scale(0.95); }
  .demo :global(.chat .play svg) { width: 22px; height: 22px; }
  .demo :global(.chat .meta) { grid-area: meta; display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-3); padding: var(--space-5) var(--space-5) 0 0; }
  .demo :global(.chat .label) { margin: 0; font-size: 16px; }
  .demo :global(.chat .time) { margin: 0; font-size: 14px; }
  .demo :global(.chat .slot) { grid-area: wave; display: grid; margin: var(--space-2) var(--space-5) var(--space-5) 0; min-height: 32px; }
  .demo :global(.chat .wave) { height: 32px; }
  .demo :global(.chat audio) { display: none; }
  .demo :global(.chat .transcript) { grid-area: tx; margin: 0; padding: 0; border: 0; border-top: 1px solid var(--line); }
  .demo :global(.chat .transcript ol) { height: 380px; border: 0 !important; border-radius: 0 !important; background: var(--canvas); }
  .gap { margin-top: var(--space-4); }

  .how { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  .how li { display: grid; grid-template-columns: 40px 1fr; column-gap: var(--space-3); padding: var(--space-4) 0; border-top: 1px solid var(--line); }
  .how .n { grid-row: span 2; font-family: var(--font-display); font-weight: 600; color: var(--link); }
  .how h3 { font-size: 1.0625rem; line-height: 1.35; margin: 0 0 2px; }
  .how p { margin: 0; font-size: 16px; line-height: 1.5; color: var(--ink-muted); }
  .specs-wrap { background: var(--surface); border-block: 1px solid var(--line); }
  .two { display: grid; grid-template-columns: 1fr 1.4fr; gap: var(--space-8); align-items: start; }
  .two h2 { margin: 0; }
  .specs { margin: 0; border-bottom: 1px solid var(--line); }
  .specs div { display: grid; grid-template-columns: 180px 1fr; gap: var(--space-4); padding: var(--space-4) 0; border-top: 1px solid var(--line); }
  .specs dt { font-size: 16px; color: var(--ink-muted); }
  .specs dd { margin: 0; font-size: 16px; font-weight: 500; }

  @media (max-width: 959px) {
    .grid, .two { grid-template-columns: 1fr; gap: var(--space-6); }
    .top { padding-block: var(--space-7) var(--space-8); }
  }
  @media (max-width: 599px) {
    .specs div { grid-template-columns: 1fr; gap: var(--space-1); }
  }
</style>

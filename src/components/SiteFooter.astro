---
import { t, localePath, otherLocalePath, type Locale } from '../i18n';
import { CONTACT_EMAIL, CONTACT_PHONE_TEL, CONTACT_PHONE_DISPLAY } from '../config/site';

export interface Props {
  locale: Locale;
  path?: string;
}

const { locale, path = '/' } = Astro.props;
const other = otherLocalePath(locale, path);
const copy = t[locale];
---
<footer class="site-footer">
  <div class="wrap grid">
    <a class="lockup" href={localePath(locale, '/')} aria-label="AirFone">
      <img class="lockup-light-bg" src="/brand/airfone-lockup.svg" alt="AirFone" width="140" height="29" />
      <img class="lockup-dark-bg" src="/brand/airfone-lockup-light.svg" alt="AirFone" width="140" height="29" />
    </a>

    <nav class="links" aria-label={locale === 'ne' ? 'फुटर नेभिगेसन' : 'Footer navigation'}>
      <a href={localePath(locale, '/pricing/')}>{copy.pricing}</a>
      <a href={localePath(locale, '/contact/')}>{copy.contact}</a>
      <a href={localePath(locale, '/privacy/')}>{copy.privacy}</a>
    </nav>

    <div class="meta">
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      <a href={CONTACT_PHONE_TEL}>{CONTACT_PHONE_DISPLAY[locale]}</a>
      <a href={other.href} hreflang={other.locale} lang={other.locale}>{copy.langSwitchLabel}</a>
    </div>

    <p class="copyright">{copy.copyright}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 96px;
  }
  .grid {
    padding-top: 40px;
    padding-bottom: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    justify-content: space-between;
  }
  .lockup {
    display: block;
  }
  .lockup img {
    height: 24px;
    width: auto;
  }
  .lockup-dark-bg {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    .lockup-light-bg {
      display: none;
    }
    .lockup-dark-bg {
      display: block;
    }
  }
  .links, .meta {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }
  .links a, .meta a {
    color: var(--ink-muted);
    text-decoration: none;
    font-size: 16px;
  }
  .links a:hover, .meta a:hover {
    color: var(--brand-ink);
  }
  .copyright {
    width: 100%;
    color: var(--ink-muted);
    font-size: 14px;
    margin: 0;
    max-width: none;
  }
</style>

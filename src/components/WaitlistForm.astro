---
import { WAITLIST_API_URL } from '../config/site';
import type { Locale } from '../i18n';

export interface Props {
  locale: Locale;
  id?: string;
  source?: string;
  compact?: boolean;
}

const { locale, id, source = 'homepage', compact = false } = Astro.props;
const uid = id ?? `wf-${Math.random().toString(36).slice(2, 9)}`;

const copy = {
  ne: {
    phoneLabel: 'मोबाइल नम्बर',
    phonePlaceholder: '98XXXXXXXX',
    businessLabel: 'व्यवसायको प्रकार (वैकल्पिक)',
    businessChoose: 'छान्नुहोस्',
    businessOptions: [['shop', 'पसल'], ['online_store', 'अनलाइन स्टोर'], ['clinic', 'क्लिनिक वा अस्पताल'], ['school', 'विद्यालय'], ['restaurant', 'रेस्टुरेन्ट'], ['other', 'अन्य']],
    moreLabel: 'व्यवसायको प्रकार वा इमेल थप्नुहोस् (वैकल्पिक)',
    emailLabel: 'इमेल (वैकल्पिक)',
    consentLabel: 'सुरु भएपछि सम्पर्क गर्न मन्जुर छु।',
    submit: 'सूचीमा नाम लेखाउनुहोस्',
    submitting: 'पठाइँदैछ...',
    created: 'धन्यवाद। सूचीमा नाम दर्ता भयो। सुरु भएपछि फोन गर्नेछौं।',
    already_on_list: 'तपाईंको नम्बर पहिले नै सूचीमा छ। धन्यवाद।',
    has_account: 'तपाईंको खाता पहिले नै छ।',
    signIn: 'साइन इन गर्नुहोस्',
    invalidPhone: 'कृपया मान्य मोबाइल नम्बर हाल्नुहोस् (9678 सुरु हुने १० अंक)।',
    invalidConsent: 'कृपया मन्जुरी दिनुहोस्।',
    rate_limited: 'धेरै पटक प्रयास भयो। केही बेरपछि फेरि प्रयास गर्नुहोस्।',
    network: 'पठाउन सकिएन। इन्टरनेट जाँच गरेर फेरि प्रयास गर्नुहोस्।',
  },
  en: {
    phoneLabel: 'Mobile number',
    phonePlaceholder: '98XXXXXXXX',
    businessLabel: 'Business type (optional)',
    businessChoose: 'Choose one',
    businessOptions: [['shop', 'Shop'], ['online_store', 'Online store'], ['clinic', 'Clinic or hospital'], ['school', 'School'], ['restaurant', 'Restaurant'], ['other', 'Other']],
    moreLabel: 'Add business type or email (optional)',
    emailLabel: 'Email (optional)',
    consentLabel: "I agree to be contacted when AirFone launches.",
    submit: 'Join the waitlist',
    submitting: 'Sending...',
    created: "Thanks. You're on the list. We'll call you when it's live.",
    already_on_list: "Your number is already on the list. Thanks.",
    has_account: 'You already have an account.',
    signIn: 'Sign in',
    invalidPhone: 'Enter a valid mobile number (10 digits, starting 9678).',
    invalidConsent: 'Please agree to be contacted.',
    rate_limited: 'Too many attempts. Try again in a few minutes.',
    network: 'Could not send. Check your connection and try again.',
  },
} as const;

const c = copy[locale];
---
<form
  class={`waitlist-form${compact ? ' compact' : ''}`}
  id={uid}
  method="post"
  action={WAITLIST_API_URL}
  data-waitlist-form
  data-locale={locale}
  data-app-url={import.meta.env.PUBLIC_APP_URL || 'https://app.airfone.app'}
  novalidate
>
  <div class="field">
    <label class="phone-label" for={`${uid}-phone`}>{c.phoneLabel}</label>
    <div class="group">
      <span class="prefix" aria-hidden="true">+977</span>
      <input
        type="tel"
        inputmode="tel"
        autocomplete="tel-national"
        name="phone"
        id={`${uid}-phone`}
        placeholder={c.phonePlaceholder}
        required
        aria-describedby={`${uid}-phone-error`}
      />
      <button type="submit" class="btn btn-primary submit-btn">{c.submit}</button>
    </div>
    <p class="field-error" id={`${uid}-phone-error`} role="alert" hidden></p>
  </div>

  <div class="field field-checkbox">
    <input type="checkbox" name="consent" id={`${uid}-consent`} value="true" required aria-describedby={`${uid}-consent-error`} />
    <label for={`${uid}-consent`}>{c.consentLabel}</label>
    <p class="field-error" id={`${uid}-consent-error`} role="alert" hidden></p>
  </div>

  <details class="more" open={!compact}>
    <summary>{c.moreLabel}</summary>
    <div class="more-fields">
      <div class="field">
        <label for={`${uid}-business`}>{c.businessLabel}</label>
        <div class="select">
          <select name="business_type" id={`${uid}-business`}>
            <option value="">{c.businessChoose}</option>
            {c.businessOptions.map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
          <span class="chevron" aria-hidden="true"></span>
        </div>
      </div>
      <div class="field">
        <label for={`${uid}-email`}>{c.emailLabel}</label>
        <input type="email" autocomplete="email" name="email" id={`${uid}-email`} placeholder="name@example.com" />
      </div>
    </div>
  </details>

  <div class="honeypot" aria-hidden="true">
    <label for={`${uid}-website`}>Website</label>
    <input type="text" name="website" id={`${uid}-website`} tabindex="-1" autocomplete="off" />
  </div>

  <input type="hidden" name="locale" value={locale} />
  <input type="hidden" name="source" value={source} />
  <input type="hidden" name="utm_source" data-utm="utm_source" value="" />
  <input type="hidden" name="utm_medium" data-utm="utm_medium" value="" />
  <input type="hidden" name="utm_campaign" data-utm="utm_campaign" value="" />

  <p class="form-message" role="status" aria-live="polite" hidden></p>
</form>

<style>
  .waitlist-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .field label {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-muted);
  }

  /* One bar: +977 prefix, number, button */
  .group {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    transition: border-color 150ms ease-out;
  }
  .group:focus-within {
    border-color: var(--brand);
  }
  .prefix {
    padding-left: 12px;
    font-size: 18px;
    font-weight: 600;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .group input {
    flex: 1;
    min-width: 0;
    height: 48px;
    padding: 0 4px;
    border: 0;
    background: transparent;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .group input::placeholder {
    color: var(--ink-muted);
    font-weight: 400;
  }
  .group input:focus {
    outline: none;
  }
  .submit-btn {
    height: 48px;
    padding: 0 22px;
    border-radius: 8px;
    font-size: 16px;
    white-space: nowrap;
  }
  .submit-btn:disabled {
    opacity: 0.7;
    cursor: default;
  }

  .field-checkbox {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    align-items: start;
    column-gap: 10px;
    row-gap: 4px;
  }
  .field-checkbox input {
    width: 18px;
    height: 18px;
    margin: 3px 0 0;
    accent-color: var(--brand);
  }
  .field-checkbox label {
    font-weight: 400;
    font-size: 14px;
    color: var(--ink-muted);
    cursor: pointer;
  }
  .field-checkbox .field-error {
    grid-column: 2;
  }
  .field-error {
    color: var(--error);
    font-size: 14px;
    margin: 0;
  }

  .more summary {
    display: none;
  }
  .compact .more summary {
    display: block;
    cursor: pointer;
    font-size: 14px;
    color: var(--ink-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    width: fit-content;
  }
  .compact .more summary::-webkit-details-marker {
    display: none;
  }
  .compact .more[open] summary {
    margin-bottom: 12px;
  }
  .more-fields {
    display: grid;
    gap: 12px;
  }
  .more-fields select,
  .more-fields input {
    height: 48px;
    border-radius: 10px;
    padding: 0 14px;
    font-size: 16px;
  }
  .select {
    position: relative;
  }
  .select select {
    appearance: none;
    -webkit-appearance: none;
    padding-right: 44px;
    cursor: pointer;
  }
  .chevron {
    position: absolute;
    right: 18px;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-top: -6px;
    border-right: 2px solid var(--ink-muted);
    border-bottom: 2px solid var(--ink-muted);
    transform: rotate(45deg);
    pointer-events: none;
  }
  @media (min-width: 560px) {
    .more-fields {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .form-message {
    font-size: 16px;
    margin: 0;
  }

  /* Narrow phones: button drops under the number */
  @media (max-width: 519px) {
    .group {
      flex-wrap: wrap;
    }
    .group input {
      flex: 1 1 60%;
    }
    .submit-btn {
      flex: 1 1 100%;
    }
  }
</style>

<script>
  type Status = 'idle' | 'submitting' | 'created' | 'already_on_list' | 'has_account' | 'invalid' | 'rate_limited' | 'network';

  const MESSAGES: Record<'ne' | 'en', Record<string, string>> = {
    ne: {
      created: 'धन्यवाद। सूचीमा नाम दर्ता भयो। सुरु भएपछि फोन गर्नेछौं।',
      already_on_list: 'तपाईंको नम्बर पहिले नै सूचीमा छ। धन्यवाद।',
      has_account: 'तपाईंको खाता पहिले नै छ।',
      invalidFromLink: 'हाल भरिएको जानकारी मान्य भएन। कृपया मोबाइल नम्बर जाँचेर फेरि पठाउनुहोस्।',
      invalidPhone: 'कृपया मान्य मोबाइल नम्बर हाल्नुहोस् (9678 सुरु हुने १० अंक)।',
      invalidConsent: 'कृपया मन्जुरी दिनुहोस्।',
      rate_limited: 'धेरै पटक प्रयास भयो। केही बेरपछि फेरि प्रयास गर्नुहोस्।',
      network: 'पठाउन सकिएन। इन्टरनेट जाँच गरेर फेरि प्रयास गर्नुहोस्।',
      submitting: 'पठाइँदैछ...',
      submit: 'सूचीमा नाम लेखाउनुहोस्',
    },
    en: {
      created: "Thanks. You're on the list. We'll call you when it's live.",
      already_on_list: 'Your number is already on the list. Thanks.',
      has_account: 'You already have an account.',
      invalidFromLink: 'That submission was not valid. Check your mobile number and send it again.',
      invalidPhone: 'Enter a valid mobile number (10 digits, starting 9678).',
      invalidConsent: 'Please agree to be contacted.',
      rate_limited: 'Too many attempts. Try again in a few minutes.',
      network: 'Could not send. Check your connection and try again.',
      submitting: 'Sending...',
      submit: 'Join the waitlist',
    },
  };

  const DEVANAGARI_DIGITS: Record<string, string> = {
    '०': '0', '१': '1', '२': '2', '३': '3', '४': '4',
    '५': '5', '६': '6', '७': '7', '८': '8', '९': '9',
  };

  function normalizePhone(raw: string): string {
    let s = raw.trim();
    s = s.replace(/[०-९]/g, (d) => DEVANAGARI_DIGITS[d] ?? d);
    s = s.replace(/[\s\-().]/g, '');
    s = s.replace(/^\+?977/, '');
    s = s.replace(/^00977/, '');
    return s;
  }

  function isValidPhone(raw: string): boolean {
    const n = normalizePhone(raw);
    return /^9[678]\d{8}$/.test(n);
  }

  function initForm(form: HTMLFormElement) {
    const locale = (form.dataset.locale === 'en' ? 'en' : 'ne') as 'ne' | 'en';
    const msgs = MESSAGES[locale];
    const phoneInput = form.querySelector<HTMLInputElement>('input[name="phone"]');
    const consentInput = form.querySelector<HTMLInputElement>('input[name="consent"]');
    const submitBtn = form.querySelector<HTMLButtonElement>('.submit-btn');
    const message = form.querySelector<HTMLParagraphElement>('.form-message');
    const phoneError = form.querySelector<HTMLElement>('[id$="-phone-error"]');
    const consentError = form.querySelector<HTMLElement>('[id$="-consent-error"]');

    // Fill UTM params + phone normalization on submit.
    try {
      const params = new URLSearchParams(window.location.search);
      form.querySelectorAll<HTMLInputElement>('input[data-utm]').forEach((el) => {
        const key = el.dataset.utm;
        if (key) el.value = params.get(key) ?? '';
      });
    } catch {
      // URLSearchParams unsupported or blocked, hidden fields stay empty.
    }

    function setStatus(status: Status) {
      if (!submitBtn || !message) return;
      submitBtn.disabled = status === 'submitting';
      submitBtn.textContent = status === 'submitting' ? msgs.submitting : msgs.submit;

      const shownMessages: Partial<Record<Status, string>> = {
        created: msgs.created,
        already_on_list: msgs.already_on_list,
        has_account: msgs.has_account,
        rate_limited: msgs.rate_limited,
        network: msgs.network,
      };

      const text = shownMessages[status];
      if (text) {
        message.textContent = text;
        message.hidden = false;
        if (status === 'has_account') {
          const link = document.createElement('a');
          link.href = form.dataset.appUrl || 'https://app.airfone.app';
          link.textContent = locale === 'ne' ? 'साइन इन गर्नुहोस्' : 'Sign in';
          message.append(' ', link);
        }
      } else if (status === 'idle' || status === 'submitting') {
        message.hidden = true;
      }

      if (status === 'created' || status === 'already_on_list') {
        form.querySelectorAll('input, select, button').forEach((el) => {
          (el as HTMLInputElement).disabled = true;
        });
      }
    }

    function clearFieldErrors() {
      if (phoneError) { phoneError.hidden = true; phoneError.textContent = ''; }
      if (consentError) { consentError.hidden = true; consentError.textContent = ''; }
    }

    function showFieldError(el: HTMLElement | null, input: HTMLInputElement | null, text: string) {
      if (!el || !input) return;
      el.textContent = text;
      el.hidden = false;
      input.setAttribute('aria-invalid', 'true');
      input.focus();
    }

    // No-JS submissions land back here with ?waitlist=invalid#waitlist. Show
    // the message even though this form re-renders fresh (no JS required to
    // see it: the query check below only adds the extra explanatory text).
    try {
      const params = new URLSearchParams(window.location.search);
      if (params.get('waitlist') === 'invalid') {
        if (message) {
          message.textContent = msgs.invalidFromLink;
          message.hidden = false;
        }
        phoneInput?.setAttribute('aria-invalid', 'true');
      }
    } catch {
      // ignore
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearFieldErrors();

      // Honeypot: if filled, silently pretend success.
      const honeypot = form.querySelector<HTMLInputElement>('input[name="website"]');
      if (honeypot && honeypot.value.trim() !== '') {
        setStatus('created');
        return;
      }

      if (!phoneInput || !isValidPhone(phoneInput.value)) {
        showFieldError(phoneError, phoneInput, msgs.invalidPhone);
        return;
      }
      if (!consentInput || !consentInput.checked) {
        showFieldError(consentError, consentInput, msgs.invalidConsent);
        return;
      }

      setStatus('submitting');

      const payload = {
        phone: normalizePhone(phoneInput.value),
        business_type: (form.querySelector<HTMLSelectElement>('select[name="business_type"]'))?.value || undefined,
        email: (form.querySelector<HTMLInputElement>('input[name="email"]'))?.value || undefined,
        locale,
        consent: true,
        website: (form.querySelector<HTMLInputElement>('input[name="website"]'))?.value || '',
        source: (form.querySelector<HTMLInputElement>('input[name="source"]'))?.value,
        utm_source: (form.querySelector<HTMLInputElement>('input[name="utm_source"]'))?.value || undefined,
        utm_medium: (form.querySelector<HTMLInputElement>('input[name="utm_medium"]'))?.value || undefined,
        utm_campaign: (form.querySelector<HTMLInputElement>('input[name="utm_campaign"]'))?.value || undefined,
      };

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (res.status === 429) {
          setStatus('rate_limited');
          return;
        }
        if (res.status === 403 || res.status >= 500) {
          setStatus('network');
          return;
        }
        if (res.status === 422 || res.status === 400) {
          let body: any = null;
          try { body = await res.json(); } catch { /* ignore */ }
          // API shape: { status: 'invalid', errors: { phone?: code, consent?: code, email?: code } }
          const errors = body?.errors ?? {};
          setStatus('idle');
          if (errors.consent) showFieldError(consentError, consentInput, msgs.invalidConsent);
          if (errors.phone || !errors.consent) showFieldError(phoneError, phoneInput, msgs.invalidPhone);
          return;
        }

        let body: any = null;
        try { body = await res.json(); } catch { /* ignore */ }
        const status: string | undefined = body?.status ?? body?.code;

        if (res.ok) {
          if (status === 'already_on_list') setStatus('already_on_list');
          else if (status === 'has_account') setStatus('has_account');
          else setStatus('created');
        } else {
          setStatus('network');
        }
      } catch {
        setStatus('network');
      }
    });
  }

  document.querySelectorAll<HTMLFormElement>('form[data-waitlist-form]').forEach(initForm);
</script>

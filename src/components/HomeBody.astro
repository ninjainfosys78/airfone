---
import WaitlistForm from './WaitlistForm.astro';
import LaunchBand from './LaunchBand.astro';
import CallCard from './CallCard.astro';
import CallTranscript from './CallTranscript.astro';
import StructuredData from './StructuredData.astro';
import { Image } from 'astro:assets';
import { photos } from '../data/photos';
import { LAUNCHED, APP_URL } from '../config/site';
import type { Locale } from '../i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy = {
  ne: {
    h1: 'ग्राहकका फोन AI ले उठाउँछ, नेपालीमा।',
    tryFree: 'निःशुल्क सुरु गर्नुहोस्',
    problemH2: 'दिनभरि उही प्रश्न, उही जवाफ',
    problemQuotes: ['मूल्य कति हो?', 'स्टकमा छ?', 'अफिस कहिले खुल्छ?', 'डेलिभरी हुन्छ?'],
    setupH2: 'तीन चरणमा तयार',
    steps: [
      { title: 'व्यवसायबारे सिकाउनुहोस्', body: 'बोलेर, वेबसाइटको लिंक राखेर, फेसबुक पेज जोडेर वा फोटो र भिडियो देखाएर। AirFone ले त्यसैबाट एजेन्टको जानकारी तयार गर्छ।' },
      { title: 'आफैं फोन गरेर जाँच्नुहोस्', body: 'आफ्नो डेमो नम्बरमा PIN सहित फोन गर्नुहोस् र ग्राहकले झैं प्रश्न सोध्नुहोस्।' },
      { title: 'ग्राहकका लागि खोल्नुहोस्', body: 'ठीक लागेपछि आफ्नै AirFone नम्बर लिनुहोस् र साँचो कल लिन थाल्नुहोस्।' },
    ],
    whoH2: 'पसलदेखि विद्यालयसम्म',
    who: [
      { type: 'पसल', q: 'यो मोबाइलको मूल्य कति हो?' },
      { type: 'अनलाइन स्टोर', q: 'काठमाडौं बाहिर डेलिभरी हुन्छ?' },
      { type: 'क्लिनिक र अस्पताल', q: 'आज डाक्टर कति बजेसम्म बस्नुहुन्छ?' },
      { type: 'विद्यालय', q: 'कक्षा ११ को भर्ना कहिलेदेखि खुल्छ?' },
      { type: 'रेस्टुरेन्ट', q: 'शनिबार खुला हुन्छ?' },
    ],
    faqH2: 'प्रायः सोधिने प्रश्न',
    faq: [
      { q: 'एजेन्टलाई जवाफ थाहा नभए के हुन्छ?', a: 'त्यो जानकारी आफूसँग छैन भन्छ। जवाफ आफैं बनाएर दिँदैन।' },
      { q: 'सेटअप गर्न प्राविधिक ज्ञान चाहिन्छ?', a: 'चाहिँदैन। व्यवसायबारे बोलेर वा लिंक राखेर सिकाउन सकिन्छ।' },
      { q: 'मूल्य कति पर्छ?', a: 'मूल्य २८ सेप्टेम्बरमा सुरुवातसँगै सार्वजनिक गर्नेछौं। सूचीमा नाम लेखाउनेलाई पहिले जानकारी दिनेछौं।' },
      { q: 'WhatsApp मा पनि चल्छ?', a: 'अहिले फोन कलमा चल्छ। WhatsApp छिट्टै थपिँदैछ।' },
    ],
  },
  en: {
    h1: 'Your customer calls, answered by AI in Nepali.',
    tryFree: 'Try it free',
    problemH2: 'The same questions, all day',
    problemQuotes: ['How much is it?', 'Is it in stock?', 'When is the office open?', 'Do you deliver?'],
    setupH2: 'Ready in three steps',
    steps: [
      { title: 'Teach it your business', body: "Talk to it, paste your website link, connect your Facebook page, or show photos and videos. AirFone builds the agent's knowledge from that." },
      { title: 'Call it yourself', body: 'Call your demo number with your PIN and ask what your customers ask.' },
      { title: 'Go live', body: "When you're happy, get your own AirFone number and start taking real calls." },
    ],
    whoH2: 'From shops to schools',
    who: [
      { type: 'Shops', q: 'How much is this phone?' },
      { type: 'Online stores', q: 'Do you deliver outside Kathmandu?' },
      { type: 'Clinics and hospitals', q: 'Until what time is the doctor in today?' },
      { type: 'Schools', q: 'When does Grade 11 admission open?' },
      { type: 'Restaurants', q: 'Are you open on Saturday?' },
    ],
    faqH2: 'Common questions',
    faq: [
      { q: "What if the agent doesn't know an answer?", a: "It says it doesn't have that information. It doesn't make one up." },
      { q: 'Do I need technical skills?', a: 'No. You teach it by talking or pasting a link.' },
      { q: 'How much does it cost?', a: "We'll publish pricing at launch on 28 September. People on the waitlist hear first." },
      { q: 'Does it work on WhatsApp?', a: 'It works on phone calls today. WhatsApp is coming soon.' },
    ],
  },
} as const;

const c = copy[locale];
const numerals = locale === 'ne' ? ['१', '२', '३'] : ['1', '2', '3'];
---
<StructuredData locale={locale} home faq={c.faq} />

<section class="hero on-night">
  <div class="wrap hero-grid">
    <h1 class="hero-title">{c.h1}</h1>
    <div class="hero-visual">
      <CallCard locale={locale} />
    </div>
    <div class="hero-form" id="waitlist">
      {LAUNCHED ? (
        <a class="btn btn-primary btn-large" href={APP_URL}>{c.tryFree}</a>
      ) : (
        <WaitlistForm locale={locale} id="hero" source="hero" compact />
      )}
    </div>
  </div>
</section>

<section class="problem on-tint">
  <div class="problem-media">
    <Image
      class="problem-photo"
      src={photos.kathmanduCall.src}
      alt={photos.kathmanduCall.alt[locale]}
      widths={[480, 800, 1200, 1600]}
      sizes="(min-width: 900px) 50vw, 100vw"
      loading="lazy"
    />
  </div>
  <div class="problem-body">
    <h2>{c.problemH2}</h2>
    <ul class="asks">
      {c.problemQuotes.map((q) => <li>{q}</li>)}
    </ul>
  </div>
</section>

<CallTranscript locale={locale} />

<section class="setup on-brand">
  <div class="wrap">
    <h2>{c.setupH2}</h2>
    <ol class="steps">
      {c.steps.map((step, i) => (
        <li>
          <span class="numeral" aria-hidden="true">{numerals[i]}</span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="who">
  <div class="wrap">
    <h2>{c.whoH2}</h2>
    <div class="strip">
      <figure class="f-shop">
        <Image class="photo" src={photos.shopkeeper.src} alt={photos.shopkeeper.alt[locale]} widths={[640, 960, 1400]} sizes="(min-width: 1120px) 540px, (min-width: 900px) 48vw, 100vw" loading="lazy" />
        <figcaption>{c.who[0].type}</figcaption>
      </figure>
      <figure class="f-school">
        <Image class="photo" src={photos.classroom.src} alt={photos.classroom.alt[locale]} widths={[320, 540, 800]} sizes="(min-width: 1120px) 264px, (min-width: 900px) 24vw, 50vw" loading="lazy" />
        <figcaption>{c.who[3].type}</figcaption>
      </figure>
      <figure class="f-food">
        <Image class="photo" src={photos.restaurant.src} alt={photos.restaurant.alt[locale]} widths={[320, 540, 800]} sizes="(min-width: 1120px) 264px, (min-width: 900px) 24vw, 50vw" loading="lazy" />
        <figcaption>{c.who[4].type}</figcaption>
      </figure>
    </div>
    <dl class="who-list">
      {c.who.map((row) => (
        <div class="who-row">
          <dt>{row.type}</dt>
          <dd>{row.q}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<section class="faq">
  <div class="wrap split">
    <div>
      <h2>{c.faqH2}</h2>
    </div>
    <div class="faq-list">
      {c.faq.map((item) => (
        <details>
          <summary>
            <span class="faq-q">{item.q}</span>
            <span class="faq-icon" aria-hidden="true"></span>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<LaunchBand locale={locale} source="closing" />

<style>
  h2 {
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.15;
    max-width: 18ch;
  }
  .split {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 900px) {
    .split {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
      align-items: start;
    }
  }

  /* Hero: dark stage. Phones: headline, call, form. Desktop: headline and form left, call right. */
  .hero {
    padding: 48px 0 72px;
  }
  .hero-grid {
    display: grid;
    grid-template-areas: 'title' 'call' 'form';
    gap: 40px;
  }
  .hero-title {
    grid-area: title;
    color: var(--night-ink);
    max-width: 13ch;
  }
  .hero-visual {
    grid-area: call;
  }
  .hero-form {
    grid-area: form;
    max-width: 520px;
  }
  .btn-large {
    padding: 16px 28px;
    font-size: 18px;
  }
  @media (min-width: 1000px) {
    .hero {
      padding: 104px 0 120px;
    }
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: 'title call' 'form call';
      grid-template-rows: auto 1fr;
      column-gap: 88px;
      row-gap: 40px;
      align-items: start;
    }
  }

  /* Problem: full-bleed editorial split. Photo runs to the left edge,
     text aligns to the site container on the right. */
  .problem {
    display: grid;
  }
  .problem-media {
    aspect-ratio: 4 / 5;
    max-height: 72vh;
    overflow: hidden;
  }
  .problem-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }
  .problem-body {
    padding: 72px var(--gutter) 96px;
  }
  .asks {
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .asks li {
    font-family: 'Instrument Sans', 'Noto Serif Devanagari', system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.25;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .problem {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      min-height: 760px;
    }
    .problem-media {
      aspect-ratio: auto;
      max-height: none;
      height: 100%;
    }
    .problem-body {
      align-self: center;
      padding: 120px max(var(--gutter), calc((100vw - var(--max-width)) / 2 + var(--gutter))) 120px 72px;
    }
  }

  .photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-panel);
    background: var(--line);
  }

  /* Setup: solid brand band */
  .setup {
    padding: 120px 0;
    background: var(--brand);
    color: var(--on-brand);
  }
  .setup h2 {
    color: var(--on-brand);
  }
  .steps {
    list-style: none;
    margin: 72px 0 0;
    padding: 0;
    display: grid;
    gap: 48px;
  }
  .steps li {
    border-top: 2px solid var(--on-brand);
    padding-top: 24px;
  }
  .numeral {
    display: block;
    font-family: 'Instrument Sans', 'Noto Serif Devanagari', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(4rem, 7vw, 6rem);
    line-height: 1;
    color: var(--on-brand);
  }
  .steps h3 {
    margin-top: 28px;
    font-size: 24px;
    color: var(--on-brand);
  }
  .steps p {
    margin: 10px 0 0;
    font-size: 17px;
    line-height: 1.55;
    color: var(--on-brand);
  }
  @media (min-width: 900px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 56px;
    }
  }

  /* Who: photos of real businesses, then example questions */
  .who {
    padding: 120px 0;
  }
  /* Every photo is pre-cropped to its frame. Phones: shop full width, then
     school and restaurant side by side. Desktop: one row of equal height
     (3:2 + 3:4 + 3:4 at 2fr 1fr 1fr). */
  .strip {
    margin-top: 56px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-areas: 'shop shop' 'school food';
    gap: 12px;
  }
  .strip figure {
    margin: 0;
  }
  .f-shop { grid-area: shop; }
  .f-school { grid-area: school; }
  .f-food { grid-area: food; }
  .f-shop .photo { aspect-ratio: 3 / 2; height: auto; }
  .f-school .photo,
  .f-food .photo { aspect-ratio: 3 / 4; height: auto; }
  .strip figcaption {
    margin-top: 10px;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink-muted);
  }
  @media (min-width: 900px) {
    .strip {
      grid-template-columns: 2fr 1fr 1fr;
      grid-template-areas: 'shop school food';
      gap: 16px;
    }
  }
  .who-list {
    margin: 64px 0 0;
    border-top: 1px solid var(--line);
  }
  .who-row {
    display: grid;
    gap: 6px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .who-row dt {
    font-size: 16px;
    font-weight: 600;
    color: var(--brand-ink);
  }
  .who-row dd {
    margin: 0;
    font-family: 'Instrument Sans', 'Noto Serif Devanagari', system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    line-height: 1.3;
  }
  @media (min-width: 700px) {
    .who-row {
      grid-template-columns: minmax(180px, 5fr) 7fr;
      gap: 24px;
      align-items: baseline;
    }
  }

  /* FAQ */
  .faq {
    padding: 120px 0;
  }
  .faq-list {
    border-top: 1px solid var(--line);
  }
  .faq-list details {
    border-bottom: 1px solid var(--line);
  }
  .faq-list summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 72px;
    padding: 18px 0;
    cursor: pointer;
    font-weight: 600;
    font-size: 20px;
  }
  .faq-list summary::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    position: relative;
    flex: 0 0 16px;
    width: 16px;
    height: 16px;
  }
  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    background: var(--ink-muted);
    border-radius: 1px;
  }
  .faq-icon::before {
    left: 0;
    right: 0;
    top: 7px;
    height: 2px;
  }
  .faq-icon::after {
    top: 0;
    bottom: 0;
    left: 7px;
    width: 2px;
    transition: transform 150ms ease-out;
  }
  details[open] .faq-icon::after {
    transform: scaleY(0);
  }
  .faq-list p {
    margin: 0 0 24px;
    font-size: 18px;
    color: var(--ink-muted);
    max-width: 60ch;
  }

</style>

---
import { fmtDate, type Post } from '../../lib/posts';
import { tagLabel } from '../../lib/blog';
export interface Props { items: Post[] }
const { items } = Astro.props;
---
<ul class="posts">
  {items.map((p) => (
    <li>
      <a href={`/blog/${p.id}`}>
        <time datetime={p.data.date.toISOString()} class="muted small">{fmtDate(p.data.date)}</time>
        <span class="title">{p.data.title}{p.data.draft && <span class="draft"> (draft)</span>}</span>
        <span class="tags muted small">{p.data.tags.map(tagLabel).join(', ')}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .posts { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  a { display: grid; grid-template-columns: 180px 1fr auto; gap: var(--space-5); align-items: baseline; padding: var(--space-5) 0; border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  a:hover .title { color: var(--link); text-decoration: underline; }
  .title { font-size: 1.25rem; font-weight: 600; overflow-wrap: anywhere; }
  .draft { color: var(--error); font-weight: 400; }
  @media (max-width: 767px) { a { grid-template-columns: 1fr; gap: var(--space-1); } }
</style>

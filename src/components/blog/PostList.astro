---
import PostCard from './PostCard.astro';
import type { Post } from '../../lib/posts';
export interface Props { items: Post[]; feature?: boolean; level?: 'h2' | 'h3' }
const { items, feature = false, level = 'h2' } = Astro.props;
const [first, ...rest] = items;
const list = feature ? rest : items;
---
{feature && first && <div class="top-post" data-enter><PostCard post={first} big level={level} /></div>}
{list.length > 0 && (
  <ul class="grid">
    {list.map((p, i) => <li data-enter style={`--d:${i + 1}`}><PostCard post={p} level={level} /></li>)}
  </ul>
)}

<style>
  .top-post { margin-bottom: var(--space-8); }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-8) var(--space-6); }
  @media (max-width: 959px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 599px) { .grid { grid-template-columns: 1fr; gap: var(--space-7); } }
</style>

---
import { fmtDate, type Post } from '../../lib/posts';
export interface Props { post: Post; big?: boolean; level?: 'h2' | 'h3' }
const { post, big = false, level = 'h2' } = Astro.props;
const d = post.data;
const H = level;
---
<article class:list={['card', { big }]}>
  <div class="text">
    <H class="title"><a href={`/blog/${post.id}`}>{d.title}{d.draft && <span class="draft"> (draft)</span>}</a></H>
    <span class="meta"><time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time></span>
  </div>
</article>

<style>
  .card { position: relative; display: grid; gap: var(--space-4); align-content: start; padding-top: var(--space-5); border-top: 1px solid var(--line); height: 100%; }
  .text { display: grid; gap: var(--space-2); }
  .title { font-size: 1.25rem; line-height: 1.3; margin: 0; overflow-wrap: anywhere; }
  .title a { color: var(--ink); text-decoration: none; transition: color var(--fast) var(--ease); }
  /* The whole card is one target through the title link. */
  .title a::after { content: ''; position: absolute; inset: 0; }
  .card:hover .title a { color: var(--link); }
  .title a:focus-visible { outline: none; }
  .card:has(.title a:focus-visible) { outline: 2px solid var(--brand); outline-offset: 6px; border-radius: var(--radius-panel); }
  .meta { font-size: 14px; color: var(--ink-muted); }
  .draft { color: var(--error); font-weight: 400; }
  /* The newest post: a green panel, title large, nothing repeated. */
  .big { padding: var(--space-8); border: 0; border-radius: var(--radius-panel); background: var(--stage); min-height: 300px; align-content: end; }
  .big .title { font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.75rem); line-height: 1.15; max-width: 22ch; }
  .big .title a { color: var(--stage-ink); }
  .big:hover .title a { color: var(--stage-ink); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .big .meta { color: var(--stage-muted); }
  .big .text { gap: var(--space-3); }
  @media (max-width: 599px) { .big { padding: var(--space-6); min-height: 240px; } }
</style>

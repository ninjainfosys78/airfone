---
// One story on the blog front, in four sizes: `top` (the top story, big photo,
// headline and standfirst), `side` (beside the lead), `grid` (photo card) and
// `list` (headline only, numbered or plain). Every story shows a picture: its
// cover, else its generated share card.
import { Image } from 'astro:assets';
import { coverFor, fmtDate, readMinutes, type Post } from '../../lib/posts';
import { tagLabel } from '../../lib/blog';
export interface Props { post: Post; size: 'top' | 'side' | 'grid' | 'list'; level?: 'h2' | 'h3'; n?: number; eager?: boolean }
const { post, size, level = 'h3', n, eager = false } = Astro.props;
const d = post.data;
const H = level;
const href = `/blog/${post.id}`;
const widths = { top: [640, 960, 1280], side: [240, 360, 480], grid: [400, 600, 800], list: [] }[size];
const sizes = { top: '(max-width: 899px) 100vw, 760px', side: '120px', grid: '(max-width: 599px) 100vw, (max-width: 959px) 50vw, 300px', list: '' }[size];
---
<article class:list={['story', size]}>
  {size !== 'list' && (
    <div class="pic">
      {d.cover
        ? <Image src={d.cover} alt="" widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
        : <img src={coverFor(post)} alt="" width="1200" height="630" loading={eager ? 'eager' : 'lazy'} />}
    </div>
  )}
  {n !== undefined && <span class="n" aria-hidden="true">{n}</span>}
  <div class="text">
    <H class="h"><a href={href}>{d.title}</a></H>
    {size === 'top' && <p class="dek">{d.description}</p>}
    <p class="meta">
      <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
      {size !== 'side' && <> · {readMinutes(post)} min read</>}
      {(size === 'top' || size === 'grid') && d.tags[0] && <> · {tagLabel(d.tags[0])}</>}
    </p>
  </div>
</article>

<style>
  .story { position: relative; display: grid; gap: var(--space-3); align-content: start; }
  .pic { overflow: hidden; border-radius: var(--radius-panel); background: var(--surface); aspect-ratio: 16 / 9; }
  .pic img, .pic :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; transition: opacity var(--fast) var(--ease); }
  .story:hover .pic :global(img) { opacity: 0.9; }
  .text { display: grid; gap: var(--space-2); }
  .h { margin: 0; font-weight: 600; line-height: 1.2; text-wrap: balance; overflow-wrap: anywhere; }
  .h a { color: var(--ink); text-decoration: none; }
  /* The whole story is one target through its headline link. */
  .h a::after { content: ''; position: absolute; inset: 0; }
  .story:hover .h a { color: var(--link); }
  .h a:focus-visible { outline: none; }
  .story:has(.h a:focus-visible) { outline: 2px solid var(--brand); outline-offset: 6px; border-radius: var(--radius-panel); }
  .meta { margin: 0; font-size: 14px; color: var(--ink-muted); }
  .dek { margin: 0; font-size: 1.0625rem; line-height: 1.5; color: var(--ink-muted); max-width: 60ch; }

  .top { gap: var(--space-4); }
  .top .h { font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem); line-height: 1.12; }
  .grid .h { font-size: 1.1875rem; }
  .side { grid-template-columns: minmax(0, 1fr) 112px; gap: var(--space-4); padding-block: var(--space-4); border-top: 1px solid var(--line); }
  .side .pic { order: 2; aspect-ratio: 1 / 1; }
  .side .h { font-size: 1.0625rem; line-height: 1.3; }
  .list { grid-template-columns: auto 1fr; gap: var(--space-4); padding-block: var(--space-4); border-top: 1px solid var(--line); }
  .list:not(:has(.n)) { grid-template-columns: 1fr; }
  .list .h { font-size: 1.0625rem; line-height: 1.3; }
  .n { font-size: 2rem; font-weight: 600; line-height: 1; color: var(--link); min-width: 1.2em; }
</style>

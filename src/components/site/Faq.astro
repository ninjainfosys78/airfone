---
import type { Faq } from '../../data/products';
export interface Props { items: Faq[]; heading?: string }
const { items, heading = 'Questions' } = Astro.props;
---
<section class="section faq" data-reveal>
  <div class="wrap two">
    <h2>{heading}</h2>
    <div>
      {items.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p class="muted">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .two { display: grid; grid-template-columns: 1fr 1.4fr; gap: var(--space-8); align-items: start; }
  details { border-bottom: 1px solid var(--line); }
  details:first-child { border-top: 1px solid var(--line); }
  summary { cursor: pointer; padding: var(--space-4) 0; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: var(--space-4); min-height: 44px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; color: var(--link); font-weight: 400; font-size: 1.5rem; line-height: 1; }
  details[open] summary::after { content: '\2212'; }
  details p { padding-bottom: var(--space-4); }
  @media (max-width: 959px) { .two { grid-template-columns: 1fr; gap: var(--space-6); } }
</style>

---
import { DEMO_NUMBER_DISPLAY, DEMO_NUMBER_TEL } from '../../config/site';
export interface Props { heading?: string }
const { heading = 'Hear AirFone answer your calls' } = Astro.props;
---
<section class="cta on-stage" data-reveal>
  <div class="wrap inner">
    <h2>{heading}</h2>
    <div class="actions">
      <a class="btn btn-lime" href="/demo">Book a demo</a>
      <a class="btn btn-secondary" href={DEMO_NUMBER_TEL}>Call {DEMO_NUMBER_DISPLAY}</a>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: var(--space-9); }
  h2 { color: var(--stage-ink); }
  .inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); flex-wrap: wrap; }
  h2 { max-width: 18ch; }
  .actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }
</style>

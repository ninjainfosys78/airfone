---
// Google One Tap and the header's Google button: the "Continue as <name>" prompt for visitors already
// signed in to Google. The credential is handed to the AirFone app in the
// URL fragment (never sent to this site's server); the app trades it for
// a session at /api/auth/google. The client id is public.
import { APP_URL } from '../../config/site';
const CLIENT_ID = '801237312001-p3ir2gc38mesec2riv6e5odjhfjrp7p1.apps.googleusercontent.com';
---
<script is:inline define:vars={{ CLIENT_ID, APP_URL }}>
  (function () {
    function start() {
      var s = document.createElement('script');
      s.src = 'https://accounts.google.com/gsi/client';
      s.async = true;
      s.onload = function () {
        if (!window.google || !google.accounts) return;
        google.accounts.id.initialize({
          client_id: CLIENT_ID,
          auto_select: false,
          cancel_on_tap_outside: true,
          context: 'signin',
          itp_support: true,
          use_fedcm_for_prompt: true,
          callback: function (r) {
            if (!r || !r.credential) return;
            location.href = APP_URL + '/welcome#google_credential=' + encodeURIComponent(r.credential);
          },
        });
        document.querySelectorAll('[data-gsi-button]').forEach(function (el) {
          var slot = el.closest('[data-gsi-slot]');
          google.accounts.id.renderButton(el, {
            type: 'standard',
            theme: 'outline',
            size: 'large',
            shape: 'pill',
            text: 'continue_with',
            logo_alignment: 'left',
            width: 250,
          });
          // Reveal once Google's frame has loaded its final (personalised)
          // version, not the first draft it paints.
          var frame = el.querySelector('iframe');
          var show = function () { if (slot) slot.classList.add('ready'); };
          if (frame) frame.addEventListener('load', function () { setTimeout(show, 120); });
          else show();
        });
        google.accounts.id.prompt();
      };
      document.head.appendChild(s);
    }
    // Async, so it never blocks the page; started right away so the header
    // button is there quickly.
    start();
    setTimeout(function () {
      document.querySelectorAll('[data-gsi-slot]:not(.ready)').forEach(function (s) {
        s.classList.add('fallback');
      });
    }, 4000);
  })();
</script>

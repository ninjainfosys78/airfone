---
import { footerColumns } from '../../data/nav';
import { COMPANY, CONTACT_EMAIL, CONTACT_PHONE_DISPLAY, CONTACT_PHONE_TEL, OFFICE_LINE, LEGAL_ADDRESS_LINE, SOCIAL_PROFILES } from '../../config/site';
import { siFacebook, siInstagram, siTiktok } from 'simple-icons';

// LinkedIn is not in simple-icons; this is its standard "in" mark.
const linkedin = 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';
const icon: Record<string, { name: string; path: string }> = {
  facebook: { name: 'Facebook', path: siFacebook.path },
  instagram: { name: 'Instagram', path: siInstagram.path },
  tiktok: { name: 'TikTok', path: siTiktok.path },
  linkedin: { name: 'LinkedIn', path: linkedin },
};
const social = SOCIAL_PROFILES.map((href) => ({ href, ...icon[Object.keys(icon).find((k) => href.includes(k))!] }));
---
<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div class="brand">
        <img src="/brand/airfone-mark.svg" alt="" width="96" height="59" class="cloud" aria-hidden="true" />
        <p class="contact">
          <a href={CONTACT_PHONE_TEL}>{CONTACT_PHONE_DISPLAY}</a><br />
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a><br />
          <span class="muted">{OFFICE_LINE}</span>
        </p>
        <ul class="social">
          {social.map((x) => (
            <li><a href={x.href} rel="me noopener" target="_blank" aria-label={`AirFone on ${x.name}`}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={x.path} fill="currentColor" /></svg></a></li>
          ))}
        </ul>
      </div>
      {footerColumns.map((col) => (
        <nav aria-label={col.title}>
          <h2 class="col-title">{col.title}</h2>
          <ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <p class="legal muted">© {new Date().getFullYear()} {COMPANY}, {LEGAL_ADDRESS_LINE}</p>
  </div>
</footer>

<style>
  .social { list-style: none; margin: var(--space-4) 0 0; padding: 0; display: flex; gap: var(--space-2); }
  .social a { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; color: var(--ink-muted); transition: color var(--fast) var(--ease), background-color var(--fast) var(--ease); }
  .social a:hover { color: var(--brand); background: var(--subtle); }
  .site-footer { background: var(--surface); padding: var(--space-9) 0 var(--space-6); }
  .top { display: grid; grid-template-columns: 1.4fr repeat(4, 1fr); gap: var(--space-6); }
  .cloud { width: 96px; height: auto; margin-bottom: var(--space-5); }
  .contact { font-size: 14px; line-height: 1.8; color: var(--ink-muted); }
  .contact a { color: var(--ink-muted); text-decoration: none; }
  .contact a:hover { text-decoration: underline; }
  .col-title { font-size: 14px; font-weight: 600; margin-bottom: var(--space-3); }
  ul { list-style: none; margin: 0; padding: 0; }
  li a { display: inline-block; padding: 4px 0; color: var(--ink-muted); text-decoration: none; font-size: 14px; }
  li a:hover { color: var(--ink); text-decoration: underline; }
  .legal { font-size: 13px; margin-top: var(--space-8); padding-top: var(--space-5); border-top: 1px solid var(--line); }
  @media (max-width: 959px) {
    .top { grid-template-columns: 1fr 1fr; }
    .brand { grid-column: 1 / -1; }
  }
</style>

---
import { footerColumns } from '../../data/nav';
import { COMPANY, CONTACT_EMAIL, CONTACT_PHONE_DISPLAY, CONTACT_PHONE_TEL, ADDRESS } from '../../config/site';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div class="brand">
        <img src="/brand/airfone-mark.svg" alt="" width="96" height="59" class="cloud" aria-hidden="true" />
        <p class="contact">
          <a href={CONTACT_PHONE_TEL}>{CONTACT_PHONE_DISPLAY}</a><br />
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a><br />
          <span class="muted">{ADDRESS.locality}, {ADDRESS.countryName}</span>
        </p>
      </div>
      {footerColumns.map((col) => (
        <nav aria-label={col.title}>
          <h2 class="col-title">{col.title}</h2>
          <ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <p class="legal muted small">© {new Date().getFullYear()} AirFone, a product of {COMPANY}, {ADDRESS.locality}, {ADDRESS.countryName}.</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--surface); padding: var(--space-9) 0 var(--space-6); }
  .top { display: grid; grid-template-columns: 1.4fr repeat(4, 1fr); gap: var(--space-6); }
  .cloud { width: 96px; height: auto; margin-bottom: var(--space-5); }
  .contact { font-size: 16px; line-height: 1.8; }
  .contact a { color: var(--ink); text-decoration: none; }
  .contact a:hover { text-decoration: underline; }
  .col-title { font-size: 16px; font-weight: 600; margin-bottom: var(--space-3); }
  ul { list-style: none; margin: 0; padding: 0; }
  li a { display: inline-block; padding: 6px 0; color: var(--ink-muted); text-decoration: none; font-size: 16px; }
  li a:hover { color: var(--ink); text-decoration: underline; }
  .legal { margin-top: var(--space-8); padding-top: var(--space-5); border-top: 1px solid var(--line); }
  @media (max-width: 959px) {
    .top { grid-template-columns: 1fr 1fr; }
    .brand { grid-column: 1 / -1; }
  }
</style>

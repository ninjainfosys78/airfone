---
// Dashain bulk-call offer. Opens on every page load until Tika is over and
// covers the page until closed. Nepali copy; links straight to a new bulk call.
import '@fontsource/poppins/devanagari-600.css';
import { APP_URL } from '../../config/site';

const GREETING_URL = 'https://cdn.airfone.app/samples/landing/dashain-greeting.mp3';
---
<dialog id="dashain" class="dp" aria-labelledby="dp-title" data-ends="2026-10-22T00:00:00+05:45">
  <div class="hero">
    <svg class="kites" viewBox="0 0 400 260" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
      <g transform="translate(48 62) scale(1.1)"><g class="k" style="--d:7s;--dx:40px;--dy:-30px">
        <path d="M0 -30 24 0 0 30 -24 0Z" fill="#D7263D" />
        <path d="M0 -30 24 0 0 0Z M0 30 -24 0 0 0Z" fill="#FFD23F" />
        <path d="M0 30c-8 12 8 18 0 30s8 18 0 30" fill="none" stroke="#FFFFFF" stroke-opacity="0.55" stroke-width="2" />
      </g></g>
      <g transform="translate(352 176) scale(0.9)"><g class="k" style="--d:9s;--dx:-50px;--dy:-40px">
        <path d="M0 -30 24 0 0 30 -24 0Z" fill="#FFD23F" />
        <path d="M0 -30 24 0 0 0Z M0 30 -24 0 0 0Z" fill="#8BC53E" />
        <path d="M0 30c-8 12 8 18 0 30s8 18 0 30" fill="none" stroke="#FFFFFF" stroke-opacity="0.55" stroke-width="2" />
      </g></g>
      <g transform="translate(318 40) scale(0.55)"><g class="k" style="--d:6s;--dx:-35px;--dy:25px">
        <path d="M0 -30 24 0 0 30 -24 0Z" fill="#FFFFFF" />
        <path d="M0 -30 24 0 0 0Z M0 30 -24 0 0 0Z" fill="#D7263D" />
        <path d="M0 30c-8 12 8 18 0 30s8 18 0 30" fill="none" stroke="#FFFFFF" stroke-opacity="0.55" stroke-width="2" />
      </g></g>
      <g transform="translate(78 196) scale(0.6)"><g class="k" style="--d:8s;--dx:45px;--dy:-35px">
        <path d="M0 -30 24 0 0 30 -24 0Z" fill="#8BC53E" />
        <path d="M0 -30 24 0 0 0Z M0 30 -24 0 0 0Z" fill="#FFFFFF" />
        <path d="M0 30c-8 12 8 18 0 30s8 18 0 30" fill="none" stroke="#FFFFFF" stroke-opacity="0.55" stroke-width="2" />
      </g></g>
      <g transform="translate(200 30) scale(0.45)"><g class="k" style="--d:10s;--dx:60px;--dy:20px">
        <path d="M0 -30 24 0 0 30 -24 0Z" fill="#FF8C1A" />
        <path d="M0 -30 24 0 0 0Z M0 30 -24 0 0 0Z" fill="#FFFFFF" />
        <path d="M0 30c-8 12 8 18 0 30s8 18 0 30" fill="none" stroke="#FFFFFF" stroke-opacity="0.55" stroke-width="2" />
      </g></g>
      <g transform="translate(250 220) scale(0.5)"><g class="k" style="--d:7.5s;--dx:-40px;--dy:-45px">
        <path d="M0 -30 24 0 0 30 -24 0Z" fill="#D7263D" />
        <path d="M0 -30 24 0 0 0Z M0 30 -24 0 0 0Z" fill="#8BC53E" />
        <path d="M0 30c-8 12 8 18 0 30s8 18 0 30" fill="none" stroke="#FFFFFF" stroke-opacity="0.55" stroke-width="2" />
      </g></g>
      <g transform="translate(140 120) scale(0.4)"><g class="k" style="--d:11s;--dx:55px;--dy:30px">
        <path d="M0 -30 24 0 0 30 -24 0Z" fill="#FFFFFF" />
        <path d="M0 -30 24 0 0 0Z M0 30 -24 0 0 0Z" fill="#FFD23F" />
        <path d="M0 30c-8 12 8 18 0 30s8 18 0 30" fill="none" stroke="#FFFFFF" stroke-opacity="0.55" stroke-width="2" />
      </g></g>
      <g transform="translate(380 90) scale(0.5)"><g class="k" style="--d:8.5s;--dx:-60px;--dy:35px">
        <path d="M0 -30 24 0 0 30 -24 0Z" fill="#8BC53E" />
        <path d="M0 -30 24 0 0 0Z M0 30 -24 0 0 0Z" fill="#D7263D" />
        <path d="M0 30c-8 12 8 18 0 30s8 18 0 30" fill="none" stroke="#FFFFFF" stroke-opacity="0.55" stroke-width="2" />
      </g></g>
    </svg>

    <span class="tag-new">NEW</span>

    <svg class="burst" viewBox="0 0 100 100" aria-label="60% OFF" role="img">
      <path fill="#D7263D" d="M50 0l7 12 13-6 2 14 14 1-5 13 12 8-11 9 8 12-14 3 1 14-14-3-5 13-10-10-10 10-5-13-14 3 1-14-14-3 8-12-11-9 12-8-5-13 14-1 2-14 13 6z"/>
      <text x="50" y="49" text-anchor="middle" fill="#fff" font-size="24" font-weight="700" font-family="Poppins, sans-serif">60%</text>
      <text x="50" y="68" text-anchor="middle" fill="#fff" font-size="15" font-weight="700" font-family="Poppins, sans-serif">OFF</text>
    </svg>

    <p class="ribbon">दशैं धमाका अफर</p>
    <p class="deal">
      <span class="amt">रु १</span>
      <span class="unit">प्रति कल</span>
    </p>
  </div>

  <div class="body">
    <h2 id="dp-title">साथीभाइ र आफन्त सबैलाई एकैचोटि फोनमै दशैंको शुभकामना</h2>

    <button class="listen" type="button" aria-pressed="false">
      <span class="ic" aria-hidden="true">
        <svg class="i-play" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
        <svg class="i-pause" viewBox="0 0 24 24"><path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor"/></svg>
      </span>
      <span class="lbl">यस्तो सुनिन्छ, सुन्नुहोस्</span>
      <span class="bar" aria-hidden="true"><i></i></span>
    </button>
    <audio preload="none" src={GREETING_URL}></audio>

    <div class="timer" aria-label="अफर सकिन बाँकी समय">
      <p class="t-lbl">अफर सकिन बाँकी</p>
      <div class="boxes">
        <span><b data-u="d">०</b>दिन</span>
        <span><b data-u="h">००</b>घण्टा</span>
        <span><b data-u="m">००</b>मिनेट</span>
        <span><b data-u="s">००</b>सेकेन्ड</span>
      </div>
    </div>

    <a class="cta" href={`${APP_URL}/bulk-calls/new`}>अहिले शुभकामना पठाउनुहोस्</a>
    <button class="later" type="button" data-close>पछि हेर्छु</button>
  </div>

  <button class="x" type="button" data-close aria-label="बन्द गर्नुहोस्">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
  </button>
</dialog>

<script>
  const dlg = document.getElementById('dashain') as HTMLDialogElement | null;
  const ends = dlg ? new Date(dlg.dataset.ends!).getTime() : 0;

  if (dlg && typeof dlg.showModal === 'function' && Date.now() < ends && !/[?&]nopopup/.test(location.search)) {
    const ne = (n: number, pad = 2) => String(n).padStart(pad, '0').replace(/\d/g, (d) => '०१२३४५६७८९'[+d]);
    const units = Object.fromEntries([...dlg.querySelectorAll<HTMLElement>('[data-u]')].map((el) => [el.dataset.u, el]));
    const tick = () => {
      const left = Math.max(0, Math.floor((ends - Date.now()) / 1000));
      units.d.textContent = ne(Math.floor(left / 86400), 1);
      units.h.textContent = ne(Math.floor(left / 3600) % 24);
      units.m.textContent = ne(Math.floor(left / 60) % 60);
      units.s.textContent = ne(left % 60);
    };
    tick();
    const timer = setInterval(tick, 1000);

    const audio = dlg.querySelector('audio')!;
    const btn = dlg.querySelector('.listen') as HTMLButtonElement;
    const fill = dlg.querySelector('.bar i') as HTMLElement;
    btn.addEventListener('click', () => (audio.paused ? audio.play() : audio.pause()));
    audio.addEventListener('play', () => btn.setAttribute('aria-pressed', 'true'));
    audio.addEventListener('pause', () => btn.setAttribute('aria-pressed', 'false'));
    audio.addEventListener('timeupdate', () => {
      fill.style.transform = `scaleX(${audio.duration ? audio.currentTime / audio.duration : 0})`;
    });

    const close = () => dlg.close();
    dlg.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', close));
    dlg.addEventListener('close', () => {
      audio.pause();
      clearInterval(timer);
      document.documentElement.classList.remove('dp-lock');
    });

    document.documentElement.classList.add('dp-lock');
    dlg.showModal();
    btn.focus();
  }
</script>

<style is:global>
  html.dp-lock, html.dp-lock body { overflow: hidden; }
</style>

<style>
  /* AirFone colours, kept local so the same file works on other sites. */
  .dp {
    --brand: #2F4F08;
    --surface: #F4F8EC;
    --line: #DCE5CC;
    --ink: #16190F;
    --ink-muted: #3E4636;
    --canvas: #FFFFFF;
    --stage-muted: #C9D6B8;
    --font-display: 'Poppins', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --radius-control: 8px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 24px;
    --space-6: 32px;
    --space-7: 48px;
    --ease: cubic-bezier(0.2, 0, 0, 1);
    --fast: 150ms;
    position: fixed;
    inset: 0;
    width: min(920px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 16px;
    background: var(--canvas);
    color: var(--ink);
    overflow: auto;
    overscroll-behavior: contain;
  }
  .dp::backdrop { background: rgb(8 12 2 / 0.82); }

  /* Offer panel */
  .hero {
    position: relative;
    padding: 56px var(--space-5) var(--space-5);
    background: var(--brand);
    color: #fff;
    text-align: center;
    overflow: hidden;
  }
  .kites { position: absolute; inset: 0; width: 100%; height: 100%; }
  .k { transform-box: fill-box; transform-origin: 50% 100%; }
  @media (prefers-reduced-motion: no-preference) {
    .k { animation: kite-float var(--d) ease-in-out infinite alternate; }
    .tag-new { animation: beep 900ms ease-in-out infinite; }
  }
  @keyframes kite-float {
    0% { transform: translate(0, 0) rotate(-8deg); }
    33% { transform: translate(calc(var(--dx) * 0.6), calc(var(--dy) * -0.4)) rotate(6deg); }
    66% { transform: translate(calc(var(--dx) * -0.3), var(--dy)) rotate(-4deg); }
    100% { transform: translate(var(--dx), calc(var(--dy) * 0.5)) rotate(8deg); }
  }
  @keyframes beep {
    0%, 100% { transform: rotate(-5deg) scale(1); }
    50% { transform: rotate(-5deg) scale(1.35); }
  }
  .tag-new {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    padding: 6px 12px;
    border-radius: 6px;
    background: #8BC53E;
    color: #0D1502;
    font: 700 18px/1 var(--font-display);
    letter-spacing: 0.04em;
    transform: rotate(-5deg);
    transform-origin: center;
  }
  .burst { position: absolute; top: 44px; right: 10px; width: 96px; height: 96px; transform: rotate(12deg); }
  .ribbon {
    position: relative;
    display: inline-block;
    margin: 0 0 var(--space-3);
    padding: 8px 18px;
    background: #FFD23F;
    color: #3A1D00;
    font: 600 18px/1.2 var(--font-display);
    clip-path: polygon(0 0, 100% 0, 94% 50%, 100% 100%, 0 100%, 6% 50%);
  }
  .deal { position: relative; display: grid; justify-items: center; margin: 0; font-family: var(--font-display); font-weight: 600; }
  .deal .amt { font-size: clamp(72px, 22vw, 104px); line-height: 1; color: #FFD23F; }
  .deal .unit { margin-top: 4px; font-size: 22px; }

  /* Details */
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
  }
  h2 { font-size: 21px; line-height: 1.4; text-align: center; }

  .listen {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: 'ic lbl' 'ic bar';
    align-items: center;
    gap: 6px var(--space-3);
    padding: 10px var(--space-3);
    border: 0;
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
    font: 600 16px var(--font-display);
    text-align: left;
    cursor: pointer;
  }
  .listen .ic { grid-area: ic; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--brand); color: #fff; }
  .listen svg { width: 22px; height: 22px; }
  .i-pause, .listen[aria-pressed='true'] .i-play { display: none; }
  .listen[aria-pressed='true'] .i-pause { display: block; }
  .lbl { grid-area: lbl; }
  .bar { grid-area: bar; height: 4px; border-radius: 2px; background: var(--line); overflow: hidden; }
  .bar i { display: block; height: 100%; background: var(--brand); transform: scaleX(0); transform-origin: left; transition: transform 250ms linear; }

  .timer { text-align: center; }
  .t-lbl { margin-bottom: var(--space-2); font: 600 15px var(--font-display); color: #B3101F; }
  .boxes { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-2); }
  .boxes span { display: grid; gap: 2px; padding: 8px 0; border-radius: 8px; background: var(--ink); color: var(--stage-muted); font: 500 14px var(--font-display); }
  .boxes b { font-size: 26px; line-height: 1.1; color: #fff; font-variant-numeric: tabular-nums; }

  .cta {
    display: block;
    padding: 16px var(--space-5);
    border-radius: 10px;
    background: #D7263D;
    color: #fff;
    font: 600 18px var(--font-display);
    text-align: center;
    text-decoration: none;
    transition: background-color var(--fast) var(--ease);
  }
  .cta:hover { background: #B81C31; }
  .later { align-self: center; margin-top: -8px; padding: 8px; border: 0; background: none; color: var(--ink-muted); font: 500 15px var(--font-display); cursor: pointer; }

  .x {
    position: absolute;
    top: 10px;
    right: 10px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.15);
    color: #fff;
    cursor: pointer;
  }
  .x svg { width: 20px; height: 20px; }

  @media (prefers-reduced-motion: no-preference) {
    .dp[open] { animation: dp-in 260ms cubic-bezier(0.2, 0, 0, 1); }
    .dp[open]::backdrop { animation: dp-fade 200ms ease-out; }
  }
  @keyframes dp-in { from { opacity: 0; transform: translateY(24px) scale(0.97); } }
  @keyframes dp-fade { from { opacity: 0; } }

  @media (max-width: 380px) {
    .body { padding: var(--space-4); }
    h2 { font-size: 19px; }
    .boxes b { font-size: 22px; }
    .burst { width: 80px; height: 80px; }
  }

  /* Wide screens: offer on the left, details on the right. */
  @media (min-width: 760px) {
    .dp[open] { display: grid; grid-template-columns: 1fr 1fr; }
    .hero { display: grid; align-content: center; justify-items: center; padding: 72px var(--space-6); }
    .deal .amt { font-size: 128px; }
    .ribbon { font-size: 20px; }
    .body { justify-content: center; padding: var(--space-7) var(--space-6); }
    h2 { font-size: 24px; }
    .x { background: var(--surface); color: var(--ink); }
  }
</style>

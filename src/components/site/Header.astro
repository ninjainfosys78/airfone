---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ChevronDown from '@lucide/astro/icons/chevron-down';
// Enterprise-style masthead (IBM / TCS / McKinsey pattern): a thin utility
// strip, a clean main bar, and full-width mega menus that drop below the
// whole header with columns and one featured item.
import { products } from '../../data/products';
import { solutions } from '../../data/solutions';
import { APP_URL, DEMO_NUMBER_DISPLAY, DEMO_NUMBER_TEL } from '../../config/site';

const path = Astro.url.pathname.replace(/\.html$/, '');
const current = (href: string) => (path === href || path.startsWith(`${href}/`) ? 'page' : undefined);

const groups = [
  {
    id: 'products',
    label: 'Products',
    base: '/products',
    links: products.map((p) => ({ href: `/products/${p.slug}`, label: p.name })),
    feature: { title: 'Hear the agent on a real call', href: DEMO_NUMBER_TEL, cta: `Call ${DEMO_NUMBER_DISPLAY}` },
  },
  {
    id: 'solutions',
    label: 'Solutions',
    base: '/solutions',
    links: solutions.map((s) => ({ href: `/solutions/${s.slug}`, label: s.name })),
    feature: { title: 'Sell AirFone in your city', href: '/resellers', cta: 'Become a reseller' },
  },
];
const plain = [
  { href: '/blog', label: 'Insights' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/contact', label: 'Contact' },
];
---
<div class="utility">
    <div class="wrap u-row">
      <a href={DEMO_NUMBER_TEL} class="u-call">Hear the agent: <span class="mono">{DEMO_NUMBER_DISPLAY}</span></a>
      <nav aria-label="Utility" class="u-links">
        <a href="/resellers">Resellers</a>
        <a href="/contact">Contact</a>
        <a href={`${APP_URL}/login`}>Sign in</a>
      </nav>
    </div>
  </div>

<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href="/" aria-label="AirFone home">
      <img src="/brand/airfone-lockup.svg" alt="AirFone" width="140" height="29" class="logo-light" />
      <img src="/brand/airfone-lockup-light.svg" alt="" width="140" height="29" class="logo-dark" aria-hidden="true" />
    </a>

    <nav class="nav-wide" aria-label="Main">
      <ul class="top">
        {groups.map((g) => (
          <li>
            <details class="menu" data-menu>
              <summary aria-current={path.startsWith(g.base) ? 'page' : undefined}>{g.label}</summary>
              <div class="mega">
                <div class="wrap mega-grid">
                  <ul class="mega-links">
                    {g.links.map((l) => (
                      <li><a href={l.href} aria-current={current(l.href)}><span class="m-name">{l.label}</span></a></li>
                    ))}
                  </ul>
                  <a class="mega-feature" href={g.feature.href}>
                    <span class="f-title">{g.feature.title}</span>
                    <span class="f-cta">{g.feature.cta} <span aria-hidden="true"><ArrowRight class="arrow-icon" size={18} stroke-width={2} aria-hidden="true" /></span></span>
                  </a>
                </div>
              </div>
            </details>
          </li>
        ))}
        {plain.map((l) => <li><a class="nav-link" href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="actions">
      <div class="gsi" data-gsi-slot><div class="gsi-btn" data-gsi-button></div><a class="btn btn-secondary gsi-fallback" href={`${APP_URL}/welcome`}>Continue with Google</a></div>
      <details class="mobile" data-menu>
        <summary aria-label="Menu"><span class="bars" aria-hidden="true"><i></i></span><span class="mobile-label">Menu</span></summary>
        <nav class="mobile-panel" aria-label="Main">
          <ul class="m-list">
            {groups.map((g) => (
              <li>
                <details class="m-acc" open={path.startsWith(g.base) || undefined}>
                  <summary class="m-row">{g.label}<ChevronDown class="m-chev" size={22} stroke-width={2} aria-hidden="true" /></summary>
                  <ul class="m-sub">
                    {g.links.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
                  </ul>
                </details>
              </li>
            ))}
            {plain.map((l) => <li><a class="m-row" href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
          </ul>
          <ul class="m-small">
            <li><a href="/resellers">Resellers</a></li>
            <li><a href={`${APP_URL}/login`}>Sign in</a></li>
          </ul>
          <div class="mobile-actions">
            <a class="btn btn-secondary" href={DEMO_NUMBER_TEL}>Call us</a>
            <a class="btn btn-primary" href={`${APP_URL}/welcome`}>Continue with Google</a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-menu]'));
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  // Close a desktop menu by rolling it back up before it disappears.
  const close = (m: HTMLDetailsElement) => {
    if (!m.open || m.classList.contains('closing')) return;
    if (still.matches) { m.open = false; return; }
    m.classList.add('closing');
    window.setTimeout(() => { if (m.classList.contains('closing')) { m.classList.remove('closing'); m.open = false; } }, 260);
  };
  const sync = () => header.classList.toggle('menu-open', menus.some((m) => m.open && !m.classList.contains('mobile')));
  document.addEventListener('click', (e) => {
    for (const m of menus) if (m.open && !m.contains(e.target as Node)) close(m);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    for (const m of menus) if (m.open) { close(m); m.querySelector('summary')?.focus(); }
  });
  for (const m of menus) m.addEventListener('toggle', () => {
    if (m.open) header.classList.toggle('switching', menus.some((o) => o !== m && o.open && !o.classList.contains('mobile')));
    if (m.open) for (const o of menus) if (o !== m) { o.classList.remove('closing'); o.open = false; }
    sync();
  });
  // Open on hover with a mouse. A short delay keeps menus from flickering as
  // the pointer crosses the bar; leaving the whole menu closes it.
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    for (const m of menus.filter((x) => !x.classList.contains('mobile'))) {
      let t = 0;
      const li = m.closest('li')!;
      li.addEventListener('pointerenter', () => { clearTimeout(t); if (m.classList.contains('closing')) { m.classList.remove('closing'); return; } t = window.setTimeout(() => { m.open = true; }, 150); });
      li.addEventListener('pointerleave', () => { clearTimeout(t); t = window.setTimeout(() => close(m), 220); });
      // A click on the label while hover-opened should not close it.
      m.querySelector('summary')!.addEventListener('click', (e) => { if (m.open) { e.preventDefault(); } });
    }
  }

  // The mobile menu opens right under the bar, wherever the bar is.
  const place = () => header.style.setProperty('--header-h', `${Math.round(header.getBoundingClientRect().bottom)}px`);
  for (const m of menus) m.addEventListener('toggle', place);
  // While the mobile sheet is open the page behind it stays put.
  const mobile = menus.find((m) => m.classList.contains('mobile'));
  mobile?.addEventListener('toggle', () => {
    document.documentElement.classList.toggle('menu-locked', mobile.open);
  });
  // The summary toggles natively; route its close through the animation.
  mobile?.querySelector('summary')!.addEventListener('click', (e) => { if (mobile.open) { e.preventDefault(); close(mobile); } });
  addEventListener('resize', place, { passive: true });
  place();
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--canvas); border-bottom: 1px solid var(--line); }
  .utility { position: relative; z-index: 51; }

  .utility { background: var(--stage); color: var(--stage-ink); font-size: 14px; }
  .u-row { display: flex; align-items: center; justify-content: space-between; min-height: 36px; gap: var(--space-4); }
  .utility a { color: var(--stage-ink); text-decoration: none; }
  .utility a:hover { text-decoration: underline; }
  .u-links { display: flex; gap: var(--space-5); }

  .bar { display: flex; align-items: center; gap: var(--space-7); height: 72px; }
  .logo { flex: none; display: block; }
  .logo img { width: 128px; height: auto; }
  .logo-dark { display: none; }

  .nav-wide { flex: 1; align-self: stretch; }
  .top { display: flex; gap: var(--space-5); list-style: none; margin: 0; padding: 0; height: 100%; align-items: stretch; }
  .top > li { display: flex; }
  summary { list-style: none; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  .nav-link, .menu > summary {
    display: inline-flex; align-items: center; gap: 8px; height: 100%; min-height: 44px;
    color: var(--ink); text-decoration: none; font-size: 16px; font-weight: 500;
    position: relative;
    transition: color var(--fast) var(--ease);
  }
  .nav-link::before, .menu > summary::before {
    content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--brand);
    transform: scaleX(0); transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1); pointer-events: none;
  }
  .menu[open]:not(.closing) > summary::before, .nav-link[aria-current='page']::before, .menu > summary[aria-current='page']::before { transform: scaleX(1); }
  .nav-link:hover, .menu > summary:hover { color: var(--link); }
  .menu[open] > summary, .nav-link[aria-current='page'], .menu > summary[aria-current='page'] { color: var(--link); }
  .menu > summary::after {
    content: ''; width: 6px; height: 6px; margin-top: -3px;
    border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg); transition: transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .menu[open]:not(.closing) > summary::after { transform: translateY(3px) rotate(-135deg); }

  /* Full-width mega menu below the whole header. */
  .mega {
    position: absolute; left: 0; right: 0; top: 100%;
    background: var(--canvas); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  /* Opening from closed: the panel unrolls downward from the bar, then its
     links rise in one after another. Moving between menus keeps the panel
     still and only replays the links. */
  .site-header:not(.switching) .menu[open] .mega { animation: unroll 460ms cubic-bezier(0.22, 1, 0.36, 1); }
  .menu.closing .mega { animation: rollup 260ms cubic-bezier(0.4, 0, 1, 1) forwards !important; }
  .menu.closing .mega-links li, .menu.closing .mega-feature { animation: item-out 180ms ease-in forwards !important; }
  .menu[open] .mega-links li, .menu[open] .mega-feature { animation: item-in 520ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .menu[open] .mega-links li:nth-child(1) { animation-delay: 80ms; }
  .menu[open] .mega-links li:nth-child(2) { animation-delay: 130ms; }
  .menu[open] .mega-links li:nth-child(3) { animation-delay: 180ms; }
  .menu[open] .mega-links li:nth-child(4) { animation-delay: 230ms; }
  .menu[open] .mega-links li:nth-child(5) { animation-delay: 280ms; }
  .menu[open] .mega-feature { animation-delay: 200ms; }
  @keyframes unroll { from { clip-path: inset(0 0 100% 0); opacity: 0.6; } to { clip-path: inset(0 0 0 0); opacity: 1; } }
  @keyframes rollup { from { clip-path: inset(0 0 0 0); opacity: 1; } to { clip-path: inset(0 0 100% 0); opacity: 0.4; } }
  @keyframes item-out { to { opacity: 0; transform: translateY(-4px); } }
  @keyframes item-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  .mega-grid { display: grid; grid-template-columns: 1fr 340px; gap: var(--space-8); padding-block: var(--space-7); }
  .mega-links { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 var(--space-7); }
  .mega-links a { display: block; padding: var(--space-4) 0; border-top: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .mega-links li:nth-child(-n+2) a { border-top: 0; }
  .m-name { font-size: 17px; font-weight: 600; transition: color var(--fast) var(--ease); }
  .mega-links a:hover .m-name, .mega-links a[aria-current='page'] .m-name { color: var(--link); }
  .mega-feature {
    display: grid; align-content: end; gap: var(--space-2); padding: var(--space-6);
    background: var(--stage); color: var(--stage-ink); border-radius: var(--radius-panel); text-decoration: none; min-height: 180px;
  }
  .f-title { font-size: 1.375rem; font-weight: 600; line-height: 1.25; }
  .f-cta { display: inline-flex; align-items: center; gap: 6px; margin-top: var(--space-3); color: var(--lime); font-weight: 600; }
  .f-cta span { display: inline-flex; transition: transform var(--fast) var(--ease); }
  .mega-feature:hover .f-cta span { display: inline-flex; transform: translateX(4px); transition: transform var(--fast) var(--ease); }


  .actions { display: flex; align-items: center; gap: var(--space-3); margin-left: auto; }
  .actions .btn { min-height: 44px; padding: 0 var(--space-5); font-size: 16px; }

  .mobile { display: none; }
  /* Google's own button: "Continue as <name>" with their photo for anyone
     signed in to Google here, plain "Continue with Google" otherwise.
     The space is held at its final size, the button stays invisible until
     Google has drawn its final version, then fades in once. The plain link
     shows only if Google never arrives (blocked, offline). */
  .gsi { position: relative; display: grid; align-items: center; width: 250px; height: 44px; }
  .gsi > * { grid-area: 1 / 1; }
  .gsi-btn { opacity: 0; transition: opacity 200ms var(--ease); }
  .gsi:global(.ready) .gsi-btn { opacity: 1; }
  .gsi-fallback { visibility: hidden; justify-self: end; }
  .gsi:global(.fallback) .gsi-fallback { visibility: visible; }
  .gsi:global(.ready) .gsi-fallback { display: none; }
  .mobile > summary {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2);
    min-height: 44px; min-width: 44px; padding: 0 var(--space-3);
    border-radius: var(--radius-control); font-size: 16px; font-weight: 500;
    transition: background-color var(--fast) var(--ease);
  }
  .mobile > summary:active { background: var(--subtle); }
  /* Three bars that fold into a cross. */
  .bars { position: relative; width: 20px; height: 14px; }
  .bars::before, .bars::after, .bars i { content: ''; position: absolute; left: 0; width: 100%; height: 2px; border-radius: 1px; background: currentColor; transition: transform 380ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms ease; }
  .bars::before { top: 0; }
  .bars i { top: 6px; }
  .bars::after { top: 12px; }
  .mobile[open]:not(.closing) .bars::before { transform: translateY(6px) rotate(45deg); }
  .mobile[open]:not(.closing) .bars::after { transform: translateY(-6px) rotate(-45deg); }
  .mobile[open]:not(.closing) .bars i { opacity: 0; transform: scaleX(0.3); }

  .mobile-panel {
    position: fixed; left: 0; right: 0; top: var(--header-h, 109px); height: calc(100dvh - var(--header-h, 109px)); overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch;
    display: flex; flex-direction: column;
    background: var(--canvas); padding: var(--space-3) var(--gutter) 0;
  }
  /* Big top-level rows; Products and Solutions open in place as accordions. */
  .mobile-panel ul { list-style: none; margin: 0; padding: 0; }
  .m-list > li { border-bottom: 1px solid var(--line); }
  .m-row {
    display: flex; align-items: center; justify-content: space-between; min-height: 64px;
    color: var(--ink); text-decoration: none; font-size: 22px; font-weight: 600; cursor: pointer; list-style: none;
  }
  .m-row::-webkit-details-marker { display: none; }
  .m-row[aria-current='page'] { color: var(--link); }
  .m-row :global(.m-chev) { color: var(--ink-muted); transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1); }
  .m-acc[open] .m-row :global(.m-chev) { transform: rotate(180deg); color: var(--brand); }
  .m-acc { interpolate-size: allow-keywords; }
  .m-acc::details-content { block-size: 0; overflow: hidden; transition: block-size 320ms cubic-bezier(0.22, 1, 0.36, 1), content-visibility 320ms allow-discrete; }
  .m-acc[open]::details-content { block-size: auto; }
  .m-sub { padding: 0 0 var(--space-4) !important; }
  .m-sub a { display: flex; align-items: center; min-height: 44px; color: var(--ink-muted); text-decoration: none; font-size: 17px; font-weight: 500; }
  .m-sub a:active, .m-sub a[aria-current='page'] { color: var(--link); }
  .m-small { display: grid; gap: var(--space-1); margin-top: var(--space-5) !important; }
  .m-small a { display: flex; align-items: center; min-height: 40px; color: var(--ink-muted); text-decoration: none; font-size: 16px; }
  /* Call and demo stay pinned to the bottom of the sheet while it scrolls. */
  .mobile-actions { position: sticky; bottom: 0; margin-top: auto; padding: var(--space-4) 0 calc(var(--space-4) + env(safe-area-inset-bottom)); background: var(--canvas); border-top: 1px solid var(--line); display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  .mobile-actions .btn { width: 100%; }

  /* Open: the sheet fades down into place and its rows follow in turn.
     Close: it lifts away quickly. */
  .mobile[open] .mobile-panel { animation: sheet-in 420ms cubic-bezier(0.22, 1, 0.36, 1); }
  .mobile[open] .mobile-panel > * { animation: item-in 520ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .mobile[open] .mobile-panel > :nth-child(2) { animation-delay: 60ms; }
  .mobile[open] .mobile-panel > :nth-child(3) { animation-delay: 120ms; }
  .mobile[open] .mobile-panel > :nth-child(4) { animation-delay: 180ms; }
  .mobile.closing .mobile-panel { animation: sheet-out 240ms cubic-bezier(0.4, 0, 1, 1) forwards; }
  @keyframes sheet-in { from { opacity: 0; transform: translateY(-12px); } to { opacity: 1; transform: none; } }
  @keyframes sheet-out { to { opacity: 0; transform: translateY(-8px); } }
  :global(html.menu-locked), :global(html.menu-locked body) { overflow: hidden; }

  @media (max-width: 599px) { .gsi { display: none; } }
  @media (max-width: 1023px) {
    .bar { gap: var(--space-4); }
    .nav-wide { display: none; }
    .mobile { display: block; }
  }
  @media (max-width: 599px) {
    .u-links { display: none; }
    .u-row { justify-content: center; }
  }
  @media (max-width: 399px) {
    .logo img { width: 112px; }
    .actions { gap: var(--space-2); }
    .actions .btn { padding: 0 var(--space-3); }
    .mobile-label { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .menu .mega, .menu .mega-links li, .menu .mega-feature, .mobile .mobile-panel, .mobile .mobile-panel > * { animation: none !important; } .bars::before, .bars::after, .bars i, .m-row :global(.m-chev) { transition: none; } .m-acc::details-content { transition: none; } .nav-link::before, .menu > summary::before { transition: none; } }
</style>

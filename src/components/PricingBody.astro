---
import WaitlistForm from './WaitlistForm.astro';
import StructuredData from './StructuredData.astro';
import { LAUNCHED, APP_URL, CONTACT_PHONE_TEL, CONTACT_PHONE_DISPLAY } from '../config/site';
import type { Locale } from '../i18n';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const copy = {
  ne: {
    h1: 'मूल्य अझै सार्वजनिक गरिएको छैन',
    tryFree: 'निःशुल्क सुरु गर्नुहोस्',
    includedH2: 'हरेक योजनामा हुनेछ',
    included: [
      { title: 'नेपालीमा फोन उठाउने AI एजेन्ट', body: 'मूल्य, खुल्ने समय, सेवा र उपलब्धताबारे ग्राहकका प्रश्नको जवाफ दिनरात दिने गरी डिजाइन गरिँदैछ।' },
      { title: 'बोलेर वा लिंक राखेरै सिकाउने सुविधा', body: 'वेबसाइटको लिंक, फेसबुक पेज, फोटो र भिडियोबाट एजेन्टको जानकारी तयार हुने गरी बनाइँदैछ।' },
      { title: 'सुरु गर्नुअघि आफैं जाँच्ने सुविधा', body: 'डेमो नम्बरमा PIN सहित फोन गरेर ग्राहकले झैं प्रश्न सोध्न सकिनेछ।' },
      { title: 'आफ्नै AirFone नम्बर' },
      { title: 'नबनाइएको जवाफ', body: 'थाहा नभएको जानकारी आफैं नबनाउने गरी डिजाइन गरिँदैछ।' },
      { title: 'WhatsApp', soon: true },
    ],
    soon: 'निर्माणाधीन',
    askH2: 'मूल्यबारे सोध्नु छ?',
    call: 'फोन गर्नुहोस्',
  },
  en: {
    h1: 'Pricing has not been announced yet',
    tryFree: 'Try it free',
    includedH2: 'Planned for every plan',
    included: [
      { title: 'An AI agent for calls in Nepali', body: "It's being designed to answer customer questions about prices, opening hours, services and stock, day and night." },
      { title: 'Teaching it by talking or pasting a link', body: "It's being built so its knowledge comes from your website, Facebook page, photos and videos." },
      { title: 'Testing it yourself before going live', body: 'You will be able to call your demo number with a PIN and ask what your customers ask.' },
      { title: 'Your own AirFone number' },
      { title: 'No made-up answers', body: "It's being designed not to make things up when it doesn't know something." },
      { title: 'WhatsApp', soon: true },
    ],
    soon: 'In development',
    askH2: 'Questions about pricing?',
    call: 'Call us',
  },
} as const;
const c = copy[locale];
---
<StructuredData locale={locale} />

<section class="hero">
  <div class="wrap">
    <h1>{c.h1}</h1>
    <div class="form" id="waitlist">
      {LAUNCHED ? (
        <a class="btn btn-primary" href={APP_URL}>{c.tryFree}</a>
      ) : (
        <WaitlistForm locale={locale} id="pricing" source="pricing" compact />
      )}
    </div>
  </div>
</section>

<section class="included on-tint">
  <div class="wrap split">
    <h2>{c.includedH2}</h2>
    <ul class="list">
      {c.included.map((item) => (
        <li>
          <span class={`check${'soon' in item && item.soon ? ' soon' : ''}`} aria-hidden="true"></span>
          <div>
            <h3>
              {item.title}
              {'soon' in item && item.soon && <span class="tag">{c.soon}</span>}
            </h3>
            {'body' in item && item.body && <p>{item.body}</p>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="ask">
  <div class="wrap ask-row">
    <h2>{c.askH2}</h2>
    <a class="phone" href={CONTACT_PHONE_TEL}>
      <span class="phone-number">{CONTACT_PHONE_DISPLAY[locale]}</span>
      <span class="btn btn-secondary">{c.call}</span>
    </a>
  </div>
</section>


<style>
  .hero {
    padding: 88px 0 104px;
  }
  h1 {
    max-width: 15ch;
  }
  .form {
    margin-top: 40px;
    max-width: 520px;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
  }
  .included {
    padding: 112px 0;
  }
  .split {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 900px) {
    .split {
      grid-template-columns: 4fr 8fr;
      gap: 64px;
      align-items: start;
    }
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .list li {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 16px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .check {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--brand);
    position: relative;
    margin-top: 2px;
  }
  .check.soon {
    background: transparent;
    border: 2px solid var(--line);
  }
  .check.soon::after {
    display: none;
  }
  .check::after {
    content: '';
    position: absolute;
    left: 8px;
    top: 5px;
    width: 6px;
    height: 11px;
    border: solid var(--on-brand);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .list h3 {
    font-size: 20px;
    line-height: 1.35;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .list p {
    margin: 6px 0 0;
    font-size: 17px;
    color: var(--ink-muted);
  }
  .tag {
    font-family: 'Instrument Sans', 'Mukta', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 2px 10px;
  }

  .ask {
    padding: 96px 0;
  }
  .ask-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
  }
  .phone {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    text-decoration: none;
    color: var(--ink);
  }
  .phone-number {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .phone:hover .btn-secondary {
    border-color: var(--ink);
  }
</style>

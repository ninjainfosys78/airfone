---
import { demoCall } from '../data/demo-call';
import { demoCallFixture } from '../data/demo-call.fixture';
import { DEMO_AUDIO_URL, DEMO_FIXTURE } from '../config/site';
import type { Locale } from '../i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const call = DEMO_FIXTURE ? demoCallFixture : demoCall;
---
{call.lines.length > 0 && (
  <section id="demo" class="demo-band" data-demo-fixture={DEMO_FIXTURE ? 'true' : undefined}>
    <div class="wrap">
      <h2>{locale === 'ne' ? 'एक साँचो कल सुन्नुहोस्' : 'Listen to a real call'}</h2>
      <p class="lede">
        {locale === 'ne'
          ? `${call.business.ne}मा ग्राहकले फोन गर्छन्, AirFone को एजेन्टले जवाफ दिन्छ। कल सम्पादन गरिएको छैन।`
          : `A customer calls ${call.business.en} and AirFone's agent answers. The call is not edited.`}
      </p>

      <div class={`player${DEMO_AUDIO_URL ? '' : ' no-audio'}`} data-demo-player data-audio-src={DEMO_AUDIO_URL}>
        <div class="controls">
          <button type="button" class="play-btn" data-play-btn aria-label={locale === 'ne' ? 'बजाउनुहोस्' : 'Play'}>
            <span data-play-icon>▶</span>
          </button>
          <input type="range" min="0" max="100" value="0" data-seek aria-label={locale === 'ne' ? 'खोज्नुहोस्' : 'Seek'} />
          <span class="time" data-time>0:00 / 0:00</span>
        </div>
        <audio preload="none" data-audio>
          {DEMO_AUDIO_URL && <source src={DEMO_AUDIO_URL} />}
        </audio>

        <ol class="transcript" data-transcript>
          {call.lines.map((line, i) => (
            <li data-start={line.start} data-index={i} tabindex="0">
              <span class="marker" aria-hidden="true"></span>
              <span class="speaker">
                {line.speaker === 'caller'
                  ? (locale === 'ne' ? 'ग्राहक' : 'Caller')
                  : 'AirFone'}
              </span>
              <span class="text">{locale === 'ne' ? line.ne : line.en}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
)}

<style>
  .demo-band {
    background: var(--night);
    color: var(--night-ink);
    padding: 96px 0;
  }
  .demo-band h2 {
    color: var(--night-ink);
  }
  .lede {
    color: var(--night-muted);
    margin-top: 12px;
  }
  .player {
    margin-top: 40px;
    border: 1px solid var(--night-line);
    border-radius: var(--radius-panel);
    padding: 24px;
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .play-btn {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-control);
    border: 1px solid var(--night-line);
    background: transparent;
    color: var(--night-ink);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .controls input[type='range'] {
    flex: 1;
  }
  .time {
    font-size: 14px;
    color: var(--night-muted);
    white-space: nowrap;
  }
  .transcript {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .transcript li {
    display: grid;
    grid-template-columns: 4px minmax(0, 1fr);
    grid-template-areas: 'marker speaker' 'marker text';
    column-gap: 12px;
    row-gap: 2px;
    align-items: start;
    padding: 12px 8px;
    border-radius: var(--radius-control);
    cursor: pointer;
  }
  .transcript li .marker {
    grid-area: marker;
    align-self: stretch;
    border-radius: 0;
  }
  .transcript li[aria-current='true'] {
    background: rgba(139, 197, 62, 0.12);
  }
  .transcript li[aria-current='true'] .marker {
    background: var(--brand);
  }
  .transcript .speaker {
    grid-area: speaker;
    font-weight: 600;
    font-size: 14px;
    color: var(--night-brand-ink);
  }
  .transcript .text {
    grid-area: text;
    color: var(--night-ink);
    font-size: 16px;
  }

  @media (min-width: 700px) {
    .transcript li {
      grid-template-columns: 4px 96px minmax(0, 1fr);
      grid-template-areas: 'marker speaker text';
      column-gap: 16px;
    }
  }
  .player.no-audio .controls {
    display: none;
  }
  .player.no-audio .transcript {
    margin-top: 0;
  }
</style>

<script>
  function initPlayer(root: HTMLElement) {
    const audio = root.querySelector<HTMLAudioElement>('[data-audio]');
    const audioSrc = root.dataset.audioSrc;
    const playBtn = root.querySelector<HTMLButtonElement>('[data-play-btn]');
    const playIcon = root.querySelector<HTMLElement>('[data-play-icon]');
    const seek = root.querySelector<HTMLInputElement>('[data-seek]');
    const time = root.querySelector<HTMLElement>('[data-time]');
    const items = Array.from(root.querySelectorAll<HTMLLIElement>('[data-transcript] li'));

    function format(sec: number): string {
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60).toString().padStart(2, '0');
      return `${m}:${s}`;
    }

    function highlightForTime(t: number) {
      let current: HTMLLIElement | null = null;
      for (const li of items) {
        const start = Number(li.dataset.start);
        if (start <= t) current = li;
      }
      items.forEach((li) => li.removeAttribute('aria-current'));
      if (current) current.setAttribute('aria-current', 'true');
    }

    items.forEach((li) => {
      li.addEventListener('click', () => {
        const start = Number(li.dataset.start);
        if (audio && audioSrc) {
          audio.currentTime = start;
        }
        highlightForTime(start);
      });
    });

    if (!audioSrc || !audio) {
      root.classList.add('no-audio');
      return;
    }

    audio.addEventListener('error', () => {
      root.classList.add('no-audio');
    });

    playBtn?.addEventListener('click', () => {
      if (audio.paused) {
        audio.play().catch(() => root.classList.add('no-audio'));
      } else {
        audio.pause();
      }
    });

    audio.addEventListener('play', () => {
      if (playIcon) playIcon.textContent = '⏸';
    });
    audio.addEventListener('pause', () => {
      if (playIcon) playIcon.textContent = '▶';
    });
    audio.addEventListener('timeupdate', () => {
      if (seek && audio.duration) {
        seek.value = String((audio.currentTime / audio.duration) * 100);
      }
      if (time) time.textContent = `${format(audio.currentTime)} / ${format(audio.duration || 0)}`;
      highlightForTime(audio.currentTime);
    });
    seek?.addEventListener('input', () => {
      if (audio.duration) {
        audio.currentTime = (Number(seek.value) / 100) * audio.duration;
      }
    });
  }

  document.querySelectorAll<HTMLElement>('[data-demo-player]').forEach(initPlayer);
</script>

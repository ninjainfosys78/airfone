---
const steps = [
  { t: '9:00', h: 'List uploaded', p: '42 appointments for tomorrow.' },
  { t: '9:01', h: 'Calls go out', p: 'AirFone rings each patient, up to 15 at a time.' },
  { t: '9:03', h: 'Answers come in', p: '31 confirmed, 6 moved to a new time, 5 no answer.' },
  { t: '11:00', h: 'Second try', p: 'The 5 who did not answer get one more call.' },
  { t: '11:05', h: 'Your team sees the result', p: 'Every answer is saved against the patient.' },
];
---
<figure class="tl">
  <figcaption class="muted small">Sunrise Clinic reminder calls</figcaption>
  <ol>
    {steps.map((s) => (
      <li><span class="t mono">{s.t}</span><span class="h">{s.h}</span><span class="p muted">{s.p}</span></li>
    ))}
  </ol>
</figure>

<style>
  .tl { margin: 0; background: var(--canvas); border: 1px solid var(--line); border-radius: var(--radius-panel); padding: var(--space-5); }
  ol { list-style: none; margin: var(--space-4) 0 0; padding: 0; }
  li { display: grid; grid-template-columns: 64px 1fr; gap: 2px var(--space-4); padding: var(--space-3) 0; border-top: 1px solid var(--line); }
  .t { grid-row: span 2; color: var(--link); font-size: 16px; padding-top: 2px; }
  .h { font-weight: 600; }
  .p { font-size: 16px; }
</style>

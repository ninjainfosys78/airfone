---
// Hero product visual: the real recorded call, shown as live captions over
// its waveform. Owns the page's single <audio>; CallTranscript lines
// (data-call-line) stay in sync with it.
import { demoCall } from '../data/demo-call';
import { demoWaveform } from '../data/demo-waveform';
import { DEMO_AUDIO_URL } from '../config/site';
import type { Locale } from '../i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const call = demoCall;
const first = call.lines[0];

const format = (sec: number) => `${Math.floor(sec / 60)}:${String(Math.floor(sec % 60)).padStart(2, '0')}`;

const copy = {
  ne: { caller: 'ग्राहक', play: 'कल बजाउनुहोस्', pause: 'रोक्नुहोस्' },
  en: { caller: 'Caller', play: 'Play the call', pause: 'Pause' },
} as const;
const c = copy[locale];

type TimedWord = { w: string; t: number };
const timed = (l: (typeof call.lines)[number]): TimedWord[] => {
  if (locale === 'ne') return l.ne.split(' ').map((w, i) => ({ w, t: l.words[i] }));
  const tokens = l.en.split(' ');
  const total = tokens.reduce((n, w) => n + w.length + 1, 0);
  let acc = 0;
  return tokens.map((w) => {
    const t = l.start + ((l.end - l.start) * acc) / total;
    acc += w.length + 1;
    return { w, t: Math.round(t * 100) / 100 };
  });
};
const firstWords = timed(first);

const BAR = 6;
const HEIGHT = 96;
const bars = demoWaveform.peaks.map((peak, i) => {
  const h = Math.max(4, Math.round(peak * HEIGHT));
  const code = demoWaveform.speakers[i];
  const who = code === 'a' ? 'agent' : code === 'c' ? 'caller' : 'silence';
  return { x: i * BAR, y: Math.round((HEIGHT - h) / 2), h, who };
});
---
{call.lines.length > 0 && (
  <div class="call" data-call-card data-label-play={c.play} data-label-pause={c.pause}>
    <div class="top">
      <p class="business">{locale === 'ne' ? call.business.ne : call.business.en}</p>
      <p class="time" data-call-time>0:00 / {format(call.duration)}</p>
    </div>

    <div class="caption" aria-live="off">
      <p class="speaker" data-call-speaker data-who={first.speaker}>{first.speaker === 'caller' ? c.caller : 'AirFone'}</p>
      <p class="text" data-call-text>{firstWords.map((x, i) => <>{i > 0 && ' '}<span class="w" data-t={x.t}>{x.w}</span></>)}</p>
    </div>

    <div class="deck">
      <button type="button" class="play" data-call-play aria-label={c.play}>
        <svg class="icon-play" viewBox="0 0 20 20" aria-hidden="true"><path d="M6 4.2v11.6a.8.8 0 0 0 1.2.7l9.3-5.8a.8.8 0 0 0 0-1.4L7.2 3.5A.8.8 0 0 0 6 4.2Z" /></svg>
        <svg class="icon-pause" viewBox="0 0 20 20" aria-hidden="true"><rect x="5" y="4" width="3.5" height="12" rx="1" /><rect x="11.5" y="4" width="3.5" height="12" rx="1" /></svg>
      </button>
      <svg
        class="wave"
        viewBox={`0 0 ${demoWaveform.peaks.length * BAR} ${HEIGHT}`}
        preserveAspectRatio="none"
        role="presentation"
        data-call-wave
      >
        {bars.map((b) => (
          <rect x={b.x} y={b.y} width="4" height={b.h} rx="2" class={b.who} />
        ))}
      </svg>
    </div>

    {DEMO_AUDIO_URL && <audio preload="none" src={DEMO_AUDIO_URL} data-call-audio></audio>}

    <script type="application/json" data-call-lines set:html={JSON.stringify(
      call.lines.map((l) => ({ start: l.start, who: l.speaker, speaker: l.speaker === 'caller' ? c.caller : 'AirFone', words: timed(l) })),
    )} />
  </div>
)}

<style>
  .call {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--night-line);
  }
  .business {
    margin: 0;
    font-weight: 600;
    font-size: 16px;
    color: var(--night-ink);
  }
  .time {
    margin: 0;
    font-size: 14px;
    color: var(--night-muted);
    font-variant-numeric: tabular-nums;
  }
  .caption {
    /* Fixed room for the longest line so nothing below moves mid-call. */
    min-height: calc(5 * 1.35em + 34px);
  }
  .speaker {
    margin: 0 0 10px;
    font-size: 16px;
    font-weight: 600;
    color: var(--night-muted);
  }
  .speaker[data-who='agent'] {
    color: var(--brand);
  }
  /* Word spans are rebuilt in the browser, so these rules must be global. */
  .text :global(.w) {
    transition: color 150ms ease-out;
  }
  /* While the call plays, words not yet spoken are dimmed (4.9:1 on --night). */
  .call:global(.is-started) .text :global(.w) {
    color: #808A72;
  }
  .call:global(.is-started) .text :global(.w.spoken) {
    color: var(--night-ink);
  }
  .text {
    margin: 0;
    font-family: 'Instrument Sans', 'Noto Serif Devanagari', system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(1.25rem, 1.7vw, 1.5rem);
    line-height: 1.35;
    color: var(--night-ink);
  }
  /* A new line slides up into place. */
  @media (prefers-reduced-motion: no-preference) {
    .text:global(.enter) {
      animation: line-in 260ms ease-out;
    }
    @keyframes line-in {
      from {
        transform: translateY(8px);
        opacity: 0.4;
      }
      to {
        transform: none;
        opacity: 1;
      }
    }
  }
  .deck {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 20px;
    align-items: center;
  }
  .play {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 0;
    background: var(--brand);
    color: var(--on-brand);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .play:hover {
    background: var(--night-brand-ink);
  }
  .play svg {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }
  .icon-pause,
  .is-playing .icon-play {
    display: none;
  }
  .is-playing .icon-pause {
    display: block;
  }
  .wave {
    width: 100%;
    height: 56px;
    display: block;
    cursor: pointer;
  }
  .wave .agent {
    fill: var(--brand);
  }
  .wave .caller {
    fill: var(--night-muted);
  }
  .wave .silence {
    fill: var(--night-line);
  }
  .wave rect {
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 150ms ease-out, transform 120ms ease-out;
  }
  /* Bars at the playhead lift while the call plays. */
  .wave :global(rect.live) {
    transform: scaleY(1.35);
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .wave :global(rect.live) {
      transform: none;
    }
  }
  .wave:global(.is-started) rect:not(:global(.played)) {
    opacity: 0.3;
  }
  .no-audio .play {
    display: none;
  }
  .no-audio .deck {
    grid-template-columns: minmax(0, 1fr);
  }
</style>

<script>
  type Line = { start: number; who: string; speaker: string; words: { w: string; t: number }[] };

  function initCall(card: HTMLElement) {
    const audio = card.querySelector<HTMLAudioElement>('[data-call-audio]');
    const playBtn = card.querySelector<HTMLButtonElement>('[data-call-play]');
    const time = card.querySelector<HTMLElement>('[data-call-time]');
    const wave = card.querySelector<SVGElement>('[data-call-wave]');
    const speakerEl = card.querySelector<HTMLElement>('[data-call-speaker]');
    const textEl = card.querySelector<HTMLElement>('[data-call-text]');
    const lines: Line[] = JSON.parse(card.querySelector('[data-call-lines]')?.textContent || '[]');
    const rects = wave ? Array.from(wave.querySelectorAll('rect')) : [];
    const listItems = Array.from(document.querySelectorAll<HTMLElement>('[data-call-line]'));

    const format = (sec: number) => `${Math.floor(sec / 60)}:${String(Math.floor(sec % 60)).padStart(2, '0')}`;

    let shown = -1;
    let wordEls = Array.from(card.querySelectorAll<HTMLElement>('[data-call-text] .w'));
    function show(t: number, duration: number) {
      let idx = 0;
      lines.forEach((l, i) => {
        if (l.start <= t) idx = i;
      });
      if (idx !== shown) {
        shown = idx;
        if (speakerEl) {
          speakerEl.textContent = lines[idx].speaker;
          speakerEl.dataset.who = lines[idx].who;
        }
        if (textEl) {
          textEl.replaceChildren();
          lines[idx].words.forEach((word, i) => {
            if (i > 0) textEl.append(' ');
            const span = document.createElement('span');
            span.className = 'w';
            span.dataset.t = String(word.t);
            span.textContent = word.w;
            textEl.append(span);
          });
          wordEls = Array.from(textEl.querySelectorAll<HTMLElement>('.w'));
          if (t > 0) {
            textEl.classList.remove('enter');
            void textEl.offsetWidth;
            textEl.classList.add('enter');
          }
        }
        listItems.forEach((li, i) => {
          if (i === idx) li.setAttribute('aria-current', 'true');
          else li.removeAttribute('aria-current');
        });
      }
      wordEls.forEach((el) => el.classList.toggle('spoken', Number(el.dataset.t) <= t));
      if (duration > 0) {
        const played = Math.floor((t / duration) * rects.length);
        const playing = !audio!.paused;
        rects.forEach((r, i) => {
          r.classList.toggle('played', i < played);
          r.classList.toggle('live', playing && i >= played - 2 && i <= played);
        });
        if (time) time.textContent = `${format(t)} / ${format(duration)}`;
      }
    }

    if (!audio) {
      card.classList.add('no-audio');
      return;
    }

    // Sound only ever starts from a click on play, the waveform or a transcript line.
    let userPaused = false;

    const play = () => audio.play();

    function seekAndPlay(seconds: number) {
      const go = () => {
        audio.currentTime = seconds;
        userPaused = false;
        play().catch(() => {});
      };
      if (audio.readyState >= 1) go();
      else audio.addEventListener('loadedmetadata', go, { once: true });
    }

    audio.addEventListener('error', () => card.classList.add('no-audio'));
    audio.addEventListener('play', () => {
      card.classList.add('is-playing', 'is-started');
      wave?.classList.add('is-started');
      playBtn?.setAttribute('aria-label', card.dataset.labelPause || 'Pause');
    });
    audio.addEventListener('pause', () => {
      rects.forEach((r) => r.classList.remove('live'));
      card.classList.remove('is-playing');
      playBtn?.setAttribute('aria-label', card.dataset.labelPlay || 'Play');
    });
    audio.addEventListener('timeupdate', () => show(audio.currentTime, audio.duration || 0));
    let frame = 0;
    const tick = () => {
      show(audio.currentTime, audio.duration || 0);
      if (!audio.paused) frame = requestAnimationFrame(tick);
    };
    audio.addEventListener('play', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(tick);
    });

    playBtn?.addEventListener('click', () => {
      if (audio.paused) {
        userPaused = false;
        play().catch(() => {});
      } else {
        userPaused = true;
        audio.pause();
      }
    });

    wave?.addEventListener('click', (e) => {
      const box = wave.getBoundingClientRect();
      const ratio = Math.min(1, Math.max(0, (e.clientX - box.left) / box.width));
      seekAndPlay(ratio * (audio.duration || 0));
    });

    listItems.forEach((li) => {
      const go = () => seekAndPlay(Number(li.dataset.start));
      li.addEventListener('click', go);
      li.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          go();
        }
      });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-call-card]').forEach(initCall);
</script>

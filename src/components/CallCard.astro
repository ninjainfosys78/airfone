---
// Hero product visual: the real recorded call, shown as live captions over
// its waveform. Owns the page's single <audio>; CallTranscript lines
// (data-call-line) stay in sync with it.
import { demoCall } from '../data/demo-call';
import { demoWaveform } from '../data/demo-waveform';
import { DEMO_AUDIO_URL } from '../config/site';
import type { Locale } from '../i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const call = demoCall;
const first = call.lines[0];

const format = (sec: number) => `${Math.floor(sec / 60)}:${String(Math.floor(sec % 60)).padStart(2, '0')}`;

const copy = {
  ne: { caller: 'ग्राहक', play: 'कल बजाउनुहोस्', pause: 'रोक्नुहोस्' },
  en: { caller: 'Caller', play: 'Play the call', pause: 'Pause' },
} as const;
const c = copy[locale];

const BAR = 6;
const HEIGHT = 96;
const bars = demoWaveform.peaks.map((peak, i) => {
  const h = Math.max(4, Math.round(peak * HEIGHT));
  const code = demoWaveform.speakers[i];
  const who = code === 'a' ? 'agent' : code === 'c' ? 'caller' : 'silence';
  return { x: i * BAR, y: Math.round((HEIGHT - h) / 2), h, who };
});
---
{call.lines.length > 0 && (
  <div class="call" data-call-card data-label-play={c.play} data-label-pause={c.pause}>
    <div class="top">
      <p class="business">{locale === 'ne' ? call.business.ne : call.business.en}</p>
      <p class="time" data-call-time>0:00 / {format(call.duration)}</p>
    </div>

    <div class="caption" aria-live="off">
      <p class="speaker" data-call-speaker data-who={first.speaker}>{first.speaker === 'caller' ? c.caller : 'AirFone'}</p>
      <p class="text" data-call-text>{locale === 'ne' ? first.ne : first.en}</p>
    </div>

    <div class="deck">
      <button type="button" class="play" data-call-play aria-label={c.play}>
        <svg class="icon-play" viewBox="0 0 20 20" aria-hidden="true"><path d="M6 4.2v11.6a.8.8 0 0 0 1.2.7l9.3-5.8a.8.8 0 0 0 0-1.4L7.2 3.5A.8.8 0 0 0 6 4.2Z" /></svg>
        <svg class="icon-pause" viewBox="0 0 20 20" aria-hidden="true"><rect x="5" y="4" width="3.5" height="12" rx="1" /><rect x="11.5" y="4" width="3.5" height="12" rx="1" /></svg>
      </button>
      <svg
        class="wave"
        viewBox={`0 0 ${demoWaveform.peaks.length * BAR} ${HEIGHT}`}
        preserveAspectRatio="none"
        role="presentation"
        data-call-wave
      >
        {bars.map((b) => (
          <rect x={b.x} y={b.y} width="4" height={b.h} rx="2" class={b.who} />
        ))}
      </svg>
    </div>

    {DEMO_AUDIO_URL && <audio preload="auto" src={DEMO_AUDIO_URL} data-call-audio></audio>}

    <script type="application/json" data-call-lines set:html={JSON.stringify(
      call.lines.map((l) => ({ start: l.start, who: l.speaker, speaker: l.speaker === 'caller' ? c.caller : 'AirFone', text: locale === 'ne' ? l.ne : l.en })),
    )} />
  </div>
)}

<style>
  .call {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--night-line);
  }
  .business {
    margin: 0;
    font-weight: 600;
    font-size: 16px;
    color: var(--night-ink);
  }
  .time {
    margin: 0;
    font-size: 14px;
    color: var(--night-muted);
    font-variant-numeric: tabular-nums;
  }
  .caption {
    /* Fixed room for the longest line so nothing below moves mid-call. */
    min-height: calc(4 * 1.35em * 1.45 + 30px);
  }
  .speaker {
    margin: 0 0 10px;
    font-size: 16px;
    font-weight: 600;
    color: var(--night-muted);
  }
  .speaker[data-who='agent'] {
    color: var(--brand);
  }
  .text {
    margin: 0;
    font-family: 'Instrument Sans', 'Noto Serif Devanagari', system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(1.375rem, 2.2vw, 1.875rem);
    line-height: 1.35;
    color: var(--night-ink);
  }
  .deck {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 20px;
    align-items: center;
  }
  .play {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 0;
    background: var(--brand);
    color: var(--on-brand);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .play:hover {
    background: var(--night-brand-ink);
  }
  .play svg {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }
  .icon-pause,
  .is-playing .icon-play {
    display: none;
  }
  .is-playing .icon-pause {
    display: block;
  }
  .wave {
    width: 100%;
    height: 72px;
    display: block;
    cursor: pointer;
  }
  .wave .agent {
    fill: var(--brand);
  }
  .wave .caller {
    fill: var(--night-muted);
  }
  .wave .silence {
    fill: var(--night-line);
  }
  .wave rect {
    transition: opacity 150ms ease-out;
  }
  .wave.is-started rect:not(.played) {
    opacity: 0.3;
  }
  .no-audio .play {
    display: none;
  }
  .no-audio .deck {
    grid-template-columns: minmax(0, 1fr);
  }
</style>

<script>
  type Line = { start: number; who: string; speaker: string; text: string };

  function initCall(card: HTMLElement) {
    const audio = card.querySelector<HTMLAudioElement>('[data-call-audio]');
    const playBtn = card.querySelector<HTMLButtonElement>('[data-call-play]');
    const time = card.querySelector<HTMLElement>('[data-call-time]');
    const wave = card.querySelector<SVGElement>('[data-call-wave]');
    const speakerEl = card.querySelector<HTMLElement>('[data-call-speaker]');
    const textEl = card.querySelector<HTMLElement>('[data-call-text]');
    const lines: Line[] = JSON.parse(card.querySelector('[data-call-lines]')?.textContent || '[]');
    const rects = wave ? Array.from(wave.querySelectorAll('rect')) : [];
    const listItems = Array.from(document.querySelectorAll<HTMLElement>('[data-call-line]'));

    const format = (sec: number) => `${Math.floor(sec / 60)}:${String(Math.floor(sec % 60)).padStart(2, '0')}`;

    let shown = -1;
    function show(t: number, duration: number) {
      let idx = 0;
      lines.forEach((l, i) => {
        if (l.start <= t) idx = i;
      });
      if (idx !== shown) {
        shown = idx;
        if (speakerEl) {
          speakerEl.textContent = lines[idx].speaker;
          speakerEl.dataset.who = lines[idx].who;
        }
        if (textEl) textEl.textContent = lines[idx].text;
        listItems.forEach((li, i) => {
          if (i === idx) li.setAttribute('aria-current', 'true');
          else li.removeAttribute('aria-current');
        });
      }
      if (duration > 0) {
        const played = Math.floor((t / duration) * rects.length);
        rects.forEach((r, i) => r.classList.toggle('played', i < played));
        if (time) time.textContent = `${format(t)} / ${format(duration)}`;
      }
    }

    if (!audio) {
      card.classList.add('no-audio');
      return;
    }

    // Set once the visitor pauses, so autoplay never overrides their choice.
    let userPaused = false;

    const play = () => audio.play();

    function seekAndPlay(seconds: number) {
      const go = () => {
        audio.currentTime = seconds;
        userPaused = false;
        play().catch(() => {});
      };
      if (audio.readyState >= 1) go();
      else audio.addEventListener('loadedmetadata', go, { once: true });
    }

    audio.addEventListener('error', () => card.classList.add('no-audio'));
    audio.addEventListener('play', () => {
      card.classList.add('is-playing');
      wave?.classList.add('is-started');
      playBtn?.setAttribute('aria-label', card.dataset.labelPause || 'Pause');
    });
    audio.addEventListener('pause', () => {
      card.classList.remove('is-playing');
      playBtn?.setAttribute('aria-label', card.dataset.labelPlay || 'Play');
    });
    audio.addEventListener('timeupdate', () => show(audio.currentTime, audio.duration || 0));

    playBtn?.addEventListener('click', () => {
      if (audio.paused) {
        userPaused = false;
        play().catch(() => {});
      } else {
        userPaused = true;
        audio.pause();
      }
    });

    wave?.addEventListener('click', (e) => {
      const box = wave.getBoundingClientRect();
      const ratio = Math.min(1, Math.max(0, (e.clientX - box.left) / box.width));
      seekAndPlay(ratio * (audio.duration || 0));
    });

    listItems.forEach((li) => {
      const go = () => seekAndPlay(Number(li.dataset.start));
      li.addEventListener('click', go);
      li.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          go();
        }
      });
    });

    // Autoplay. Browsers only allow sound after the visitor has interacted
    // with the page, so try right away and otherwise start on the first
    // tap, click or key press anywhere (except on the call's own controls,
    // which handle themselves).
    const events = ['pointerdown', 'keydown'] as const;
    const onFirstInteraction = (e: Event) => {
      const target = e.target as Element | null;
      if (target && target.closest('[data-call-play], [data-call-wave], [data-call-line]')) return;
      if (!userPaused && audio.paused && audio.currentTime === 0) play().catch(() => {});
      events.forEach((name) => document.removeEventListener(name, onFirstInteraction, true));
    };
    play().catch(() => {
      events.forEach((name) => document.addEventListener(name, onFirstInteraction, true));
    });
  }

  document.querySelectorAll<HTMLElement>('[data-call-card]').forEach(initCall);
</script>

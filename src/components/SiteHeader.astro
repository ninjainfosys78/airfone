---
import { t, localePath, otherLocalePath, type Locale } from '../i18n';
import { LAUNCHED, APP_URL } from '../config/site';

export interface Props {
  locale: Locale;
  path?: string;
}

const { locale, path = '/' } = Astro.props;
const other = otherLocalePath(locale, path);
const copy = t[locale];
const ctaHref = LAUNCHED ? APP_URL : `${localePath(locale, '/')}#waitlist`;
const ctaLabel = LAUNCHED ? copy.ctaLaunched : copy.cta;
const signIn = locale === 'ne' ? 'साइन इन' : 'Sign in';

const links = [
  { href: localePath(locale, '/'), label: locale === 'ne' ? 'गृहपृष्ठ' : 'Home', match: '/' },
  { href: localePath(locale, '/pricing/'), label: copy.pricing, match: '/pricing/' },
  { href: localePath(locale, '/contact/'), label: copy.contact, match: '/contact/' },
];
---
<header class="site-header on-night">
  <div class="wrap bar">
    <a class="lockup" href={localePath(locale, '/')} aria-label="AirFone">
      <img src="/brand/airfone-lockup-light.svg" alt="AirFone" width="146" height="30" />
    </a>

    <nav class="links" aria-label={locale === 'ne' ? 'मुख्य नेभिगेसन' : 'Main navigation'}>
      {links.map((l) => (
        <a href={l.href} aria-current={path === l.match ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="right">
      <a class="lang" href={other.href} hreflang={other.locale} lang={other.locale}>{copy.langSwitchLabel}</a>
      <a class="sign-in" href={APP_URL}>{signIn}</a>
      <a class="btn btn-primary cta" href={ctaHref}>{ctaLabel}</a>
    </div>

    <details class="mobile-menu">
      <summary aria-label={copy.menu}>
        <span class="bars" aria-hidden="true"><span></span><span></span></span>
      </summary>
      <div class="sheet">
        <nav aria-label={locale === 'ne' ? 'मोबाइल नेभिगेसन' : 'Mobile navigation'}>
          {links.map((l) => (
            <a href={l.href} aria-current={path === l.match ? 'page' : undefined}>{l.label}</a>
          ))}
          <a href={APP_URL}>{signIn}</a>
          <a href={other.href} hreflang={other.locale} lang={other.locale}>{copy.langSwitchLabel}</a>
        </nav>
        <a class="btn btn-primary sheet-cta" href={ctaHref}>{ctaLabel}</a>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--night-line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 68px;
  }
  .lockup {
    display: block;
    flex: 0 0 auto;
  }
  .lockup img {
    display: block;
    height: 30px;
    width: auto;
  }
  .links {
    display: none;
    gap: 4px;
  }
  .links a,
  .lang,
  .sign-in {
    color: var(--night-muted);
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    padding: 8px 12px;
    border-radius: var(--radius-control);
    transition: color 150ms ease-out, background-color 150ms ease-out;
  }
  .links a:hover,
  .lang:hover,
  .sign-in:hover {
    color: var(--night-ink);
    background: var(--night-surface);
  }
  .links a[aria-current='page'] {
    color: var(--night-ink);
  }
  .right {
    display: none;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }
  .cta {
    margin-left: 8px;
    height: 40px;
    padding: 0 16px;
    font-size: 15px;
  }

  /* Mobile */
  .mobile-menu {
    margin-left: auto;
  }
  .mobile-menu summary {
    list-style: none;
    cursor: pointer;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-control);
  }
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .bars {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 20px;
  }
  .bars span {
    display: block;
    height: 2px;
    background: var(--night-ink);
    border-radius: 1px;
    transition: transform 150ms ease-out;
  }
  .mobile-menu[open] .bars span:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .mobile-menu[open] .bars span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }
  .sheet {
    position: absolute;
    left: 0;
    right: 0;
    top: 68px;
    background: var(--night);
    border-bottom: 1px solid var(--night-line);
    padding: 8px var(--gutter) 24px;
  }
  .sheet nav {
    display: flex;
    flex-direction: column;
  }
  .sheet nav a {
    color: var(--night-ink);
    text-decoration: none;
    font-size: 18px;
    font-weight: 600;
    padding: 14px 0;
    border-bottom: 1px solid var(--night-line);
  }
  .sheet nav a[aria-current='page'] {
    color: var(--brand);
  }
  .sheet-cta {
    margin-top: 20px;
    width: 100%;
    height: 52px;
    font-size: 17px;
  }

  @media (min-width: 900px) {
    .links,
    .right {
      display: flex;
    }
    .mobile-menu {
      display: none;
    }
  }
</style>

---
import { localePath, type Locale } from '../i18n';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const copy = {
  ne: {
    created: { h1: 'धन्यवाद।', line: 'सूचीमा नाम दर्ता भयो। सुरु भएपछि हामी तपाईंलाई फोन गर्नेछौं।' },
    already_on_list: { h1: 'तपाईं पहिले नै सूचीमा हुनुहुन्छ।', line: 'धन्यवाद, थप केही गर्नु पर्दैन।' },
    default: { h1: 'धन्यवाद।', line: 'तपाईंको जानकारी प्राप्त भयो।' },
    home: 'गृहपृष्ठमा फर्कनुहोस्',
  },
  en: {
    created: { h1: 'Thank you.', line: "You're on the waitlist. We'll call you when it's live." },
    already_on_list: { h1: "You're already on the list.", line: 'Thanks, nothing else to do.' },
    default: { h1: 'Thank you.', line: 'Your details were received.' },
    home: 'Back to the homepage',
  },
} as const;

const c = copy[locale];
const status = Astro.url.searchParams.get('status');
const state = status === 'already_on_list' ? c.already_on_list : status === 'created' ? c.created : c.default;
---
<section class="page-hero">
  <div class="wrap">
    <h1>{state.h1}</h1>
    <p class="secondary-text">{state.line}</p>
    <p><a href={localePath(locale, '/')}>{c.home}</a></p>
  </div>
</section>
<style>
  .page-hero {
    padding: 72px 0 96px;
  }
</style>

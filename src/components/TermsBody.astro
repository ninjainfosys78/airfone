---
import LegalBody from './LegalBody.astro';
import { CONTACT_EMAIL } from '../config/site';
import type { Locale } from '../i18n';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const mail = `<a href="mailto:${CONTACT_EMAIL}">${CONTACT_EMAIL}</a>`;
const privacy = locale === 'ne' ? '/privacy/' : '/en/privacy/';
const pricing = locale === 'ne' ? '/pricing/' : '/en/pricing/';

const copy = {
  en: {
    h1: 'Terms of service',
    updated: 'Last updated 2 October 2026',
    intro: [
      'These terms are the agreement between you and AirFone for using the AirFone app, website and phone service. By creating an account or using AirFone you agree to them. If you use AirFone for a business, you agree on its behalf and confirm you are allowed to.',
      `Questions: ${mail}.`,
    ],
    sections: [
      {
        h: 'Who can use AirFone',
        p: ['You must be at least 16, and old enough to make a binding agreement where you live. Give accurate details when you sign up and keep them up to date.'],
      },
      {
        h: 'Your account',
        p: ['Keep your password and devices secure. You are responsible for what happens under your account and your business’s account, including what members you invite do. Tell us at once if you think your account has been misused.'],
      },
      {
        h: 'What AirFone does',
        p: [
          'AirFone answers calls with an AI assistant, connects callers to people, records and transcribes calls where you turn this on, and handles messages, phone numbers and calling between your team.',
          'The assistant answers from what you teach it and can make mistakes. Check what it knows and review its calls. Do not rely on it for decisions with legal, medical, financial or safety consequences.',
        ],
      },
      {
        h: 'Not for emergencies',
        p: ['AirFone is not a replacement for a regular phone for emergencies. Do not rely on it to call or reach the police (100), an ambulance (102), the fire service (101) or any other emergency service.'],
      },
      {
        h: 'Your responsibilities',
        p: ['When you use AirFone you agree to:'],
        list: [
          'Follow the law, including the laws on telecommunications, privacy and consumer protection that apply to your calls and messages.',
          'Tell callers that their call may be answered by an AI assistant and may be recorded, where the law requires it.',
          'Have the right to everything you upload or teach the assistant, and not upload anything unlawful, harmful or that infringes others’ rights.',
          'Not use AirFone for spam, unsolicited bulk calls or messages, fraud, harassment, or to get around a carrier’s rules.',
          'Not interfere with the service, test its security without our written permission, or resell it without an agreement with us.',
        ],
      },
      {
        h: 'Phone numbers',
        p: ['Numbers we assign to your business are for your use while your account is active and in good standing; you do not own them. Carriers’ rules apply to them. When a number is released, because you release it, close your business or stop paying, it is held for 30 days and may then be given to someone else.'],
      },
      {
        h: 'Payments and your wallet',
        list: [
          `AirFone is paid for in advance from your wallet. Calls, numbers and AI use are charged at the prices on our <a href="${pricing}">pricing page</a> or in the app when you use them.`,
          'Top-ups are not refundable, except where the law requires it or a charge was our mistake.',
          'A balance left when you delete your account is not refunded. Ask us before you delete it if you want it back.',
          'We may change prices. We will tell account owners before a change takes effect, and it does not apply to what you have already used.',
          'Payments are processed by our payment providers under their own terms.',
        ],
      },
      {
        h: 'Your content',
        p: [
          `Your business’s calls, recordings, transcripts, messages and the knowledge you add belong to you. You let us store, process and transmit them as needed to run AirFone for you, including through the providers named in our <a href="${privacy}">privacy policy</a>, which explains how we handle personal information.`,
        ],
      },
      {
        h: 'Availability and changes',
        p: ['We work to keep AirFone running, but calls depend on networks, carriers and providers we do not control, so we cannot promise it will always be available or error free. We may change, add or remove features; if a change takes away something you rely on, we will tell you in advance where we can.'],
      },
      {
        h: 'Suspension and closing an account',
        p: ['You can delete your account at any time in the app. We may suspend or close an account that breaks these terms, puts others at risk, or is used unlawfully. Where we can, we will tell you first and give you a chance to fix it.'],
      },
      {
        h: 'Disclaimers',
        p: ['AirFone is provided as it is and as available. To the extent the law allows, we make no promises beyond those in these terms, including about the accuracy of the assistant’s answers.'],
      },
      {
        h: 'Limits on liability',
        p: ['To the extent the law allows, AirFone is not liable for indirect or consequential losses, such as lost profits, lost business or missed calls, and our total liability for any claim is limited to what you paid us in the 3 months before it arose. Nothing in these terms limits liability that cannot be limited by law.'],
      },
      {
        h: 'Changes to these terms',
        p: ['We may update these terms. We will change the date above and, for significant changes, tell account owners before they take effect. Using AirFone after that means you accept the new terms.'],
      },
      {
        h: 'Law and disputes',
        p: ['These terms are governed by the laws of Nepal. Please talk to us first if something goes wrong; disputes we cannot resolve together go to the courts of Kathmandu.'],
      },
    ],
  },
  ne: {
    h1: 'सेवाका सर्तहरू',
    updated: 'अन्तिम पटक अद्यावधिक: २ अक्टोबर २०२६',
    intro: [
      'AirFone एप, वेबसाइट र फोन सेवा प्रयोग गर्नका लागि यी सर्तहरू तपाईं र AirFone बीचको सम्झौता हुन्। खाता खोलेर वा AirFone प्रयोग गरेर तपाईं यिनमा सहमत हुनुहुन्छ। कुनै व्यवसायका लागि प्रयोग गर्नुहुन्छ भने त्यसको तर्फबाट सहमत हुनुहुन्छ र त्यसो गर्ने अधिकार भएको पुष्टि गर्नुहुन्छ।',
      `प्रश्न: ${mail}।`,
    ],
    sections: [
      {
        h: 'AirFone कसले प्रयोग गर्न सक्छ',
        p: ['तपाईं कम्तीमा १६ वर्षको र आफू बस्ने ठाउँमा बाध्यकारी सम्झौता गर्न सक्ने उमेरको हुनुपर्छ। साइन अप गर्दा सही विवरण दिनुहोस् र अद्यावधिक राख्नुहोस्।'],
      },
      {
        h: 'तपाईंको खाता',
        p: ['पासवर्ड र उपकरण सुरक्षित राख्नुहोस्। तपाईंको खाता र व्यवसायको खाताबाट हुने काम, तपाईंले बोलाउनुभएका सदस्यले गर्ने काम समेत, तपाईंको जिम्मेवारी हो। खाताको दुरुपयोग भएको लागेमा हामीलाई तुरुन्त भन्नुहोस्।'],
      },
      {
        h: 'AirFone ले के गर्छ',
        p: [
          'AirFone ले AI सहायकमार्फत कल उठाउँछ, कल गर्नेलाई व्यक्तिसँग जोड्छ, तपाईंले खोल्नुभएमा कल रेकर्ड गर्छ र लेख्छ, र सन्देश, फोन नम्बर र टिमभित्रको कल सम्हाल्छ।',
          'सहायकले तपाईंले सिकाएको कुराबाट जवाफ दिन्छ र गल्ती गर्न सक्छ। उसलाई के थाहा छ जाँच्नुहोस् र उसका कल हेर्नुहोस्। कानुनी, स्वास्थ्य, आर्थिक वा सुरक्षासम्बन्धी निर्णयका लागि उसमा भर नपर्नुहोस्।',
        ],
      },
      {
        h: 'आपत्कालका लागि होइन',
        p: ['AirFone आपत्कालका लागि सामान्य फोनको विकल्प होइन। प्रहरी (१००), एम्बुलेन्स (१०२), दमकल (१०१) वा अरू आपत्कालीन सेवामा पुग्न यसमा भर नपर्नुहोस्।'],
      },
      {
        h: 'तपाईंका जिम्मेवारी',
        p: ['AirFone प्रयोग गर्दा तपाईं यसमा सहमत हुनुहुन्छ:'],
        list: [
          'तपाईंका कल र सन्देशमा लागू हुने दूरसञ्चार, गोपनीयता र उपभोक्ता संरक्षणसम्बन्धी कानुनसहित कानुन पालना गर्ने।',
          'कानुनले माग गरेमा कल गर्नेलाई उनको कल AI सहायकले उठाउन सक्ने र रेकर्ड हुन सक्ने कुरा बताउने।',
          'अपलोड गर्ने वा सहायकलाई सिकाउने सबै कुरामा अधिकार भएको हुने, र गैरकानुनी, हानिकारक वा अरूको अधिकार हनन गर्ने कुरा अपलोड नगर्ने।',
          'स्प्याम, नचाहिएका थोक कल वा सन्देश, ठगी, दुर्व्यवहार वा फोन कम्पनीका नियम छल्न AirFone प्रयोग नगर्ने।',
          'सेवामा बाधा नपुर्‍याउने, हाम्रो लिखित अनुमतिबिना सुरक्षा परीक्षण नगर्ने, र हामीसँग सम्झौताबिना पुनः बिक्री नगर्ने।',
        ],
      },
      {
        h: 'फोन नम्बर',
        p: ['हामीले तपाईंको व्यवसायलाई दिएका नम्बर खाता सक्रिय र नियमित रहँदासम्म प्रयोगका लागि हुन्; तिनको स्वामित्व तपाईंको होइन। तिनमा फोन कम्पनीका नियम लागू हुन्छन्। नम्बर छाडिएपछि, तपाईंले छाड्नुभएर, व्यवसाय बन्द गरेर वा भुक्तानी नगरेर, त्यो ३० दिन राखिन्छ र त्यसपछि अरूलाई दिन सकिन्छ।'],
      },
      {
        h: 'भुक्तानी र वालेट',
        list: [
          `AirFone को भुक्तानी वालेटबाट अग्रिम हुन्छ। कल, नम्बर र AI प्रयोगको शुल्क हाम्रो <a href="${pricing}">मूल्य पृष्ठ</a> वा प्रयोग गर्दा एपमा देखाइएको मूल्यअनुसार लाग्छ।`,
          'कानुनले माग गरेको वा शुल्क हाम्रो गल्तीले लागेको बाहेक टप-अप फिर्ता हुँदैन।',
          'खाता मेटाउँदा बाँकी रहेको ब्यालेन्स फिर्ता हुँदैन। फिर्ता चाहिएमा मेटाउनुअघि हामीलाई भन्नुहोस्।',
          'हामी मूल्य बदल्न सक्छौं। परिवर्तन लागू हुनुअघि खाताधनीलाई जानकारी दिन्छौं, र यो पहिल्यै प्रयोग गरिसकेकोमा लागू हुँदैन।',
          'भुक्तानी हाम्रा भुक्तानी प्रदायकले आफ्नै सर्तअनुसार प्रशोधन गर्छन्।',
        ],
      },
      {
        h: 'तपाईंको सामग्री',
        p: [
          `तपाईंको व्यवसायका कल, रेकर्डिङ, लिखित रूप, सन्देश र तपाईंले थपेको जानकारी तपाईंकै हुन्। तपाईंका लागि AirFone चलाउन आवश्यकअनुसार, हाम्रो <a href="${privacy}">गोपनीयता नीति</a> मा उल्लेख प्रदायकमार्फत समेत, यिनलाई राख्न, प्रशोधन गर्न र पठाउन तपाईं हामीलाई अनुमति दिनुहुन्छ। व्यक्तिगत जानकारी कसरी सम्हालिन्छ भन्ने त्यो नीतिले बताउँछ।`,
        ],
      },
      {
        h: 'उपलब्धता र परिवर्तन',
        p: ['हामी AirFone चलिरहोस् भनेर काम गर्छौं, तर कल हाम्रो नियन्त्रणबाहिरका नेटवर्क, फोन कम्पनी र प्रदायकमा निर्भर हुन्छन्, त्यसैले सधैं उपलब्ध वा त्रुटिरहित हुने वाचा गर्न सक्दैनौं। हामी सुविधा बदल्न, थप्न वा हटाउन सक्छौं; तपाईं भर पर्ने कुरा हटाउँदा सम्भव भएसम्म पहिल्यै जानकारी दिन्छौं।'],
      },
      {
        h: 'निलम्बन र खाता बन्द',
        p: ['तपाईं जुनसुकै बेला एपबाट खाता मेटाउन सक्नुहुन्छ। यी सर्त तोड्ने, अरूलाई जोखिममा पार्ने वा गैरकानुनी प्रयोग हुने खाता हामी निलम्बन वा बन्द गर्न सक्छौं। सम्भव भएसम्म पहिले जानकारी दिएर सच्याउने मौका दिन्छौं।'],
      },
      {
        h: 'अस्वीकरण',
        p: ['AirFone जस्तो छ र जति उपलब्ध छ त्यसैअनुसार दिइन्छ। कानुनले दिएसम्म, सहायकका जवाफ सही हुनेबारे समेत, यी सर्तमा लेखिएभन्दा बाहिर हामी कुनै वाचा गर्दैनौं।'],
      },
      {
        h: 'दायित्वको सीमा',
        p: ['कानुनले दिएसम्म, नाफा वा व्यापार गुम्नु वा कल छुट्नुजस्ता अप्रत्यक्ष वा परिणामस्वरूपका हानिका लागि AirFone जिम्मेवार हुँदैन, र कुनै पनि दाबीमा हाम्रो कुल दायित्व त्यो दाबी उठ्नुअघिका ३ महिनामा तपाईंले हामीलाई तिरेको रकमसम्म सीमित हुन्छ। कानुनले सीमित गर्न नदिने दायित्वलाई यी सर्तले सीमित गर्दैनन्।'],
      },
      {
        h: 'सर्तमा परिवर्तन',
        p: ['हामी यी सर्त अद्यावधिक गर्न सक्छौं। माथिको मिति बदल्छौं र ठूलो परिवर्तन लागू हुनुअघि खाताधनीलाई जानकारी दिन्छौं। त्यसपछि पनि AirFone प्रयोग गर्नु भनेको नयाँ सर्त स्वीकार गर्नु हो।'],
      },
      {
        h: 'कानुन र विवाद',
        p: ['यी सर्त नेपालको कानुनअनुसार चल्छन्। केही गडबड भएमा पहिले हामीसँग कुरा गर्नुहोस्; आपसमा नमिलेका विवाद काठमाडौंका अदालतमा जान्छन्।'],
      },
    ],
  },
} as const;
const c = copy[locale];
---
<LegalBody locale={locale} h1={c.h1} updated={c.updated} intro={c.intro} sections={c.sections} />

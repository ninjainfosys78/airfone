---
// A call with its transcript. Without JavaScript it is a native audio
// player and a full transcript; call-player.ts upgrades it.
import { clip as loadClip, type ClipData } from './clips';

export interface Props {
  clip?: string;
  /** For audio hosted elsewhere (the real call). */
  src?: string;
  label?: string;
  transcript?: { speaker: 'agent' | 'caller'; text: string; ne?: string; start?: number; end?: number }[];
  data?: ClipData & { src?: string };
  id?: string;
  compact?: boolean;
  /** Sits on the green stage under the orb: no panel, live caption. */
  stage?: boolean;
}

const p = Astro.props;
const data: Partial<ClipData> & { src?: string } = p.data ?? (p.clip ? loadClip(p.clip) : {});
const label = p.label ?? data.label ?? 'Example call';
const lines = p.transcript ?? data.lines ?? [];
const id = p.id ?? `call-${p.clip ?? data.id ?? 'remote'}`;
const remote = p.src ?? data.src;
const sources = remote
  ? [{ src: remote, type: 'audio/mpeg' }]
  : [
      { src: `/audio/${p.clip ?? data.id}.opus`, type: 'audio/ogg; codecs=opus' },
      { src: `/audio/${p.clip ?? data.id}.m4a`, type: 'audio/mp4' },
    ];
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
const timing = JSON.stringify({ duration: data.duration ?? 0, lines: lines.map((l) => ({ speaker: l.speaker, start: l.start ?? 0, end: l.end ?? 0 })), peaks: data.peaks ?? [] });
---
<call-player class:list={['player', { compact: p.compact, stage: p.stage }]} data-timing={timing}>
  <div class="head">
    <button type="button" class="play" aria-pressed="false" aria-controls={id} disabled>
      <span class="visually-hidden">Play {label}</span>
      <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
      <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor" /></svg>
    </button>
    <div class="meta">
      <p class="label">{label}</p>
      {data.duration ? <p class="time small"><span class="now">0:00</span> / {fmt(data.duration)}</p> : null}
    </div>
  </div>
  <div class="slot">
    <canvas class="wave" aria-hidden="true"></canvas>
    <audio id={id} controls preload="none">
      {sources.map((s) => <source src={s.src} type={s.type} />)}
    </audio>
  </div>
  {p.stage && (
    <div class="caption" aria-hidden="true">
      <p class="c-who">{lines[0]?.speaker === 'caller' ? 'Caller' : 'AirFone'}</p>
      <p class="c-ne" lang="ne">{lines[0]?.ne ?? lines[0]?.text}</p>
      {lines[0]?.ne && <p class="c-en">{lines[0]?.text}</p>}
    </div>
  )}
  <p class="error small" role="status" hidden>Audio couldn't load. The transcript is below.</p>
  {lines.length > 0 && (
    <details class="transcript" open={!p.compact && !p.stage} data-transcript>
      <summary>Transcript</summary>
      <ol>
        {lines.map((l) => (
          <li data-speaker={l.speaker} data-start={l.start} data-end={l.end}>
            <span class="who">{l.speaker === 'agent' ? 'AirFone' : 'Caller'}</span>
            <span class="said">
              {l.ne && <span class="ne" lang="ne">{l.ne}</span>}
              <span class:list={['en', { sub: !!l.ne }]}>{l.text}</span>
            </span>
          </li>
        ))}
      </ol>
    </details>
  )}
</call-player>

<script src="./call-player.ts"></script>

<style>
  .player {
    display: block;
    background: var(--canvas);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    padding: var(--space-5);
  }
  .head { display: flex; align-items: center; gap: var(--space-4); }
  .play {
    flex: none; display: grid; place-items: center;
    width: 52px; height: 52px; border: 0; border-radius: var(--radius-control);
    background: var(--lime); color: var(--on-lime); cursor: pointer;
    transition: background-color var(--fast) var(--ease);
  }
  .play:hover { background: var(--brand); color: var(--on-brand); }
  .play svg { width: 24px; height: 24px; }
  .play .i-pause, .play[aria-pressed='true'] .i-play { display: none; }
  .play[aria-pressed='true'] .i-pause { display: block; }
  .label { font-weight: 600; }
  .time { color: var(--ink-muted); font-variant-numeric: tabular-nums; }
  /* Waveform and native audio share one slot so upgrading never shifts layout. */
  .slot { display: grid; margin-top: var(--space-4); min-height: 54px; align-items: center; }
  .slot > * { grid-area: 1 / 1; }
  .wave { width: 100%; height: 48px; cursor: pointer; visibility: hidden; }
  audio { width: 100%; }
  .is-live .wave { visibility: visible; }
  .is-live audio { visibility: hidden; pointer-events: none; }
  .play:disabled { opacity: 0.35; cursor: default; }
  .error { color: var(--error); margin-top: var(--space-3); }
  .transcript { margin-top: var(--space-4); border-top: 1px solid var(--line); padding-top: var(--space-3); }
  .transcript summary { cursor: pointer; font-size: 16px; font-weight: 500; color: var(--ink-muted); min-height: 32px; display: flex; align-items: center; }
  .transcript ol { list-style: none; margin: var(--space-3) 0 0; padding: 0; display: grid; gap: var(--space-3); }
  .transcript li { display: grid; grid-template-columns: 76px 1fr; gap: var(--space-3); font-size: 17px; transition: opacity var(--fast) var(--ease); overflow-wrap: anywhere; }
  .who { font-weight: 600; color: var(--ink-muted); }
  .said { display: grid; gap: 2px; }
  .ne { font-size: 17px; }
  .en.sub { color: var(--ink-muted); font-size: 16px; }
  li[data-speaker='agent'] .who { color: var(--link); }
  .is-playing li { opacity: 0.45; }
  .is-playing li.is-past { opacity: 0.8; }
  .is-playing li.is-now { opacity: 1; }
  .compact { padding: var(--space-4); }

  /* Stage: part of the orb, not a box. */
  .stage { background: none; border: 0; padding: 0; color: var(--stage-ink); text-align: center; }
  .stage .head { justify-content: center; }
  .stage .meta { text-align: left; }
  .stage .label { font-size: 16px; }
  .stage .time { color: var(--stage-muted); }
  .stage .play:hover { background: var(--stage-ink); color: var(--on-lime); }
  .stage .slot { max-width: 360px; margin-inline: auto; }
  .stage audio { color-scheme: dark; }
  .caption { min-height: 6.5em; margin-top: var(--space-5); display: grid; align-content: start; gap: 4px; }
  .c-who { font-size: 14px; color: var(--lime); font-weight: 600; }
  .c-ne { font-size: 20px; line-height: 1.4; font-weight: 500; }
  .c-en { font-size: 16px; color: var(--stage-muted); }
  .caption.swap { animation: cap var(--slow) var(--ease); }
  @keyframes cap { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  .stage .transcript { border-top-color: var(--stage-line); text-align: left; }
  .stage .transcript summary { color: var(--stage-muted); justify-content: center; }
  .stage .who { color: var(--stage-muted); }
  .stage li[data-speaker='agent'] .who { color: var(--lime); }
  .stage .en.sub { color: var(--stage-muted); }
</style>

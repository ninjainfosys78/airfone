---
// A call with its transcript. Without JavaScript it is a native audio
// player and a full transcript; call-player.ts upgrades it.
import { clip as loadClip, type ClipData } from './clips';

export interface Props {
  clip?: string;
  /** For audio hosted elsewhere (the real call). */
  src?: string;
  label?: string;
  transcript?: { speaker: 'agent' | 'caller'; text: string; ne?: string; start?: number; end?: number }[];
  data?: ClipData & { src?: string };
  id?: string;
  compact?: boolean;
  /** Sits on the green stage under the orb: no panel, live caption. */
  stage?: boolean;
  /** The call as a conversation: bubbles that light up as it plays. */
  chat?: boolean;
  /** No title or controls of its own; something else on the page plays it (data-play-for). */
  bare?: boolean;
}

const p = Astro.props;
const data: Partial<ClipData> & { src?: string } = p.data ?? (p.clip ? loadClip(p.clip) : {});
const label = p.label ?? data.label ?? 'Example call';
const lines = p.transcript ?? data.lines ?? [];
const id = p.id ?? `call-${p.clip ?? data.id ?? 'remote'}`;
const remote = p.src ?? data.src;
const sources = remote
  ? [{ src: remote, type: 'audio/mpeg' }]
  : [
      { src: `/audio/${p.clip ?? data.id}.opus`, type: 'audio/ogg; codecs=opus' },
      { src: `/audio/${p.clip ?? data.id}.m4a`, type: 'audio/mp4' },
    ];
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
const timing = JSON.stringify({ duration: data.duration ?? 0, lines: lines.map((l) => ({ speaker: l.speaker, start: l.start ?? 0, end: l.end ?? 0 })), peaks: data.peaks ?? [] });
---
<call-player class:list={['player', { compact: p.compact, stage: p.stage, chat: p.chat }]} data-timing={timing}>
  {p.stage && (
    <div class="caption" aria-hidden="true">
      <p class="c-ne" lang="ne">{lines[0]?.ne ?? lines[0]?.text}</p>
      <p class="c-en">{lines[0]?.ne ? lines[0]?.text : ''}</p>
    </div>
  )}
  {!p.bare && <div class="head">
    <button type="button" class="play" aria-pressed="false" aria-controls={id} aria-label={`Play ${label}`} disabled>
      <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
      <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor" /></svg>
    </button>
    <div class="meta">
      {p.stage && <p class="c-status" aria-live="polite">Tap the orb to listen</p>}
      <p class="label">{label}</p>
      {data.duration ? <p class="time small"><span class="now">0:00</span> / {fmt(data.duration)}</p> : null}
    </div>
  </div>}
  <div class="slot">
    <canvas class="wave" aria-hidden="true"></canvas>
    <audio id={id} controls preload="none">
      {sources.map((s) => <source src={s.src} type={s.type} />)}
    </audio>
  </div>

  <p class="error small" role="status" hidden>Audio couldn't load. The transcript is below.</p>
  {lines.length > 0 && (
    <details class="transcript" data-transcript open={p.chat}>
      <summary>Transcript</summary>
      <ol tabindex={p.chat ? 0 : undefined} aria-label={p.chat ? `Transcript of ${label}` : undefined}>
        {lines.map((l) => (
          <li data-speaker={l.speaker} data-start={l.start} data-end={l.end}>
            <span class="who">{l.speaker === 'agent' ? 'AirFone' : 'Caller'}</span>
            <span class="said">
              {l.ne && <span class="ne" lang="ne">{l.ne}</span>}
              <span class:list={['en', { sub: !!l.ne }]}>{l.text}</span>
            </span>
          </li>
        ))}
      </ol>
    </details>
  )}
</call-player>

<script src="./call-player.ts"></script>

<style>
  .player {
    display: block;
    background: var(--canvas);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    padding: var(--space-5);
  }
  .head { display: flex; align-items: center; gap: var(--space-4); }
  .play {
    flex: none; display: grid; place-items: center;
    width: 52px; height: 52px; border: 0; border-radius: var(--radius-control);
    background: var(--lime); color: var(--on-lime); cursor: pointer;
    transition: background-color var(--fast) var(--ease);
  }
  .play:hover { background: var(--brand); color: var(--on-brand); }
  .play svg { width: 24px; height: 24px; }
  .play .i-pause, .play[aria-pressed='true'] .i-play { display: none; }
  .play[aria-pressed='true'] .i-pause { display: block; }
  .label { font-weight: 600; }
  .time { color: var(--ink-muted); font-variant-numeric: tabular-nums; }
  /* Waveform and native audio share one slot so upgrading never shifts layout. */
  .slot { display: grid; margin-top: var(--space-4); min-height: 54px; align-items: center; }
  .slot > * { grid-area: 1 / 1; }
  .wave { width: 100%; height: 48px; cursor: pointer; visibility: hidden; }
  audio { width: 100%; }
  .is-live .wave { visibility: visible; }
  .is-live audio { visibility: hidden; pointer-events: none; }
  .play:disabled { opacity: 0.35; cursor: default; }
  .error { color: var(--error); margin-top: var(--space-3); }
  .transcript { margin-top: var(--space-4); border-top: 1px solid var(--line); padding-top: var(--space-3); }
  .transcript summary { cursor: pointer; font-size: 16px; font-weight: 500; color: var(--ink-muted); min-height: 32px; display: flex; align-items: center; }
  .transcript ol { list-style: none; margin: var(--space-3) 0 0; padding: 0; display: grid; gap: var(--space-3); }
  .transcript li { display: grid; grid-template-columns: 76px 1fr; gap: var(--space-3); font-size: 17px; transition: opacity var(--fast) var(--ease); overflow-wrap: anywhere; }
  .who { font-weight: 600; color: var(--ink-muted); }
  .said { display: grid; gap: 2px; }
  .ne { font-size: 17px; }
  .en.sub { color: var(--ink-muted); font-size: 16px; }
  li[data-speaker='agent'] .who { color: var(--link); }
  .is-playing li { opacity: 0.45; }
  .is-playing li.is-past { opacity: 0.8; }
  .is-playing li.is-now { opacity: 1; }
  .compact { padding: var(--space-4); }

  /* Stage: Siri / ChatGPT voice pattern. The orb is the control; small
     captions appear under it only while it speaks; one quiet status line. */
  .stage { background: none; border: 0; padding: 0; color: var(--stage-ink); text-align: center; display: grid; justify-items: center; }
  .stage .play { display: none; }
  .caption { margin-top: var(--space-3); height: 8.6em; overflow: hidden; max-width: 44ch; display: grid; align-content: start; gap: 2px; }
  .c-ne { font-size: 17px; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .c-en { font-size: 15px; line-height: 1.45; color: var(--stage-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .caption.swap p { animation: cap 700ms cubic-bezier(0.2, 0, 0, 1); }
  @keyframes cap { from { opacity: 0; transform: translateY(3px); } to { opacity: 1; transform: none; } }
  .stage .head { order: -1; margin: 0; justify-content: center; }
  .stage .meta { display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: 0 var(--space-2); font-size: 14px; line-height: 1.5; }
  .stage .meta > * + *::before { content: '·'; margin-right: var(--space-2); color: var(--stage-muted); }
  .c-status { color: var(--lime); font-weight: 600; }
  .stage .label, .stage .time { color: var(--stage-muted); font-weight: 400; font-size: 14px; }
  .stage .slot { display: none; }
  .stage audio { color-scheme: dark; }
  /* Kept for search engines and screen readers, not shown on the stage. */
  .stage .transcript { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .stage .who { color: var(--stage-muted); }
  .stage li[data-speaker='agent'] .who { color: var(--lime); }
  .stage .en.sub { color: var(--stage-muted); }

  /* Chat: the call as a conversation. */
  .chat { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); padding: 0; border: 0; background: none; }
  .chat .head { gap: var(--space-4); }
  .chat .play { width: 64px; height: 64px; }
  .chat .play svg { width: 28px; height: 28px; }
  .chat .label { font-size: 17px; }
  .chat .slot { display: none; }
  .chat .transcript { margin: 0; padding: 0; border: 0; }
  .chat .transcript summary { display: none; }
  .chat .transcript ol {
    margin: 0; height: 420px; overflow-y: auto; scroll-behavior: smooth; overscroll-behavior: contain;
    padding: var(--space-5); gap: var(--space-3);
    background: var(--canvas); border: 1px solid var(--line); border-radius: var(--radius-panel);
  }
  .chat .transcript li {
    display: block; max-width: 80%; padding: var(--space-3) var(--space-4); border-radius: var(--radius-panel);
    background: var(--surface); border: 1px solid var(--line); cursor: pointer;
  }
  .chat .transcript li[data-speaker='caller'] { justify-self: end; background: var(--canvas); }
  /* Who is talking shows by side and colour, not a repeated label. */
  .chat .who { display: none; }
  .chat .transcript li[data-speaker='agent'] { background: var(--stage); border-color: var(--stage); color: var(--stage-ink); }
  .chat .transcript li[data-speaker='agent'] .en.sub { color: var(--stage-muted); }
  .chat .ne { font-size: 16px; }
  .chat .en.sub { font-size: 14px; }
  .chat.is-playing li, .chat.is-playing li.is-past { opacity: 1; }
  .chat .transcript li { border-width: 2px; }
  .chat.is-playing li.is-now { border-color: var(--lime); }
</style>

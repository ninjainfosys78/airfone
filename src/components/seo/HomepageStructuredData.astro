---
interface Props {
  locale?: 'en' | 'ne';
}
const { locale = 'en' } = Astro.props;

const description = locale === 'en'
  ? 'AI-powered voice and IVR platform for automating and analyzing customer phone calls.'
  : 'ग्राहक फोन कलहरू स्वचालित र विश्लेषण गर्ने AI-संचालित भ्वाइस र IVR प्लेटफर्म।';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://airfone.app/#organization',
      name: 'Airfone',
      url: 'https://airfone.app',
      logo: 'https://airfone.app/airfone-logo-transparent.png',
      email: 'info@airfone.app',
      telephone: '+977-9851343348',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Kathmandu',
        addressCountry: 'NP',
      },
      contactPoint: [{
        '@type': 'ContactPoint',
        telephone: '+977-9851343348',
        contactType: 'sales',
        email: 'info@airfone.app',
        areaServed: 'NP',
        availableLanguage: ['en', 'ne'],
      }],
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://airfone.app/#software',
      name: 'Airfone',
      applicationCategory: 'CommunicationApplication',
      operatingSystem: 'Web',
      url: 'https://airfone.app',
      description,
      offers: [
        { '@type': 'Offer', name: 'Starter', price: '4500', priceCurrency: 'NPR', url: 'https://airfone.app/pricing/' },
        { '@type': 'Offer', name: 'Growth', price: '9500', priceCurrency: 'NPR', url: 'https://airfone.app/pricing/' },
        { '@type': 'Offer', name: 'AI Enterprise', price: '22500', priceCurrency: 'NPR', url: 'https://airfone.app/pricing/' },
      ],
    },
  ],
};
---
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

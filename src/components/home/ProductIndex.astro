---
import { products } from '../../data/products';
---
<section class="section" data-reveal>
  <div class="wrap">
    <h2>Products</h2>
    <ul class="index" id="products">
      {products.map((p, i) => (
        <li>
          <a href={`/products/${p.slug}`}>
            <span class="n mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="name">{p.name}</span>
            <span class="short">{p.short}</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .index { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  a {
    display: grid; grid-template-columns: 48px minmax(0, 1.1fr) minmax(0, 1.4fr) 32px; gap: var(--space-5);
    align-items: baseline; padding: var(--space-5) 0; border-bottom: 1px solid var(--line);
    color: var(--ink); text-decoration: none;
  }
  a:hover .name { color: var(--link); }
  a:hover .arrow { transform: translateX(4px); }
  .n { color: var(--ink-muted); font-size: 16px; }
  .name { font-size: 1.375rem; font-weight: 600; line-height: 1.25; transition: color var(--fast) var(--ease); }
  .short { color: var(--ink-muted); }
  .arrow { color: var(--link); font-size: 1.375rem; transition: transform var(--fast) var(--ease); justify-self: end; }
  @media (max-width: 767px) {
    a { grid-template-columns: 1fr 24px; gap: var(--space-2) var(--space-3); }
    .n { display: none; }
    .short { grid-column: 1; }
    .arrow { grid-row: 1; grid-column: 2; }
  }
</style>

---
import CallPlayer from '../player/CallPlayer.astro';
import { realCall } from '../player/clips';
import { testimonials } from '../../data/testimonials';

const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
---
<section class="section proof" data-reveal>
  <div class="wrap grid">
    <div class="side on-stage">
      <h2>Hear AirFone answer a real customer</h2>
      <div class="ctrl">
        <button type="button" class="big" data-play-for="call-real" aria-pressed="false" aria-label="Play the real call">
          <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
          <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor" /></svg>
        </button>
        <div class="who">
          <p class="biz">Pathibhara Solutions</p>
          <p class="meta">Real call · <span data-time-for="call-real">0:00</span> / {fmt(realCall.duration)}</p>
        </div>
      </div>
      <div class="bar" aria-hidden="true"><span data-progress-for="call-real"></span></div>
    </div>
    <div class="convo"><CallPlayer data={realCall} id="call-real" chat bare /></div>
  </div>
  {testimonials.length > 0 && (
    <div class="wrap quotes">
      {testimonials.map((t) => (
        <figure>
          <blockquote>{t.quote}</blockquote>
          <figcaption>{t.name}, {t.business}</figcaption>
        </figure>
      ))}
    </div>
  )}
</section>

<style>
  .proof { background: var(--surface); }
  .grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: var(--space-5); align-items: stretch; }
  .side {
    display: grid; grid-template-rows: 1fr auto auto; gap: var(--space-5);
    padding: var(--space-7); border-radius: var(--radius-panel); min-height: 420px;
  }
  .side h2 { color: var(--stage-ink); max-width: 13ch; }
  .ctrl { display: flex; align-items: center; gap: var(--space-4); }
  .big {
    flex: none; display: grid; place-items: center; width: 72px; height: 72px; border: 0; border-radius: 50%;
    background: var(--lime); color: var(--on-lime); cursor: pointer; transition: background-color var(--fast) var(--ease);
  }
  .big:hover { background: var(--stage-ink); }
  .big:focus-visible { outline: 2px solid var(--stage-ink); outline-offset: 3px; }
  .big svg { width: 28px; height: 28px; }
  .big .i-pause, .big[aria-pressed='true'] .i-play { display: none; }
  .big[aria-pressed='true'] .i-pause { display: block; }
  .biz { font-weight: 600; font-size: 18px; }
  .meta { color: var(--stage-muted); font-size: 15px; font-variant-numeric: tabular-nums; }
  .bar { height: 3px; background: var(--stage-line); border-radius: 2px; overflow: hidden; }
  .bar span { display: block; height: 100%; background: var(--lime); transform: scaleX(0); transform-origin: left; }

  /* The player shows only its conversation here; the panel is the control. */
  .convo :global(.slot) { display: none; }
  .convo :global(.transcript ol) { height: 100%; min-height: 420px; max-height: 420px; }

  .quotes { margin-top: var(--space-8); display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-6); }
  figure { margin: 0; }
  blockquote { margin: 0 0 var(--space-3); font-size: 1.25rem; }
  figcaption { color: var(--ink-muted); font-size: 16px; }
  @media (max-width: 959px) {
    .grid { grid-template-columns: 1fr; }
    .side { min-height: 0; padding: var(--space-5); }
    .convo :global(.transcript ol) { min-height: 360px; max-height: 360px; }
  }
</style>

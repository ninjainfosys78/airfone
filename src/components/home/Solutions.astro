---
import { solutions } from '../../data/solutions';
---
<section class="section who" data-reveal>
  <div class="wrap">
    <h2>Who it's for</h2>
    <ul class="list">
      {solutions.map((s) => (
        <li><a href={`/solutions/${s.slug}`}><span class="name">{s.name}</span></a></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .who { background: var(--surface); }
  .list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 var(--space-7); }
  a { display: grid; gap: var(--space-1); padding: var(--space-5) 0; border-top: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  a:hover .name { color: var(--link); text-decoration: underline; }
  .name { font-size: 1.25rem; font-weight: 600; }
  @media (max-width: 767px) { .list { grid-template-columns: 1fr; } }
</style>

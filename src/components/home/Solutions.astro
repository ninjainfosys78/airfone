---
import { Image } from 'astro:assets';
import { solutions } from '../../data/solutions';
import frontDesk from '../../assets/photos/team-front-desk.png';
---
<section class="section who" data-reveal>
  <div class="wrap grid">
    <Image src={frontDesk} alt="An AirFone team member at the office front desk in Kathmandu" widths={[440, 880, 1080]} sizes="(max-width: 959px) 100vw, 380px" quality={90} format="webp" class="photo" />
    <div>
    <h2>Who it's for</h2>
    <ul class="list">
      {solutions.map((s) => (
        <li><a href={`/solutions/${s.slug}`}><span class="name">{s.name}</span><span class="arrow" aria-hidden="true">→</span></a></li>
      ))}
    </ul>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 380px) minmax(0, 1fr); gap: var(--space-8); align-items: center; }
  .photo { width: 100%; height: auto; aspect-ratio: 9 / 16; border-radius: var(--radius-panel); }
  .grid h2 { margin-bottom: var(--space-6); }
  @media (max-width: 959px) { .grid { grid-template-columns: 1fr; } .photo { max-width: 400px; } }
  .list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; }
  .list { border-bottom: 1px solid var(--line); }
  a { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); min-height: 64px; border-top: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .name { font-size: 18px; font-weight: 500; line-height: 1.3; transition: color var(--fast) var(--ease); }
  .arrow { color: var(--link); font-size: 18px; transition: transform var(--fast) var(--ease); }
  a:hover .name { color: var(--link); }
  a:hover .arrow { transform: translateX(4px); }
</style>

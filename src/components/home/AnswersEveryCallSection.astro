---
import { Image } from 'astro:assets';
import { ArrowRight } from 'lucide-react';
import answerInstantlyImage from '../../assets/images/answer-instantly.png';

interface Props {
  locale?: 'en' | 'ne';
}
const { locale = 'en' } = Astro.props;
---
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" />

<section class="answers-section reveal">
  <div class="answers-inner">
    <div class="answers-text">
      <h2 class="answers-title">
        {locale === 'en'
          ? <>Your AI agent <span class="answers-accent">answers every call</span>, instantly.</>
          : <>तपाईंको AI एजेन्टले <span class="answers-accent">हरेक कल</span> तुरुन्तै जवाफ दिन्छ।</>}
      </h2>
      <p class="answers-lede">
        {locale === 'en'
          ? 'Switch it on, and Airfone starts picking up, understanding, and resolving customer calls immediately — no waiting, no missed calls, no extra staff.'
          : 'यसलाई सक्रिय गर्नुहोस्, र Airfone ले तुरुन्तै ग्राहकका कलहरू उठाउन, बुझ्न र समाधान गर्न थाल्छ — न पर्खाइ, न छुटेको कल, न थप कर्मचारी।'}
      </p>
      <a href="#live-demo" class="answers-cta">
        {locale === 'en' ? 'See it in action' : 'यसलाई कार्यमा हेर्नुहोस्'}
        <ArrowRight size={18} />
      </a>
    </div>

    <div class="answers-visual">
      <div class="answers-glow" aria-hidden="true"></div>
      <Image
        src={answerInstantlyImage}
        alt={locale === 'en' ? 'Phone screen showing an active AI Agent call' : 'AI एजेन्ट सक्रिय कल देखाउने फोन स्क्रिन'}
        class="answers-phone-image"
        loading="lazy"
      />
      <div class="answers-badge answers-badge-agent" aria-hidden="true">
        <span class="answers-badge-dot"></span>
        {locale === 'en' ? 'AI Agent active' : 'AI एजेन्ट सक्रिय'}
      </div>
      <div class="answers-badge answers-badge-latency" aria-hidden="true">
        {locale === 'en' ? '0.6s response time' : '0.6 सेकेन्ड प्रतिक्रिया समय'}
      </div>
    </div>
  </div>
</section>

<style>
  .answers-section {
    font-family: 'Inter', 'Noto Sans', system-ui, sans-serif !important;
    padding: 110px 2rem;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
  }

  .answers-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 4rem;
  }

  .answers-title {
    font-size: clamp(2rem, 4vw, 2.875rem);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0 0 1.25rem;
  }

  .answers-accent {
    background: linear-gradient(135deg, #97C459 0%, #1D9E75 55%, #0F6E56 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .answers-lede {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 460px;
    margin: 0 0 2rem;
  }

  .answers-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.8rem;
    border-radius: 9999px;
    background: linear-gradient(135deg, #97C459 0%, #1D9E75 55%, #0F6E56 100%);
    color: #FFFFFF;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 8px 20px -8px rgba(15, 110, 86, 0.5);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .answers-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px -8px rgba(15, 110, 86, 0.6);
  }

  /* ── Visual side ────────────────────────────────────────────────────── */
  .answers-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .answers-glow {
    position: absolute;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(151, 196, 89, 0.45) 0%, rgba(15, 110, 86, 0.25) 55%, transparent 75%);
    filter: blur(50px);
    animation: answersGlowPulse 4s ease-in-out infinite;
    z-index: 0;
  }

  @keyframes answersGlowPulse {
    0%, 100% { transform: scale(0.92); opacity: 0.75; }
    50% { transform: scale(1.08); opacity: 1; }
  }

  .answers-phone-image {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 420px;
    height: auto;
    border-radius: 20px;
    box-shadow: 0 30px 60px -20px rgba(15, 110, 86, 0.35);
    animation: answersPhoneFloat 5s ease-in-out infinite;
  }

  @keyframes answersPhoneFloat {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-14px) rotate(1.5deg); }
  }

  .answers-badge {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-radius: 9999px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    box-shadow: 0 10px 24px -12px rgba(15, 110, 86, 0.3);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-primary);
    white-space: nowrap;
  }

  .answers-badge-agent {
    top: 8%;
    left: -8%;
    animation: answersBadgeFloat 4.5s ease-in-out infinite;
  }

  .answers-badge-latency {
    bottom: 10%;
    right: -6%;
    animation: answersBadgeFloat 4.5s ease-in-out infinite 1.4s;
  }

  @keyframes answersBadgeFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .answers-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #1D9E75;
    animation: answersDotPulse 1.6s ease-in-out infinite;
  }

  @keyframes answersDotPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.4); }
  }

  :global([data-theme='dark']) .answers-badge-dot { background: #97C459; }

  @media (prefers-reduced-motion: reduce) {
    .answers-glow, .answers-phone-image, .answers-badge, .answers-badge-dot {
      animation: none;
    }
  }

  @media (max-width: 900px) {
    .answers-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .answers-lede { margin-left: auto; margin-right: auto; }
    .answers-badge { display: none; }
    .answers-glow { width: 260px; height: 260px; filter: blur(36px); }
  }

  @media (max-width: 600px) {
    .answers-section { padding: 64px 1.5rem; }
  }
</style>

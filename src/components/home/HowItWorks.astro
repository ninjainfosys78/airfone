---
// Three steps, each with a small picture of the real screen at that step.
// Built in HTML/CSS (not drawn art) so it stays crisp and on brand.
---
<section class="section how" data-reveal>
  <div class="wrap">
    <h2>Live in a day</h2>
    <ol class="steps">
      <li>
        <h3><span class="n mono">1</span>Connect your number</h3>
        <figure class="pic" aria-hidden="true">
          <div class="ui">
            <div class="row line">
              <span class="ic"><svg viewBox="0 0 24 24"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z" fill="currentColor" /></svg></span>
              <span class="grow"><span class="lbl">Your number</span><span class="val mono">01-5970000</span></span>
            </div>
            <div class="link"><span></span><svg viewBox="0 0 24 24"><path d="M12 4v16m0 0-5-5m5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg><span></span></div>
            <div class="row line af">
              <img src="/brand/airfone-mark.svg" alt="" width="32" height="20" />
              <span class="grow"><span class="lbl">AirFone</span><span class="val">SIP line</span></span>
              <span class="ok"><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>Connected</span>
            </div>
          </div>
        </figure>
      </li>

      <li>
        <h3><span class="n mono">2</span>Add your price list</h3>
        <figure class="pic" aria-hidden="true">
          <div class="ui">
            <div class="row file">
              <span class="sheet"><svg viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6zM14 3v4h4M9 12h6M9 15h6M9 18h4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg></span>
              <span class="grow"><span class="val">price-list.xlsx</span><span class="track"><span></span></span></span>
            </div>
            <ul class="items">
              <li><span>ThinkPad 14</span><span class="tag">Learned</span></li>
              <li><span>Opening hours</span><span class="tag">Learned</span></li>
              <li><span>Delivery to Pokhara</span><span class="tag">Learned</span></li>
            </ul>
          </div>
        </figure>
      </li>

      <li>
        <h3><span class="n mono">3</span>AirFone answers</h3>
        <figure class="pic" aria-hidden="true">
          <div class="ui">
            <div class="row line">
              <span class="ic"><svg viewBox="0 0 24 24"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z" fill="currentColor" /></svg></span>
              <span class="grow"><span class="lbl">Incoming call</span><span class="val mono">+977 98XXXXXXXX</span></span>
            </div>
            <div class="row line af">
              <img src="/brand/airfone-mark.svg" alt="" width="32" height="20" />
              <span class="grow"><span class="lbl">AirFone</span><span class="val" lang="ne">नमस्ते, सिटी इलेक्ट्रोनिक्स।</span></span>
            </div>
            <span class="ok"><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>Answered on the first ring</span>
          </div>
        </figure>
      </li>
    </ol>
  </div>
</section>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .steps > li { display: grid; grid-template-rows: auto 1fr; gap: var(--space-4); }
  h3 { display: flex; align-items: center; gap: var(--space-3); font-size: 1.25rem; }
  .n { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--lime); color: var(--on-lime); font-size: 15px; font-weight: 600; flex: none; }

  /* The picture: a tinted stage with one white product surface on it. */
  .pic { margin: 0; display: grid; }
  .ui { width: 100%; background: var(--canvas); border: 1px solid var(--line); border-radius: var(--radius-panel); padding: var(--space-4); display: grid; align-content: start; gap: var(--space-3); }
  .row { display: flex; align-items: center; gap: var(--space-3); }
  .grow { flex: 1; display: grid; min-width: 0; }
  .lbl { font-size: 12px; color: var(--ink-muted); }
  .val { font-size: 15px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ic { display: grid; place-items: center; width: 32px; height: 32px; border-radius: var(--radius-control); background: var(--subtle); color: var(--link); }
  .ic svg { width: 16px; height: 16px; }
  .line { padding: var(--space-3); border: 1px solid var(--line); border-radius: var(--radius-control); }
  .af img { width: 32px; height: auto; }
  .ok { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 600; color: var(--link); }
  .ok svg { width: 14px; height: 14px; }
  .link { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; color: var(--lime); height: 20px; }
  .link svg { width: 20px; height: 20px; }

  .file { padding: var(--space-3); border: 1px dashed var(--brand); border-radius: var(--radius-control); background: var(--surface); }
  .sheet { display: grid; place-items: center; width: 32px; height: 32px; border-radius: var(--radius-control); background: var(--brand); color: var(--on-brand); }
  .sheet svg { width: 18px; height: 18px; }
  .track { display: block; height: 4px; margin-top: 6px; border-radius: 2px; background: var(--line); overflow: hidden; }
  .track span { display: block; height: 100%; width: 100%; background: var(--lime); }
  .items { list-style: none; margin: 0; padding: 0; display: grid; }
  .items li { display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); padding: var(--space-2) 0; font-size: 14px; }
  .items li + li { border-top: 1px solid var(--line); }
  .tag { font-size: 12px; font-weight: 600; color: var(--link); background: var(--subtle); padding: 2px var(--space-2); border-radius: 6px; }

  @media (max-width: 959px) {
    .steps { grid-template-columns: 1fr; gap: var(--space-7); }
  }
</style>

---
const steps = ['Connect your number', 'Add your price list', 'AirFone answers'];
---
<section class="section how" data-reveal>
  <div class="wrap">
    <h2>Live in a day</h2>
    <ol class="steps">
      {steps.map((s, i) => (
        <li>
          <span class="n mono" aria-hidden="true">{i + 1}</span>
          <span class="t">{s}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); position: relative; }
  /* One line runs through the three numbers. */
  .steps::before { content: ''; position: absolute; left: 24px; right: calc((100% - 2 * var(--space-6)) / 3 - 24px); top: 23px; height: 2px; background: var(--line); }
  li { position: relative; display: grid; gap: var(--space-4); }
  .n {
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
    background: var(--canvas); border: 2px solid var(--brand); color: var(--link); font-weight: 600; font-size: 17px;
  }
  li:last-child .n { background: var(--lime); border-color: var(--lime); color: var(--on-lime); }
  .t { font-size: clamp(1.25rem, 1rem + 0.9vw, 1.625rem); font-weight: 600; line-height: 1.25; }
  @media (max-width: 767px) {
    .steps { grid-template-columns: 1fr; gap: var(--space-5); }
    .steps::before { left: 23px; right: auto; top: 24px; bottom: 24px; width: 2px; height: auto; }
    li { grid-template-columns: 48px 1fr; align-items: center; }
  }
</style>

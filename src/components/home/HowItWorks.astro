    </ol>
    </div>
  </div>
</section>

<style>
  /* Conveyor: two copies of the steps move left forever; hover pauses it. */
  .how h2 { margin-bottom: var(--space-6); }
  /* Desktop: the belt bleeds to both screen edges. Smaller screens: inside the margins. */
  .belt { overflow: hidden; padding-block: var(--space-2); }
  @media (max-width: 1023px) { .belt { margin-inline: var(--gutter); } }
  .conveyor { display: flex; width: max-content; gap: var(--space-6); animation: belt 36s linear infinite; }
  .belt:hover .conveyor, .belt:focus-within .conveyor { animation-play-state: paused; }
  @keyframes belt { from { transform: translateX(0); } to { transform: translateX(calc(-50% - var(--space-6) / 2)); } }
  .conveyor .steps { display: flex; gap: var(--space-6); }
  .conveyor .steps > li { width: 420px; flex: none; }
  .steps { list-style: none; margin: 0; padding: 0; }
  .steps > li { display: grid; grid-template-rows: auto 1fr; gap: var(--space-4); }
  h3 { display: flex; align-items: center; gap: var(--space-3); font-size: 1.25rem; }
  .n { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--lime); color: var(--on-lime); font-size: 15px; font-weight: 600; flex: none; }

  /* A small AirFone app window. */
  .app { margin: 0; display: grid; grid-template-rows: auto 1fr; height: 260px; background: var(--canvas); border: 1px solid var(--line); border-radius: var(--radius-panel); overflow: hidden; }
  .bar { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--line); background: var(--surface); font-size: 13px; font-weight: 600; }
  .bar img { width: 22px; height: auto; }
  .body { padding: var(--space-4); display: grid; align-content: start; gap: var(--space-3); }
  .grow { flex: 1; display: grid; min-width: 0; }
  .lbl { font-size: 12px; color: var(--ink-muted); display: inline-flex; align-items: center; gap: 6px; }
  .val { font-size: 15px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ic { display: grid; place-items: center; width: 36px; height: 36px; border-radius: var(--radius-control); background: var(--subtle); color: var(--link); flex: none; }
  .ic svg { width: 16px; height: 16px; }
  .ic.on { background: var(--lime); color: var(--on-lime); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--lime); flex: none; }

  .line-card, .live { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3); border: 1px solid var(--line); border-radius: var(--radius-control); }
  .status { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; color: var(--link); }
  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  .stats > div { display: grid; gap: 2px; padding: var(--space-3); background: var(--surface); border-radius: var(--radius-control); }
  .big { font-size: 18px; font-weight: 600; }

  .files { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .files li { display: flex; align-items: center; gap: var(--space-3); }
  .doc { display: grid; place-items: center; width: 36px; height: 36px; border-radius: var(--radius-control); background: var(--brand); color: var(--on-brand); flex: none; }
  .doc svg { width: 18px; height: 18px; }
  .ok { color: var(--link); display: grid; }
  .ok svg { width: 18px; height: 18px; }
  .ask { display: grid; gap: var(--space-2); padding: var(--space-3); background: var(--surface); border-radius: var(--radius-control); }
  .q { justify-self: end; padding: 4px var(--space-3); border-radius: var(--radius-control); background: var(--brand); color: var(--on-brand); font-size: 13px; }
  .a { justify-self: start; padding: 4px var(--space-3); border-radius: var(--radius-control); background: var(--canvas); border: 1px solid var(--line); font-size: 13px; }

  .said { margin: 0; padding: var(--space-3); background: var(--surface); border-radius: var(--radius-control); font-size: 15px; }
  .take { justify-self: start; padding: 6px var(--space-4); border: 1px solid var(--brand); border-radius: var(--radius-control); font-size: 13px; font-weight: 600; color: var(--link); }

  @media (max-width: 767px) { .conveyor .steps > li { width: 300px; } }
  /* No motion: the three steps stand still, side by side or stacked. */
  @media (prefers-reduced-motion: reduce) {
    .conveyor { animation: none; width: auto; padding-inline: var(--gutter); max-width: var(--max-width); margin-inline: auto; }
    .conveyor .steps[aria-hidden] { display: none; }
    .conveyor .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); width: 100%; }
    .conveyor .steps > li { width: auto; }
  }
</style>

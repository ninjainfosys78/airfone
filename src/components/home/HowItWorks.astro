---
const steps = [
  { h: 'Connect your line', p: 'Keep your number and connect it through SIP, or take a new number from us.' },
  { h: 'Teach it your business', p: 'Add price lists, documents and notes. Change them any time and the agent knows at once.' },
  { h: 'Watch every call', p: 'Read each call as text, listen back, or join a live call and take over.' },
];
---
<section class="section how" data-reveal>
  <div class="wrap">
    <h2>Live in a day</h2>
    <ol class="steps">
      {steps.map((s, i) => (
        <li>
          <span class="n mono">{i + 1}</span>
          <h3>{s.h}</h3>
          <p class="muted">{s.p}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-7); }
  li { border-top: 1px solid var(--line); padding-top: var(--space-5); }
  .n { display: block; color: var(--link); font-size: 16px; margin-bottom: var(--space-3); }
  h3 { margin-bottom: var(--space-3); }
  @media (max-width: 767px) { .steps { grid-template-columns: 1fr; gap: var(--space-6); } }
</style>

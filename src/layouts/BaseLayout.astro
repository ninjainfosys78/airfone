---
import ThemeToggle from '../components/ThemeToggle';
import { MapPin, Phone, Mail, LogIn, UserPlus } from 'lucide-react';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  solidNav?: boolean;
}

const {
  title,
  description = 'SmartIVRAI — Digital Service Portal | स्मार्ट IVR AI',
  solidNav = false,
} = Astro.props;

const locale = Astro.currentLocale ?? 'ne';

const currentPath = Astro.url.pathname;
const pathWithoutLocale = currentPath.replace(/^\/(en|ne)(\/|$)/, '/');
const normalizedPath = (pathWithoutLocale.endsWith('/') && pathWithoutLocale !== '/')
  ? pathWithoutLocale.slice(0, -1)
  : pathWithoutLocale;

const nePath = `/ne${pathWithoutLocale}`;
const enPath = `/en${pathWithoutLocale}`;

const isHome       = normalizedPath === '/';
const isAbout      = normalizedPath.startsWith('/about');
const isFeatures   = normalizedPath.startsWith('/features');
const isEnterprise = normalizedPath.startsWith('/enterprise');
const isPricing    = normalizedPath.startsWith('/pricing');
const isContact    = normalizedPath.startsWith('/contact');

const isLogin    = pathWithoutLocale.startsWith('/login');
const isRegister = pathWithoutLocale.startsWith('/register');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      // Apply saved theme before the first paint and re-apply it after every
      // View Transition swap. Astro restores the root <html> attributes from the
      // server-rendered page (which has no data-theme), so without this the page
      // would flash white/dark before initLayout runs on astro:page-load.
      (function () {
        function applyTheme() {
          try {
            var stored = localStorage.getItem('theme');
            var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
          } catch (e) {}
        }
        applyTheme();
        if (!window.__themeSwapHandler) {
          window.__themeSwapHandler = applyTheme;
          document.addEventListener('astro:after-swap', applyTheme);
        }
      })();
    </script>
    <link rel="icon" type="image/png" href="/airfone-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Tiro+Devanagari+Hindi:ital@0;1&display=swap"
    />
    <ViewTransitions />
  </head>
  <body>
    <a href="#main" class="skip">{locale === 'en' ? 'Skip to main content' : 'मुख्य सामग्रीमा जानुहोस्'}</a>

    <header class={`navbar${solidNav ? ' solid-nav' : ''}`} transition:animate="none">
      <div class="navbar-inner">
        <a href={`/${locale}/`} class="brand">
          <img src="/airfone-logo-transparent.png" alt="AirFone" class="brand-logo" />
        </a>

        <ul class="nav-links">
          <li><a href={`/${locale}/`} class={`nav-link${isHome ? ' active' : ''}`}>{locale === 'en' ? 'Home' : 'गृह'}</a></li>
          <li><a href={`/${locale}/about/`} class={`nav-link${isAbout ? ' active' : ''}`}>{locale === 'en' ? 'About Us' : 'हाम्रोबारे'}</a></li>
          <li><a href={`/${locale}/features/`} class={`nav-link${isFeatures ? ' active' : ''}`}>{locale === 'en' ? 'Features' : 'सुविधाहरू'}</a></li>
          <li><a href={`/${locale}/pricing/`} class={`nav-link${isPricing ? ' active' : ''}`}>{locale === 'en' ? 'Pricing' : 'मूल्य निर्धारण'}</a></li>
          <li><a href={`/${locale}/contact/`} class={`nav-link${isContact ? ' active' : ''}`}>{locale === 'en' ? 'Contact' : 'सम्पर्क'}</a></li>
        </ul>

        <div class="nav-right">
          <div class="navbar-theme-toggle">
            <ThemeToggle client:load locale={locale} />
          </div>
          <a href={locale === 'ne' ? enPath : nePath} class="lang-toggle-btn" data-astro-scroll="false" title={locale === 'ne' ? 'Switch to English' : 'नेपालीमा स्विच गर्नुहोस्'}>
            {locale === 'ne' ? 'ENG' : 'नेप'}
          </a>
          <div class="nav-auth-buttons">
            <a href={`/${locale}/login/`} class={`btn-signin`}>Sign In</a>
            <a href={`/${locale}/contact/`} class={`btn-book-demo`}>Book a Demo</a>
          </div>
        </div>

        <!-- Hamburger button (mobile only) -->
        <button class="hamburger" id="hamburger-btn" aria-label="Toggle navigation" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <!-- Mobile Nav Drawer -->
    <div class="mobile-nav-drawer" id="mobile-nav-drawer" aria-hidden="true">
      <nav>
        <ul class="mobile-nav-links">
          <li><a href={`/${locale}/`} class={`mobile-nav-link${isHome ? ' active' : ''}`}>{locale === 'en' ? 'Home' : 'गृह'}</a></li>
          <li><a href={`/${locale}/about/`} class={`mobile-nav-link${isAbout ? ' active' : ''}`}>{locale === 'en' ? 'About Us' : 'हाम्रोबारे'}</a></li>
          <li><a href={`/${locale}/features/`} class={`mobile-nav-link${isFeatures ? ' active' : ''}`}>{locale === 'en' ? 'Features' : 'सुविधाहरू'}</a></li>
          <li><a href={`/${locale}/pricing/`} class={`mobile-nav-link${isPricing ? ' active' : ''}`}>{locale === 'en' ? 'Pricing' : 'मूल्य निर्धारण'}</a></li>
          <li><a href={`/${locale}/contact/`} class={`mobile-nav-link${isContact ? ' active' : ''}`}>{locale === 'en' ? 'Contact' : 'सम्पर्क'}</a></li>
        </ul>
        <div class="mobile-nav-auth">
          <a href={`/${locale}/login/`} class={`mobile-btn-signin${isLogin ? ' active' : ''}`}>{locale === 'en' ? 'Sign In' : 'प्रवेश गर्नुहोस्'}</a>
          <a href={`/${locale}/contact/`} class={`mobile-btn-demo${isContact ? ' active' : ''}`}>{locale === 'en' ? 'Book a Demo' : 'डेमो बुक गर्नुहोस्'}</a>
        </div>
      </nav>
    </div>

    <div class="floating-theme-toggle">
      <ThemeToggle client:load locale={locale} />
    </div>

    <main id="main">
      <slot />
    </main>

    <script>
      // ── Scroll preservation across ViewTransition language switches ──────
      // We track whether the navigation was triggered by the lang button.
      let _langSwitchScrollY = -1;

      // Before the DOM swap: capture current scroll (only for lang-btn clicks)
      document.addEventListener('astro:before-swap', () => {
        if (_langSwitchScrollY >= 0) {
          // Store in sessionStorage so it survives the swap
          sessionStorage.setItem('__vt_scroll', String(_langSwitchScrollY));
        }
        _langSwitchScrollY = -1;
      });

      // After the DOM swap (before paint): restore scroll immediately
      document.addEventListener('astro:after-swap', () => {
        const saved = sessionStorage.getItem('__vt_scroll');
        if (saved !== null) {
          sessionStorage.removeItem('__vt_scroll');
          const pos = parseInt(saved, 10);
          if (!isNaN(pos) && pos >= 0) {
            // Disable browser's own scroll restoration
            if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
            window.scrollTo({ top: pos, behavior: 'instant' });
          }
        }
      });

      function initLayout() {
        // Initialize theme
        const stored = localStorage.getItem('theme');
        let theme = stored || 'dark';
        if (!stored) {
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          theme = prefersDark ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);

        // Active nav link highlighting
        const pathname = window.location.pathname.replace(/^\/(en|ne)(\/|$)/, '/');
        const normPath = (pathname.endsWith('/') && pathname !== '/') ? pathname.slice(0, -1) : pathname;
        document.querySelectorAll('.nav-links .nav-link').forEach(link => {
          const href = link.getAttribute('href') || '';
          const hrefPath = href.replace(/^\/(en|ne)(\/|$)/, '/');
          const normHref = (hrefPath.endsWith('/') && hrefPath !== '/') ? hrefPath.slice(0, -1) : hrefPath;
          const isActive = (normHref === '/' && normPath === '/') || (normHref !== '/' && normPath.startsWith(normHref));
          link.classList.toggle('active', isActive);
        });

        // Navbar scroll detection
        const navbar = document.querySelector('.navbar');
        if (navbar) {
          window.addEventListener('scroll', () => {
            navbar.classList.toggle('scrolled', window.scrollY > 50);
          });
        }

        // Hamburger toggle
        const hamburger = document.getElementById('hamburger-btn');
        const drawer    = document.getElementById('mobile-nav-drawer');
        if (hamburger && drawer) {
          hamburger.addEventListener('click', () => {
            const open = hamburger.classList.toggle('open');
            drawer.classList.toggle('open', open);
            hamburger.setAttribute('aria-expanded', String(open));
            drawer.setAttribute('aria-hidden', String(!open));
            document.body.style.overflow = open ? 'hidden' : '';
          });
          // Close drawer when a link inside is clicked
          drawer.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
              hamburger.classList.remove('open');
              drawer.classList.remove('open');
              hamburger.setAttribute('aria-expanded', 'false');
              drawer.setAttribute('aria-hidden', 'true');
              document.body.style.overflow = '';
            });
          });
        }

        // Capture scroll position when lang button is clicked (before navigation)
        document.querySelectorAll('.lang-toggle-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            _langSwitchScrollY = window.scrollY;
          });
        });
      }

      document.addEventListener('astro:page-load', initLayout);
    </script>

    <footer class="site-footer">
      <div class="footer-inner">

        <!-- Brand column -->
        <div class="footer-brand-col">
          <a href={`/${locale}/`} class="footer-brand">
            <img src="/airfone-logo-transparent.png" alt="AirFone" class="footer-brand-logo" />
          </a>
          <p class="footer-tagline">
            {locale === 'en'
              ? 'Turning every phone call into an intelligent, data-driven interaction — built for the Nepali market and beyond.'
              : 'हरेक फोन कललाई एउटा बौद्धिक, डाटा-संचालित अन्तरक्रियामा बदल्दै — नेपाली बजार र त्यसभन्दा परका लागि।'}
          </p>
        </div>

        <!-- Platform links -->
        <div class="footer-col">
          <span class="footer-col-heading">{locale === 'en' ? 'PLATFORM' : 'प्लेटफर्म'}</span>
          <ul>
            <li><a href={`/${locale}/features/`}>{locale === 'en' ? 'Features' : 'सुविधाहरू'}</a></li>
            <li><a href={`/${locale}/features/`}>{locale === 'en' ? 'Architecture' : 'आर्किटेक्चर'}</a></li>
            <li><a href={`/${locale}/features/`}>{locale === 'en' ? 'Roadmap' : 'रोडम्याप'}</a></li>
            <li><a href={`/${locale}/pricing/`}>{locale === 'en' ? 'Pricing' : 'मूल्य निर्धारण'}</a></li>
          </ul>
        </div>

        <!-- Company links -->
        <div class="footer-col">
          <span class="footer-col-heading">{locale === 'en' ? 'COMPANY' : 'कम्पनी'}</span>
          <ul>
            <li><a href={`/${locale}/about/`}>{locale === 'en' ? 'About Us' : 'हाम्रोबारे'}</a></li>
            <li><a href={`/${locale}/about/`}>{locale === 'en' ? 'Our Values' : 'हाम्रा मूल्यहरू'}</a></li>
            <li><a href={`/${locale}/contact/`}>{locale === 'en' ? 'Contact' : 'सम्पर्क'}</a></li>
          </ul>
        </div>

        <!-- Resources links -->
        <div class="footer-col">
          <span class="footer-col-heading">{locale === 'en' ? 'RESOURCES' : 'स्रोतहरू'}</span>
          <ul>
            <li><a href={`/${locale}/contact/`}>{locale === 'en' ? 'Request a Demo' : 'डेमो अनुरोध'}</a></li>
            <li><a href={`/${locale}/contact/`}>{locale === 'en' ? 'Download Proposal' : 'प्रस्ताव डाउनलोड'}</a></li>
            <li><a href={`/${locale}/pricing/`}>{locale === 'en' ? 'SLA & Terms' : 'SLA र सर्तहरू'}</a></li>
          </ul>
        </div>

      </div>

      <div class="footer-bottom">
        <span>{locale === 'en' ? '© 2026 Smart IVR & AI Cloud Voice Broadcasting Platform. All rights reserved.  ·  All NPR pricing excludes VAT.' : '© २०२६ स्मार्ट IVR र AI क्लाउड भ्वाइस ब्रोडकास्टिङ प्लेटफर्म। सर्वाधिकार सुरक्षित।  ·  सबै NPR मूल्यमा VAT समावेश छैन।'}</span>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    /* AirFone brand palette — bright lime-green → deep forest green */
    --primary: #3DB551;           /* mid green */
    --primary-dark: #2A8A3C;      /* deeper green */
    --primary-light: #6DC040;     /* lime green (logo top) */
    --primary-gradient-start: #8DC63F;  /* bright lime (logo highlight) */
    --primary-gradient-end: #1B7A2F;    /* deep forest green */
    --success: #3DB551;

    /* Page background stays clean white/cream */
    --bg-primary: #FFFFFF;
    --bg-secondary: #050d07ff;
    --bg-tertiary: #F4FAF5;
    --text-primary: #1A1A1A;
    --text-secondary: #555555;
    --border-color: #C8E6C9;
    --card-bg: #0D2010;
    --card-border: rgba(61, 181, 81, 0.2);

    /* Height of the fixed navbar — used to position the mobile drawer below it */
    --nav-height: 92px;
  }

  html[data-theme="light"] {
    --bg-primary: #FFFFFF;
    --bg-secondary: #F4FAF5;
    --bg-tertiary: #F4FAF5;
    --text-primary: #1A1A1A;
    --text-secondary: #555555;
    --border-color: #C8E6C9;
    --card-bg: #FFFFFF;
    --card-border: #C8E6C9;
  }

  /* Dark mode — deep green + medium green sections with readable text */
  html[data-theme="dark"] {
    color-scheme: dark;
    --bg-primary: #081F0F;        /* darkest green — hero / base sections */
    --bg-secondary: #0F2E1A;      /* dark green — alternating sections */
    --bg-tertiary: #163B21;       /* medium green — card-on-dark blocks */
    --text-primary: #EAF6EC;
    --text-secondary: #B9D6C0;
    --border-color: rgba(109, 192, 64, 0.22);
    --card-bg: #12331C;           /* medium green card surface */
    --card-border: rgba(109, 192, 64, 0.18);
    --primary-dark: #6DC040;      /* brighter green for text/icons on dark */
  }

  * { box-sizing: border-box; }
  html {
    -webkit-text-size-adjust: 100%;
    overflow-y: scroll;
    scrollbar-gutter: stable;
  }
  html, body { margin: 0; padding: 0; }

  *, *::before, *::after, body, button, input, select, textarea, h1, h2, h3, h4, h5, h6 {
    font-family: "Tiro Devanagari Hindi", serif, system-ui, -apple-system, sans-serif !important;
  }

  body {
    color: var(--text-primary);
    background: var(--bg-primary);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100vh;
    transition: background 0.3s ease, color 0.3s ease;
  }

  a { color: var(--primary); text-decoration: none; transition: color 0.2s; }
  a:hover { color: var(--primary-dark); }

  /* AirFone green gradient utility */
  .text-airfone-gradient {
    background: linear-gradient(135deg, var(--primary-gradient-start), var(--primary-gradient-end));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 1rem; top: 1rem; background: #fff; color: #000; padding: 0.75rem 1rem; z-index: 1000; outline: 2px solid #000; }

  /* Dark-mode form controls */
  html[data-theme="dark"] input,
  html[data-theme="dark"] select,
  html[data-theme="dark"] textarea {
    background: var(--card-bg);
    border-color: var(--card-border);
    color: var(--text-primary);
  }
  html[data-theme="dark"] input::placeholder,
  html[data-theme="dark"] textarea::placeholder {
    color: rgba(185, 214, 192, 0.6);
  }

  /* Navbar */
  .navbar {
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(61, 181, 81, 0.15);
    box-shadow: 0 2px 12px rgba(61, 181, 81, 0.08);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    text-shadow: none;
  }

  html[data-theme="light"] .navbar {
    text-shadow: none;
  }

  .navbar.scrolled {
    background: rgba(255, 255, 255, 0.99);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(61, 181, 81, 0.2);
    box-shadow: 0 4px 20px rgba(61, 181, 81, 0.1);
    text-shadow: none;
  }

  html[data-theme="light"] .navbar.scrolled {
    background: rgba(255, 255, 255, 0.99);
    border-bottom: 1px solid rgba(61, 181, 81, 0.2);
    box-shadow: 0 4px 20px rgba(61, 181, 81, 0.1);
  }

  /* Always-opaque navbar for pages without a dark hero (e.g. login) */
  .navbar.solid-nav {
    background: rgba(255, 255, 255, 0.99);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(61, 181, 81, 0.2);
    box-shadow: 0 4px 20px rgba(61, 181, 81, 0.1);
    text-shadow: none;
  }

  html[data-theme="light"] .navbar.solid-nav {
    background: rgba(255, 255, 255, 0.99);
    border-bottom: 1px solid rgba(61, 181, 81, 0.2);
    box-shadow: 0 4px 20px rgba(61, 181, 81, 0.1);
  }

  html[data-theme="light"] .navbar.solid-nav .brand,
  html[data-theme="light"] .navbar.solid-nav .nav-link {
    color: #1A3A1A;
  }

  html[data-theme="light"] .navbar.solid-nav .brand:hover,
  html[data-theme="light"] .navbar.solid-nav .nav-link:hover {
    color: #3DB551;
  }

  html[data-theme="light"] .navbar.solid-nav .brand-line-1,
  html[data-theme="light"] .navbar.solid-nav .brand-line-2 {
    color: #3DB551;
  }

  html[data-theme="light"] .navbar.solid-nav .lang-toggle a.active {
    color: #3DB551;
  }

  html[data-theme="light"] .navbar.solid-nav .theme-toggle {
    background: rgba(61, 181, 81, 0.08);
    border: 1px solid rgba(61, 181, 81, 0.2);
  }

  html[data-theme="light"] .navbar.solid-nav .theme-toggle:hover {
    background: rgba(61, 181, 81, 0.15);
  }

  .navbar.solid-nav .brand-line-3 {
    color: #FFFFFF;
  }

  html[data-theme="light"] .navbar.solid-nav .brand-line-3 {
    color: #1A3A1A;
  }

  html[data-theme="light"] .navbar.scrolled .brand,
  html[data-theme="light"] .navbar.scrolled .nav-link {
    color: #1A3A1A;
  }

  html[data-theme="light"] .navbar.scrolled .brand:hover,
  html[data-theme="light"] .navbar.scrolled .nav-link:hover {
    color: #3DB551;
  }

  html[data-theme="light"] .navbar.scrolled .brand-line-1,
  html[data-theme="light"] .navbar.scrolled .brand-line-2 {
    color: #3DB551;
  }

  html[data-theme="light"] .navbar.scrolled .lang-toggle a.active {
    color: #3DB551;
  }

  html[data-theme="light"] .navbar.scrolled .theme-toggle {
    background: rgba(61, 181, 81, 0.08);
    border: 1px solid rgba(61, 181, 81, 0.2);
  }

  html[data-theme="light"] .navbar.scrolled .theme-toggle:hover {
    background: rgba(61, 181, 81, 0.15);
  }

  /* Dark-mode navbar — deep green bar with readable text */
  html[data-theme="dark"] .navbar {
    background: rgba(8, 31, 15, 0.96);
    border-bottom-color: rgba(109, 192, 64, 0.15);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
  }

  html[data-theme="dark"] .navbar.scrolled,
  html[data-theme="dark"] .navbar.solid-nav {
    background: rgba(8, 31, 15, 0.98);
    border-bottom-color: rgba(109, 192, 64, 0.2);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  html[data-theme="dark"] .brand-logo {
    filter: brightness(0) invert(1);
  }

  html[data-theme="dark"] .nav-link {
    color: var(--text-primary);
  }

  html[data-theme="dark"] .nav-link:hover {
    color: #6DC040;
  }

  html[data-theme="dark"] .nav-link.active {
    color: #6DC040 !important;
  }

  html[data-theme="dark"] .btn-signin {
    color: var(--text-primary);
  }

  html[data-theme="dark"] .btn-signin:hover {
    color: #6DC040;
  }

  html[data-theme="dark"] .lang-toggle-btn {
    color: var(--text-primary);
    border-color: rgba(109, 192, 64, 0.35);
    background: rgba(109, 192, 64, 0.04);
  }

  html[data-theme="dark"] .lang-toggle-btn:hover {
    color: #FFFFFF;
    border-color: #3DB551;
    background: #3DB551;
  }

  html[data-theme="dark"] .navbar-theme-toggle .theme-toggle {
    background: rgba(109, 192, 64, 0.1);
    border-color: rgba(109, 192, 64, 0.25);
    color: #6DC040;
  }

  html[data-theme="dark"] .hamburger span {
    background: var(--text-primary);
  }

  .navbar-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
  }

  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity 0.2s;
    z-index: 2;
  }

  .brand:hover { opacity: 0.85; }

  /* AirFone logo image in navbar */
  .brand-logo {
    height: 132px;
    width: auto;
    display: block;
    object-fit: contain;
    margin-top: -20px;
    margin-bottom: -20px;
  }

  .nav-links {
    position: absolute;
    left: 46%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 2.5rem;
    list-style: none;

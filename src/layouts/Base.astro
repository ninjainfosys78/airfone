---
// The site's layout: the kit's Base plus the pieces only AirFone has.
// The slots are written without whitespace between them, so none leaks into <main>.
import KitBase from '@ninjainfosys/site-kit/layouts/Base.astro';
import GoogleOneTap from '../components/site/GoogleOneTap.astro';

const props = Astro.props;
// Without JavaScript the custom players can't run: show native audio controls.
const headEnd = `<!-- Without JavaScript the custom players can't run: show native audio controls. --><noscript><style>call-player .slot { display: grid !important; } call-player audio { visibility: visible !important; } call-player .slot .wave { display: none; }</style></noscript>`;
---
<KitBase {...props}><slot name="head" slot="head" /><Fragment slot="head-end" set:html={headEnd} /><slot /><Fragment slot="scripts"><script>
  import { initTaps } from '../scripts/tap';
  initTaps();
</script></Fragment><GoogleOneTap slot="body-end" /></KitBase>

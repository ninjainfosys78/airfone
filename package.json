{
  "name": "airfone-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "airfone.app marketing site (Astro static).",
  "scripts": {
    "dev": "astro dev",
    "build": "site-kit redirects && astro build && site-kit sitemap dist",
    "preview": "astro preview",
    "test": "vitest run",
    "check": "site-kit credits && site-kit check dist",
    "indexnow": "site-kit indexnow",
    "voices": "node scripts/make-voices.mjs",
    "bundle": "pnpm run build && node scripts/make-bundle.mjs",
    "verify": "node scripts/make-bundle.mjs --verify-only",
    "lighthouse": "scripts/lighthouse.sh",
    "qa": "pnpm test && pnpm build && pnpm check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/source-serif-4": "5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@fontsource/poppins": "^5",
    "@lucide/astro": "1.53.0",
    "astro": "^5",
    "@ninjainfosys/site-kit": "^0.2.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2",
    "axe-core": "^4",
    "puppeteer-core": "^24",
    "sharp": "^0.35.4",
    "typescript": "^5.4.0",
    "vitest": "^3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0"
}

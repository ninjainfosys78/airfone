{
  "name": "airfone-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "airfone.app marketing site (Astro static).",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "check": "node scripts/check-site.mjs dist",
    "voices": "node scripts/make-voices.mjs",
    "bundle": "pnpm run build && node scripts/make-bundle.mjs",
    "verify": "node scripts/make-bundle.mjs --verify-only"
  },
  "dependencies": {
    "@astrojs/rss": "^4",
    "@astrojs/sitemap": "^3",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "astro": "^5"
  },
  "devDependencies": {
    "node-html-parser": "^7",
    "sharp": "^0.35.4",
    "typescript": "^5.4.0",
    "vitest": "^3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0"
}
